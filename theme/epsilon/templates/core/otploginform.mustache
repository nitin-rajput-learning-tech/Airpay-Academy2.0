<div class="row justify-content-center login_main">
    <div class="col-xl-4 col-sm-8 ">
        <div class="card">
            <div class="card-block">
                
                {{#logourl}}
                    <h1 class="h2 card-header text-center" >
                        <span class="sr-only">{{sitename}}: {{#str}} login {{/str}}</span>
                        <img src="{{logourl}}" class="img-fluid" alt=""/>
                    </h1>
                {{/logourl}}
                {{^logourl}}
                    <h1 class="h2 card-header text-center" aria-label="{{sitename}}: {{#str}} login {{/str}}">{{sitename}}</h1>
                {{/logourl}}
                
                <div class="card-body">
                    {{#cansignup}}
                        <div class="sr-only">
                            <a href="{{signupurl}}">{{#str}} tocreatenewaccount {{/str}}</a>
                        </div>
                    {{/cansignup}}

                    {{#error}}
                        <div class="loginerrors mt-3">
                            <a href="#" id="loginerrormessage" class="accesshide">{{error}}</a>
                            <div class="alert alert-danger" role="alert" data-aria-autofocus="true">{{error}}</div>
                        </div>
                    {{/error}}

                    <div class="row justify-content-md-center">
                        <div class="col-md-12">
                            {{#logourl}}
                                    <h2 class="card-header">
                                        <img src="{{logourl}}" title="{{sitename}}" alt="{{sitename}}"/>
                                    </h2>
                            {{/logourl}}
                            {{^logourl}}
                                <h4 class="col-md-12 pb-0 heading_tag">{{{welcometext}}}</h4>
                                <img class = "login_logo" src="{{loginlogo}}" title="Login Logo" alt="Login Logo"/>
                                <div class="col-md-12 pb-0">
                                    <p class=" col-md-12 loginstart_tag text-center mb-0">{{{captiontext}}}</p>
                                </div>
                            {{/logourl}}
                            <form class="mt-3" action="{{loginurl}}" method="post" id="login">
                                <input id="anchor" type="hidden" name="anchor" value="">
                                <script>document.getElementById('anchor').value = location.hash;</script>
                                <input type="hidden" name="logintoken" value="{{logintoken}}">
                                <div class="form-group">
                                    <label for="username" class="custom_lable">
                                        {{^canloginbyemail}}
                                            {{#str}} phonenumber, theme_epsilon {{/str}}
                                        {{/canloginbyemail}}
                                        {{#canloginbyemail}}
                                            {{#str}} usernameemail {{/str}}
                                        {{/canloginbyemail}}
                                    </label>
                                    <input type="text" name="username" id="applicationid"
                                        class="form-control custom_control"
                                        value="{{username}}"
                                        placeholder={{#quote}}{{^canloginbyemail}}XXX XXX XXXX{{/canloginbyemail}}{{#canloginbyemail}}{{#str}}usernameemail{{/str}}{{/canloginbyemail}}{{/quote}}
                                        autocomplete="username">
                                </div>
                                <div class="forgetpass">
                                    <p><input class="btn" type="button" id="sentotplink" value="{{#str}}generateotp, auth_otp{{/str}}" /></p>
                                </div>
                                <div id="loginpassdiv" style="display:none;">
                                <div class="form-group">
                                    <label for="password" class="custom_lable">{{#str}}  enterotp, theme_epsilon  {{/str}}</label>
                                    <input type="password" name="password" id="password" value=""
                                        class="form-control custom_control"
                                        placeholder={{#quote}}{{#str}}enterotp, theme_epsilon{{/str}}{{/quote}}
                                        autocomplete="current-password">
                                </div>

                                <div class="forgetpass">
                                   <p><a href="#" class="fp_text" id="resendotplink">{{#str}}resentotp, theme_epsilon{{/str}}</a></p>
                                </div>

                                <button type="submit" class="btn btn-primary btn-block mt-5 hiddennow" id="loginbtn">{{#str}}login, moodle{{/str}}</button>
                            </div>
                            </form>
                        </div>

                        {{#hasidentityproviders}}
                            <h2 class="h6 mt-2">{{#str}} potentialidps, auth {{/str}}</h2>
                            <div class="potentialidplist mt-3">
                                {{#identityproviders}}
                                    <div class="potentialidp">
                                        <a href="{{url}}" title={{#quote}}{{name}}{{/quote}} class="btn btn-secondary btn-block">
                                            {{#iconurl}}
                                                <img src="{{iconurl}}" alt="" width="24" height="24"/>
                                            {{/iconurl}}
                                            {{name}}
                                        </a>
                                    </div>
                                {{/identityproviders}}
                            </div>
                        {{/hasidentityproviders}}
                    </div>

                    {{#hasinstructions}}
                        <div class="row mt-3">
                            <div class="col-xl-12">
                                {{#cansignup}}
                                    <form class="" action="{{{ config.wwwroot }}}/local/users/signup.php" method="get" id="signup">
                                        <button type="submit" class="btn btn-link register_with_us p-0">{{#str}}startsignup, theme_epsilon{{/str}}</button>
                                    </form>
                                {{/cansignup}}
                            </div>
                        </div>
                    {{/hasinstructions}}
                </div>
            </div>
        </div>
    </div>
</div>


{{#maintenance}}
    <div class="row justify-content-center mt-3">
        <div class="col-xl-6 col-sm-8">
            <div class="card">
                <div class="card-body">
                    <div class="card-title">
                        <h2>{{#str}}sitemaintenance, core_admin{{/str}}</h2>
                    </div>
                    <div>
                        {{{maintenance}}}
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/maintenance}}
{{#js}}
require(['jquery', 'core/ajax'], function($, ajax) {
    $("#sentotplink").click(function(e){
        var application_id = $("#applicationid").val();
        var type = 1;
        sendotp(application_id, type, 1);
    });
    $("#resendotplink").click(function(e){
        var application_id = $("#applicationid").val();
        var type = 1;
        sendotp(application_id, type, 2);
    });

    $("#loginbtn").click(function(e) {
        e.preventDefault();
        var application_id = $("#applicationid").val();
        var otppassword =$("#password").val();
        var type = 2;

        if(application_id !='' && otppassword !='') {
            ajax.call([{
                methodname: 'auth_otp_validateuserdetails',
                args: {username: application_id, otp: otppassword, type: type},
                done: function(status) {
                    if(status == 1) {
                        $("#login").submit();
                        return true;
                    } else if(status == 2) {
                        e.preventDefault();
                        var retVal =confirm("OTP entered incorrect more than 3 times. Please re-generate OTP");
                        if(retVal === true) {
                            document.location.reload();
                        }
                    } else if(status == 3) {
                        e.preventDefault();
                        confirm("OTP incorrect, please enter correct OTP");
                    } else if(status == 4) {
                        e.preventDefault();
                        confirm("OTP incorrect, please Regenerate OTP and try again");
                    } else {
                        e.preventDefault();
                        alert("Please verify the mobile number and OTP");
                    }
                }
            }]);
        } else {
            e.preventDefault();
            if (application_id == '') {
                alert("Please enter email");
            } else {
                if ($('#loginbtn').hasClass('hiddennow')) {
                    sendotp(application_id, 4, 1);
                } else {
                    alert("Please enter OTP");
                }
            }
        }
    });

    function sendotp(application_id, type, flag) {
        if(application_id !='') {
            ajax.call([{
                methodname: 'auth_otp_validateuserdetails',
                args: {username: application_id, otp: 0, type: type},
                done: function(status) {
                    if (status == 3) {
                        if (flag == 1) {
                            alert("Successfully sent OTP to your Mobile.");
                        } else if (flag == 2) {
                            alert("Successfully resent OTP to your Mobile.");
                        } else {
                            alert("Error in login");
                        }
                        $("#sentotplink").hide();
                        $("#loginpassdiv").show();
                        $('#loginbtn').removeClass('hiddennow');
                    } else if(status == 2) {
                        var retVal =confirm("Please check your account mobile number");
                        if(retVal == true){
                            document.location.reload();
                        }
                    } else if(status == 1) {
                        var retVal =confirm("Entered username / email does not exists");
                        if(retVal == true){
                            document.location.reload();
                        }
                    } else if(status == 0) {
                        var retVal =confirm("Error with OTP service");
                        if(retVal == true){
                            document.location.reload();
                        }
                    } else {
                        confirm(status);
                    }
                }
            }]);
        }
        else {
            alert("Please enter email");
        }
    }
});
{{#error}}
    require(['jquery'], function($) {
        $('#loginerrormessage').focus();
    });
{{/error}}
{{^error}}
    {{#autofocusform}}
        require(['jquery'], function($) {
            if ($('#username').val()) {
                $('#password').focus();
            } else {
                $('#username').focus();
            }
        });
    {{/autofocusform}}
{{/error}}
{{/js}}
