{{!
    @template theme_sentientia/sidebar_langswitch

    Language switcher for the app-shell sidebar (persona-pass fix D7,
    2026-09-30). Included by sidebar.mustache and by the dashboard's own
    sidebar copy in dashboard.mustache, just above the dark-mode toggle.

    Renders nothing unless langswitch.hasoptions is true, which needs the
    default-OFF flag ux.languageSwitcher.enabled to be ON and two or more
    installed languages. Selecting a language goes through the sesskey-checked
    switchlang.php endpoint, which applies it at once and saves it to the
    user's profile. The active language is a non-clickable marker (empty url).

    Context variables required for this template:
    * langswitch - object with hasoptions, currentlabel, currentcode and options
      * options - list of code, label, htmllang, active and url

    Example context (json):
    {
        "langswitch": {
            "hasoptions": true,
            "currentlabel": "English (en)",
            "currentcode": "en",
            "options": [
                {
                    "code": "en",
                    "label": "English (en)",
                    "htmllang": "en",
                    "active": true,
                    "url": ""
                },
                {
                    "code": "hi",
                    "label": "Hindi (hi)",
                    "htmllang": "hi",
                    "active": false,
                    "url": "https://example.com/theme/sentientia/switchlang.php?code=hi"
                }
            ]
        }
    }
}}
{{#langswitch.hasoptions}}
<details class="ap-sidebar__langswitch" data-region="langswitch">
    <summary class="ap-sidebar__langswitch-toggle" aria-label="{{#str}}langswitch_label, theme_sentientia{{/str}}: {{langswitch.currentlabel}}">
        <i class="fa fa-globe ap-sidebar__langswitch-icon" aria-hidden="true"></i>
        <span class="ap-sidebar__langswitch-current">{{langswitch.currentlabel}}</span>
        <i class="fa fa-chevron-up ap-sidebar__langswitch-caret" aria-hidden="true"></i>
    </summary>
    <div class="ap-sidebar__langswitch-list" role="group" aria-label="{{#str}}langswitch_label, theme_sentientia{{/str}}">
        {{#langswitch.options}}
            {{#active}}
            <span class="ap-sidebar__roleswitch-item ap-sidebar__roleswitch-item--active" lang="{{htmllang}}" aria-current="true">
                <span class="ap-sidebar__roleswitch-item-text">{{label}}</span>
                <i class="fa fa-check ap-sidebar__roleswitch-check" aria-hidden="true"></i>
            </span>
            {{/active}}
            {{^active}}
            <a href="{{url}}" class="ap-sidebar__roleswitch-item" lang="{{htmllang}}" hreflang="{{htmllang}}" data-langswitch-link="1">
                <span class="ap-sidebar__roleswitch-item-text">{{label}}</span>
            </a>
            {{/active}}
        {{/langswitch.options}}
    </div>
</details>
{{/langswitch.hasoptions}}
