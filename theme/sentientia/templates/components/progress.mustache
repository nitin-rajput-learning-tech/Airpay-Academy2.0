{{!
    Airpay Progress Bar Component
    Context: { percent (0-100), label, size (sm|md|lg), showlabel (bool) }
    Usage: include the partial "theme_sentientia/components/progress".
    Audit fix H1 (2026-05-15) — see stat_card.mustache for the rationale.
}}
<div class="airpay-progress {{#size}}airpay-progress--{{size}}{{/size}}">
    {{#showlabel}}
    <div class="airpay-progress__header">
        {{#label}}<span class="airpay-progress__label">{{label}}</span>{{/label}}
        <span class="airpay-progress__value">{{percent}}%</span>
    </div>
    {{/showlabel}}
    <div class="airpay-progress__track" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
        <div class="airpay-progress__fill" style="width: {{percent}}%"></div>
    </div>
</div>
