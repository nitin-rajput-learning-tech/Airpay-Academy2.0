{{!
    Airpay Stat Card Component — Phase A0.5 (2026-05-14)

    Context:
        value         (required) — the headline number / metric
        label         (required) — the metric name
        icon          (optional) — Font Awesome class without "fa-" prefix
        color         (optional) — semantic colour: primary | accent | success | gold | warning | danger
                                   defaults to "primary"
        trend         (optional) — supporting text shown below label (e.g. "+12 this week")
        trenddir      (optional) — "up" | "down" | "flat" — controls trend arrow + colour
        href          (optional) — when present, wraps tile in <a> with focus-visible support
        ariadesc      (optional) — overrides the auto-built aria-label

    Behaviour:
        - When href is set, the whole tile becomes a single click target with proper
          keyboard focus + hover lift.
        - When href is absent, renders as a plain div (no keyboard focus, no link).
        - Trend respects motion tokens — fades in 250ms ease-out on load.

    Usage:
        Include the partial named "theme_sentientia/components/stat_card"
        from any template that loops over a kpi_tiles array.

    Audit fix H1 (2026-05-15): the previous usage example contained the
    literal partial syntax with closing braces inside this comment, which
    Mustache parses non-greedily — the in-body close prematurely ended
    the comment and dumped the trailing close as literal text before every
    rendered card. Keep this comment free of close-brace pairs.
}}
{{#href}}
<a class="airpay-stat-card airpay-stat-card--{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}} airpay-stat-card--linked"
   href="{{href}}"
   aria-label="{{#ariadesc}}{{ariadesc}}{{/ariadesc}}{{^ariadesc}}{{label}}: {{value}}{{#trend}}, {{trend}}{{/trend}}{{/ariadesc}}">
{{/href}}
{{^href}}
<div class="airpay-stat-card airpay-stat-card--{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}}"
     role="group"
     aria-label="{{#ariadesc}}{{ariadesc}}{{/ariadesc}}{{^ariadesc}}{{label}}: {{value}}{{#trend}}, {{trend}}{{/trend}}{{/ariadesc}}">
{{/href}}
    {{#icon}}
    <div class="airpay-stat-card__icon" aria-hidden="true">
        <i class="fa fa-{{icon}}"></i>
    </div>
    {{/icon}}
    <div class="airpay-stat-card__body">
        <span class="airpay-stat-card__value">{{value}}</span>
        <span class="airpay-stat-card__label">{{label}}</span>
        {{#trend}}
        <span class="airpay-stat-card__trend airpay-stat-card__trend--{{#trenddir}}{{trenddir}}{{/trenddir}}{{^trenddir}}flat{{/trenddir}}">
            {{#trenddir}}<i class="fa fa-arrow-{{trenddir}}" aria-hidden="true"></i>{{/trenddir}}
            <span>{{trend}}</span>
        </span>
        {{/trend}}
    </div>
{{#href}}
</a>
{{/href}}
{{^href}}
</div>
{{/href}}
