{{! Reusable org hierarchy cascade filter — 5 cascading selects from }}
{{! tenant root down to level-5 unit. W1-1 BizLMS parity (2026-05-15). }}
{{! See WAVE-1-PLAN.md and stat_card.mustache for documentation. The }}
{{! parent template MUST pass cascade_group in its render data array. }}
<div>
    <label for="ap-org-cascade-l1-{{cascade_group}}" class="small text-muted mb-1 d-block">{{#str}}cascade_l1, local_sentientia_org{{/str}}</label>
    <select id="ap-org-cascade-l1-{{cascade_group}}" class="form-select form-select-sm"
            data-airpay-org-cascade data-cascade-depth="1" data-cascade-all-label="{{#str}}cascade_all_l1, local_sentientia_org{{/str}}"
            data-cascade-parent="0" data-cascade-group="{{cascade_group}}"
            style="min-width: 180px;" aria-label="{{#str}}cascade_l1, local_sentientia_org{{/str}}">
        <option value="0">{{#str}}cascade_all_l1, local_sentientia_org{{/str}}</option>
    </select>
</div>
