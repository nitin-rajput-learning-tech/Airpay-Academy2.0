{{!
    Page header.
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}

    {{! Dark mode init — runs BEFORE CSS to prevent flash.
        Dark mode is OPT-IN ONLY: it applies solely when the user has explicitly
        chosen it (localStorage 'airpay-theme' === 'dark'). It NEVER follows the
        browser/OS prefers-color-scheme (2026-09-04: an OS dark setting must not
        force the app dark). Whether the feature is offered at all is the
        super-admin's ux.darkMode.enabled switch, gated in standard_head_html().
        Default is light. }}
    <script>
    (function() {
        var saved = localStorage.getItem('airpay-theme');
        var isDark = saved === 'dark';
        // Apply IMMEDIATELY to <html> to prevent flash.
        // Set BOTH class (legacy) and data-attribute (token system).
        document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        if (isDark) {
            document.documentElement.classList.add('dark-mode');
        } else {
            document.documentElement.classList.remove('dark-mode');
        }
        // Sync to <body> once available + set up listeners.
        document.addEventListener('DOMContentLoaded', function() {
            // Force-sync body to match html (handles any leftover state).
            if (isDark) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }
            // Update toggle icon to match current state.
            var toggleBtn = document.querySelector('.airpay-nav__theme-toggle i');
            if (toggleBtn) {
                toggleBtn.className = isDark ? 'fa fa-sun' : 'fa fa-moon';
            }
            // Dark mode is opt-in only; it does NOT follow OS/browser theme changes.
        });
    })();
    </script>

    <style media="screen">
        :root {
            /* Airpay Academy Design System — Phase 6B */
            --primarycolor: #0066A7;
            --secondarycolor: #1985DD;
            --hovercolor: #004d7a;

            /* Derived from primary */
            --sitehighlight: var(--primarycolor);
            --buttonbgcolor: var(--primarycolor);
            --btntextcolor: #ffffff;
            --btnhoverbgcolor: var(--hovercolor);
            --btnhovertextcolor: #ffffff;
            --btnbordercolor: var(--primarycolor);
            --linkcolor: var(--primarycolor);
            --linkhovercolor: var(--hovercolor);

            /* Sidebar & blocks */
            --sidebarbgstartcolor: var(--primarycolor);
            --sidebarbgendcolor: var(--primarycolor);
            --blockheaderstartbg: var(--primarycolor);
            --blockheaderendbg: var(--primarycolor);
            --blocktextcolor: #1a1a2e;

            /* Page backgrounds */
            --headerbgcolor: #F2F4FB;
            --bodybgcolor: #F2F4FB;

            /* Tables */
            --tblhdstartbg: var(--primarycolor);
            --tblhdendbg: var(--primarycolor);
            --tbltextcolor: #fff;

            /* Other surfaces */
            --gradientcolor: #fff;
            --coursecontainerbg: #e6f0f7;
            --usernavhvrbg: #ffffff;
            --usernavhvrlink: var(--primarycolor);
            --iconbgcolor: var(--sitehighlight);

            /* Airpay extended tokens */
            --airpay-primary: #0066A7;
            --airpay-primary-dk: #004d7a;
            --airpay-accent: #1985DD;
            --airpay-accent-lt: #e6f5f3;
            --airpay-text: #1a1a2e;
            --airpay-text-sec: #607286;
            --airpay-text-muted: #8896a6;
            --airpay-border: #e3eaf3;
            --airpay-bg-body: #F2F4FB;
            --airpay-bg-surface: #FFFFFF;
            --airpay-shadow-sm: 0 4px 20px rgba(0,51,102,0.06);
            --airpay-shadow-md: 0 8px 32px rgba(0,51,102,0.08);
            --airpay-radius-sm: 8px;
            --airpay-radius-md: 12px;
            --airpay-radius-lg: 16px;
        }
    </style>
    <link rel="stylesheet" href="{{output.getsitecolors_link}}" >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0066A7">
    {{! Standard PWA capability meta (Chrome/Edge/Android). Apple's variant is
        kept below for older iOS Safari. Emitting only the apple one logs a
        deprecation warning on every page; pairing them clears it. }}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="{{{config.wwwroot}}}/theme/sentientia/pix/brand/manifest.json">
    <link rel="apple-touch-icon" href="{{{config.wwwroot}}}/theme/sentientia/pix/brand/favicon_io/apple-touch-icon.png">
    {{!
        2026-05-20 / Stream B / Phase B.1 — Service worker registration.
        Loads register.js which registers the SW from /local/sentientia_pwa/sw.php.
        The PHP endpoint sends Service-Worker-Allowed: / so the SW controls
        the whole Moodle install, not just /local/sentientia_pwa/. Unlocks
        the manifest-driven install prompt (footer.mustache's
        beforeinstallprompt handler) and Phase B.2+ push notifications.
    }}
    <script src="{{{config.wwwroot}}}/local/sentientia_pwa/register.js" defer></script>
    <style>
        html,body{
            font-family:"Montserrat", sans-serif;
        }
    </style>
    <script>
    // Dark mode persistence — runs before body renders to prevent flash
    (function() {
        var theme = localStorage.getItem('airpay-theme');
        if (theme === 'dark') {
            document.documentElement.classList.add('dark-mode');
        }
        // Also apply to body once it exists
        document.addEventListener('DOMContentLoaded', function() {
            var t = localStorage.getItem('airpay-theme');
            if (t === 'dark') {
                document.body.classList.add('dark-mode');
            }
            // Update toggle icon state
            var toggle = document.querySelector('.airpay-nav__theme-toggle i');
            if (toggle && t === 'dark') {
                toggle.className = 'fa fa-sun';
            }
        });
    })();
    </script>
    <script>
    // A1 Fix: jQuery $ shim for BizLMS. Uses jQuery.noConflict pattern.
    // This runs early but jQuery may not be loaded yet.
    // The real fix is applied after DOMContentLoaded when jQuery is available.
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof window.jQuery !== 'undefined' && typeof window.$ === 'undefined') {
            window.$ = window.jQuery;
        }
    });
    </script>
</head>
