{{!
    @template core/full_header

    This template renders the header.

    Example context (json):
    {
        "contextheader": "context_header_html",
        "settingsmenu": "settings_html",
        "hasnavbar": false,
        "navbar": "navbar_if_available",
        "courseheader": "course_header_html",
        "welcomemessage": "welcomemessage"
    }
}}
<header id="page-header" class="d-print-none">
    <div class="w-100">
        <div class="d-flex justify-content-end">
            {{#hasnavbar}}
                    <div id="page-navbar">
                        {{{navbar}}}
                    </div>
                {{/hasnavbar}}
        </div>
        {{!
            SECURITY — coursebannerimage CSS url() injection prevention (P2 #20 / F-20).

            Source of `coursebannerimage`:
              \theme_sentientia\output\traits\course_view::course_bannerimage()
              (classes/output/traits/course_view.php:74-88).

            That method only ever returns one of two values:
              1. \moodle_url::make_pluginfile_url(
                     $file->get_contextid(), $file->get_component(),
                     $file->get_filearea(), null,
                     $file->get_filepath(), $file->get_filename()
                 )->out()
                 — for course overview files uploaded by course editors.
              2. $this->image_url('course_default', 'theme_sentientia')->out()
                 — for the theme-bundled default banner (developer-controlled).

            The user-controllable inputs ($filepath, $filename — uploaded
            banner file name) flow through Moodle's
            \core\url::set_slashargument() (lib/classes/url.php:585-601),
            which applies rawurlencode() to every path segment.
            rawurlencode() percent-encodes every character that could
            terminate the CSS url('...') context:
              '  "  (  )  ;  \  <  >  <space>

            Worked example: a filename of   foo'); background:url('evil
            becomes                          foo%27%29%3B%20background%3Aurl%28%27evil
            in the final URL — inert in CSS context.

            For the slasharguments=off code-path, the value is passed as a
            query-string parameter (file=...) and url::get_query_string()
            (lib/classes/url.php:298-323) likewise calls rawurlencode() on
            every value before assembling the URL — same protection.

            Defense in depth: the {{ }} double-brace below adds
            HTML-escaping on top of the URL-encoding (covers the
            HTML-attribute context too). DO NOT migrate to {{{ }}}
            triple-brace here.

            Verified 2026-05-24 / Wave-3 chip Q. See:
              - docs/audits/PLATFORM-VISUAL-AUDIT-2026-05-24.md (F-20)
              - docs/visual-evidence/2026-05-24/wave3-chip-Q/README.md
        }}
        <div class="courseheader" style="background-image: url('{{coursebannerimage}}');">
            
            <div class="d-flex flex-column  course_heading h-100">
              
                <div class="heading" >
                    {{{contextheader}}}
                    {{#activityurl}}
                        {{{course_summary_data}}}
                    {{/activityurl}}
                </div>
                <div class="row mt-auto pb-4">
                    <div class="col-md-3 rating_container d-flex align-items-center">
                        {{{display_ratings}}}
                    </div>      
                                  
                    {{{display_duedays}}}                       
                    
                    {{^courseprogresspercent}}
                    <div class="col-md-3 user_enrollment d-flex">
                        <div class="seats_icon">
                            <i class="fa fa-shopping-cart"></i>
                        </div>
                        <div class="enroll_details d-flex">
                            <span class="details_content text-nowrap">User Enrollements :</span>
                            <span class="enroll_number">{{enrolledusercount}}</span>
                        </div>
                    </div>
                    <div class=" user_completion col-md-3 d-flex">
                        <div class="user_icon">
                            <i class="fa fa-users"></i>
                        </div>
                        <div class="enroll_details d-flex">
                            <span class="details_content text-nowrap">User Completion :</span>
                            <span class="enroll_number">{{completedusercount}}/{{enrolledusercount}}</span>
                        </div>
                    </div>
                    {{/courseprogresspercent}}
                    {{#courseprogresspercent}}
                    <div class="col-md-2"></div>
                    <div class="col-md-4 align-items-center user_enrollment flex-column d-flex">
                        
                        {{#activityurl}}
                            <div class="context-header-settings-menu">
                                <a href="{{activityurl}}" title="Start" class='btn start_btn mb-3 btn-block btn-secondary'>
                                        Start
                                </a>
                            </div>
                        {{/activityurl}}
                        <div class="d-flex w-100">
                            <div class="max-progress d-flex align-items-center">
                                <div class="progress flexgrow-1">
                                    <div class="progress-bar text-center" role="progressbar" style="width:{{usercourseprogresspercent}}%;"
                                        aria-valuenow="{{usercourseprogresspercent}}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span>{{usercourseprogresspercent}}%</span>
                            </div>
                        </div>
                    </div> 
                    
                    {{/courseprogresspercent}}
                </div>
            </div>
            {{#settingsmenu}}
                <div class="context-header-settings-menu">
                    {{{settingsmenu}}}
                </div>
            {{/settingsmenu}}
        </div>
        {{#course_summary_data}}
        <div class="px-3">
            <h3 class="mt-2">Description</h3>
            {{{course_summary_data}}}
        </div>
        {{/course_summary_data}}
        
    </div>
    
</header>
