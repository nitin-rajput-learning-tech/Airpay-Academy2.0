{{!

    @template theme_sentientia/navbar

    This template renders the top navbar.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "airpay academy",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": false
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": false
            }
        ]
    }
}}
<nav class="navbar fixed-top navbar-light navbar-expand airpay-nav" aria-label="{{#str}}sitemenubar, admin{{/str}}">

    {{! Mobile hamburger }}
    <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_sentientia-drawers-primary" aria-label="{{#str}}a11y_mobilemenu, theme_sentientia{{/str}}">
        <span class="navbar-toggler-icon"></span>
        <span class="sr-only">{{#str}}a11y_mobilemenu, theme_sentientia{{/str}}</span>
    </button>

    {{! Left: Logo }}
    <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 mr-3 p-0 aabtn">
        {{# output.should_display_navbar_logo }}
            <img src="{{output.get_custom_logo}}" class="logo mr-1" alt="{{sitename}}">
        {{/ output.should_display_navbar_logo }}
        {{^ output.should_display_navbar_logo }}
            <span class="airpay-nav__brand">{{{ sitename }}}</span>
        {{/ output.should_display_navbar_logo }}
    </a>

    {{! Pill Navigation — siteadmin: Dashboard only. Everyone else: all 4. Guest: no Dashboard. }}
    <div class="airpay-nav__pills d-none d-md-flex">
        {{#isloggedin}}
        <a href="{{{config.wwwroot}}}/my/" class="airpay-nav__pill airpay-nav__pill--dashboard">{{#str}}nav_dashboard, theme_sentientia{{/str}}</a>
        {{/isloggedin}}
        {{^output.is_siteadmin_only}}
        {{#isloggedin}}
        <a href="{{{config.wwwroot}}}/local/sentientia_catalog/mycourses.php" class="airpay-nav__pill airpay-nav__pill--courses">{{#str}}nav_courses, theme_sentientia{{/str}}</a>
        {{/isloggedin}}
        <a href="{{{config.wwwroot}}}/local/sentientia_catalog/index.php" class="airpay-nav__pill airpay-nav__pill--catalog">{{#str}}nav_catalog, theme_sentientia{{/str}}</a>
        {{#isloggedin}}
        <a href="{{{config.wwwroot}}}/local/sentientia_users/profile.php" class="airpay-nav__pill airpay-nav__pill--profile">{{#str}}nav_profile, theme_sentientia{{/str}}</a>
        {{/isloggedin}}
        {{/output.is_siteadmin_only}}
    </div>

    {{! Right: Search + Quick Access + Plugins + User menu }}
    <div id="usernavigation" class="navbar-nav ml-auto airpay-nav__actions">
        {{! Search }}
        <div class="d-none d-md-flex align-items-center">
            <form action="{{{config.wwwroot}}}/search/index.php" method="get" class="airpay-nav__search" role="search" aria-label="{{#str}}a11y_search, theme_sentientia{{/str}}">
                <i class="fa fa-search airpay-nav__search-icon" aria-hidden="true"></i>
                <input type="text" name="q" class="airpay-nav__search-input" placeholder="{{#str}}a11y_search, theme_sentientia{{/str}}" aria-label="{{#str}}a11y_search, theme_sentientia{{/str}}" autocomplete="off">
            </form>
        </div>

        {{! Quick Access (BizLMS) }}
        {{#isloggedin}}
        <ul class="nav navbar-nav">
            <li class="nav-item">
                {{> theme_sentientia/quickaccess-popover}}
            </li>
        </ul>
        {{/isloggedin}}

        {{! Notifications, messaging (BizLMS plugins) }}
        {{{ output.navbar_plugin_output }}}

        {{!
            Airpay Cart icon — links to custom cart page with session-based count.
            Badge text + visibility are painted by amd/src/cart_badge.js (P0 #9
            audit follow-up 2026-05-24). The init call is wired from the layout
            PHP that renders this navbar partial.
        }}
        <a href="{{{config.wwwroot}}}/local/sentientia_catalog/cart.php" class="airpay-nav__cart" title="Shopping Cart" id="ap-cart-link">
            <i class="fa fa-shopping-cart" aria-hidden="true"></i>
            <span class="airpay-nav__cart-badge" id="ap-cart-badge" hidden>0</span>
        </a>

        {{! Dark mode toggle — persists via localStorage, icon swaps }}
        {{! Audit fix M1: FA4 -o icons replaced with FA5+ equivalents. }}
        <button class="airpay-nav__theme-toggle" onclick="var d=document.body.classList.toggle('dark-mode');document.documentElement.classList.toggle('dark-mode');localStorage.setItem('airpay-theme',d?'dark':'light');this.querySelector('i').className=d?'fa fa-sun':'fa fa-moon';" title="Toggle dark mode" aria-label="Toggle dark mode">
            <i class="fa fa-moon" aria-hidden="true"></i>
        </button>

        {{! User menu (BizLMS role switching) }}
        <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu" aria-label="{{#str}}a11y_usermenu, theme_sentientia{{/str}}">
            {{{ output.user_menu }}}
        </div>
        {{{ output.edit_switch }}}
    </div>
</nav>

{{! ═══ MOBILE BOTTOM NAVIGATION BAR ═══ }}
{{#isloggedin}}
<nav class="ap-mobile-nav d-md-none" aria-label="Mobile navigation">
    <a href="{{{config.wwwroot}}}/my/" class="ap-mobile-nav__item" data-page="dashboard">
        <i class="fa fa-th-large" aria-hidden="true"></i>
        <span>{{#str}}nav_home, theme_sentientia{{/str}}</span>
    </a>
    {{^output.is_siteadmin_only}}
    <a href="{{{config.wwwroot}}}/local/sentientia_catalog/index.php" class="ap-mobile-nav__item" data-page="catalog">
        <i class="fa fa-search"></i>
        <span>Explore</span>
    </a>
    <a href="{{{config.wwwroot}}}/local/sentientia_catalog/mycourses.php" class="ap-mobile-nav__item" data-page="courses">
        <i class="fa fa-book"></i>
        <span>Learning</span>
    </a>
    {{/output.is_siteadmin_only}}
    <a href="#" class="ap-mobile-nav__item" data-page="notifications" id="ap-mobile-notif-btn">
        <i class="fa fa-bell"></i>
        <span>Alerts</span>
    </a>
    <a href="{{{config.wwwroot}}}/local/sentientia_users/profile.php" class="ap-mobile-nav__item" data-page="profile">
        <i class="fa fa-user-circle" aria-hidden="true"></i>
        <span>{{#str}}nav_profile, theme_sentientia{{/str}}</span>
    </a>
</nav>
{{!
    B9/F-064 stabilization fix (2026-05-28): inline <script> extracted to
    AMD module `theme_sentientia/mobile_nav_highlight` so CSP-hardened
    deployments don't block the highlighter. Same logic, no behavior
    change.
}}
{{#js}}
require(['theme_sentientia/mobile_nav_highlight'], function(m) { m.init(); });
{{/js}}
{{/isloggedin}}

{{> theme_sentientia/primary-drawer-mobile }}
