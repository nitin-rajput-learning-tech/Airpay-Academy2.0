{{!
    Sidebar — Airpay Academy Enterprise.
    SINGLE SOURCE OF TRUTH for sidebar HTML.
    Rendered by core_renderer::airpay_shell_start().
    NO layout template should duplicate this — they call the renderer.

    Context from sidebar_navigation::get_context():
    * wwwroot - site root URL
    * collapsed - bool, sidebar collapsed state
    * logourl - tenant logo URL
    * sitename - site short name
    * navitems[] - {type, label, icon, url, active, badge}
    * issiteadmin, isldadmin, ismanager - role flags
    * userfullname, useravatar, userinitials
    * profileurl, logouturl
}}
<aside class="ap-sidebar" id="ap-sidebar" data-collapsed="{{#collapsed}}true{{/collapsed}}{{^collapsed}}false{{/collapsed}}">
    <div class="ap-sidebar__header">
        <a href="{{{wwwroot}}}/my/" class="ap-sidebar__brand">
            <span class="ap-sidebar__brand-mark"><i class="fa fa-graduation-cap"></i></span>
            <span class="ap-sidebar__brand-text">{{sitename}}</span>
        </a>
        <button class="ap-sidebar__collapse" id="ap-sidebar-toggle" aria-label="Toggle sidebar">
            <i class="fa fa-chevron-left ap-sidebar__toggle-icon"></i>
        </button>
    </div>
    <nav class="ap-sidebar__nav">
        {{#navitems}}
        {{#isdivider}}<div class="ap-sidebar__divider"></div>{{/isdivider}}
        {{^isdivider}}
        <a href="{{{url}}}" class="ap-sidebar__link {{#active}}ap-sidebar__link--active{{/active}}">
            <span class="ap-sidebar__link-icon"><i class="fa {{icon}}"></i></span>
            <span class="ap-sidebar__link-text">{{label}}</span>
        </a>
        {{/isdivider}}
        {{/navitems}}
    </nav>
    {{#roleswitch.hasoptions}}
    {{! Role switcher — multi-role (BizLMS category-context) users only. Shared
        across all app-shell pages via airpay_shell_start(); single-role users
        get hasoptions=false so nothing renders. Mirrors dashboard.mustache. }}
    <div class="ap-sidebar__roleswitch" data-region="roleswitch">
        <span class="ap-sidebar__roleswitch-label">
            <i class="fa fa-exchange ap-sidebar__roleswitch-icon"></i>
            <span class="ap-sidebar__roleswitch-label-text">{{#str}}switchroleto, theme_sentientia{{/str}}</span>
        </span>
        <div class="ap-sidebar__roleswitch-list" role="group" aria-label="{{#str}}switchroleto, theme_sentientia{{/str}}">
            {{#roleswitch.options}}
                {{#active}}
                <span class="ap-sidebar__roleswitch-item ap-sidebar__roleswitch-item--active" aria-current="true">
                    <i class="fa {{icon}} ap-sidebar__roleswitch-item-icon"></i>
                    <span class="ap-sidebar__roleswitch-item-text">{{label}}</span>
                    <i class="fa fa-check ap-sidebar__roleswitch-check" aria-hidden="true"></i>
                </span>
                {{/active}}
                {{^active}}
                <a href="{{{url}}}" class="ap-sidebar__roleswitch-item" data-roleswitch-link="1">
                    <i class="fa {{icon}} ap-sidebar__roleswitch-item-icon"></i>
                    <span class="ap-sidebar__roleswitch-item-text">{{label}}</span>
                </a>
                {{/active}}
            {{/roleswitch.options}}
        </div>
    </div>
    {{/roleswitch.hasoptions}}
    <div class="ap-sidebar__footer-actions">
        <button class="ap-sidebar__theme-btn" id="ap-dark-toggle" title="Toggle theme">
            <i class="fa fa-moon"></i>
            <span class="ap-sidebar__theme-label">Dark Mode</span>
        </button>
    </div>
    <div class="ap-sidebar__user">
        <a href="{{{profileurl}}}" class="ap-sidebar__user-link">
            <div class="ap-sidebar__user-avatar">{{{useravatar}}}</div>
            <div class="ap-sidebar__user-info">
                <span class="ap-sidebar__user-name">{{userfullname}}</span>
                <span class="ap-sidebar__user-action">Profile &amp; Settings</span>
            </div>
        </a>
        <a href="{{{logouturl}}}" class="ap-sidebar__signout" title="{{#str}}logout{{/str}}"><i class="fa fa-sign-out" aria-hidden="true"></i><span class="ap-sidebar__signout-label">{{#str}}logout{{/str}}</span></a>
    </div>
</aside>
