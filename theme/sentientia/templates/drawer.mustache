{{!
    @template theme_sentientia/drawer

    Cutover-prep (2026-05-24) — vanilla Moodle 5.2 boost backport.
    Structurally aligned with public/theme/boost/templates/drawer.mustache @ v5.2.0.
    Backwards-compatible with 5.1: extra wrapper divs are inert when blocks empty;
    BS5 attributes are already in use on production 5.1.3+ (Phase B.3.e+).

    Block parameters:
    * drawerclasses        - CSS classes for the outer drawer container
    * id                   - Element id for the outer drawer container
    * drawerpreferencename - User-preference key persisting open/closed state
    * drawerstate          - body class added when this drawer is open
    * forceopen            - "1" to force the drawer to ignore the saved preference and open
    * drawercloseonresize  - "1" to close on viewport resize below desktop
    * tooltipplacement     - bootstrap tooltip placement for the close button
    * closebuttontext      - aria-label / title for the close button
    * drawerheading        - (5.2) optional heading slot — rendered above actions
    * drawerheadercontent  - (5.2) optional header-content slot — rendered alongside close button
    * closebuttonicon      - (5.2) override the default e/cancel pix icon
    * drawercontent        - main body of the drawer

    Example context (json):
    {
        "drawerclasses": "drawer drawer-right",
        "drawertrigger": "toggleblocks",
        "tooltipplacement": "right",
        "drawerconent": "Content for the blocks region",
        "closebuttontext": "Close drawer"
    }
}}
<div {{!
    }} class="{{$drawerclasses}}{{/drawerclasses}} d-print-none not-initialized"{{!
    }} data-region="fixed-drawer"{{!
    }} id="{{$id}}{{/id}}"{{!
    }} data-preference="{{$drawerpreferencename}}{{/drawerpreferencename}}"{{!
    }} data-state="{{$drawerstate}}{{/drawerstate}}"{{!
    }} data-forceopen="{{$forceopen}}0{{/forceopen}}"{{!
    }} data-close-on-resize="{{$drawercloseonresize}}0{{/drawercloseonresize}}"{{!
    }}>
    <div class="drawerheader">
        {{! 5.2 backport — drawerheading wrapper. primary-drawer-mobile.mustache
            already provides a logo override; pre-5.2 drawer.mustache had no
            slot for it, so the override silently rendered nothing. The wrapper
            renders as an empty div on 5.1 consumers that don't override the
            block — no layout impact. }}
        <div class="drawerheading">
            {{$drawerheading}}{{/drawerheading}}
        </div>
        {{! 5.2 backport — draweractions wrapper groups drawerheadercontent +
            close button. Vanilla 5.2 puts the close button inside this wrapper. }}
        <div class="draweractions">
            <div class="drawerheadercontent">
                {{$drawerheadercontent}}{{/drawerheadercontent}}
            </div>
            <button
                {{! 5.2 backport — classes:
                       btn-icon icon-size-3   → BS5 circular icon-only button
                       drawertoggle           → existing JS + SCSS hook (5.1 + 5.2)
                    Removed: hidden (5.1 relied on the parent .drawer
                       visibility:hidden when not .show, the button itself
                       no longer needs to be display:none — vanilla 5.2 has
                       no .hidden either). icon-no-margin was redundant once
                       the BS5 btn-icon utility owns spacing. }}
                class="btn btn-icon icon-size-3 drawertoggle"
                data-toggler="drawers"
                data-action="closedrawer"
                data-target="{{$id}}{{/id}}"
                data-bs-toggle="tooltip"
                {{! 5.2 backport — data-placement → data-bs-placement.
                    Production runs BS5 on 5.1.3+ (Phase B.3.e+ migration);
                    BS5 reads data-bs-placement, not data-placement. }}
                data-bs-placement="{{$tooltipplacement}}right{{/tooltipplacement}}"
                title="{{$closebuttontext}}{{#str}}closedrawer, core{{/str}}{{/closebuttontext}}"
            >
                {{! 5.2 backport — closebuttonicon block. Lets consumers swap
                    the default cancel pix (e.g. for a chevron). Default
                    matches the pre-5.2 behaviour exactly. }}
                {{$closebuttonicon}}
                    {{#pix}} e/cancel, core {{/pix}}
                {{/closebuttonicon}}
            </button>
        </div>
    </div>
    <div class="drawercontent drag-container" data-usertour="scroller">
        {{$drawercontent}}{{/drawercontent}}
    </div>
</div>
{{#js}}
{{! 5.2 backport — Behat instrumentation. M.util.js_pending / js_complete
    exist in 5.1 (since 3.x), so adding them is safe on both versions and
    lets Behat wait for the AMD module to resolve before stepping forward. }}
M.util.js_pending('theme_sentientia/drawer:load');
require(['theme_sentientia/drawers'], function() {
    M.util.js_complete('theme_sentientia/drawer:load');
});
{{/js}}
