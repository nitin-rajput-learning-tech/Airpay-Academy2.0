{{!
    @template theme_sentientia/secure

    epsilon secure layout template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page

      Example context (json):
    {
        "sitename": "airpay academy",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         }
    }
}}
{{> theme_sentientia/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    {{>theme_sentientia/navbar-secure}}

    <div id="page" class="container-fluid">
        {{! Secured full header }}

        {{! Phase B.12 backport (2026-05-24) — vanilla 5.2 boost upgraded
            this div to a semantic <header> with data-for="page-heading"
            (5.2 JS reads it for focus management; 5.1 ignores the attribute). }}
        <header id="page-header" class="row" data-for="page-heading">
            <div class="col-12 py-3">
                <div class="page-context-header">
                    <div class="page-header-headings">
                        {{{ output.page_heading }}}
                    </div>
                </div>
            </div>
        </header>

        <div id="page-content" class="row">
            <div id="region-main-box" class="col-12">
                {{! Keep <section> + aria-label for a11y — vanilla 5.2 regressed
                    this to a bare <div>; we keep the screen-reader landmark. }}
                <section id="region-main" {{#hasblocks}}class="has-blocks"{{/hasblocks}} aria-label="{{#str}}content{{/str}}">

                    {{{ output.course_content_header }}}
                    {{! Phase B.12 backport — render activity_header when present
                        (5.2 added this block to surface completion labels +
                        restricted-access conditions). headercontent is null
                        on 5.1 today, so the block is inert until cutover. }}
                    {{#headercontent}}
                        {{> core/activity_header }}
                    {{/headercontent}}
                    {{{ output.main_content }}}
                    {{{ output.course_content_footer }}}

                </section>
                {{#hasblocks}}
                <section data-region="blocks-column" aria-label="{{#str}}blocks{{/str}}">
                    {{{ sidepreblocks }}}
                </section>
                {{/hasblocks}}
            </div>
        </div>
    </div>
    <footer id="page-footer" class="py-3">
        <div class="container">
            <div id="course-footer">{{{ output.course_footer }}}</div>
            {{{ output.standard_end_of_body_html }}}
        </div>
    </footer>
</div>


</body>
</html>
{{#js}}
M.util.js_pending('theme_sentientia/loader');
require(['theme_sentientia/loader'], function() {
    M.util.js_complete('theme_sentientia/loader');
});
{{/js}}
