{{!
    @template core/loginform

    Airpay Academy UX — Login form redesign.
    Split-screen: gradient hero panel (left) + clean form (right).

    ALL BizLMS Mustache variables preserved for full compatibility:
    - loginurl, logintoken, username, password fields
    - hashusername, hashpassword (BizLMS security)
    - canloginbyemail, canloginasguest, cansignup
    - signupurl_custom (BizLMS custom signup)
    - forgotpasswordurl
    - hasidentityproviders, identityproviders (SSO)
    - error (validation messages)
    - output.loginlogo, output.welcometext, output.captiontext
    - output.loginslider, output.footer_social_icons
    - helptext, aboutustext, contactustext (popup buttons)
    - output.helpbtn, output.aboutbtn, output.contactbtn (popup content)
    - output.loginordering (left/right swap)
    - password-showhide (eye toggle JS)
}}

<div class="airpay-login">
    {{! ═══ LEFT: Gradient Hero Panel ═══ }}
    <div class="airpay-login__hero">
        {{! Decorative background elements }}
        <div class="airpay-login__hero-bg"></div>
        <div class="airpay-login__hero-pattern"></div>
        <div class="airpay-login__hero-circle airpay-login__hero-circle--1"></div>
        <div class="airpay-login__hero-circle airpay-login__hero-circle--2"></div>
        <div class="airpay-login__hero-circle airpay-login__hero-circle--3"></div>

        {{! Content }}
        <div class="airpay-login__hero-content">
            {{! Logo — use theme pix if no admin-uploaded logo }}
            <div class="airpay-login__hero-logo">
                <img src="{{{config.wwwroot}}}/theme/sentientia/pix/brand/academy-logo-350.png" alt="{{sitename}}">
            </div>

            <h1 class="airpay-login__hero-title">{{sitename}}</h1>
            <p class="airpay-login__hero-subtitle">{{#str}}login_hero_subtitle, theme_sentientia{{/str}}</p>

            {{!
                Audit fix 2026-05-15 — login hero copy rewritten to target the
                public learner persona: people upskilling on their own,
                taking employer-graded assessments, and earning shareable
                certificates. Replaces the previous enterprise-admin framing
                (compliance / analytics / heatmaps). Icons updated to match.
            }}
            <div class="airpay-login__hero-features">
                <div class="airpay-login__hero-feature">
                    <div class="airpay-login__hero-feature-icon"><i class="fa fa-rocket"></i></div>
                    <div>
                        <strong>{{#str}}login_feature_upskill_title, theme_sentientia{{/str}}</strong>
                        <span>{{#str}}login_feature_upskill_desc, theme_sentientia{{/str}}</span>
                    </div>
                </div>
                <div class="airpay-login__hero-feature">
                    <div class="airpay-login__hero-feature-icon"><i class="fa fa-briefcase"></i></div>
                    <div>
                        <strong>{{#str}}login_feature_assess_title, theme_sentientia{{/str}}</strong>
                        <span>{{#str}}login_feature_assess_desc, theme_sentientia{{/str}}</span>
                    </div>
                </div>
                <div class="airpay-login__hero-feature">
                    <div class="airpay-login__hero-feature-icon"><i class="fa fa-certificate"></i></div>
                    <div>
                        <strong>{{#str}}login_feature_cert_title, theme_sentientia{{/str}}</strong>
                        <span>{{#str}}login_feature_cert_desc, theme_sentientia{{/str}}</span>
                    </div>
                </div>
            </div>

            {{! Stats bar — live data from DB via core_renderer methods }}
            <div class="airpay-login__hero-stats">
                <div class="airpay-login__hero-stat">
                    <strong>{{output.login_stat_users}}</strong>
                    <span>{{#str}}login_stat_learners, theme_sentientia{{/str}}</span>
                </div>
                <div class="airpay-login__hero-stat">
                    <strong>{{output.login_stat_courses}}</strong>
                    <span>{{#str}}login_stat_courses, theme_sentientia{{/str}}</span>
                </div>
                <div class="airpay-login__hero-stat">
                    <strong>{{output.login_stat_certs}}</strong>
                    <span>{{#str}}login_stat_certificates, theme_sentientia{{/str}}</span>
                </div>
            </div>

            {{! Social icons }}
            <div class="airpay-login__hero-social">
                {{{ output.footer_social_icons }}}
            </div>
        </div>
    </div>

    {{! ═══ RIGHT: Login Form Panel ═══ }}
    <div class="airpay-login__form-panel">
        <div class="airpay-login__form-container">
            {{! Mobile-only logo }}
            <div class="airpay-login__mobile-logo d-lg-none">
                {{^logourl}}
                    <img src="{{output.loginlogo}}" alt="{{sitename}}">
                {{/logourl}}
                {{#logourl}}
                    <img src="{{logourl}}" alt="{{sitename}}">
                {{/logourl}}
            </div>

            {{! Form header — public-learner framing (audit fix 2026-05-15) }}
            <h2 class="airpay-login__form-title">{{#str}}login_form_title, theme_sentientia{{/str}}</h2>
            <p class="airpay-login__form-subtitle">{{#str}}login_form_subtitle, theme_sentientia{{/str}}</p>

            {{! Error display }}
            {{#error}}
                <div class="airpay-login__error">
                    <a href="#" id="loginerrormessage" class="accesshide">{{error}}</a>
                    <div class="alert alert-danger" role="alert" data-aria-autofocus="true">
                        <i class="fa fa-exclamation-circle"></i> {{error}}
                    </div>
                </div>
            {{/error}}

            {{! Login form }}
            <form action="{{loginurl}}" method="post" id="login" class="airpay-login__form">
                <input id="anchor" type="hidden" name="anchor" value="">
                <script>document.getElementById('anchor').value = location.hash;</script>
                <input type="hidden" name="logintoken" value="{{logintoken}}">

                {{! Username }}
                <div class="airpay-login__field">
                    <label for="username" class="airpay-login__label">
                        {{^canloginbyemail}}{{#str}}username{{/str}}{{/canloginbyemail}}
                        {{#canloginbyemail}}{{#str}}usernameemail{{/str}}{{/canloginbyemail}}
                    </label>
                    <div class="airpay-login__input-group">
                        <span class="airpay-login__input-icon"><i class="fa fa-user"></i></span>
                        <input type="text" name="username" id="username"
                            class="airpay-login__input"
                            value="{{username}}"
                            placeholder={{#quote}}{{^canloginbyemail}}{{#str}}username{{/str}}{{/canloginbyemail}}{{#canloginbyemail}}{{#str}}usernameemail{{/str}}{{/canloginbyemail}}{{/quote}}>
                        <input type="hidden" name="hashusername" id="hashusername" value="">
                    </div>
                </div>

                {{! Password }}
                <div class="airpay-login__field">
                    <label for="password" class="airpay-login__label">{{#str}}password{{/str}}</label>
                    <div class="airpay-login__input-group">
                        <span class="airpay-login__input-icon"><i class="fa fa-lock"></i></span>
                        <input type="password" name="password" id="password" value=""
                            class="airpay-login__input"
                            placeholder={{#quote}}{{#str}}password{{/str}}{{/quote}}>
                        <span class="airpay-login__eye fa fa-eye" id="password-showhide"></span>
                        <input type="hidden" name="hashpassword" id="hashpassword" value="">
                    </div>
                </div>

                {{! Submit button }}
                <button type="submit" class="airpay-login__submit" id="loginbtn">
                    {{#str}}login{{/str}}
                </button>

                {{! Links }}
                <div class="airpay-login__links">
                    <a href="{{forgotpasswordurl}}">{{#str}}login_forgot, theme_sentientia{{/str}}</a>
                    {{#signupurl_custom}}
                        <span class="airpay-login__links-sep">&middot;</span>
                        <a href="{{signupurl_custom}}">{{#str}}login_create_account, theme_sentientia{{/str}}</a>
                    {{/signupurl_custom}}
                </div>
            </form>

            {{! Guest login }}
            {{#canloginasguest}}
                <div class="airpay-login__guest">
                    <div class="airpay-login__divider"><span>or</span></div>
                    <form action="{{loginurl}}" method="post" id="guestlogin">
                        <input type="hidden" name="logintoken" value="{{logintoken}}">
                        <input type="hidden" name="username" value="guest">
                        <input type="hidden" name="password" value="guest">
                        <button class="airpay-login__guest-btn" type="submit">
                            {{! Audit fix M1: FA4 fa-user-o → FA5+ fa-user (Moodle 5.1 ships FA5+). }}
                            <i class="fa fa-user"></i> {{#str}}loginguest{{/str}}
                        </button>
                    </form>
                </div>
            {{/canloginasguest}}

            {{! SSO / Identity providers — P0 borrow #5 (Moodle 5.2):
                localisable divider text + alt fallback for screen readers
                while keeping the provider-name as the admin-configured
                literal (which can also be localised via lang customisation). }}
            {{#hasidentityproviders}}
                <div class="airpay-login__sso">
                    <div class="airpay-login__divider"><span>{{#str}}signinwithidentityprovider, theme_sentientia{{/str}}</span></div>
                    {{#identityproviders}}
                        <a href="{{url}}" title={{#quote}}{{name}}{{/quote}} class="airpay-login__sso-btn" aria-label="{{#str}}signinwithidentityprovider, theme_sentientia{{/str}} {{name}}">
                            {{#iconurl}}<img src="{{iconurl}}" alt="" width="20" height="20">{{/iconurl}}
                            {{name}}
                        </a>
                    {{/identityproviders}}
                </div>
            {{/hasidentityproviders}}

            {{#cansignup}}
                <div class="sr-only">
                    <a href="{{signupurl}}">{{#str}}tocreatenewaccount{{/str}}</a>
                </div>
            {{/cansignup}}

            {{! Privacy + Terms links }}
            <div class="airpay-login__legal">
                <a href="{{{config.wwwroot}}}/local/sentientia_pages/index.php?page=privacy">{{#str}}login_privacy, theme_sentientia{{/str}}</a>
                <span>&middot;</span>
                <a href="{{{config.wwwroot}}}/local/sentientia_pages/index.php?page=terms">{{#str}}login_terms, theme_sentientia{{/str}}</a>
            </div>
        </div>
    </div>
</div>

{{! BizLMS Help/About/Contact popups (preserved) }}
<div class="login_nav_btns">
    {{#helptext}}<button onclick="loginpopup('help');" class="airpay-login__popup-btn">{{#str}}footer_help, theme_sentientia{{/str}}</button>{{/helptext}}
    {{#aboutustext}}<button onclick="loginpopup('aboutus');" class="airpay-login__popup-btn">{{#str}}login_support, theme_sentientia{{/str}}</button>{{/aboutustext}}
    {{#contactustext}}<button onclick="loginpopup('contactus');" class="airpay-login__popup-btn">{{#str}}login_contact, theme_sentientia{{/str}}</button>{{/contactustext}}
</div>
<div id="div_loginpopup_help" class="login_popup_container"><div onclick="closeonclick('help');" class="div_close">X</div><div class="login_popup_content">{{{ output.helpbtn }}}</div></div>
<div id="div_loginpopup_aboutus" class="login_popup_container"><div onclick="closeonclick('aboutus');" class="div_close">X</div><div class="login_popup_content">{{{ output.aboutbtn }}}</div></div>
<div id="div_loginpopup_contactus" class="login_popup_container"><div onclick="closeonclick('contactus');" class="div_close">X</div><div class="login_popup_content">{{{ output.contactbtn }}}</div></div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            var userNameField = document.getElementById('username');
            if (userNameField.value.length == 0) {
                userNameField.focus();
            } else {
                document.getElementById('password').focus();
            }
        {{/autofocusform}}
    {{/error}}
    {{#error}}
        document.getElementById('loginerrormessage').focus();
    {{/error}}
    require(['jquery'], function($) {
        document.getElementById('password-showhide').onclick = function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            var input = $('#password');
            if (input.attr("type") == "password") {
                input.attr("type", "text");
            } else {
                input.attr("type", "password");
            }
        }
    });
{{/js}}
