{{!
    @template theme_sentientia/login

    Login page layout — stripped of Bootstrap grid wrapper to allow
    full-viewport flex layout in loginform.mustache.

    IMPORTANT: The container-fluid > row > col-12 wrapper from epsilon
    was removed because it constrained the login form to a single column,
    preventing our split-screen layout from working.
}}
{{> theme_sentientia/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="airpay-login-wrapper">
    {{{ output.standard_top_of_body_html }}}
    <div id="page" class="airpay-login-page">
        <section id="region-main" class="airpay-login-region">
            {{{ output.main_content }}}
        </section>
    </div>
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_sentientia/loader');
require(['theme_sentientia/loader'], function() {
  M.util.js_complete('theme_sentientia/loader');
});
{{/js}}
