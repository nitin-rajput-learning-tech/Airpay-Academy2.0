{{!
    @template theme_airpayux/footer

    Page footer.

    Example context (json):
    {
        "output": {
            "page_doc_link": "Help and documentation",
            "supportemail": "<a href=\"#\">Contact site support</a>",
            "has_popover_links": true,
            "services_support": "Services and support",
            "login_info": "You are logged in as cute kitten",
            "moodle_release": "90210"
        }
    }
}}

<footer id="page-footer" class="airpay-footer">
    {{! Course footer + Moodle required output }}
    <div id="course-footer" class="d-none">{{{ output.course_footer }}}</div>
    <div class="tool_usertours-resettourcontainer"></div>

    {{! Footer content — admin gets minimal, learner gets full }}
    {{#output.is_admin_or_manager}}
        <div class="airpay-footer__bottom" style="padding-top: 20px;">
            <span>&copy; 2026 Airpay Payment Services. All rights reserved.</span>
            <span>Contact: academy@airpay.co.in</span>
        </div>
    {{/output.is_admin_or_manager}}
    {{^output.is_admin_or_manager}}
        <div class="airpay-footer__grid">
            <div class="airpay-footer__col">
                {{# output.should_display_navbar_logo }}
                    <img src="{{output.get_custom_logo}}" alt="{{sitename}}" style="height: 36px; margin-bottom: 8px; filter: brightness(10);">
                {{/ output.should_display_navbar_logo }}
                {{^ output.should_display_navbar_logo }}
                    <strong style="color: #fff; font-size: 1.1rem;">{{{ sitename }}}</strong>
                {{/ output.should_display_navbar_logo }}
                <p class="airpay-footer__brand-desc">Airpay Academy is a comprehensive learning platform built for employability, business training, and financial education.</p>
            </div>
            <div class="airpay-footer__col">
                <h4 class="airpay-footer__heading">Learn</h4>
                <ul class="airpay-footer__links">
                    <li><a href="{{{config.wwwroot}}}/local/search/allcourses.php">All Courses</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/search/allcourses.php">E-Learning</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/classroom/index.php">Classroom</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/certificates/index.php">Certifications</a></li>
                </ul>
            </div>
            <div class="airpay-footer__col">
                <h4 class="airpay-footer__heading">Support</h4>
                <ul class="airpay-footer__links">
                    <li><a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=help">Help Center</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=contact">Contact Us</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=privacy">Privacy Policy</a></li>
                    <li><a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=terms">Terms of Service</a></li>
                </ul>
            </div>
        </div>
        <div class="airpay-footer__bottom">
            <span>{{{ output.get_copyright_text }}}</span>
            <span>Contact: academy@airpay.co.in</span>
        </div>
    {{/output.is_admin_or_manager}}

    {{! Moodle required — MUST be before </body> }}
    {{{ output.standard_footer_html }}}
    {{{ output.standard_end_of_body_html }}}

    {{! Debug (dev only) }}
    {{{ output.debug_footer_html }}}
</footer>
<script>
/*Scroll to top when arrow up clicked BEGIN*/
require(['jquery'], function($) {
    var winwidth = "";
    winwidth = $(window).width();
    docwidth = $(document).width();
    if((winwidth < 768) || (docwidth < 768)){
        $(window).scroll(function() {
            var height = $(window).scrollTop();
            if (height > 100) {
                $('#back2Top').fadeIn();
            } else {
                $('#back2Top').fadeOut();
            }
        });
        $(document).ready(function() {
            $("#back2Top").click(function(event) {
                event.preventDefault();
                $("html, body").animate({ scrollTop: 0 }, "slow");
                return false;
            });

        });
    }
});
</script>
