{{!
    @template theme_airpayux/theme_epsilon/footer

    Airpay Academy UX footer — Phase 6B redesign.
    Overrides theme_epsilon/footer.mustache with the Airpay design system.

    Design: Clean, minimal footer with quick links, social icons, and copyright.
    Matches production pattern (simple) while being visually upgraded.
    Uses CSS custom properties from the design system for dark mode support.
}}

<footer id="page-footer" class="airpay-footer">
    {{! Required Moodle hooks — must be present for JS/tour functionality }}
    <div style="display:none;">
        <div id="course-footer">{{{ output.course_footer }}}</div>
        <div class="tool_usertours-resettourcontainer"></div>
        <nav class="nav navbar-nav d-md-none">
            {{# output.custom_menu_flat }}
                <ul class="list-unstyled">
                    {{> theme_epsilon/custom_menu_footer}}
                </ul>
            {{/ output.custom_menu_flat }}
        </nav>
    </div>

    {{! Main footer content }}
    <div class="airpay-footer__main">
        <div class="container-fluid airpay-footer__inner">
            {{! Row 1: Quick links + Social }}
            <div class="airpay-footer__top">
                <div class="airpay-footer__links">
                    <a href="{{{ config.wwwroot }}}/local/users/privacypolicy.php">Privacy Policy</a>
                    <span class="airpay-footer__sep"></span>
                    <a href="{{{ config.wwwroot }}}/local/users/termscondition.php">Terms of Use</a>
                    <span class="airpay-footer__sep"></span>
                    <a href="{{{ config.wwwroot }}}/admin/tool/dataprivacy/summary.php">Data Retention</a>
                </div>
                <div class="airpay-footer__social">
                    {{{ output.footer_social_icons }}}
                </div>
            </div>

            {{! Row 2: Copyright }}
            <div class="airpay-footer__bottom">
                <p class="airpay-footer__copy">
                    &copy; airpay payment services. All rights reserved.
                </p>
            </div>
        </div>
    </div>

    {{! Moodle required: debug footer and end-of-body hooks }}
    <div class="airpay-footer__debug">
        {{{ output.standard_footer_html }}}
        {{{ output.debug_footer_html }}}
    </div>

    {{! Back to top button (mobile only) }}
    <a id="back2Top" class="airpay-footer__back2top" title="Back to top" href="#">
        <i class="fa fa-chevron-up"></i>
    </a>

    {{{ output.standard_end_of_body_html }}}
</footer>

<script>
require(['jquery'], function($) {
    if ($(window).width() < 768) {
        $(window).scroll(function() {
            if ($(window).scrollTop() > 200) {
                $('#back2Top').fadeIn(200);
            } else {
                $('#back2Top').fadeOut(200);
            }
        });
        $('#back2Top').click(function(e) {
            e.preventDefault();
            $('html, body').animate({ scrollTop: 0 }, 400);
        });
    }
});
</script>
