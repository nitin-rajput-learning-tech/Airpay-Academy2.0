# Stage B rehearsal kit -- the ONE env file. Copy to rehearsal.env, edit, chmod 600.
#
# It is sourced as shell (KEY=value, quote values with spaces). The kit refuses it if group or others can write it.
# Every path, host and database name the kit uses is here; nothing is hard-coded in the scripts.
# DRY mode (the default) reads this example when there is no rehearsal.env, so the plan can be printed anywhere.

# ---------------------------------------------------------------------------------------------------------------------
# The box
# ---------------------------------------------------------------------------------------------------------------------
# Where logs, state, reports and the baseline go. Created by --execute. Absolute POSIX path.
REHEARSAL_WORK=/srv/rehearsal/work
# The kit must run AS this user (sudo -u www-data bash tools/rehearsal/run_all.sh --execute), like Moodle's CLI tools.
# Empty = do not check (only for a scratch box where you are the web user already).
WEB_USER=www-data
# PHP 8.3 for both hops (Moodle 4.5 refuses 8.4; 5.2 needs 8.3). PHP_OPTS are extra php.ini switches for every run.
PHP_BIN=php
PHP_OPTS="-d memory_limit=2048M"
MYSQL_BIN=mysql

# ---------------------------------------------------------------------------------------------------------------------
# The code. Hop 1 = a clean Moodle 4.5 core; hop 2 = the Sentientia 5.x package. Two directories, never one over the other.
# If a directory has no code yet and an archive is named, step 03/04 unpacks it after checking the SHA-256.
# ---------------------------------------------------------------------------------------------------------------------
CODE_45_DIR=/srv/rehearsal/moodle45
CODE_45_ARCHIVE=/srv/rehearsal/dist/moodle-4.5.10.zip
CODE_45_SHA256=
# The directory that holds public/ (the zip's moodle5.2/ folder). Plugins ship in the package: nothing is copied by hand.
CODE_5X_DIR=/srv/rehearsal/moodle5
CODE_5X_ARCHIVE=/srv/rehearsal/dist/Sentientia-LMS-5.2-Complete-Standalone-2026-09-10.zip
CODE_5X_SHA256=
# Moodle data (the restored filedir lives here). Shared by both hops.
MOODLEDATA=/srv/rehearsal/moodledata

# ---------------------------------------------------------------------------------------------------------------------
# The database. The rehearsal may touch ONLY a database named in REHEARSAL_DB_ALLOWLIST (space separated).
# Any name with 'prod' or 'uat' in it (production's database is airpayprod, UAT's is sentientia_uat), 'live' as a word, and
# system databases are refused even if listed. And the database must carry the rehearsal-kit marker (step 01 stamps it).
# ---------------------------------------------------------------------------------------------------------------------
DB_TYPE=mysqli
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=stageb_rehearsal
DB_USER=rehearsal
# A file whose first line is the password. Not readable by others (chmod 600). Never put the password in this file.
DB_PASS_FILE=/etc/rehearsal/db.pass
DB_PREFIX=mdl_
DB_COLLATION=utf8mb4_unicode_ci
REHEARSAL_DB_ALLOWLIST="stageb_rehearsal"
# REQUIRED with --execute: the live database host name (dbhost of live's config.php, the RDS endpoint). The kit refuses any host,
# path or config.php string that names it, so a DB_HOST copied from live's config cannot get through. It is added to
# PRODUCTION_HOSTNAMES. Left empty (or as a CHANGE_ME placeholder), --execute refuses to start; a DRY run only warns.
PRODUCTION_DB_ENDPOINT=
# Schemas that must not exist on the database SERVER (the live schema airpayprod is always refused). Add UAT's (sentientia_uat)
# unless this rehearsal runs on the same server as UAT; the name guard, the marker and the allow-list still apply there.
FORBIDDEN_SERVER_SCHEMAS=""

# ---------------------------------------------------------------------------------------------------------------------
# The site. wwwroot is a rehearsal URL, never the production one: the ADR-031 scripts take it as --target.
# PRODUCTION_HOSTNAMES: substrings the kit refuses anywhere (database host, wwwroot, paths, every string in config.php): the live
# site, and UAT (academy2.airpay.ninja). The live database endpoint is PRODUCTION_DB_ENDPOINT above.
# ---------------------------------------------------------------------------------------------------------------------
REHEARSAL_WWWROOT=https://rehearsal.example.invalid
PRODUCTION_HOSTNAMES="airpay.academy academy2.airpay.ninja"
# Optional belt and braces: every e-mail is diverted here (a controlled mailbox) in addition to noemailever.
DIVERT_EMAILS_TO=

# ---------------------------------------------------------------------------------------------------------------------
# What to restore (step 01). Leave empty when the restore was done by hand (and see RESTORE_DONE_BY_HAND).
# The dump goes only into an EMPTY database; the kit never drops or overwrites anything. The dump is refused when it holds a
# USE / CREATE DATABASE / DROP DATABASE statement (take it without --databases / --all-databases) or has no "-- Dump completed"
# trailer (a cut-short or aborted mysqldump); the mysql client runs with --one-database.
# ---------------------------------------------------------------------------------------------------------------------
RESTORE_DB_DUMP=
# A tar(.gz) of the moodledata (with filedir/ at its top) or a zip. Unpacked only when MOODLEDATA/filedir is missing, into an empty
# directory or one this kit stamped (a file .rehearsal-kit-restore-id): any other non-empty directory may be another site's.
RESTORE_MOODLEDATA_ARCHIVE=
# Restored by hand? Write the database name here (it must equal DB_NAME) for the run of step 01 that stamps it: "this database is a
# copy of the live backup that I restored for this rehearsal, and so is MOODLEDATA". Without the marker no step writes to it. Never
# set it for a database you did not restore yourself: it may be a real site.
RESTORE_DONE_BY_HAND=
# 1 = accept a dump without mysqldump's "-- Dump completed" trailer (made with --skip-comments or by another tool). Check it is whole.
RESTORE_ALLOW_NO_TRAILER=0
# The release the restored source must report (a regex). Live is Moodle 4.1.2.
SOURCE_RELEASE_REGEX='^4\.1\.'
# Optional exact active-user count of the live baseline (migration plan 4c step 1).
EXPECT_ACTIVE_USERS=
# The baseline taken ON LIVE at the freeze (source_baseline.php), if you have it. Then step 01 compares the restored
# copy with it (isolates restore loss) and step 02 uses it. Empty = step 02 takes the baseline from the restored copy.
LIVE_BASELINE_FILE=
# The most content hashes the restored filedir may lack. The gate is 0.
FILEDIR_MAX_MISSING=0

# ---------------------------------------------------------------------------------------------------------------------
# Repo files the steps read (defaults are inside this checkout; change only for a package without a checkout)
# ---------------------------------------------------------------------------------------------------------------------
#CAP_ALLOWLIST=/path/to/bizlms-capability-allowlist.json
#IMPORT_DECISIONS=/path/to/bizlms-import-decisions.json
#SOURCE_BASELINE_PHP=/path/to/source_baseline.php
#ADR031_SCRIPTS_DIR=/path/to/tools/uat
# The role shortname of the tenant admins (BizLMS role 9; 'administrator' on live).
TENANT_ADMIN_ROLE=administrator
# Nitin's decision, not the operator's: let the role-9 apply proceed although the role is assigned below system context.
ADR031_ACCEPT_NONSYSTEM_HOLDERS=0

# ---------------------------------------------------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------------------------------------------------
# upgrade.php refuses a non-stable build in non-interactive mode; the local rehearsals ran with it on.
UPGRADE_ALLOW_UNSTABLE=1
# An executable called as: hook <label>. Take the restore point (RDS snapshot, LVM snapshot, dump). Called before hop 1, before hop 2
# and before the import (step 09, label before-import: with BIZLMS_PRODUCTION_FLAG=1 it is the only way back). Empty = a reminder.
SNAPSHOT_HOOK=
# After hop 2 the parity compare is a stop (1) or only a warning that step 09 re-judges (0). (The message_provider_defaults
# invariant alone, which step 05 repairs, is never a stop at step 04.)
PARITY_HOP2_ENFORCE=1
# 1 = continue although the package's cli/source_baseline.php is not the file the baseline was taken with (step 04 stops otherwise:
# the two sides must run the same code).
ALLOW_BASELINE_TOOL_SKEW=0
# Runbook step 4b/4c: tenant registry seed and the tenant/org parity checks. warn = run, a failure is a warning;
# stop = a failure stops step 05; skip = do not run them. (The SW-1 flag flip is never run by this kit.) The runbook expects
# 100% PARITY from them, which is "stop": use stop for the dress rehearsal.
TENANT_CHECKS=warn
# Step 07: clear user/course/category/cohort theme overrides that name a theme (default: stop and report them). It writes the
# `theme` column only; no column the parity baseline hashes is `theme`, so the gate of step 09 is not disturbed.
CLEAR_THEME_OVERRIDES=0
# Step 08: enable the standard log store when it is off (the import tripwire needs it), instead of stopping.
FIX_LOGSTORE=0
# Step 08: reset restored task rows that a live cron had marked as running (they would block the import guard).
CLEAR_STALE_RUNNING_TASKS=1
# Step 08: how long the import guard stays armed (seconds; the runbook says 4 hours).
GUARD_ARM_SECONDS=14400
# Step 08: 1 sets bizlms_production = 1, the exact cutover form (no --allow-online, no --purge-feature; the snapshot is the way
# back). 0 (default) lets a failed rehearsal import be purged and repeated.
BIZLMS_PRODUCTION_FLAG=0
# Step 09: apply (a fresh run) or resume (continue the newest incomplete apply run; step 09 says when it is needed).
IMPORT_APPLY_MODE=apply
IMPORT_EXTRA_ARGS=
# Cutover day: the decisions hash recorded in the rehearsal. Step 09 refuses if the decisions file hashes to anything else.
IMPORT_EXPECT_DECISIONS_HASH=
# Exit 2 ("not proven") is a stop. It is accepted only with Nitin's written acceptance, referenced here.
ACCEPT_UNPROVEN=0
ACCEPT_UNPROVEN_REF=
# Step 11: on = CLI maintenance goes back on after the cron cycle, off = leave it lifted for the smoke walk.
MAINTENANCE_AFTER_CRON=on
# Step 11: scheduled task class-name fragments switched off in the rehearsal database for the cycle because they phone home
# (noemailever closes e-mail only). Empty string = switch none off. Production is not touched.
OUTBOUND_TASK_PATTERNS="registration_cron_task check_for_updates_task refresh_system_tokens_task webhook_drain sync_providers hrms_sync"
