# ios/App/Podfile — Sentientia LMS iOS app
#
# TEMPLATE FILE — generated by the Capacitor scaffold.
# Run `npx cap add ios` to generate the full ios/ directory.
# Apply these patterns to the generated Podfile.
#
# XCODE REQUIREMENTS: Xcode 15+ (iOS 17 SDK + Swift 5.9)
# APPLE DEVELOPER PROGRAM: Required for device testing + store submission.
# See BUILD.md §iOS: APNs setup for full instructions.

require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'   # Capacitor 5.x minimum iOS version

install! 'cocoapods', :deterministic_uuids => false

use_frameworks!

target 'App' do
  # Capacitor core — links the native bridge
  capacitor_pods

  # Capacitor plugins
  pod 'CapacitorApp',               :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser',           :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorNetwork',           :path => '../../node_modules/@capacitor/network'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorSplashScreen',      :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar',         :path => '../../node_modules/@capacitor/status-bar'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end

# APNs push notification setup — see BUILD.md §5.2 for full instructions.
# Required: Apple Developer membership, App ID with Push Notifications enabled,
# APNs auth key (.p8), Push Notifications capability in Xcode project.
