{
  "name": "sentientia-app",
  "version": "1.0.0",
  "description": "Capacitor native wrapper for Sentientia LMS — wraps the local_sentientia_pwa PWA for iOS and Android store distribution",
  "private": true,
  "scripts": {
    "build": "echo 'No local bundle build configured — this project uses remote URL mode. See BUILD.md §Remote URL vs Local Bundle.'",
    "sync": "npx cap sync",
    "copy": "npx cap copy",
    "update": "npx cap update",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/app": "^5.0.7",
    "@capacitor/browser": "^5.2.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/network": "^5.0.7",
    "@capacitor/push-notifications": "^5.1.3",
    "@capacitor/splash-screen": "^5.0.7",
    "@capacitor/status-bar": "^5.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
