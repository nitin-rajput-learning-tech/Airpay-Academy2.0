# .env.example — Sentientia LMS native wrapper environment variables
#
# Copy this to .env and fill in real values for local development.
# .env is gitignored — NEVER commit real credentials to git.
# CI/CD values are set as GitHub Actions secrets (see BUILD.md §Secrets Management).

# App identity
SENTIENTIA_APP_ID=academy.airpay.sentientia
SENTIENTIA_MOODLE_URL=https://www.airpay.academy

# Android signing
# Local dev: create android/keystore.properties instead (see BUILD.md §Android Keystore)
# CI/CD: set these as GitHub Actions repository secrets
ANDROID_KEYSTORE_PATH=/path/to/sentientia-release.jks
ANDROID_KEY_ALIAS=sentientia-key
ANDROID_STORE_PASSWORD=REPLACE_WITH_STORE_PASSWORD
ANDROID_KEY_PASSWORD=REPLACE_WITH_KEY_PASSWORD

# Apple / iOS
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_BUNDLE_ID=academy.airpay.sentientia
APPLE_APNS_KEY_ID=XXXXXXXXXX
APPLE_APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_ASC_KEY_ID=XXXXXXXXXX
APPLE_ASC_ISSUER_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
APPLE_ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Firebase / FCM (Android push notifications)
# FCM is configured via google-services.json — NOT this file.
# Place google-services.json at android/app/google-services.json.
# NEVER commit google-services.json to git.
# FCM_SERVER_KEY=REPLACE_WITH_FCM_SERVER_KEY  # only if backend uses FCM HTTP v1 API

# VAPID public key — must match local_sentientia_pwa config in Moodle
# Authoritative value: php local/sentientia_pwa/cli/generate_vapid_keys.php
# In remote URL mode, this is served by the PWA page — not read from this file.
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY_FROM_MOODLE
