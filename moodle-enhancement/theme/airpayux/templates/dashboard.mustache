{{!
    @template theme_airpayux/columns2

    Admin time setting template.

    epsilon 2 column layout template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * navdraweropen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.

    Example context (json):
    {
        "sitename": "airpay academy",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "navdraweropen":true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false
    }
}}
{{> theme_airpayux/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

{{! ═══ SIDEBAR SHELL WRAPPER ═══ }}
{{#use_shell}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    <div class="ap-shell" id="ap-shell">
        {{! Sidebar }}
        {{#sidebar}}
        <aside class="ap-sidebar" id="ap-sidebar" data-collapsed="{{#collapsed}}true{{/collapsed}}{{^collapsed}}false{{/collapsed}}">

            {{! ── Header ─────────────────────────────────── }}
            <div class="ap-sidebar__header">
                <a href="{{{wwwroot}}}/my/" class="ap-sidebar__brand">
                    <span class="ap-sidebar__brand-mark"><i class="fa fa-graduation-cap"></i></span>
                    <span class="ap-sidebar__brand-text">{{sitename}}</span>
                </a>
                <button class="ap-sidebar__collapse" id="ap-sidebar-toggle" aria-label="Toggle sidebar">
                    <i class="fa fa-chevron-left ap-sidebar__toggle-icon"></i>
                </button>
            </div>

            {{! ── Nav ─────────────────────────────────────── }}
            <nav class="ap-sidebar__nav">
                {{#navitems}}
                {{#isdivider}}
                <div class="ap-sidebar__divider"></div>
                {{/isdivider}}
                {{^isdivider}}
                <a href="{{{url}}}" class="ap-sidebar__link {{#active}}ap-sidebar__link--active{{/active}}">
                    <span class="ap-sidebar__link-icon"><i class="fa {{icon}}"></i></span>
                    <span class="ap-sidebar__link-text">{{label}}</span>
                </a>
                {{/isdivider}}
                {{/navitems}}
            </nav>

            {{! ── Footer: theme + user ─────────────────── }}
            <div class="ap-sidebar__footer-actions">
                <button class="ap-sidebar__theme-btn" id="ap-dark-toggle" title="Toggle theme">
                    <i class="fa fa-moon"></i>
                    <span class="ap-sidebar__theme-label">Dark Mode</span>
                </button>
            </div>
            <div class="ap-sidebar__user">
                <a href="{{{profileurl}}}" class="ap-sidebar__user-link">
                    <div class="ap-sidebar__user-avatar">{{{useravatar}}}</div>
                    <div class="ap-sidebar__user-info">
                        <span class="ap-sidebar__user-name">{{userfullname}}</span>
                        <span class="ap-sidebar__user-action">Profile &amp; Settings</span>
                    </div>
                </a>
                <a href="{{{logouturl}}}" class="ap-sidebar__signout" title="Sign out"><i class="fa fa-sign-out"></i></a>
            </div>
        </aside>
        {{/sidebar}}

        {{! Mobile overlay }}
        <div class="ap-shell__overlay" id="ap-shell-overlay"></div>

        {{! Main content area }}
        <div class="ap-shell__main">
            {{! Topbar }}
            <header class="ap-topbar" id="ap-topbar">
                <div class="ap-topbar__left">
                    <button class="ap-topbar__hamburger d-lg-none" id="ap-sidebar-mobile-toggle" aria-label="Open menu">
                        <i class="fa fa-bars"></i>
                    </button>
                    <nav class="ap-topbar__breadcrumb d-none d-md-flex" aria-label="Breadcrumb">
                        {{{ output.navbar }}}
                    </nav>
                </div>
                <div class="ap-topbar__center">
                    {{! Audit fix (2026-05-15) — context-aware topbar search. }}
                    {{! Default action submits to Moodle global search. The }}
                    {{! topbar_search.js bootstrap (below) rewires action,  }}
                    {{! placeholder, and submit handler when the current   }}
                    {{! page exposes a scoped search affordance (catalog    }}
                    {{! search bar OR data-airpay-table) and hides the     }}
                    {{! redundant scoped UI so only one search box stays   }}
                    {{! visible per page.                                   }}
                    <form action="{{{config.wwwroot}}}/search/index.php" method="get"
                          class="ap-topbar__search" id="ap-topbar-search-form"
                          data-default-action="{{{config.wwwroot}}}/search/index.php"
                          data-default-placeholder="Search courses, people, content...">
                        <i class="fa fa-search ap-topbar__search-icon"></i>
                        <input type="text" name="q" class="ap-topbar__search-input"
                               id="ap-topbar-search-input"
                               placeholder="Search courses, people, content..."
                               autocomplete="off">
                    </form>
                </div>
                <div class="ap-topbar__right">
                    {{! User avatar + dark mode moved to sidebar. Topbar is clean. }}
                </div>
            </header>

            {{! Page content
                A11Y-8: visually-hidden h1 with the page title precedes the
                visible content so screen readers always have a level-1
                anchor.
                A11Y-9: keep <main> as the SINGLE main landmark. Moodle's
                region-main is a <section> with aria-label, not a main, so
                there's no duplicate. }}
            <main class="ap-shell__content" id="ap-shell-content">
                <h1 class="sr-only">{{#str}}myhome, core{{/str}}</h1>
                <div id="page" class="d-print-block">
                    {{#secondarymoremenu}}
                        <div class="secondary-navigation">
                            {{> core/moremenu}}
                        </div>
                    {{/secondarymoremenu}}

        {{! ═══ AIRPAY DASHBOARD ═══ }}
        {{#airpay}}
        <div class="airpay-dash">

            {{! Welcome header — all roles }}
            <div class="airpay-dash__welcome-header">
                {{#isadmin}}
                <h2 class="airpay-dash__welcome-header__title">{{# str }} welcome_back_admin, theme_airpayux, {{firstname}} {{/ str }}</h2>
                <p class="airpay-dash__welcome-header__subtitle">
                    {{#tenant_scope}}{{tenant_scope}} &mdash; {{/tenant_scope}}{{# str }} subtitle_admin, theme_airpayux {{/ str }}
                </p>
                {{/isadmin}}
                {{#ismanager}}{{^isadmin}}
                <h2 class="airpay-dash__welcome-header__title">{{# str }} welcome_manager, theme_airpayux, {{firstname}} {{/ str }}</h2>
                <p class="airpay-dash__welcome-header__subtitle">{{# str }} subtitle_manager, theme_airpayux {{/ str }}</p>
                {{/isadmin}}{{/ismanager}}
                {{^isadmin}}{{^ismanager}}
                <h2 class="airpay-dash__welcome-header__title">{{# str }} welcome_learner, theme_airpayux, {{firstname}} {{/ str }}</h2>
                <p class="airpay-dash__welcome-header__subtitle">{{# str }} subtitle_learner, theme_airpayux {{/ str }}</p>
                {{/ismanager}}{{/isadmin}}
            </div>

            {{! ═══ ADMIN DASHBOARD (siteadmin / L&D admin) ═══ }}
            {{#isadmin}}

            {{! Admin KPI Tiles — Phase B0 iter 2: migrated to stat_card partial }}
            {{#hasadminkpis}}
            <div class="airpay-stat-grid">
                {{#admin_kpis}}
                {{> theme_airpayux/components/stat_card }}
                {{/admin_kpis}}
            </div>
            {{/hasadminkpis}}

            {{! Quick Navigation REMOVED — sidebar handles navigation now }}

            {{! Admin Charts (Chart.js) }}
            {{#hascharts}}
            <div class="airpay-dash__two-col">
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-line-chart"></i> {{# str }} chart_enrolment_trend, theme_airpayux {{/ str }}</h3>
                    <canvas id="airpay-chart-enrolments" height="220"></canvas>
                </div>
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-pie-chart"></i> {{# str }} chart_course_distribution, theme_airpayux {{/ str }}</h3>
                    <canvas id="airpay-chart-distribution" height="220"></canvas>
                </div>
            </div>
            {{/hascharts}}

            {{! System Health + User Analytics (two-column) }}
            <div class="airpay-dash__two-col">
                {{! System Health — siteadmin ONLY, not L&D admin }}
                {{#issiteadmin}}
                {{#hassystemhealth}}
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-heartbeat"></i> System Health</h3>
                    <div class="airpay-dash__health-list">
                        {{#systemhealth}}
                        <div class="airpay-dash__health-item">
                            <i class="fa fa-{{icon}} airpay-dash__health-icon airpay-dash__health-icon--{{status}}"></i>
                            <div class="airpay-dash__health-info">
                                <span class="airpay-dash__health-label">{{label}}</span>
                                <span class="airpay-dash__health-value">{{value}}</span>
                            </div>
                        </div>
                        {{/systemhealth}}
                    </div>
                </div>
                {{/hassystemhealth}}
                {{/issiteadmin}}

                {{! User Analytics — Phase B0 iter 8: migrated to stat_card partial }}
                {{#hasuseranalytics}}
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-users" aria-hidden="true"></i> User Analytics</h3>
                    <div class="airpay-stat-grid">
                        {{#useranalytics}}
                        {{> theme_airpayux/components/stat_card }}
                        {{/useranalytics}}
                    </div>
                </div>
                {{/hasuseranalytics}}
            </div>

            {{! Chart.js initialization.

                P1 #17 / F-14 audit fix (2026-05-24, wave3-chip-N):
                the external CDN <script src="https://cdn.jsdelivr.net/…">
                was replaced with theme_airpayux/chart_loader, an AMD
                module that delegates to Moodle's bundled core/chartjs
                (Chart.js v4.4.2 in lib/amd/src/chartjs-lazy.js). The
                loader exposes the constructor on window.Chart so the
                init code below keeps using `new Chart(...)` unchanged
                — only the loader changed. layout/dashboard.php also
                pre-warms the module via $PAGE->requires->js_call_amd
                so it's in the AMD cache before this inline require()
                resolves. See:
                  amd/src/chart_loader.js                — source
                  amd/build/chart_loader.min.js          — built
                  docs/audits/PLATFORM-VISUAL-AUDIT-2026-05-24.md F-14
            }}
            {{#hascharts}}
            <script>
            require(['theme_airpayux/chart_loader'], function() {
                // Enrolment Trend Bar Chart
                var ctx1 = document.getElementById('airpay-chart-enrolments');
                if (ctx1) {
                    new Chart(ctx1, {
                        type: 'bar',
                        data: {
                            labels: {{{chart_labels}}},
                            datasets: [{
                                label: 'Enrolments',
                                data: {{{chart_enrolments}}},
                                backgroundColor: 'rgba(0, 102, 167, 0.7)',
                                borderColor: '#0066A7',
                                borderWidth: 1,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: { legend: { display: false } },
                            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                        }
                    });
                }
                // Course Distribution Doughnut
                var ctx2 = document.getElementById('airpay-chart-distribution');
                if (ctx2) {
                    new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: {{{chart_pie_labels}}},
                            datasets: [{
                                data: {{{chart_pie_data}}},
                                backgroundColor: ['#0066A7', '#0f7a73', '#7c3aed', '#d97706', '#dc2626'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            cutout: '60%',
                            plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true } } }
                        }
                    });
                }
            });
            </script>
            {{/hascharts}}

            {{! ── Compliance Summary + Top Courses (two-column) ── }}
            <div class="airpay-dash__two-col airpay-dash__two-col--top-spacing">
                {{#hascompliance}}
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-shield"></i> Compliance Overview</h3>
                    <div class="airpay-dash__compliance-grid">
                        <div class="airpay-dash__compliance-card">
                            <div class="airpay-dash__compliance-card__count airpay-dash__compliance-card__count--mandatory">{{compliance.mandatory}}</div>
                            <div class="airpay-dash__compliance-card__label">{{# str }} kpi_mandatory_courses, theme_airpayux {{/ str }}</div>
                        </div>
                        <div class="airpay-dash__compliance-card">
                            <div class="airpay-dash__compliance-card__count airpay-dash__compliance-card__count--compliant">{{compliance.compliant}}</div>
                            <div class="airpay-dash__compliance-card__label">{{# str }} kpi_compliance_rate, theme_airpayux {{/ str }}</div>
                        </div>
                        <div class="airpay-dash__compliance-card">
                            <div class="airpay-dash__compliance-card__count airpay-dash__compliance-card__count--overdue">{{compliance.overdue}}</div>
                            <div class="airpay-dash__compliance-card__label">{{# str }} kpi_overdue, theme_airpayux {{/ str }}</div>
                        </div>
                        <div class="airpay-dash__compliance-card">
                            <div class="airpay-dash__compliance-card__count airpay-dash__compliance-card__count--assigned">{{compliance.assigned}}</div>
                            <div class="airpay-dash__compliance-card__label">{{# str }} kpi_total_assigned, theme_airpayux {{/ str }}</div>
                        </div>
                    </div>
                </div>
                {{/hascompliance}}

                {{#hastopcourses}}
                <div class="airpay-dash__section">
                    <h3 class="airpay-dash__section-title"><i class="fa fa-trophy"></i> Top Courses</h3>
                    <div class="airpay-dash__top-courses">
                        {{#topcourses}}
                        <a href="{{{url}}}" class="airpay-dash__top-courses__row">
                            <span class="airpay-dash__top-courses__name">{{name}}</span>
                            <span class="airpay-dash__top-courses__stats">
                                <span>{{enrolled}} enrolled</span>
                                <span>{{completions}} completed</span>
                            </span>
                        </a>
                        {{/topcourses}}
                    </div>
                </div>
                {{/hastopcourses}}
            </div>

            {{! Recent Activity — Phase B0 iter 4: migrated to activity_item partial }}
            {{#hasrecentactivity}}
            <div class="airpay-dash__section airpay-dash__section--top-spacing">
                <h3 class="airpay-dash__section-title"><i class="fa fa-clock" aria-hidden="true"></i> Recent Activity</h3>
                <ul class="airpay-activity-list">
                    {{#recentactivity}}
                    {{> theme_airpayux/components/activity_item }}
                    {{/recentactivity}}
                </ul>
            </div>
            {{/hasrecentactivity}}

            {{/isadmin}}

            {{! ═══ MANAGER TEAM SECTION (managers only — shown above learner content) ═══ }}
            {{#ismanager}}

            {{! Manager KPI tiles }}
            {{#hasmanagerkpis}}
            <div class="airpay-dash__section airpay-dash__section--bottom-spacing">
                <h3 class="airpay-dash__section-title"><i class="fa fa-users"></i> My Team</h3>
                <div class="airpay-stat-grid">
                    {{! Manager KPI tiles — Phase B0 iter 2: migrated to stat_card partial }}
                    {{#manager_kpis}}
                    {{> theme_airpayux/components/stat_card }}
                    {{/manager_kpis}}
                </div>
            </div>
            {{/hasmanagerkpis}}

            {{! Team Compliance Table }}
            {{#hasteamcompliance}}
            <div class="airpay-dash__section airpay-dash__section--bottom-spacing">
                <h3 class="airpay-dash__section-title"><i class="fa fa-shield"></i> Team Compliance</h3>
                <table class="generaltable airpay-dash__team-table">
                    <thead>
                        <tr>
                            <th>Team Member</th>
                            <th>Enrolled</th>
                            <th>Completed</th>
                            <th>Rate</th>
                            <th>Pending</th>
                            <th>Overdue</th>
                            <th>Last Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#teamcompliance}}
                        <tr class="{{#is_inactive}}airpay-dash__team-table__row--inactive{{/is_inactive}}">
                            <td><strong>{{name}}</strong></td>
                            <td>{{enrolled}}</td>
                            <td>{{completed}}</td>
                            <td><span class="badge badge-{{rate_class}}">{{rate}}%</span></td>
                            <td>{{#haspending}}<span class="airpay-dash__team-table__pending airpay-dash__team-table__pending--has">{{pending}}</span>{{/haspending}}{{^haspending}}<span class="airpay-dash__team-table__pending airpay-dash__team-table__pending--none">0</span>{{/haspending}}</td>
                            <td>{{#has_overdue}}<span class="badge badge-danger">{{overdue}}</span>{{/has_overdue}}{{^has_overdue}}<span class="airpay-dash__team-table__overdue--none">✓</span>{{/has_overdue}}</td>
                            <td>{{lastaccess}}</td>
                            <td><a href="{{drilldown_url}}" class="btn btn-sm btn-link p-0" title="Drill down"><i class="fa fa-search-plus"></i></a></td>
                        </tr>
                        {{/teamcompliance}}
                    </tbody>
                </table>
            </div>
            {{/hasteamcompliance}}

            {{/ismanager}}

            {{! ═══ LEARNER DASHBOARD (employees, managers own learning, external learners) ═══ }}
            {{#islearner}}

            {{! Learner KPI tiles — Phase B0 iter 2: migrated to stat_card partial.
                Data shape comes from $airpay_dashboard['learner_kpis'] in dashboard.php. }}
            {{#haslearnerkpis}}
            <div class="airpay-stat-grid">
                {{#learner_kpis}}
                {{> theme_airpayux/components/stat_card }}
                {{/learner_kpis}}
            </div>
            {{/haslearnerkpis}}

            {{! Progress Ring — overall completion percentage }}
            {{#has_progress_ring}}
            <div class="airpay-dash__section airpay-dash__section--progress-summary">
                <div class="ap-progress-ring">
                    <svg width="88" height="88" viewBox="0 0 80 80">
                        <circle class="ap-progress-ring__track" cx="40" cy="40" r="36"/>
                        <circle class="ap-progress-ring__fill ap-progress-ring__fill--{{progress_ring.color_class}}"
                                cx="40" cy="40" r="36"
                                stroke-dasharray="{{progress_ring.circumference}}"
                                stroke-dashoffset="{{progress_ring.offset}}"/>
                    </svg>
                    <span class="ap-progress-ring__label ap-progress-ring__label--lg">{{progress_ring.percent}}%</span>
                </div>
                <div class="airpay-dash__progress-summary__text">
                    <strong class="airpay-dash__progress-summary__title">Overall Completion</strong><br>
                    <span class="airpay-dash__progress-summary__meta">
                        {{stats.completed}} of {{stats.enrolled}} courses completed
                    </span>
                </div>
            </div>
            {{/has_progress_ring}}

            {{! Gamification Widgets — Points, Streaks, Leaderboard.
                Dynamic per-user values (level_color, level_progress) flow
                via CSS custom properties on the affected element, so the
                cascade stays in SCSS. The level_color hex comes from
                local_airpay_gamification/classes/points_manager.php
                (5-step server-side lookup table — not user input). }}
            {{#hasgamification}}
            <div class="airpay-dash__section">
                <div class="airpay-dash__gamification-row">
                    {{! Points + Badges Summary }}
                    <div class="airpay-gamification">
                        <div class="airpay-gamification__header">
                            <div class="airpay-gamification__level" style="--level-color: {{gamification.level_color}};">
                                <span class="airpay-gamification__level-badge">
                                    Lv.{{gamification.level_number}}
                                </span>
                                <div class="airpay-gamification__level-info">
                                    <strong>{{gamification.level_name}}</strong>
                                    <small>{{gamification.total_points}} pts &middot; Rank #{{gamification.rank}}</small>
                                </div>
                            </div>
                            {{#gamification.has_streak}}
                            <div class="airpay-gamification__streak">
                                <i class="fa fa-fire airpay-dash__streak-icon"></i>
                                <strong>{{gamification.current_streak}}</strong>
                                <small>day streak</small>
                            </div>
                            {{/gamification.has_streak}}
                        </div>
                        <div class="airpay-gamification__progress">
                            <div class="airpay-gamification__progress-bar" style="--level-progress: {{gamification.level_progress}}%; --level-color: {{gamification.level_color}};"></div>
                        </div>
                        <small class="airpay-gamification__progress-label">{{gamification.points_to_next}} pts to next level</small>
                    </div>

                    {{! Streak Calendar + Leaderboard }}
                    {{#hasstreakcalendar}}
                    <div>
                        <div class="airpay-gamification__streak-calendar">
                            <div class="airpay-gamification__streak-header">
                                <span><i class="fa fa-fire airpay-dash__streak-icon"></i> {{streak_calendar.current_streak}} day streak</span>
                                <small>Best: {{streak_calendar.longest_streak}} days</small>
                            </div>
                            <div class="airpay-gamification__streak-days">
                                {{#streak_calendar.days}}
                                <div class="airpay-gamification__streak-day {{#active}}airpay-gamification__streak-day--active{{/active}} {{#is_today}}airpay-gamification__streak-day--today{{/is_today}}">
                                    <small>{{label}}</small>
                                    <div class="airpay-gamification__streak-dot"></div>
                                </div>
                                {{/streak_calendar.days}}
                            </div>
                        </div>

                        {{! Mini Leaderboard }}
                        {{#hasleaderboard}}
                        <div class="airpay-gamification__leaderboard airpay-gamification__leaderboard--spaced">
                            <div class="airpay-gamification__leaderboard-header">
                                <h4><i class="fa fa-trophy airpay-dash__trophy-icon"></i> Leaderboard</h4>
                                <small>Your department</small>
                            </div>
                            {{#leaderboard.has_entries}}
                            <div class="airpay-gamification__leaderboard-list">
                                {{#leaderboard.entries}}
                                <div class="airpay-gamification__leaderboard-row {{#is_current_user}}airpay-gamification__leaderboard-row--you{{/is_current_user}}">
                                    <span class="airpay-gamification__leaderboard-rank {{#is_top3}}airpay-gamification__leaderboard-rank--top{{/is_top3}}">{{rank}}</span>
                                    <span class="airpay-gamification__leaderboard-avatar" style="--level-color: {{level_color}};">{{initials}}</span>
                                    <span class="airpay-gamification__leaderboard-name">{{firstname}} {{lastname}} {{#is_current_user}}<small>(You)</small>{{/is_current_user}}</span>
                                    <span class="airpay-gamification__leaderboard-points">{{points}} pts</span>
                                </div>
                                {{/leaderboard.entries}}
                            </div>
                            {{/leaderboard.has_entries}}
                        </div>
                        {{/hasleaderboard}}
                    </div>
                    {{/hasstreakcalendar}}
                </div>
            </div>
            {{/hasgamification}}

            {{! Continue Learning — Phase B0 iter 3: migrated to course_progress_card partial }}
            {{#hascontinuecourses}}
            <div class="airpay-dash__section">
                <div class="airpay-dash__section-header">
                    <h3 class="airpay-dash__section-title">Continue Learning</h3>
                    <a href="{{{config.wwwroot}}}/my/courses.php" class="airpay-dash__section-link">View all <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="airpay-course-grid">
                    {{#continuecourses}}
                    {{> theme_airpayux/components/course_progress_card }}
                    {{/continuecourses}}
                </div>
            </div>
            {{/hascontinuecourses}}
            {{! Empty state — Phase B0 iter 7: migrated to empty_state partial }}
            {{^hascontinuecourses}}
