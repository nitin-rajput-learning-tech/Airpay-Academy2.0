{{!
    Maintenance / error page — Airpay Academy branded.

    Overrides Moodle core maintenance template to show Airpay branding
    instead of generic Moodle error pages.

    Context variables:
    * heading - page heading
    * text - error/maintenance message
    * output.standard_head_html - required head HTML
    * output.standard_end_of_body_html - required end-of-body HTML
}}
<!DOCTYPE html>
<html {{{ output.htmlattributes }}}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#str}}pluginname, theme_airpayux{{/str}} — {{heading}}</title>
    {{{ output.standard_head_html }}}
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Montserrat', -apple-system, sans-serif;
            background: #F2F4FB;
            color: #1a1a2e;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ap-error {
            text-align: center;
            max-width: 520px;
            padding: 48px 32px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        }
        .ap-error__logo {
            width: 180px;
            margin-bottom: 24px;
        }
        .ap-error__code {
            font-size: 64px;
            font-weight: 800;
            color: #0066A7;
            line-height: 1;
            margin-bottom: 8px;
        }
        .ap-error__heading {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .ap-error__message {
            font-size: 15px;
            color: #5a6070;
            line-height: 1.6;
            margin-bottom: 24px;
        }
        .ap-error__btn {
            display: inline-block;
            padding: 12px 32px;
            background: #0066A7;
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: background 0.2s;
        }
        .ap-error__btn:hover { background: #004d80; color: #fff; }
        .ap-error__footer {
            margin-top: 32px;
            font-size: 12px;
            color: #a0a9b8;
        }
    </style>
</head>
<body>
    <div class="ap-error">
        <img class="ap-error__logo"
             src="{{{config.wwwroot}}}/theme/airpayux/pix/default_logo.png"
             alt="airpay academy">
        <div class="ap-error__heading">{{heading}}</div>
        <div class="ap-error__message">{{{text}}}</div>
        <a href="{{{config.wwwroot}}}" class="ap-error__btn">Go to Dashboard</a>
        <div class="ap-error__footer">airpay academy &mdash; enterprise learning platform</div>
    </div>
    {{{ output.standard_end_of_body_html }}}
</body>
</html>
