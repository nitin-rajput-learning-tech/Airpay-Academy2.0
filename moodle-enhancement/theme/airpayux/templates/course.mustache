{{!
    @template theme_airpayux/drawers

    epsilon drawer template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * courseindexopen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.

    Example context (json):
    {
        "sitename": "airpay academy",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "courseindexopen": true,
        "navdraweropen": false,
        "blockdraweropen": true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false,
        "addblockbutton": ""
    }
}}
{{> theme_airpayux/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_airpayux/navbar }}
    {{#courseindex}}
        {{< theme_airpayux/drawer }}
            {{$id}}theme_airpayux-drawers-courseindex{{/id}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{/ theme_airpayux/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_airpayux/drawer }}
            {{$id}}theme_airpayux-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <section class="d-print-none" aria-label="{{#str}}blocks{{/str}}">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </section>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_airpayux/drawer}}
    {{/hasblocks}}
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_airpayux-drawers-courseindex"
                            data-bs-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                            {{#pix}} t/index_drawer, moodle {{/pix}}
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ml-auto d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_airpayux-drawers-blocks"
                            data-bs-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>
            {{{ output.full_header }}}
            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}
            {{! ═══ AIRPAY COURSE PROGRESS BAR (sticky top) ═══
                Phase B0 Player iter 2 — a11y polish: aria-label on icon
                buttons (was title-only), aria-current on progress, real
                progress-bar role on the track. }}
            {{#ap_has_progress}}
            <div class="ap-course-progress-bar"
                 role="region"
                 aria-label="Course progress and navigation">
                <div class="ap-course-progress-bar__info">
                    <a href="{{ap_course_url}}"
                       class="ap-course-progress-bar__back"
                       aria-label="Back to {{ap_course_name}}">
                        <i class="fa fa-arrow-left" aria-hidden="true"></i>
                    </a>
                    {{#ap_has_sidebar}}
                    <button class="ap-course-progress-bar__toggle"
                            type="button"
                            id="ap-sidebar-toggle"
                            aria-label="Toggle course sidebar"
                            aria-controls="ap-course-sidebar">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                    </button>
                    {{/ap_has_sidebar}}
                    <span class="ap-course-progress-bar__name">{{ap_course_name}}</span>
                    <span class="ap-course-progress-bar__stats"
                          aria-label="{{ap_course_completed}} of {{ap_course_total}} activities completed, {{ap_course_progress}}%">
                        {{ap_course_completed}}/{{ap_course_total}} &middot; {{ap_course_progress}}%
                    </span>
                </div>
                <div class="ap-course-progress-bar__track"
                     role="progressbar"
                     aria-valuenow="{{ap_course_progress}}"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-label="Course completion progress">
                    <div class="ap-course-progress-bar__fill" style="width:{{ap_course_progress}}%;"></div>
                </div>
            </div>
            {{/ap_has_progress}}

            <div id="page-content" class="pb-3 d-print-block">
                <div class="ap-course-player {{#ap_has_sidebar}}ap-course-player--has-sidebar{{/ap_has_sidebar}}">

                    {{! ═══ COURSE SIDEBAR — Module List ═══ }}
                    {{#ap_has_sidebar}}
                    <aside class="ap-course-sidebar" id="ap-course-sidebar">
                        <div class="ap-course-sidebar__header">
                            <h4 class="ap-course-sidebar__title">Course Content</h4>
                            <span class="ap-course-sidebar__progress-label">{{ap_course_progress}}% complete</span>
                        </div>
                        <div class="ap-course-sidebar__progress-track">
                            <div class="ap-course-sidebar__progress-fill" style="width:{{ap_course_progress}}%;"></div>
                        </div>
                        <nav class="ap-course-sidebar__nav">
                            {{#ap_sidebar_sections}}
                            <div class="ap-course-sidebar__section">
                                <div class="ap-course-sidebar__section-header">
                                    <span class="ap-course-sidebar__section-name">{{name}}</span>
                                    <span class="ap-course-sidebar__section-count">{{count}}</span>
                                </div>
                                <ul class="ap-course-sidebar__list">
                                    {{#activities}}
                                    <li class="ap-course-sidebar__item {{#is_current}}ap-course-sidebar__item--current{{/is_current}} {{#is_done}}ap-course-sidebar__item--done{{/is_done}}">
                                        <a href="{{url}}" class="ap-course-sidebar__link">
                                            {{#is_done}}
                                            <i class="fa fa-check-circle ap-course-sidebar__icon ap-course-sidebar__icon--done"></i>
                                            {{/is_done}}
                                            {{#is_current}}
                                            <i class="fa fa-play-circle ap-course-sidebar__icon ap-course-sidebar__icon--current"></i>
                                            {{/is_current}}
                                            {{#is_todo}}
                                            <i class="fa {{icon}} ap-course-sidebar__icon"></i>
                                            {{/is_todo}}
                                            <span class="ap-course-sidebar__item-name">{{name}}</span>
                                        </a>
                                    </li>
                                    {{/activities}}
                                </ul>
                            </div>
                            {{/ap_sidebar_sections}}
                        </nav>
                    </aside>
                    {{/ap_has_sidebar}}

                    {{! ═══ MAIN CONTENT AREA ═══ }}
                    <div id="region-main-box" class="ap-course-player__main">
                        {{#hasregionmainsettingsmenu}}
                        <div id="region-main-settings-menu" class="d-print-none">
                            <div> {{{ regionmainsettingsmenu }}} </div>
                        </div>
                        {{/hasregionmainsettingsmenu}}
                        <section id="region-main" aria-label="{{#str}}content{{/str}}" >
                            {{#hasregionmainsettingsmenu}}
                                <div class="region_main_settings_menu_proxy"></div>
                            {{/hasregionmainsettingsmenu}}
                            {{{ output.course_content_header }}}
                            {{#headercontent}}
                                {{> core/activity_header }}
                            {{/headercontent}}
                            {{#overflow}}
                                <div class="container-fluid tertiary-navigation">
                                    <div class="navitem">
                                        {{!-- Phase B.3.c+ dual-target (2026-05-24).
                                              layout/course.php now sets is_select_menu_context = true
                                              on 5.2 (when \core\output\select_menu is available) and
                                              false on 5.1. The 5.2 partial wraps the select_menu data
                                              shape; the 5.1 partial wraps the legacy url_select shape.
                                              Same template, both targets. See
                                              docs/5.2-merge/PHASE-B3C-TOP-TEMPLATES-REBASE.md. --}}
                                        {{#is_select_menu_context}}
                                            {{> core/tertiary_navigation_selector }}
                                        {{/is_select_menu_context}}
                                        {{^is_select_menu_context}}
                                            {{> core/url_select }}
                                        {{/is_select_menu_context}}
                                    </div>
                                </div>
                            {{/overflow}}
                            {{{ output.main_content }}}
                            {{{ output.activity_navigation }}}
                            {{{ output.course_content_footer }}}

                            {{! ═══ AIRPAY NEXT ACTIVITY CTA ═══ }}
                            {{#ap_has_next}}
                            <div class="ap-course-next">
                                <a href="{{ap_next_url}}" class="ap-btn-gradient ap-course-next__btn">
                                    Next: {{ap_next_name}} <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                            {{/ap_has_next}}
                        </section>
                    </div>
                </div>
            </div>
        </div>
        {{> theme_airpayux/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_airpayux/loader');
require(['theme_airpayux/loader', 'theme_airpayux/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_airpayux/loader');
});
{{/js}}

<script>
document.addEventListener('DOMContentLoaded', function() {
    var sidebar = document.getElementById('ap-course-sidebar');
    var toggleBtn = document.getElementById('ap-sidebar-toggle');
    if (!sidebar || !toggleBtn) return;

    // Restore saved state.
    var savedState = localStorage.getItem('ap_sidebar_open');
    if (savedState === 'false') {
        sidebar.classList.add('ap-course-sidebar--collapsed');
    }

    // Toggle sidebar.
    toggleBtn.addEventListener('click', function() {
        sidebar.classList.toggle('ap-course-sidebar--collapsed');
        localStorage.setItem('ap_sidebar_open',
            !sidebar.classList.contains('ap-course-sidebar--collapsed'));
    });

    // Scroll current activity into view.
    var currentItem = sidebar.querySelector('.ap-course-sidebar__item--current');
    if (currentItem) {
        setTimeout(function() {
            currentItem.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }, 300);
    }

    // Keyboard shortcuts.
    document.addEventListener('keydown', function(e) {
        // Don't trigger in input fields.
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
        // [B] Toggle sidebar.
        if (e.key === 'b' && !e.ctrlKey && !e.metaKey) {
            sidebar.classList.toggle('ap-course-sidebar--collapsed');
            localStorage.setItem('ap_sidebar_open',
                !sidebar.classList.contains('ap-course-sidebar--collapsed'));
        }
        // [N] Next activity.
        if (e.key === 'n' && !e.ctrlKey && !e.metaKey) {
            var nextBtn = document.querySelector('.ap-course-next__btn');
            if (nextBtn) window.location.href = nextBtn.href;
        }
    });
});
</script>
