{{!
    @template theme_airpayux/footer

    Compact single-row footer — consistent across all pages and roles.
    Matches the homepage footer design from frontpage.php.

    Example context (json):
    {
        "output": {
            "standard_footer_html": "",
            "standard_end_of_body_html": ""
        }
    }
}}

<footer id="page-footer" class="airpay-footer">
    {{! Moodle required: course footer + tour reset }}
    <div id="course-footer" class="d-none">{{{ output.course_footer }}}</div>
    <div class="tool_usertours-resettourcontainer"></div>

    {{! ── Compact footer row ────────────────────────── }}
    <div class="airpay-footer__compact">
        <a href="{{{config.wwwroot}}}/" class="airpay-footer__logo">
            <img src="{{{config.wwwroot}}}/theme/airpayux/pix/brand/academy-logo-350.png" alt="airpay academy">
        </a>
        <nav class="airpay-footer__links">
            <a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=privacy">{{#str}}footer_privacy, theme_airpayux{{/str}}</a>
            <a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=terms">{{#str}}footer_terms, theme_airpayux{{/str}}</a>
            <a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=help">{{#str}}footer_help, theme_airpayux{{/str}}</a>
            <a href="{{{config.wwwroot}}}/local/airpay_pages/index.php?page=contact">{{#str}}footer_contact, theme_airpayux{{/str}}</a>
        </nav>
        <span class="airpay-footer__copy">{{#str}}footer_copyright, theme_airpayux{{/str}}</span>
    </div>

    {{!
        2026-05-20 / Session 4 — Sentientia LMS product attribution band.
        Per ADR-001 § Trademark cleanup, the GPL-required Moodle attribution
        AND the Sentientia LMS product brand both live here. For Airpay
        Academy as customer-zero, this stays compact — a single line in
        muted text below the primary brand row.

        P0 #6 follow-up (2026-05-24) — inline styles removed in favour of
        BEM classes; tokens live in partials/_surface-footer.scss.
    }}
    <div class="airpay-footer__product-attribution">
        <span class="airpay-footer__product-attribution-brand">Sentientia LMS</span>
        <span class="airpay-footer__product-attribution-sep" aria-hidden="true">·</span>
        <span class="airpay-footer__product-attribution-licence">Licensed under GPL v3</span>
    </div>

    {{! Standard footer/end-of-body output — MUST be before </body> }}
    {{{ output.standard_footer_html }}}
    {{{ output.standard_end_of_body_html }}}
    {{{ output.debug_footer_html }}}
</footer>

{{!
    2026-05-22 — removed the inline PWA install banner that previously
    lived here. That script ignored localStorage / dismissals and
    re-rendered a position:fixed banner on EVERY page load, conflicting
    with the official local_sentientia_pwa/install_prompt AMD module
    (Phase D.1.b). The official module is the single source of truth:
    it captures beforeinstallprompt, suppresses Chrome native bar,
    renders a flag-gated dashboard-only CTA, persists Not now both
    locally + via user preference, and respects a 7-day quarantine.
}}
