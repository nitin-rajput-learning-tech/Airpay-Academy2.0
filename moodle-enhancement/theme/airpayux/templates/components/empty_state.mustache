{{!
    Airpay Empty State — Phase B0 iter 7 (2026-05-14)

    Use when a list, table, or section has zero items. The manifesto
    (§1.5) says "empty states are scenes" — they should INVITE action,
    not look like a bug.

    Context:
        title       (required) — short headline (e.g. "No deadlines yet")
        message     (optional) — supporting one-sentence explanation
        icon        (optional) — FA icon name without "fa-" prefix
        ctalabel    (optional) — text for the action button
        ctaurl      (optional) — URL the action button links to
        ctaicon     (optional) — FA icon for the action button
        size        (optional) — "sm" | "md" (default) | "lg"
                                 - sm  = inline empty state for narrow panels
                                 - md  = section-level (default)
                                 - lg  = full-page empty state

    A11y:
      - Icon is aria-hidden (decorative).
      - Title is <h4> so it nests under the section header (h3) cleanly.
      - CTA is a real <a> with focus-visible support.

    Usage:
        {{> theme_airpayux/components/empty_state }}
}}
<div class="airpay-empty-state airpay-empty-state--{{#size}}{{size}}{{/size}}{{^size}}md{{/size}}" role="status">
    {{#icon}}
    <i class="fa fa-{{icon}} airpay-empty-state__icon" aria-hidden="true"></i>
    {{/icon}}
    <h4 class="airpay-empty-state__title">{{title}}</h4>
    {{#message}}
    <p class="airpay-empty-state__message">{{message}}</p>
    {{/message}}
    {{#ctaurl}}
    <a class="airpay-empty-state__cta" href="{{ctaurl}}">
        {{#ctaicon}}<i class="fa fa-{{ctaicon}}" aria-hidden="true"></i>{{/ctaicon}}
        <span>{{ctalabel}}</span>
    </a>
    {{/ctaurl}}
</div>
