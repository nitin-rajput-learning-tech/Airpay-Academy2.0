{{!
    Airpay Card Component
    Context: { title, subtitle, body, imageurl, badge, badgetype (primary|accent|success|warning),
               actionurl, actionlabel, footer, extraclass }
    Usage: include the partial "theme_airpayux/components/card".
    Audit fix H1 (2026-05-15) — see stat_card.mustache for the rationale.
}}
<div class="airpay-card {{extraclass}}">
    {{#imageurl}}
    <div class="airpay-card__image" style="background-image: url('{{imageurl}}')">
        {{#badge}}<span class="airpay-card__badge airpay-card__badge--{{#badgetype}}{{badgetype}}{{/badgetype}}{{^badgetype}}primary{{/badgetype}}">{{badge}}</span>{{/badge}}
    </div>
    {{/imageurl}}
    <div class="airpay-card__body">
        {{#title}}<h4 class="airpay-card__title">{{title}}</h4>{{/title}}
        {{#subtitle}}<p class="airpay-card__subtitle">{{subtitle}}</p>{{/subtitle}}
        {{#body}}<div class="airpay-card__content">{{{body}}}</div>{{/body}}
    </div>
    {{#actionurl}}
    <div class="airpay-card__footer">
        <a href="{{actionurl}}" class="airpay-btn airpay-btn--primary airpay-btn--sm">
            {{#actionlabel}}{{actionlabel}}{{/actionlabel}}{{^actionlabel}}{{# str }}view, core{{/ str }}{{/actionlabel}}
        </a>
    </div>
    {{/actionurl}}
    {{#footer}}<div class="airpay-card__footer">{{{footer}}}</div>{{/footer}}
</div>
