{{!
    Airpay Badge Component
    Context: { text, type (primary|accent|success|warning|danger|info), icon, size (sm|md) }
    Usage: include the partial "theme_airpayux/components/badge".
    Audit fix H1 (2026-05-15) — see stat_card.mustache for the rationale.
}}
<span class="airpay-badge airpay-badge--{{#type}}{{type}}{{/type}}{{^type}}primary{{/type}} {{#size}}airpay-badge--{{size}}{{/size}}">
    {{#icon}}<i class="fa fa-{{icon}}" aria-hidden="true"></i> {{/icon}}{{text}}
</span>
