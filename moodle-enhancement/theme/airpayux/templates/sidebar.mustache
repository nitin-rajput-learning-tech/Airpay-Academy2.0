{{!
    Sidebar navigation — Airpay Academy Enterprise.

    Context from sidebar_navigation::get_context():
    * wwwroot - site root URL
    * collapsed - bool, sidebar collapsed state
    * logourl - tenant logo URL
    * sitename - site short name
    * navitems[] - {type, label, icon, url, active, badge}
    * issiteadmin, isldadmin, ismanager - role flags
    * userfullname, useravatar, userinitials
    * profileurl, logouturl
}}
<aside class="ap-sidebar" id="ap-sidebar" data-collapsed="{{#collapsed}}true{{/collapsed}}{{^collapsed}}false{{/collapsed}}">
    {{! ── Logo ──────────────────────────────────────── }}
    <div class="ap-sidebar__logo">
        <a href="{{{wwwroot}}}/my/dashboard.php" class="ap-sidebar__logo-link">
            <img src="{{{logourl}}}" alt="{{sitename}}" class="ap-sidebar__logo-img">
            <span class="ap-sidebar__logo-text">{{sitename}}</span>
        </a>
    </div>

    {{! ── Navigation ────────────────────────────────── }}
    <nav class="ap-sidebar__nav" aria-label="Main navigation">
        <ul class="ap-sidebar__list">
            {{#navitems}}
                {{#type.divider}}
                {{/type.divider}}
                {{^type.divider}}
                {{#type}}{{/type}}
                {{/type.divider}}
            {{/navitems}}
        </ul>
    </nav>

    {{! ── Simplified nav rendering ──────────────────── }}
    <nav class="ap-sidebar__nav" aria-label="Main navigation">
        <ul class="ap-sidebar__list">
            {{#navitems}}
                {{#active}}
                <li class="ap-sidebar__item ap-sidebar__item--active">
                    <a href="{{{url}}}" class="ap-sidebar__link" aria-current="page">
                        <i class="fa {{icon}} ap-sidebar__icon"></i>
                        <span class="ap-sidebar__label">{{label}}</span>
                        {{#badge}}<span class="ap-sidebar__badge">{{badge}}</span>{{/badge}}
                    </a>
                </li>
                {{/active}}
                {{^active}}
                <li class="ap-sidebar__item">
                    <a href="{{{url}}}" class="ap-sidebar__link">
                        <i class="fa {{icon}} ap-sidebar__icon"></i>
                        <span class="ap-sidebar__label">{{label}}</span>
                        {{#badge}}<span class="ap-sidebar__badge">{{badge}}</span>{{/badge}}
                    </a>
                </li>
                {{/active}}
            {{/navitems}}
        </ul>
    </nav>

    {{! ── Bottom section: user + collapse toggle ───── }}
    <div class="ap-sidebar__bottom">
        <button class="ap-sidebar__toggle" id="ap-sidebar-toggle" title="Toggle sidebar">
            <i class="fa fa-chevron-left ap-sidebar__toggle-icon"></i>
        </button>
        <a href="{{{profileurl}}}" class="ap-sidebar__user">
            <div class="ap-sidebar__avatar">
                {{{useravatar}}}
            </div>
            <div class="ap-sidebar__userinfo">
                <span class="ap-sidebar__username">{{userfullname}}</span>
            </div>
        </a>
    </div>
</aside>
