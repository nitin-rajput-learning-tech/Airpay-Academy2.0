CREATE TABLE mdl_local_sentientia_xapi_stmts (
    id BIGINT(10) NOT NULL auto_increment,
    statementid VARCHAR(36) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
    costcenterid BIGINT(10) NOT NULL DEFAULT 0,
    actorid BIGINT(10),
    actor LONGTEXT COLLATE utf8mb4_unicode_ci NOT NULL,
    verb VARCHAR(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
    verbdisplay VARCHAR(128) COLLATE utf8mb4_unicode_ci,
    object LONGTEXT COLLATE utf8mb4_unicode_ci NOT NULL,
    objectid VARCHAR(1333) COLLATE utf8mb4_unicode_ci,
    result LONGTEXT COLLATE utf8mb4_unicode_ci,
    score_scaled NUMERIC(5,4),
    score_raw NUMERIC(10,2),
    success TINYINT(1),
    completion TINYINT(1),
    context LONGTEXT COLLATE utf8mb4_unicode_ci,
    registration VARCHAR(36) COLLATE utf8mb4_unicode_ci,
    authority LONGTEXT COLLATE utf8mb4_unicode_ci,
    timestamp BIGINT(10),
    stored BIGINT(10) NOT NULL DEFAULT 0,
    source VARCHAR(32) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'moodle',
    voided TINYINT(1) NOT NULL DEFAULT 0,
    timecreated BIGINT(10) NOT NULL DEFAULT 0,
    timemodified BIGINT(10) NOT NULL DEFAULT 0,
