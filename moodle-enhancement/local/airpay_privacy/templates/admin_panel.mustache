{{!
    DPDP Privacy Admin Panel — manage data requests from all users.
    Context: sesskey, baseurl, total, pending, completed, rejected,
             requests [{id, user_name, user_email, tenant_id, type, type_delete, type_download,
                       reason, status, is_pending, is_completed, is_rejected, created, processed}]
}}
<div style="font-family:'Montserrat',-apple-system,sans-serif;">

    <h2 style="font-size:22px; font-weight:700; color:#1a1a2e; margin:0 0 4px;">
        <i class="fa fa-lock" style="color:#7c3aed;"></i>
        DPDP Privacy Management
    </h2>
    <p style="font-size:13px; color:#5a6070; margin:0 0 24px;">
        Manage data download and account deletion requests under the Digital Personal Data Protection Act, 2023.
        Response deadline: 72 hours (data access), 30 days (deletion).
    </p>

    {{! Stat cards — Phase B0+: migrated to tokens-aware stat_card partial }}
    {{#has_kpi_tiles}}
    <div class="airpay-stat-grid" style="margin-bottom: 24px;">
        {{#kpi_tiles}}
        {{> theme_airpayux/components/stat_card }}
        {{/kpi_tiles}}
    </div>
    {{/has_kpi_tiles}}

    {{! Requests table }}
    {{#has_requests}}
    <div style="background:#fff; border:1px solid #e2e6ef; border-radius:12px; overflow:hidden;">
        <table style="width:100%; border-collapse:collapse; font-size:13px;">
            <thead>
                <tr style="background:#f8f9fc;">
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">User</th>
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Request Type</th>
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Reason</th>
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Status</th>
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Submitted</th>
                    <th style="text-align:left; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Processed</th>
                    <th style="text-align:right; padding:10px 14px; font-weight:600; color:#5a6070; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#requests}}
                <tr style="border-bottom:1px solid #f0f2f7;">
                    <td style="padding:10px 14px;">
                        <strong>{{user_name}}</strong><br/>
                        <span style="font-size:11px; color:#8890a0;">{{user_email}}</span>
                    </td>
                    <td style="padding:10px 14px;">
                        {{#type_delete}}
                        <span style="display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; background:#fef2f2; color:#dc2626;">Account Deletion</span>
                        {{/type_delete}}
                        {{#type_download}}
                        <span style="display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; background:#f5f3ff; color:#7c3aed;">Data Download</span>
                        {{/type_download}}
                    </td>
                    <td style="padding:10px 14px; font-size:12px; color:#5a6070; max-width:200px;">{{reason}}</td>
                    <td style="padding:10px 14px;">
                        {{#is_pending}}<span style="display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; background:#fef3c7; color:#d97706;">Pending</span>{{/is_pending}}
                        {{#is_completed}}<span style="display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; background:#dcfce7; color:#16a34a;">Completed</span>{{/is_completed}}
                        {{#is_rejected}}<span style="display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; background:#f0f2f7; color:#dc2626;">Rejected</span>{{/is_rejected}}
                    </td>
                    <td style="padding:10px 14px; font-size:12px;">{{created}}</td>
                    <td style="padding:10px 14px; font-size:12px;">{{processed}}</td>
                    <td style="padding:10px 14px; text-align:right;">
                        {{#is_pending}}
                        {{#type_delete}}
                        <a href="{{baseurl}}?action=approve&reqid={{id}}&sesskey={{sesskey}}"
                           style="display:inline-block; padding:4px 10px; border-radius:6px; font-size:12px; font-weight:500; background:#16a34a; color:#fff; text-decoration:none; margin-right:4px;"
                           onclick="return confirm('This will anonymize the user account and suspend it. Continue?');">
                            Approve
                        </a>
                        <a href="{{baseurl}}?action=reject&reqid={{id}}&sesskey={{sesskey}}"
                           style="display:inline-block; padding:4px 10px; border-radius:6px; font-size:12px; font-weight:500; background:#dc2626; color:#fff; text-decoration:none;"
                           onclick="return confirm('Reject this deletion request?');">
                            Reject
                        </a>
                        {{/type_delete}}
                        {{#type_download}}
                        <span style="font-size:11px; color:#8890a0;">Auto-processed</span>
                        {{/type_download}}
                        {{/is_pending}}
                        {{^is_pending}}
                        <span style="font-size:11px; color:#8890a0;">Done</span>
                        {{/is_pending}}
                    </td>
                </tr>
                {{/requests}}
            </tbody>
        </table>
    </div>
    {{/has_requests}}

    {{^has_requests}}
    <div style="text-align:center; padding:60px 20px; color:#5a6070; background:#fff; border:1px solid #e2e6ef; border-radius:12px;">
        <i class="fa fa-lock" style="font-size:48px; color:#e2e6ef; display:block; margin-bottom:16px;"></i>
        No DPDP requests yet. Requests appear when users submit data download or account deletion requests.
    </div>
    {{/has_requests}}

    <div style="margin-top:24px; padding:12px 16px; background:#f5f3ff; border:1px solid #d8b4fe; border-radius:8px; font-size:13px; color:#5b21b6;">
        <strong>DPDP Act 2023 Compliance:</strong> Data access requests (Section 11) must be fulfilled within 72 hours.
        Account deletion requests (Section 12) must be processed within 30 days.
        DPO Contact: <strong>academy@airpay.co.in</strong>
    </div>
</div>
