<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_challenge/db" VERSION="20260507"
       COMMENT="Airpay Gamification Engine — challenges, attempts, leaderboard snapshots">
  <TABLES>
    <TABLE NAME="local_airpay_challenge_challenges"
           COMMENT="Challenge definitions (course-completion-based in Phase 1)">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"          TYPE="char" LENGTH="255" NOTNULL="true"
               COMMENT="Display name shown to learners"/>
        <FIELD NAME="shortname"     TYPE="char" LENGTH="100" NOTNULL="true"
               COMMENT="Internal slug, must be unique per tenant"/>
        <FIELD NAME="description"   TYPE="text" NOTNULL="false"/>
        <FIELD NAME="type"          TYPE="char" LENGTH="40"  NOTNULL="true" DEFAULT="course_completion"
               COMMENT="course_completion | streak (Phase 2) | quiz_score (Phase 2) | custom"/>
        <FIELD NAME="targetcount"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="1"
               COMMENT="How many courses must be completed to win the challenge"/>
        <FIELD NAME="courseids"     TYPE="text" NOTNULL="false"
               COMMENT="JSON array of course IDs. Empty = any course counts."/>
        <FIELD NAME="pointsreward"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="100"/>
        <FIELD NAME="badge"         TYPE="char" LENGTH="100" NOTNULL="false"
               COMMENT="Optional badge identifier (Phase 2: tool_certificate template name)"/>
        <FIELD NAME="cohortid"      TYPE="int"  LENGTH="10"  NOTNULL="false"
               COMMENT="Optional cohort filter — if set, only cohort members can join"/>
        <FIELD NAME="status"        TYPE="int"  LENGTH="2"   NOTNULL="true" DEFAULT="0"
               COMMENT="0=draft, 1=active, 2=archived"/>
        <FIELD NAME="startdate"     TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="enddate"       TYPE="int"  LENGTH="10"  NOTNULL="false"/>
        <FIELD NAME="costcenterid"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="BizLMS tenant ID. 0 = global (visible to all tenants)."/>
        <FIELD NAME="open_path"     TYPE="char" LENGTH="255" NOTNULL="false"
               COMMENT="BizLMS path of the creator. Used for tenant scoping."/>
        <FIELD NAME="createdby"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"     TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_creator"  TYPE="foreign" FIELDS="createdby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_status"        UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="idx_costcenterid"  UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_shortname"     UNIQUE="false" FIELDS="shortname"
               COMMENT="Lookup by slug for engine + WS calls"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_challenge_attempts"
           COMMENT="Per-user enrolment + progress on a challenge. One row per (challengeid, userid) pair.">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="challengeid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status"         TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="enrolled"
               COMMENT="enrolled | in_progress | completed | failed | expired"/>
        <FIELD NAME="progress"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Number of qualifying course completions for this attempt"/>
        <FIELD NAME="targetcount"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="1"
               COMMENT="Snapshot of challenge.targetcount at join time (so target changes don't retroactively apply)"/>
        <FIELD NAME="pointsawarded"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completiondate" TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="When the attempt reached completed status; null if still in progress"/>
        <FIELD NAME="costcenterid"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_challenge" TYPE="foreign" FIELDS="challengeid" REFTABLE="local_airpay_challenge_challenges" REFFIELDS="id"/>
        <KEY NAME="fk_user"      TYPE="foreign" FIELDS="userid"      REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_challenge_user"  UNIQUE="true"  FIELDS="challengeid, userid"
               COMMENT="One attempt per user per challenge"/>
        <INDEX NAME="idx_status"          UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="idx_costcenterid"    UNIQUE="false" FIELDS="costcenterid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_challenge_leaderboard"
           COMMENT="Pre-computed leaderboard snapshot. Refreshed by scheduled task every 15 minutes; refreshed on-event for affected users.">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="challengeid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="0 = aggregate (sum across all challenges); >0 = per-challenge ranking"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="costcenterid"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="BizLMS tenant of the user — for scoped leaderboards"/>
        <FIELD NAME="points"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userrank"         TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="1-based; 0 = unranked"/>
        <FIELD NAME="attemptscompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastrecomputed"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user"  TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_challenge_user"  UNIQUE="true"  FIELDS="challengeid, userid"
               COMMENT="One leaderboard row per (challenge, user) — upsert target"/>
        <INDEX NAME="idx_challenge_pts"   UNIQUE="false" FIELDS="challengeid, points"
               COMMENT="Per-challenge top-N read; ORDER BY points DESC"/>
        <INDEX NAME="idx_costcenter_pts"  UNIQUE="false" FIELDS="costcenterid, points"
               COMMENT="Tenant-scoped top-N read"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
