<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_proctoring/db" VERSION="20260511"
       COMMENT="Airpay Proctoring — 5 tables. L1 identity, L2 monitoring, L3 AI review.">

  <TABLES>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_proctor_sessions — one row per attempt
         Tracks the proctored attempt lifecycle:
           new → consenting → verifying → recording → finished
                                                     → flagged → reviewed
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_proctor_sessions" COMMENT="One proctored attempt">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="quizid"       TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK quiz.id"/>
        <FIELD NAME="attemptid"    TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK quiz_attempts.id once attempt starts"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="new"
               COMMENT="new|consenting|verifying|recording|finished|flagged|reviewed"/>
        <FIELD NAME="identity_id"  TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK local_airpay_proctor_identity.id"/>
        <FIELD NAME="consent_given_at" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="risk_score"   TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false"
               COMMENT="0..100 aggregated from events + AI analysis"/>
        <FIELD NAME="auto_decision" TYPE="char" LENGTH="20" NOTNULL="false"
               COMMENT="clean|warn|fail — AI's verdict before human review"/>
        <FIELD NAME="human_decision" TYPE="char" LENGTH="20" NOTNULL="false"
               COMMENT="clean|warn|fail — final human verdict"/>
        <FIELD NAME="timestarted"   TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timefinished"  TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_quiz" TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_quiz" UNIQUE="false" FIELDS="userid, quizid"/>
        <INDEX NAME="idx_attempt"   UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="idx_status_time" UNIQUE="false" FIELDS="status, timecreated"/>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
      </INDEXES>
    </TABLE>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_proctor_identity — pre-exam identity verification
         Photos are uploaded to a temp file area, sent to verifier,
         then DELETED. Only match score + verification result retained.
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_proctor_identity" COMMENT="Identity verification results">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sessionid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="provider"     TYPE="char" LENGTH="30" NOTNULL="true"
               COMMENT="aws|azure|mock"/>
        <FIELD NAME="match_score"  TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false"
               COMMENT="0..100 face match"/>
        <FIELD NAME="passed"       TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"
               COMMENT="0|1 boolean (XMLDB has no bool type)"/>
        <FIELD NAME="error_code"   TYPE="char" LENGTH="50" NOTNULL="false"/>
        <FIELD NAME="error_msg"    TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_session" TYPE="foreign" FIELDS="sessionid"
             REFTABLE="local_airpay_proctor_sessions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_time" UNIQUE="false" FIELDS="userid, timecreated"/>
      </INDEXES>
    </TABLE>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_proctor_events — per-attempt behavioural events
         Append-only log of every event captured during the attempt.
         Examples: face_lost, tab_switch, clipboard_paste, mic_noise.
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_proctor_events" COMMENT="Append-only attempt events">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="event_type"   TYPE="char" LENGTH="40" NOTNULL="true"/>
        <FIELD NAME="severity"     TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="info"
               COMMENT="info|warn|critical"/>
        <FIELD NAME="payload_json" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_session" TYPE="foreign" FIELDS="sessionid"
             REFTABLE="local_airpay_proctor_sessions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_session_time" UNIQUE="false" FIELDS="sessionid, timecreated"/>
        <INDEX NAME="idx_severity"     UNIQUE="false" FIELDS="severity"/>
      </INDEXES>
    </TABLE>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_proctor_recordings — S3 keys + metadata
         The actual video/audio bytes live in S3. We only store the
         S3 object keys + retention metadata here.
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_proctor_recordings" COMMENT="Pointers to recording chunks in S3">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="chunk_idx"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="kind"        TYPE="char" LENGTH="20" NOTNULL="true"
               COMMENT="webcam|screen|audio"/>
        <FIELD NAME="s3_key"      TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="size_bytes"  TYPE="int"  LENGTH="20" NOTNULL="false"/>
        <FIELD NAME="duration_ms" TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="retain_until" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="Unix ts when this chunk becomes deletable"/>
        <FIELD NAME="deleted_at"  TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_session" TYPE="foreign" FIELDS="sessionid"
             REFTABLE="local_airpay_proctor_sessions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_session_kind"  UNIQUE="false" FIELDS="sessionid, kind"/>
        <INDEX NAME="idx_retain"        UNIQUE="false" FIELDS="retain_until, deleted_at"/>
      </INDEXES>
    </TABLE>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_proctor_reviews — human reviewer outcomes
         When a session is flagged, a reviewer is assigned and makes a
         final decision. One row per review attempt; if a session is
         re-reviewed, multiple rows can exist.
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_proctor_reviews" COMMENT="Human reviewer decisions">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="reviewer_userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="decision"     TYPE="char" LENGTH="20" NOTNULL="true"
               COMMENT="clean|warn|fail"/>
        <FIELD NAME="note"         TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_session"  TYPE="foreign" FIELDS="sessionid"
             REFTABLE="local_airpay_proctor_sessions" REFFIELDS="id"/>
        <KEY NAME="fk_reviewer" TYPE="foreign" FIELDS="reviewer_userid"
             REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_session" UNIQUE="false" FIELDS="sessionid"/>
        <INDEX NAME="idx_reviewer_time" UNIQUE="false" FIELDS="reviewer_userid, timecreated"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
