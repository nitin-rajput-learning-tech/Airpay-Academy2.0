{{!
    Airpay Reports — execute and view a saved report.
    @template local_sentientia_reports/run
}}
<style>
    [data-region="airpay-report-run"] .summary-card {
        background: var(--ap-color-bg-surface, #fff);
        border: 1px solid var(--ap-color-border, #e2e6ef);
        border-radius: 12px;
        padding: 18px 20px;
    }
    [data-region="airpay-report-run"] .summary-card .label {
        font-size: 0.75rem;
        color: #777;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }
    [data-region="airpay-report-run"] .summary-card .value {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--ap-color-primary, #0066A7);
        margin-top: 4px;
    }
    [data-region="airpay-report-run"] .results-table thead {
        background: var(--ap-color-primary, #0066A7);
        color: #fff;
    }
    [data-region="airpay-report-run"] .results-table thead th {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 12px;
    }
    [data-region="airpay-report-run"] .results-table tbody td {
        padding: 10px 12px;
        font-size: 0.9rem;
    }
    [data-region="airpay-report-run"] .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }
</style>

<div data-region="airpay-report-run">

<div class="ap-page-header mb-4">
    <a href="{{{backurl}}}" class="text-muted small text-decoration-none">
        <i class="fa fa-arrow-left fa-fw"></i> Back to Reports
    </a>
    <div class="d-flex justify-content-between align-items-start mt-2">
        <div>
            <h2 class="mb-1" style="font-weight: 700;">{{name}}</h2>
            {{#description}}<p class="text-muted mb-0">{{.}}</p>{{/description}}
            <div class="mt-2 small text-muted">
                <span class="me-3"><i class="fa fa-tag fa-fw"></i> {{typelabel}}</span>
                {{#orgname}}<span class="me-3"><i class="fa fa-sitemap fa-fw"></i> {{orgname}}</span>{{/orgname}}
                <span><i class="fa fa-clock fa-fw"></i> Generated just now</span>
            </div>
        </div>
        <div>
            {{#can_export}}
            <a href="export.php?id={{reportid}}" class="btn btn-outline-primary btn-sm">
                <i class="fa fa-download fa-fw"></i> Export CSV
            </a>
            {{/can_export}}
        </div>
    </div>
</div>

{{#has_summary}}
<div class="row mb-4">
    {{#summary}}
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="summary-card">
            <div class="label">{{label}}</div>
            <div class="value">{{value}}</div>
        </div>
    </div>
    {{/summary}}
</div>
{{/has_summary}}

{{#has_rows}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle results-table">
        <thead><tr>
            {{#columns}}
            <th class="ps-3">{{label}}</th>
            {{/columns}}
        </tr></thead>
        <tbody>
            {{#rows}}
            <tr>
                {{#cells}}
                <td class="ps-3 {{cssclass}}">{{value}}</td>
                {{/cells}}
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
{{#row_limit_reached}}
<div class="card-body bg-light border-top small text-muted text-center">
    <i class="fa fa-info-circle fa-fw"></i> Showing first {{row_count}} rows. Export CSV for the full dataset.
</div>
{{/row_limit_reached}}
</div>
{{/has_rows}}

{{^has_rows}}
<div class="card border-0 shadow-sm"><div class="card-body empty-state">
    <i class="fa fa-inbox fa-3x mb-3 d-block"></i>
    <h5 class="text-muted">No data found</h5>
    <p class="text-muted mb-0">This report returned no rows for the current scope. Adjust filters or wait for activity to accumulate.</p>
</div></div>
{{/has_rows}}

</div>
