{{!
    Cross-evaluation analysis dashboard — Kirkpatrick aggregates (G-05).

    @template local_sentientia_evaluation/analysis
    @package  local_sentientia_evaluation

    Context vars:
      levels                array of {level, level_label, evaluation_count,
                                      response_count, avg_rating, avg_rating_pct,
                                      rating_count, has_rating, rating_class,
                                      avg_nps, nps_count, has_nps, nps_score,
                                      nps_class, nps_promoters, nps_detractors}
      total_responses       int
      total_evaluations     int
      has_data              bool
      backurl               URL back to /index.php
      filter_action_url     form action
      filter_date_from      preserved value
      filter_date_to        preserved value
      filter_courseid       preserved value
      filter_programid      preserved value
      filter_classroomid    preserved value
      has_filter            bool
      reset_url             URL with no filters
}}
<style>
    [data-region="airpay-eval-analysis"] .level-card {
        background: var(--ap-color-bg-surface, #fff);
        border: 1px solid var(--ap-color-border, #e2e6ef);
        border-radius: 12px;
        padding: 24px;
        height: 100%;
    }
    [data-region="airpay-eval-analysis"] .level-card .level-num {
        background: var(--ap-color-primary, #0066A7);
        color: #fff;
        width: 40px; height: 40px;
        border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1.1rem;
        margin-bottom: 12px;
    }
    [data-region="airpay-eval-analysis"] .stat-row {
        display: flex; justify-content: space-between;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }
    [data-region="airpay-eval-analysis"] .stat-row .stat-value {
        font-weight: 700;
    }
    [data-region="airpay-eval-analysis"] .empty-bucket {
        color: #94a3b8;
        font-style: italic;
        padding: 8px 0;
    }
</style>

<div data-region="airpay-eval-analysis">

    <div class="ap-page-header mb-4 d-flex justify-content-between align-items-start">
        <div>
            <a href="{{{backurl}}}" class="text-muted small text-decoration-none">
                <i class="fa fa-arrow-left fa-fw"></i> Back to Evaluations
            </a>
            <h2 class="mb-1 mt-2" style="font-weight: 700;">Evaluation Analysis</h2>
            <p class="text-muted mb-0">
                Cross-evaluation Kirkpatrick aggregation across {{total_evaluations}}
                evaluation{{^total_evaluations}}s{{/total_evaluations}}{{#total_evaluations}}{{#single}}{{/single}}{{^single}}s{{/single}}{{/total_evaluations}}.
            </p>
        </div>
    </div>

    {{! ── Top-line totals ─────────────────────────────────────────── }}
    <div class="row mb-3">
        <div class="col-md-6 mb-2">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size: 2rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_responses}}</div>
                <div class="text-muted small text-uppercase">Total Responses</div>
            </div></div>
        </div>
        <div class="col-md-6 mb-2">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size: 2rem; font-weight: 800; color: var(--ap-color-accent, #1985DD);">{{total_evaluations}}</div>
                <div class="text-muted small text-uppercase">Evaluations Defined</div>
            </div></div>
        </div>
    </div>

    {{! ── Filter form ─────────────────────────────────────────────── }}
    <form method="get" action="{{{filter_action_url}}}" class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small mb-1 fw-semibold">From</label>
                    <input type="date" class="form-control form-control-sm"
                           name="date_from" value="{{filter_date_from}}">
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small mb-1 fw-semibold">To</label>
                    <input type="date" class="form-control form-control-sm"
                           name="date_to" value="{{filter_date_to}}">
                </div>
                <div class="col-md-2 col-sm-4">
                    <label class="form-label small mb-1 fw-semibold">Course ID</label>
                    <input type="number" class="form-control form-control-sm"
                           name="courseid" value="{{filter_courseid}}" placeholder="—" min="0">
                </div>
                <div class="col-md-2 col-sm-4">
                    <label class="form-label small mb-1 fw-semibold">Program ID</label>
                    <input type="number" class="form-control form-control-sm"
                           name="programid" value="{{filter_programid}}" placeholder="—" min="0">
                </div>
                <div class="col-md-2 col-sm-4">
                    <label class="form-label small mb-1 fw-semibold">Classroom ID</label>
                    <input type="number" class="form-control form-control-sm"
                           name="classroomid" value="{{filter_classroomid}}" placeholder="—" min="0">
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-filter fa-fw"></i> Apply filters
                </button>
                {{#has_filter}}
                <a href="{{{reset_url}}}" class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-times fa-fw"></i> Clear
                </a>
                {{/has_filter}}
            </div>
        </div>
    </form>

    {{^has_data}}{{#has_filter}}
    <div class="card border-0 shadow-sm mb-3"><div class="card-body text-center py-4">
        <i class="fa fa-search fa-2x text-muted mb-2 d-block"></i>
        <p class="text-muted mb-0">No responses match the current filter — buckets below show zeros.</p>
    </div></div>
    {{/has_filter}}{{/has_data}}

    {{! 4 Kirkpatrick level cards always render — they just show zeros
        when no responses exist for that level. Helps admins understand
        the 4-level model even on a fresh install. }}
    <div class="row">
        {{#levels}}
        <div class="col-md-6 col-lg-3 mb-3">
            <div class="level-card">
                <div class="level-num">{{level}}</div>
                <h6 class="fw-bold mb-3">{{level_label}}</h6>

                <div class="stat-row">
                    <span class="text-muted">Evaluations</span>
                    <span class="stat-value">{{evaluation_count}}</span>
                </div>
                <div class="stat-row">
                    <span class="text-muted">Responses</span>
                    <span class="stat-value">{{response_count}}</span>
                </div>

                <hr class="my-2">

                {{#has_rating}}
                <div class="stat-row">
                    <span class="text-muted">Avg rating</span>
                    <span class="stat-value {{rating_class}}">{{avg_rating}} / 5</span>
                </div>
                <div class="text-muted small">{{rating_count}} rating answer(s)</div>
                {{/has_rating}}
                {{^has_rating}}
                <div class="empty-bucket small">No rating questions answered.</div>
                {{/has_rating}}

                {{#has_nps}}
                <hr class="my-2">
                <div class="stat-row">
                    <span class="text-muted">NPS score</span>
                    <span class="stat-value {{nps_class}}">{{nps_score}}</span>
                </div>
                <div class="text-muted small">
                    {{nps_promoters}} promoters · {{nps_detractors}} detractors
                </div>
                {{/has_nps}}
            </div>
        </div>
        {{/levels}}
    </div>

</div>
