<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_request/db" VERSION="20260511"
       COMMENT="Airpay Course Requests — self-service enrolment + approval workflow.">

  <TABLES>

    <TABLE NAME="local_airpay_request" COMMENT="Course enrolment requests">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK user.id — who made the request"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK course.id — what they want enrolment in"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant root id (snapshot of user.open_path at request time)"/>
        <FIELD NAME="reason"       TYPE="text" NOTNULL="true"
               COMMENT="Why the user needs this course"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"
               COMMENT="pending|approved|rejected|cancelled|expired"/>
        <FIELD NAME="route"        TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="manager"
               COMMENT="manager|courseowner|admin — routing decision at submit time"/>
        <FIELD NAME="approver_userid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="FK user.id — current approver (may change if escalated)"/>
        <FIELD NAME="decision_note" TYPE="text" NOTNULL="false"
               COMMENT="Approver's note to the requester"/>
        <FIELD NAME="decided_by_userid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="FK user.id — who actually made the decision"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timedue"      TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="When SLA deadline hits — used by cron for escalation"/>
        <FIELD NAME="timedecided"  TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timeescalated" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user"     TYPE="foreign" FIELDS="userid"          REFTABLE="user"   REFFIELDS="id"/>
        <KEY NAME="fk_course"   TYPE="foreign" FIELDS="courseid"        REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="fk_approver" TYPE="foreign" FIELDS="approver_userid" REFTABLE="user"   REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_status"  UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="idx_approver_status" UNIQUE="false" FIELDS="approver_userid, status"/>
        <INDEX NAME="idx_costcenter"   UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_status_due"   UNIQUE="false" FIELDS="status, timedue"/>
        <INDEX NAME="idx_userid_courseid" UNIQUE="false" FIELDS="userid, courseid"
               COMMENT="Used to prevent duplicate pending requests"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
