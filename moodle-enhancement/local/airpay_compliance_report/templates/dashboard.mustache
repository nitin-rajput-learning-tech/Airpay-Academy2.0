{{!
    @template local_airpay_compliance_report/dashboard
    Compliance reporting dashboard — matrix, defaulters, scorecard, manager report.
}}
<div class="airpay-compliance-rpt">

    {{! Data Freshness Indicator }}
    {{#last_refreshed}}
    <div style="display:flex; justify-content:flex-end; align-items:center; gap:8px; margin-bottom:8px; font-size:12px; color:var(--ap-text-muted, #8896a6);">
        <i class="fa fa-clock"></i>
        <span>Data updated: {{last_refreshed}}</span>
        {{#is_stale}}<span style="color:#d97706; font-weight:600;"><i class="fa fa-exclamation-triangle"></i> Stale — refresh recommended</span>{{/is_stale}}
    </div>
    {{/last_refreshed}}

    {{! KPI Summary Bar — Phase B0 iter X: migrated to tokens-aware stat_card partial }}
    {{#has_kpi_tiles}}
    <div class="airpay-stat-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
        {{#kpi_tiles}}
        {{> theme_airpayux/components/stat_card }}
        {{/kpi_tiles}}
    </div>
    {{/has_kpi_tiles}}

    {{! ═══ FILTER BAR ═══ }}
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:16px; padding:12px 16px; background:#fff; border:1px solid #e2e6ef; border-radius:10px;">
        <span style="font-size:13px; font-weight:600; color:#5a6070;"><i class="fa fa-filter"></i> Filter:</span>
        {{#has_bus}}
        <select onchange="applyFilter('bu', this.value)" style="padding:6px 12px; border:1px solid #e2e6ef; border-radius:8px; font-size:13px; font-family:inherit;">
            <option value="0">All Business Units</option>
            {{#filter_bus}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} ({{user_count}})</option>
            {{/filter_bus}}
        </select>
        {{/has_bus}}
        {{#has_depts}}
        <select onchange="applyFilter('dept', this.value)" style="padding:6px 12px; border:1px solid #e2e6ef; border-radius:8px; font-size:13px; font-family:inherit;">
            <option value="0">All Departments</option>
            {{#filter_depts}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} ({{user_count}})</option>
            {{/filter_depts}}
        </select>
        {{/has_depts}}
        {{#has_subdepts}}
        <select onchange="applyFilter('subdept', this.value)" style="padding:6px 12px; border:1px solid #e2e6ef; border-radius:8px; font-size:13px; font-family:inherit;">
            <option value="0">All Sub-Departments</option>
            {{#filter_subdepts}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}} ({{user_count}})</option>
            {{/filter_subdepts}}
        </select>
        {{/has_subdepts}}
        {{#selected_bu}}
        <a href="{{baseurl}}?tab={{#tab_matrix}}matrix{{/tab_matrix}}{{#tab_defaulters}}defaulters{{/tab_defaulters}}{{#tab_scorecard}}scorecard{{/tab_scorecard}}{{#tab_manager}}manager{{/tab_manager}}{{#tab_config}}config{{/tab_config}}"
           style="font-size:12px; color:#dc2626; text-decoration:none;"><i class="fa fa-times"></i> Clear filters</a>
        {{/selected_bu}}
    </div>
    <script>
    function applyFilter(param, val) {
        var url = new URL(window.location.href);
        url.searchParams.set(param, val);
        // Reset child filters when parent changes.
        if (param === 'bu') { url.searchParams.delete('dept'); url.searchParams.delete('subdept'); }
        if (param === 'dept') { url.searchParams.delete('subdept'); }
        window.location = url.toString();
    }
    </script>

    {{! Tab Navigation }}
    <div class="airpay-compliance-rpt__tabs">
        <a href="{{baseurl}}?tab=matrix&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_matrix}}active{{/tab_matrix}}">Compliance Matrix</a>
        <a href="{{baseurl}}?tab=defaulters&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_defaulters}}active{{/tab_defaulters}}">Defaulters</a>
        <a href="{{baseurl}}?tab=scorecard&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_scorecard}}active{{/tab_scorecard}}">Dept Scorecard</a>
        <a href="{{baseurl}}?tab=manager&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_manager}}active{{/tab_manager}}">Manager Report</a>
        {{#is_siteadmin}}
        <a href="{{baseurl}}?tab=config" class="{{#tab_config}}active{{/tab_config}}"><i class="fa fa-cog"></i> Configure</a>
        {{/is_siteadmin}}
        <a href="{{exporturl}}" class="airpay-compliance-rpt__export"><i class="fa fa-download"></i> Export Excel</a>
    </div>

    {{! Tab Content: Compliance Matrix }}
    {{#tab_matrix}}
    {{#has_matrix}}
    <div class="airpay-compliance-rpt__table-wrap">
        <table class="airpay-compliance-rpt__table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Email</th>
                    <th>Department</th>
                    {{#matrix.courses}}
                    <th title="{{coursename}}">{{coursename}}</th>
                    {{/matrix.courses}}
                </tr>
            </thead>
            <tbody>
                {{#matrix.rows}}
                <tr class="{{#all_completed}}row-ok{{/all_completed}}">
                    <td title="{{fullname}}"><strong>{{fullname}}</strong><br><small>{{employee_id}}</small></td>
                    <td>{{email}}</td>
                    <td>{{designation}}</td>
                    {{#courses}}
                    <td><span class="badge badge-{{status_class}}">{{status_label}}</span>
                        {{#days_overdue}}<small class="text-danger">{{days_overdue}}d</small>{{/days_overdue}}</td>
                    {{/courses}}
                </tr>
                {{/matrix.rows}}
            </tbody>
        </table>
    </div>
    {{/has_matrix}}
    {{^has_matrix}}
    <p class="text-muted">{{# str }}nodata, local_airpay_compliance_report{{/ str }}</p>
    {{/has_matrix}}
    {{/tab_matrix}}

    {{! Tab Content: Defaulters }}
    {{#tab_defaulters}}
    {{#has_defaulters}}
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>Employee</th><th>Email</th><th>Course</th><th>Days Overdue</th><th>Progress</th></tr></thead>
        <tbody>
            {{#defaulters}}
            <tr>
                <td><strong>{{firstname}} {{lastname}}</strong></td>
                <td>{{email}}</td>
                <td>{{coursename}}</td>
                <td class="text-danger"><strong>{{days_overdue}} days</strong></td>
                <td>{{progress_percent}}%</td>
            </tr>
            {{/defaulters}}
        </tbody>
    </table>
    {{/has_defaulters}}
    {{/tab_defaulters}}

    {{! Tab Content: Department Scorecard }}
    {{#tab_scorecard}}
    {{#has_scorecard}}
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>Department</th><th>Total</th><th>Completed</th><th>Overdue</th><th>Rate</th><th>Status</th></tr></thead>
        <tbody>
            {{#scorecard}}
            <tr>
                <td>{{department}}</td>
                <td>{{total}}</td>
                <td>{{completed}}</td>
                <td class="{{#is_red}}text-danger font-weight-bold{{/is_red}}">{{overdue}}</td>
                <td>{{rate}}%</td>
                <td><span class="badge badge-{{#is_green}}success{{/is_green}}{{#is_amber}}warning{{/is_amber}}{{#is_red}}danger{{/is_red}}">
                    {{#is_green}}On Track{{/is_green}}{{#is_amber}}At Risk{{/is_amber}}{{#is_red}}Critical{{/is_red}}
                </span></td>
            </tr>
            {{/scorecard}}
        </tbody>
    </table>
    {{/has_scorecard}}
    {{/tab_scorecard}}

    {{! Tab Content: Manager Report }}
    {{#tab_manager}}
    {{#has_manager_report}}
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>Manager</th><th>Team Items</th><th>Completed</th><th>Overdue</th><th>Rate</th></tr></thead>
        <tbody>
            {{#manager_report}}
            <tr>
                <td><strong>{{mgr_firstname}} {{mgr_lastname}}</strong></td>
                <td>{{team_items}}</td>
                <td>{{team_completed}}</td>
                <td class="{{#team_overdue}}text-danger font-weight-bold{{/team_overdue}}">{{team_overdue}}</td>
                <td>{{team_rate}}%</td>
            </tr>
            {{/manager_report}}
        </tbody>
    </table>
    {{/has_manager_report}}
    {{/tab_manager}}

    {{! ═══ Tab Content: Configuration ═══ }}
    {{#tab_config}}
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">

        {{! Compliance Courses Management }}
        <div style="background:#fff; border:1px solid #e2e6ef; border-radius:12px; padding:20px;">
            <h3 style="font-size:16px; font-weight:700; color:#1a1a2e; margin:0 0 16px;">
                <i class="fa fa-book" style="color:#0066A7;"></i> Compliance Courses
            </h3>
            <p style="font-size:13px; color:#5a6070; margin:0 0 12px;">Courses tracked for mandatory compliance. Add or remove courses per entity.</p>

            {{! Add course form }}
            <form method="post" action="{{baseurl}}" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; padding:12px; background:#f8f9fc; border-radius:8px;">
                <input type="hidden" name="action" value="addcourse">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="tab" value="config">
                <select name="courseid" required style="flex:2; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit; min-width:180px;">
                    <option value="">Select course...</option>
                    {{#allcourses}}
                    <option value="{{id}}">{{name}}</option>
                    {{/allcourses}}
                </select>
                <select name="entityid" style="flex:1; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit;">
                    <option value="0">All Entities</option>
                    {{#filter_bus}}
                    <option value="{{id}}">{{name}}</option>
                    {{/filter_bus}}
                </select>
                <input type="number" name="days" value="30" min="1" max="365" style="width:70px; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px;" title="Deadline days">
                <button type="submit" style="padding:6px 14px; background:#0066A7; color:#fff; border:none; border-radius:6px; font-size:13px; font-weight:500; cursor:pointer;">
                    <i class="fa fa-plus"></i> Add
                </button>
            </form>

            {{! Course list }}
            {{#has_config_courses}}
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:#f8f9fc;">
                        <th style="text-align:left; padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">Course</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">Entity</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">Days</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef; text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#config_courses}}
                    <tr style="border-bottom:1px solid #f0f2f7; {{^is_active}}opacity:0.5;{{/is_active}}">
                        <td style="padding:8px 10px;"><strong>{{coursename}}</strong></td>
                        <td style="padding:8px 10px;">{{entity_name}}</td>
                        <td style="padding:8px 10px; text-align:center;">{{deadline_days}}d</td>
                        <td style="padding:8px 10px; text-align:right;">
                            {{#is_active}}
                            <a href="{{baseurl}}?action=removecourse&id={{id}}&sesskey={{sesskey}}&tab=config"
                               style="color:#dc2626; font-size:12px; text-decoration:none;"
                               onclick="return confirm('Remove this course from compliance tracking?');">
                                <i class="fa fa-times"></i> Remove
                            </a>
                            {{/is_active}}
                            {{^is_active}}
                            <span style="color:#8890a0; font-size:12px;">Inactive</span>
                            {{/is_active}}
                        </td>
                    </tr>
                    {{/config_courses}}
                </tbody>
            </table>
            {{/has_config_courses}}
        </div>

        {{! Excluded Users }}
        <div style="background:#fff; border:1px solid #e2e6ef; border-radius:12px; padding:20px;">
            <h3 style="font-size:16px; font-weight:700; color:#1a1a2e; margin:0 0 16px;">
                <i class="fa fa-user-times" style="color:#dc2626;"></i> Excluded Users
            </h3>
            <p style="font-size:13px; color:#5a6070; margin:0 0 12px;">Users excluded from all compliance tracking (operations, temp accounts, etc.).</p>

            {{! Exclude user form }}
            <form method="post" action="{{baseurl}}" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; padding:12px; background:#f8f9fc; border-radius:8px;">
                <input type="hidden" name="action" value="exclude">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="tab" value="config">
                <input type="number" name="userid" placeholder="User ID" required style="width:100px; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px;">
                <input type="text" name="reason" placeholder="Reason (e.g., Operations email)" style="flex:1; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit;">
                <button type="submit" style="padding:6px 14px; background:#dc2626; color:#fff; border:none; border-radius:6px; font-size:13px; font-weight:500; cursor:pointer;">
                    <i class="fa fa-ban"></i> Exclude
                </button>
            </form>

            {{! Excluded list }}
            {{#has_config_excluded}}
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:#f8f9fc;">
                        <th style="text-align:left; padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">User</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">Reason</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">Date</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef; text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#config_excluded}}
                    <tr style="border-bottom:1px solid #f0f2f7;">
                        <td style="padding:8px 10px;"><strong>{{fullname}}</strong><br><span style="font-size:11px; color:#8890a0;">{{email}}</span></td>
                        <td style="padding:8px 10px;">{{reason}}</td>
                        <td style="padding:8px 10px;">{{excluded_date}}</td>
                        <td style="padding:8px 10px; text-align:right;">
                            <a href="{{baseurl}}?action=include&userid={{userid}}&sesskey={{sesskey}}&tab=config"
                               style="color:#16a34a; font-size:12px; text-decoration:none;">
                                <i class="fa fa-check"></i> Re-include
                            </a>
                        </td>
                    </tr>
                    {{/config_excluded}}
                </tbody>
            </table>
            {{/has_config_excluded}}
            {{^has_config_excluded}}
            <p style="color:#8890a0; font-size:13px; text-align:center; padding:20px;">No excluded users.</p>
            {{/has_config_excluded}}
        </div>
    </div>
    {{/tab_config}}
</div>
