{{!
   Course-Skill Mapping admin page.

   Context vars:
     has_course        bool
     course            { id, fullname, shortname }
     mapped_rows[]     { id, skillid, skill_name, teaches_level, max_level,
                          category_name, category_color }
     has_mapped_rows   bool
     top_courses[]     { id, fullname, shortname, mapped_count }
     has_top_courses   bool
     skill_options[]   { id, name, max_level, category_name, category_color }
     has_skills        bool
     admin_url         string  back link
     sesskey           string
}}
<div class="ap-card mb-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div>
      <a href="{{ admin_url }}" class="text-muted text-decoration-none small">
        <i class="fa fa-chevron-left me-1"></i>Skills Management
      </a>
      <h2 class="h4 m-0 mt-1">Course-Skill Mapping</h2>
      <p class="text-muted small mb-0">
        Define which skills (and at what level) a course awards on completion.
        These mappings drive automatic skill credit when learners finish a course.
      </p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-5">
      <div class="ap-card ap-card--inset h-100">
        <div class="d-flex align-items-center mb-2">
          <h3 class="h6 m-0 me-2">Pick a course</h3>
          <span class="text-muted small">{{ top_courses.length }} shown</span>
        </div>
        <div class="mb-2">
          <label for="ap-skill-course-search" class="form-label small mb-1">Search</label>
          <input type="search" id="ap-skill-course-search"
                 class="form-control form-control-sm"
                 placeholder="Search by name or shortname"
                 aria-label="Search courses">
        </div>
        <ul id="ap-skill-course-list" class="list-group list-group-flush"
            style="max-height:380px;overflow:auto;">
          {{# top_courses }}
          <li class="list-group-item d-flex justify-content-between align-items-center
                     {{# course.id }}{{# course.id }}{{# course.id }}{{/ course.id }}{{/ course.id }}{{/ course.id }}">
            <a href="?courseid={{ id }}" class="text-decoration-none flex-grow-1">
              <div class="fw-semibold">{{ fullname }}</div>
              <div class="small text-muted">{{ shortname }}</div>
            </a>
            <span class="badge bg-secondary rounded-pill" title="Skills mapped">
              {{ mapped_count }}
            </span>
          </li>
          {{/ top_courses }}
          {{^ has_top_courses }}
          <li class="list-group-item text-muted">No visible courses found.</li>
          {{/ has_top_courses }}
        </ul>
      </div>
    </div>

    <div class="col-md-7">
      {{# has_course }}
      <div class="ap-card ap-card--inset h-100" data-region="ap-skill-course-detail"
           data-courseid="{{ course.id }}">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
          <div>
            <span class="text-muted small">Mapping skills for</span>
            <h3 class="h5 m-0 mt-1">{{ course.fullname }}</h3>
            <code class="small text-muted">{{ course.shortname }}</code>
          </div>
        </div>

        <form id="ap-skill-add-mapping" class="row g-2 align-items-end mb-3">
          <div class="col-md-6">
            <label for="ap-skill-mapping-skill" class="form-label small mb-1">Skill</label>
            <select id="ap-skill-mapping-skill" class="form-select form-select-sm">
              <option value="">— Select a skill —</option>
              {{# skill_options }}
                <option value="{{ id }}" data-max="{{ max_level }}"
                        data-name="{{ name }}">
                  {{# category_name }}[{{ category_name }}] {{/ category_name }}{{ name }}
                  &nbsp;(max L{{ max_level }})
                </option>
              {{/ skill_options }}
            </select>
          </div>
          <div class="col-md-3">
            <label for="ap-skill-mapping-level" class="form-label small mb-1">Teaches level</label>
            <select id="ap-skill-mapping-level" class="form-select form-select-sm">
              <option value="1">L1</option>
              <option value="2">L2</option>
              <option value="3" selected>L3</option>
              <option value="4">L4</option>
              <option value="5">L5</option>
            </select>
          </div>
          <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-sm btn-primary"
                    data-action="add-course-skill"
                    data-courseid="{{ course.id }}">
              <i class="fa fa-plus me-1"></i>Add mapping
            </button>
          </div>
        </form>

        <div data-region="ap-skill-mapping-rows">
          {{# has_mapped_rows }}
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Category</th>
                <th>Skill</th>
                <th style="width:130px;">Teaches level</th>
                <th style="width:90px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{# mapped_rows }}
              <tr data-rowid="{{ id }}">
                <td>
                  {{# category_name }}<span class="badge"
                    style="background-color: {{ category_color }}; color:#fff;">{{ category_name }}</span>{{/ category_name }}
                  {{^ category_name }}<em class="text-muted">No category</em>{{/ category_name }}
                </td>
                <td>{{ skill_name }}</td>
                <td>
                  <strong>L{{ teaches_level }}</strong>
                  <span class="text-muted small">/ L{{ max_level }}</span>
                </td>
                <td>
                  <button type="button" class="btn btn-sm btn-link text-danger p-1"
                          data-action="delete-course-skill"
                          data-rowid="{{ id }}"
                          data-skill="{{ skill_name }}"
                          aria-label="Delete mapping for {{ skill_name }}">
                    <i class="fa fa-trash"></i>
                  </button>
                </td>
              </tr>
              {{/ mapped_rows }}
            </tbody>
          </table>
          {{/ has_mapped_rows }}
          {{^ has_mapped_rows }}
          <div class="alert alert-secondary mb-0">
            No skills mapped to this course yet. Add one above to start crediting
            skill levels on completion.
          </div>
          {{/ has_mapped_rows }}
        </div>
      </div>
      {{/ has_course }}
      {{^ has_course }}
      <div class="ap-card ap-card--inset h-100 d-flex align-items-center justify-content-center"
           style="min-height:200px;">
        <div class="text-center text-muted">
          <i class="fa fa-link fa-2x mb-2"></i>
          <div>Select a course on the left to view or edit its skill mappings.</div>
        </div>
      </div>
      {{/ has_course }}
    </div>
  </div>
</div>
