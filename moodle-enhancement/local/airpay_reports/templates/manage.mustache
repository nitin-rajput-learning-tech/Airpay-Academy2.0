{{!
    Airpay Reports — datatable-driven admin listing.
    @template local_airpay_reports/manage
}}
<style>
    [data-region="airpay-reports"] .ap-filter-bar { background: var(--ap-color-bg-surface, #fff); border: 1px solid var(--ap-color-border, #e2e6ef); border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; }
    [data-region="airpay-reports"] .btn-group .btn.active { background: var(--ap-color-primary, #0066A7); color: #fff; border-color: var(--ap-color-primary, #0066A7); }
</style>

<div data-region="airpay-reports">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Reports</h2>
        <p class="text-muted mb-0">Saved report definitions — completion, compliance, activity, and enrolment trends.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-report">
        <i class="fa fa-plus fa-fw"></i> New Report
    </a>
    {{/can_manage}}
</div>

<div class="row mb-4">
    <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
        <div class="text-muted small text-uppercase">Total Reports</div>
    </div></div></div>
    <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active_count}}</div>
        <div class="text-muted small text-uppercase">Active</div>
    </div></div></div>
    <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{archived_count}}</div>
        <div class="text-muted small text-uppercase">Archived</div>
    </div></div></div>
    <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-accent, #0f7a73);">{{total_runs}}</div>
        <div class="text-muted small text-uppercase">Total Runs</div>
    </div></div></div>
</div>

<div class="ap-filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="small text-muted mb-1 d-block">Status</label>
            <div class="btn-group btn-group-sm" role="group" data-airpay-reports-status>
                <button type="button" class="btn btn-light active" data-status="all">All</button>
                <button type="button" class="btn btn-light"        data-status="1">Active</button>
                <button type="button" class="btn btn-light"        data-status="0">Archived</button>
            </div>
        </div>
        <div>
            <label class="small text-muted mb-1 d-block">Type</label>
            <select class="form-select form-select-sm" data-airpay-reports-type style="min-width: 200px;">
                <option value="">All types</option>
                <option value="course_completion">Course Completion</option>
                <option value="compliance_overview">Compliance Overview</option>
                <option value="user_activity">User Activity</option>
                <option value="enrolment_trend">Enrolment Trend</option>
            </select>
        </div>
    </div>
</div>

<div data-airpay-table
     data-endpoint="local_airpay_reports_list_reports"
     data-columns="{{{columns_json}}}"
     data-search-placeholder="Search report name or description…"
     data-perpage="25">
</div>

</div>

{{#js}}
require([
    'theme_airpayux/datatable',
    'local_airpay_reports/report_actions'
], function(Datatable, ReportActions) {
    Datatable.init();
    if (ReportActions && ReportActions.init) ReportActions.init();

    var root = document.querySelector('[data-airpay-table]');
    var dt = Datatable.getInstance(root);
    if (!dt) return;

    document.querySelectorAll('[data-airpay-reports-status] [data-status]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var s = e.target.dataset.status;
            document.querySelectorAll('[data-airpay-reports-status] [data-status]').forEach(function(b) {
                b.classList.toggle('active', b === e.target);
            });
            dt.setFilter('status', s);
        });
    });

    var typeSel = document.querySelector('[data-airpay-reports-type]');
    if (typeSel) {
        typeSel.addEventListener('change', function(e) {
            dt.setFilter('report_type', e.target.value);
        });
    }
});
{{/js}}
