{{!
   Manager — pending enrolment requests from direct reports.
}}
{{! B7 (2026-11-18): requests are decided on local_sentientia_request's Pending approvals.
    requests.php sends a manager with no rows here straight there; this card is for one with rows. }}
{{#approvals_url}}
<div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3" role="status">
  <div>
    <strong>{{#str}}requests_moved_title, local_sentientia_manager{{/str}}</strong>
    <div class="small">{{#str}}requests_moved_message, local_sentientia_manager{{/str}}</div>
  </div>
  <a href="{{ approvals_url }}" class="btn btn-sm btn-primary">
    <i class="fa fa-inbox me-1"></i>{{#str}}requests_open_approvals, local_sentientia_manager, {{ approvals_count }}{{/str}}
  </a>
</div>
{{/approvals_url}}
<div class="ap-card mb-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h2 class="h4 m-0">{{#approvals_url}}{{#str}}requests_earlier, local_sentientia_manager{{/str}}{{/approvals_url}}{{^approvals_url}}Enrolment Requests{{/approvals_url}}</h2>
    <div class="btn-group">
      <a href="{{ index_url }}" class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-tachometer-alt me-1"></i>Team dashboard
      </a>
      <a href="{{ allocations_url }}" class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-tasks me-1"></i>Allocations
      </a>
    </div>
  </div>

  <form id="ap-mgr-requests-filter" class="row g-2 mb-3">
    <div class="col-md-3">
      <label for="ap-mgr-status" class="form-label small mb-1">Status</label>
      <select id="ap-mgr-status" class="form-select form-select-sm">
        <option value="pending" selected>Pending</option>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
        <option value="cancelled">Cancelled</option>
        <option value="all">All</option>
      </select>
    </div>
  </form>

  <div id="ap-mgr-requests-table"
       data-region="airpay-datatable"
       data-ws-name="local_sentientia_manager_list_requests"
       data-page-size="25"
       data-columns-json="{{ columns_json }}"
       data-extra-args="{{ extra_args_json }}"></div>
</div>
