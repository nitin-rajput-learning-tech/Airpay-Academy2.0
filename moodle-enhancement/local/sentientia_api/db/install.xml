<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_api/db" VERSION="20260616"
       COMMENT="Sentientia Public API + LTI — request log, rate-limit counters, LTI registrations">
  <TABLES>

    <TABLE NAME="local_sentientia_api_log"
           COMMENT="Append-only audit of every public-API request (no response bodies, no PII).">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="FK to mdl_user.id — the token's owning user"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="BizLMS tenant root the request was scoped to"/>
        <FIELD NAME="apiversion"   TYPE="char" LENGTH="8"  NOTNULL="true" DEFAULT="v1" COMMENT="API version namespace, e.g. v1"/>
        <FIELD NAME="endpoint"     TYPE="char" LENGTH="120" NOTNULL="true" DEFAULT="" COMMENT="External function name invoked"/>
        <FIELD NAME="httpmethod"   TYPE="char" LENGTH="8"  NOTNULL="true" DEFAULT="GET" COMMENT="Logical method GET|POST"/>
        <FIELD NAME="status"       TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="200" COMMENT="Logical HTTP-style status: 200 ok, 403 denied, 429 rate-limited, 500 error"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter"  UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_user_time"   UNIQUE="false" FIELDS="userid, timecreated"/>
        <INDEX NAME="idx_endpoint"    UNIQUE="false" FIELDS="endpoint"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_rate"
           COMMENT="Fixed-window rate-limit counters per (userid, window-start).">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"      TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Unix epoch of the current fixed window's start"/>
        <FIELD NAME="hits"        TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Requests counted in this window"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_user_window" UNIQUE="true" FIELDS="userid, windowstart"
               COMMENT="One counter row per user per window"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_lti_reg"
           COMMENT="LTI 1.3 platform/tool registrations (provider + consumer). Secrets are stored hashed/PEM here, never logged.">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="costcenterid"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="BizLMS tenant this registration belongs to"/>
        <FIELD NAME="regtype"       TYPE="char" LENGTH="12"  NOTNULL="true" DEFAULT="consumer" COMMENT="consumer = we launch an external tool; provider = we are launched"/>
        <FIELD NAME="name"          TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Human label for the registration"/>
        <FIELD NAME="issuer"        TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="LTI platform issuer (iss claim)"/>
        <FIELD NAME="clientid"      TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="OIDC client_id"/>
        <FIELD NAME="deploymentid"  TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="LTI deployment_id"/>
        <FIELD NAME="authloginurl"  TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform OIDC auth login URL"/>
        <FIELD NAME="authtokenurl"  TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform OAuth2 token URL"/>
        <FIELD NAME="jwksurl"       TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform public JWKS URL for signature verification"/>
        <FIELD NAME="publickey"     TYPE="text" NOTNULL="false" COMMENT="Optional inline PEM public key (when no JWKS URL)"/>
        <FIELD NAME="enabled"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="0=disabled, 1=enabled"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter"   UNIQUE="false" FIELDS="costcenterid"/>
        <!-- No composite index on (issuer, clientid): both are char(255), so on
             utf8mb4 the combined index key (~2040 bytes) exceeds the DB limit
             (999 bytes / ~249 chars) and Moodle's XMLDB rejects it at install.
             It was only a non-unique lookup hint (not a constraint), and this
             registrations table holds a handful of rows per tenant, so the
             iss+client_id resolution scans a tiny table within the tenant scope
             (idx_costcenter) — no measurable cost. If selectivity ever matters,
             add a char(64) sha256(issuer."\n".clientid) column and index that. -->
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_lti_nonce"
           COMMENT="One-time OIDC login nonces / state for LTI launches — replay protection.">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="nonce"       TYPE="char" LENGTH="64"  NOTNULL="true" DEFAULT="" COMMENT="Random nonce value"/>
        <FIELD NAME="state"       TYPE="char" LENGTH="64"  NOTNULL="false" COMMENT="OIDC state value"/>
        <FIELD NAME="regid"       TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="FK to local_sentientia_api_lti_reg.id"/>
        <FIELD NAME="consumed"    TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0" COMMENT="0=unused, 1=already consumed"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_reg"  TYPE="foreign" FIELDS="regid" REFTABLE="local_sentientia_api_lti_reg" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_nonce" UNIQUE="true"  FIELDS="nonce"/>
        <INDEX NAME="idx_time"   UNIQUE="false" FIELDS="timecreated"
               COMMENT="Cleanup task prunes expired nonces by age"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_whsub"
           COMMENT="Outbound webhook subscriptions (ADR-030 Wave A). One HMAC secret per subscription; tenant-scoped (costcenterid 0 = all tenants of the customer).">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"   NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="customerid"   TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0" COMMENT="Sentientia customer (ADR-021); 0 = default customer"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0" COMMENT="Tenant root the subscription listens to; 0 = every tenant"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255"  NOTNULL="true" COMMENT="Human label"/>
        <FIELD NAME="url"          TYPE="char" LENGTH="1333" NOTNULL="true" COMMENT="https endpoint that receives POSTed events"/>
        <FIELD NAME="secret"       TYPE="char" LENGTH="128"  NOTNULL="true" COMMENT="Per-subscription HMAC-SHA256 signing secret (needed in clear to sign; never logged)"/>
        <FIELD NAME="events"       TYPE="char" LENGTH="255"  NOTNULL="true" COMMENT="Comma-separated subscribed event keys, e.g. course.completed,enrolment.created"/>
        <FIELD NAME="enabled"      TYPE="int"  LENGTH="1"    NOTNULL="true" DEFAULT="1" COMMENT="0=paused, 1=active"/>
        <FIELD NAME="lastsuccess"  TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0" COMMENT="Unix time of last 2xx delivery"/>
        <FIELD NAME="lastfailure"  TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0" COMMENT="Unix time of last failed attempt"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_enabled"    UNIQUE="false" FIELDS="enabled"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_whdel"
           COMMENT="Outbound webhook delivery queue + audit (ADR-030 Wave A). Retried with exponential backoff; dead-lettered after the attempt cap.">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="subid"       TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="FK to local_sentientia_api_whsub.id"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Affected user (for privacy export/delete); 0 if none"/>
        <FIELD NAME="eventkey"    TYPE="char" LENGTH="64"  NOTNULL="true" COMMENT="Event key, e.g. course.completed"/>
        <FIELD NAME="payload"     TYPE="text" NOTNULL="false" COMMENT="JSON body as sent (minimal: ids + timestamps, no names/emails)"/>
        <FIELD NAME="status"      TYPE="char" LENGTH="12"  NOTNULL="true" DEFAULT="queued" COMMENT="queued|sent|failed|dead"/>
        <FIELD NAME="attempts"    TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="0" COMMENT="Delivery attempts made so far"/>
        <FIELD NAME="nextattempt" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Unix time the drain task may next try this row"/>
        <FIELD NAME="httpstatus"  TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="0" COMMENT="Last HTTP status received (0 = transport error)"/>
        <FIELD NAME="lasterror"   TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Last failure summary (no payload echo)"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeupdated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_sub"  TYPE="foreign" FIELDS="subid" REFTABLE="local_sentientia_api_whsub" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_status_next" UNIQUE="false" FIELDS="status, nextattempt"
               COMMENT="Drain task: WHERE status IN (queued,failed) AND nextattempt at or before now"/>
        <INDEX NAME="idx_sub_time"    UNIQUE="false" FIELDS="subid, timecreated"/>
        <INDEX NAME="idx_userid"      UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_scimcli"
           COMMENT="SCIM 2.0 provisioning clients (ADR-030 Wave B): one bearer token per IdP integration, hashed at rest, tenant-bound.">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="customerid"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Sentientia customer (ADR-021); 0 = default"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Tenant root this client may provision into; 0 = all tenants (site-level client)"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Human label, e.g. Entra ID - Meridian"/>
        <FIELD NAME="tokenhash"    TYPE="char" LENGTH="64"  NOTNULL="true" COMMENT="sha256 of the bearer token; plaintext never stored"/>
        <FIELD NAME="auth"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="oauth2" COMMENT="Moodle auth plugin assigned to users this client creates"/>
        <FIELD NAME="enabled"      TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="1" COMMENT="0=disabled, 1=enabled"/>
        <FIELD NAME="ratelimit"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Per-window request budget; 0 = plugin default"/>
        <FIELD NAME="ratehits"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Hits in the current fixed window"/>
        <FIELD NAME="ratewindow"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Start of the current fixed window (unix)"/>
        <FIELD NAME="lastseen"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="Unix time of last authenticated request"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_tokenhash" UNIQUE="true"  FIELDS="tokenhash"/>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_scimmap"
           COMMENT="SCIM externalId to Moodle user mapping, per client (ADR-030 Wave B). externalid kept at 191 chars so the composite unique index stays inside the utf8mb4 key limit.">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="cliid"        TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="FK to local_sentientia_api_scimcli.id"/>
        <FIELD NAME="externalid"   TYPE="char" LENGTH="191" NOTNULL="true" COMMENT="IdP-side identifier (SCIM externalId)"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_cli"  TYPE="foreign" FIELDS="cliid"  REFTABLE="local_sentientia_api_scimcli" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_cli_ext" UNIQUE="true"  FIELDS="cliid, externalid"/>
        <!-- No separate index on userid: the fk_user foreign key already
             creates one, and XMLDB rejects a key/index pair on identical fields. -->
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
