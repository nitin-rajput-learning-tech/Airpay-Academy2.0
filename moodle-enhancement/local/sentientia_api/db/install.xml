<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_api/db" VERSION="20260616"
       COMMENT="Sentientia Public API + LTI — request log, rate-limit counters, LTI registrations">
  <TABLES>

    <TABLE NAME="local_sentientia_api_log"
           COMMENT="Append-only audit of every public-API request (no response bodies, no PII).">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="FK to mdl_user.id — the token's owning user"/>
        <FIELD NAME="costcenterid" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="BizLMS tenant root the request was scoped to"/>
        <FIELD NAME="apiversion"   TYPE="char" LENGTH="8"  NOTNULL="true" DEFAULT="v1" COMMENT="API version namespace, e.g. v1"/>
        <FIELD NAME="endpoint"     TYPE="char" LENGTH="120" NOTNULL="true" DEFAULT="" COMMENT="External function name invoked"/>
        <FIELD NAME="httpmethod"   TYPE="char" LENGTH="8"  NOTNULL="true" DEFAULT="GET" COMMENT="Logical method GET|POST"/>
        <FIELD NAME="status"       TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="200" COMMENT="Logical HTTP-style status: 200 ok, 403 denied, 429 rate-limited, 500 error"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter"  UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_user_time"   UNIQUE="false" FIELDS="userid, timecreated"/>
        <INDEX NAME="idx_endpoint"    UNIQUE="false" FIELDS="endpoint"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_rate"
           COMMENT="Fixed-window rate-limit counters per (userid, window-start).">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"      TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Unix epoch of the current fixed window's start"/>
        <FIELD NAME="hits"        TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Requests counted in this window"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_user_window" UNIQUE="true" FIELDS="userid, windowstart"
               COMMENT="One counter row per user per window"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_lti_reg"
           COMMENT="LTI 1.3 platform/tool registrations (provider + consumer). Secrets are stored hashed/PEM here, never logged.">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="costcenterid"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="BizLMS tenant this registration belongs to"/>
        <FIELD NAME="regtype"       TYPE="char" LENGTH="12"  NOTNULL="true" DEFAULT="consumer" COMMENT="consumer = we launch an external tool; provider = we are launched"/>
        <FIELD NAME="name"          TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Human label for the registration"/>
        <FIELD NAME="issuer"        TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="LTI platform issuer (iss claim)"/>
        <FIELD NAME="clientid"      TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="OIDC client_id"/>
        <FIELD NAME="deploymentid"  TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="LTI deployment_id"/>
        <FIELD NAME="authloginurl"  TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform OIDC auth login URL"/>
        <FIELD NAME="authtokenurl"  TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform OAuth2 token URL"/>
        <FIELD NAME="jwksurl"       TYPE="char" LENGTH="1333" NOTNULL="false" COMMENT="Platform public JWKS URL for signature verification"/>
        <FIELD NAME="publickey"     TYPE="text" NOTNULL="false" COMMENT="Optional inline PEM public key (when no JWKS URL)"/>
        <FIELD NAME="enabled"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="0=disabled, 1=enabled"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter"   UNIQUE="false" FIELDS="costcenterid"/>
        <!-- No composite index on (issuer, clientid): both are char(255), so on
             utf8mb4 the combined index key (~2040 bytes) exceeds the DB limit
             (999 bytes / ~249 chars) and Moodle's XMLDB rejects it at install.
             It was only a non-unique lookup hint (not a constraint), and this
             registrations table holds a handful of rows per tenant, so the
             iss+client_id resolution scans a tiny table within the tenant scope
             (idx_costcenter) — no measurable cost. If selectivity ever matters,
             add a char(64) sha256(issuer."\n".clientid) column and index that. -->
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_api_lti_nonce"
           COMMENT="One-time OIDC login nonces / state for LTI launches — replay protection.">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="nonce"       TYPE="char" LENGTH="64"  NOTNULL="true" DEFAULT="" COMMENT="Random nonce value"/>
        <FIELD NAME="state"       TYPE="char" LENGTH="64"  NOTNULL="false" COMMENT="OIDC state value"/>
        <FIELD NAME="regid"       TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0" COMMENT="FK to local_sentientia_api_lti_reg.id"/>
        <FIELD NAME="consumed"    TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="0" COMMENT="0=unused, 1=already consumed"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_reg"  TYPE="foreign" FIELDS="regid" REFTABLE="local_sentientia_api_lti_reg" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniq_nonce" UNIQUE="true"  FIELDS="nonce"/>
        <INDEX NAME="idx_time"   UNIQUE="false" FIELDS="timecreated"
               COMMENT="Cleanup task prunes expired nonces by age"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
