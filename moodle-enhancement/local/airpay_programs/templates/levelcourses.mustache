{{!
    Airpay Programs — per-level course management page.

    @template local_airpay_programs/levelcourses
    @package  local_airpay_programs

    Context vars:
      levelid             int
      programid           int
      level_name          string format_string'd
      level_position      int (1-based human-friendly)
      level_required      bool
      program_name        string format_string'd
      course_count        int
      back_url            URL back to /view.php?id=programid&tab=levels
      page_heading        string already-translated
      can_update          bool
      courses_columns_json string JSON
      extra_args_json     string JSON {levelid: N}
}}
<div data-region="airpay-level-courses"
     data-levelid="{{ levelid }}"
     data-programid="{{ programid }}">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-3">
        <div>
            <a href="{{{ back_url }}}" class="small text-muted text-decoration-none">
                <i class="fa fa-angle-left fa-fw"></i> {{# str }}back_to_program, local_airpay_programs{{/ str }} ({{ program_name }})
            </a>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">{{ page_heading }}</h2>
            <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
                <span>Level position: {{ level_position }}</span>
                <span>·</span>
                {{# level_required }}
                <span class="badge bg-danger-subtle text-danger">Required to proceed</span>
                {{/ level_required }}
                {{^ level_required }}
                <span class="badge bg-secondary-subtle text-secondary">Optional level</span>
                {{/ level_required }}
                <span>·</span>
                <span>{{ course_count }} courses assigned</span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        {{# can_update }}
        <button type="button" class="btn btn-primary btn-sm" data-action="add-level-courses">
            <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
            {{# str }}add_courses, local_airpay_programs{{/ str }}
        </button>
        {{/ can_update }}
    </div>

    <div data-airpay-table
         data-airpay-table-name="level-courses"
         data-endpoint="local_airpay_programs_list_level_courses"
         data-columns="{{ courses_columns_json }}"
         data-search-placeholder="Search course name or short name…"
         data-perpage="50"
         data-extra-args='{{ extra_args_json }}'
         data-row-actions="{{# can_update }}1{{/ can_update }}{{^ can_update }}0{{/ can_update }}">
    </div>

</div>

{{# js }}
require([
    'theme_airpayux/datatable',
    'local_airpay_programs/program_actions',
], function(Datatable, ProgramActions) {
    Datatable.init();
    if (ProgramActions && ProgramActions.initLevelCourses) {
        ProgramActions.initLevelCourses({{ levelid }});
    }
});
{{/ js }}
