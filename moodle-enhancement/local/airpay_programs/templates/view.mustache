{{!
    Airpay Programs — detail view (Overview / Levels / Users tabs).

    @template local_airpay_programs/view
    @package  local_airpay_programs

    Context vars:
      programid             int
      name                  string  format_string'd
      description           string  format_text'd HTML
      has_description       bool
      completion_rule       string
      status_label, status_css       Badge text + Bootstrap class
      level_count, enrolled_count    ints
      created_human, modified_human  strings
      back_url              URL back to /index.php
      tab_*_active          bool — exactly one of overview/levels/users true
      tab_*_url             URL to switch tabs
      can_update            bool — show "Add Level" + remove buttons
      can_enrol             bool — show "Enrol Users" + remove buttons
      levels_columns_json   string  JSON for shared datatable
      users_columns_json    string  JSON for shared datatable
      extra_args_json       string  JSON {programid: N}
}}
<div data-region="airpay-programs-view" data-programid="{{ programid }}">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-3">
        <div>
            <a href="{{{ back_url }}}" class="small text-muted text-decoration-none">
                <i class="fa fa-angle-left fa-fw"></i> {{# str }}back_to_programs, local_airpay_programs{{/ str }}
            </a>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">{{ name }}</h2>
            <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
                <span class="badge"
                      style="background-color: {{ status_color }}; color: #fff;">{{ status_label }}</span>
                <span>·</span>
                <span>{{ level_count }} levels</span>
                <span>·</span>
                <span>{{ enrolled_count }} enrolled</span>
                <span>·</span>
                <span>{{# str }}updated, local_airpay_programs{{/ str }} {{ modified_human }}</span>
            </div>
        </div>
    </div>

    {{! ── Tab nav ─────────────────────────────────────────────────────── }}
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link {{# tab_overview_active }}active{{/ tab_overview_active }}"
               href="{{{ tab_overview_url }}}"
               role="tab"
               aria-selected="{{# tab_overview_active }}true{{/ tab_overview_active }}{{^ tab_overview_active }}false{{/ tab_overview_active }}">
                <i class="fa fa-info-circle fa-fw" aria-hidden="true"></i>
                {{# str }}tab_overview, local_airpay_programs{{/ str }}
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link {{# tab_levels_active }}active{{/ tab_levels_active }}"
               href="{{{ tab_levels_url }}}"
               role="tab"
               aria-selected="{{# tab_levels_active }}true{{/ tab_levels_active }}{{^ tab_levels_active }}false{{/ tab_levels_active }}">
                <i class="fa fa-list-ol fa-fw" aria-hidden="true"></i>
                {{# str }}tab_levels, local_airpay_programs{{/ str }}
                <span class="badge bg-light text-dark ms-1">{{ level_count }}</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link {{# tab_users_active }}active{{/ tab_users_active }}"
               href="{{{ tab_users_url }}}"
               role="tab"
               aria-selected="{{# tab_users_active }}true{{/ tab_users_active }}{{^ tab_users_active }}false{{/ tab_users_active }}">
                <i class="fa fa-users fa-fw" aria-hidden="true"></i>
                {{# str }}tab_users, local_airpay_programs{{/ str }}
                <span class="badge bg-light text-dark ms-1">{{ enrolled_count }}</span>
            </a>
        </li>
    </ul>

    {{! ── Overview tab ────────────────────────────────────────────────── }}
    {{# tab_overview_active }}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            {{# has_description }}
            <h5 class="mb-2">Description</h5>
            <div class="mb-4">{{{ description }}}</div>
            {{/ has_description }}
            {{^ has_description }}
            <p class="text-muted fst-italic">{{# str }}no_description, local_airpay_programs{{/ str }}</p>
            {{/ has_description }}

            <div class="row mt-3">
                <div class="col-md-3 mb-3">
                    <div class="small text-uppercase text-muted">Levels</div>
                    <div style="font-size: 1.5rem; font-weight: 700;">{{ level_count }}</div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="small text-uppercase text-muted">Enrolled</div>
                    <div style="font-size: 1.5rem; font-weight: 700;">{{ enrolled_count }}</div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="small text-uppercase text-muted">Created</div>
                    <div>{{ created_human }}</div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="small text-uppercase text-muted">Last modified</div>
                    <div>{{ modified_human }}</div>
                </div>
            </div>

            <hr class="my-3">
            <div>
                <div class="small text-uppercase text-muted">Completion rule</div>
                <div>{{ completion_rule }}</div>
            </div>

            {{! Phase F.1 — learner progress + level lock state }}
            {{# has_user_state }}
            <hr class="my-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                <h3 class="h6 m-0">
                    <i class="fa fa-graduation-cap text-primary me-1"></i>Your progress
                </h3>
                <span class="small text-muted">
                    {{ user_state.completed_levels }}/{{ user_state.total_levels }}
                    levels · {{ user_state.overall_pct }}%
                </span>
            </div>
            <div class="progress mb-3" role="progressbar"
                 aria-valuenow="{{ user_state.overall_pct }}"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-label="Overall program progress {{ user_state.overall_pct }} percent">
                <div class="progress-bar bg-primary"
                     style="width: {{ user_state.overall_pct }}%;">
                </div>
            </div>
            <ul class="list-group list-group-flush">
                {{# user_state.levels }}
                <li class="list-group-item d-flex align-items-start
                       {{# locked }}opacity-50{{/ locked }}">
                    <div class="me-2 pt-1">
                        {{# completed }}
                        <i class="fa fa-check-circle text-success" aria-label="Completed"></i>
                        {{/ completed }}
                        {{^ completed }}{{# locked }}
                        <i class="fa fa-lock text-muted" aria-label="Locked"></i>
                        {{/ locked }}{{/ completed }}
                        {{^ completed }}{{^ locked }}
                        <i class="fa fa-circle-o text-primary" aria-label="In progress"></i>
                        {{/ locked }}{{/ completed }}
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">
                            Level {{ sortorder }}: {{ name }}
                            {{# completion_required }}<span class="badge bg-light text-muted small ms-1">required</span>{{/ completion_required }}
                            {{^ completion_required }}<span class="badge bg-light text-muted small ms-1">optional</span>{{/ completion_required }}
                        </div>
                        {{# locked }}
                        <div class="small text-muted mt-1">
                            <i class="fa fa-lock me-1"></i>Complete the previous required level to unlock.
                        </div>
                        {{/ locked }}
                        {{^ locked }}
                        <div class="small text-muted mt-1">
                            {{ mandatory_completed }}/{{ mandatory_total }} required courses
                            ({{ pct }}%)
                        </div>
                        {{/ locked }}
                    </div>
                </li>
                {{/ user_state.levels }}
            </ul>
            {{/ has_user_state }}
        </div>
    </div>
    {{/ tab_overview_active }}

    {{! ── Levels tab ──────────────────────────────────────────────────── }}
    {{# tab_levels_active }}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted small mb-0">
            Levels run sequentially. Click a level to manage its courses.
        </p>
        {{# can_update }}
        <button type="button" class="btn btn-primary btn-sm" data-action="add-level">
            <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
            {{# str }}add_level, local_airpay_programs{{/ str }}
        </button>
        {{/ can_update }}
    </div>
    <div data-airpay-table
         data-airpay-table-name="program-levels"
         data-endpoint="local_airpay_programs_list_levels"
         data-columns="{{ levels_columns_json }}"
         data-search-placeholder="Search level name or description…"
         data-perpage="50"
         data-extra-args='{{ extra_args_json }}'
         data-row-actions="{{# can_update }}1{{/ can_update }}{{^ can_update }}0{{/ can_update }}">
    </div>
    {{/ tab_levels_active }}

    {{! ── Users tab ───────────────────────────────────────────────────── }}
    {{# tab_users_active }}
    <div class="d-flex justify-content-end mb-3 gap-2">
        {{# can_enrol }}
        <button type="button" class="btn btn-outline-secondary btn-sm"
                data-action="enrol-program-cohort">
            <i class="fa fa-users fa-fw" aria-hidden="true"></i>
            Mass-enrol cohort
        </button>
        <button type="button" class="btn btn-primary btn-sm" data-action="enrol-program-users">
            <i class="fa fa-user-plus fa-fw" aria-hidden="true"></i>
            {{# str }}enrol_users, local_airpay_programs{{/ str }}
        </button>
        {{/ can_enrol }}
    </div>
    <div data-airpay-table
         data-airpay-table-name="program-users"
         data-endpoint="local_airpay_programs_list_users"
         data-columns="{{ users_columns_json }}"
         data-search-placeholder="Search by name or email…"
         data-perpage="25"
         data-extra-args='{{ extra_args_json }}'
         data-row-actions="{{# can_enrol }}1{{/ can_enrol }}{{^ can_enrol }}0{{/ can_enrol }}">
    </div>
    {{/ tab_users_active }}

</div>

{{# js }}
require([
    'theme_airpayux/datatable',
    'local_airpay_programs/program_actions',
], function(Datatable, ProgramActions) {
    Datatable.init();
    if (ProgramActions && ProgramActions.initView) {
        ProgramActions.initView({{ programid }});
    }
});
{{/ js }}
