{{!
    Airpay Certification Programs — admin management.
    @template local_airpay_programs/manage
}}
<style>
    [data-region="airpay-programs"] .dropdown-toggle.no-arrow::after { display: none !important; }
    [data-region="airpay-programs"] .dropdown-toggle.no-arrow { box-shadow: none; background: none; border: none; }
    [data-region="airpay-programs"] .dropdown-toggle.no-arrow:hover { color: var(--ap-color-primary, #0066A7) !important; }
</style>

<div data-region="airpay-programs">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Certification Programs</h2>
        <p class="text-muted mb-0">Manage multi-level certification programs with sequential course completion requirements.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-program">
        <i class="fa fa-plus fa-fw"></i> Create Program
    </a>
    {{/can_manage}}
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total}}</div>
            <div class="text-muted small text-uppercase">Total Programs</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active}}</div>
            <div class="text-muted small text-uppercase">Active</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{draft}}</div>
            <div class="text-muted small text-uppercase">Drafts</div>
        </div></div>
    </div>
</div>

{{#has_data}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Program Name</th>
            <th>Description</th>
            <th class="text-center">Levels</th>
            <th class="text-center">Enrolled</th>
            <th>Status</th>
            {{#can_manage}}<th class="text-end pe-3">Actions</th>{{/can_manage}}
        </tr></thead>
        <tbody>
            {{#programs}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td class="small text-muted" style="max-width: 350px;">{{#description}}{{.}}{{/description}}{{^description}}—{{/description}}</td>
                <td class="text-center">{{levelcount}}</td>
                <td class="text-center">{{enrolled}}</td>
                <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                {{#can_manage}}
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 dropdown-toggle no-arrow"
                                data-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="edit-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-pencil fa-fw"></i> Edit
                                </a>
                            </li>
                            {{#is_draft}}
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="publish-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-check-circle fa-fw text-success"></i> Publish
                                </a>
                            </li>
                            {{/is_draft}}
                            {{#is_active}}
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="archive-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-archive fa-fw text-warning"></i> Archive
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="draft-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-undo fa-fw text-secondary"></i> Move to Draft
                                </a>
                            </li>
                            {{/is_active}}
                            {{#is_archived}}
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="publish-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-undo fa-fw text-success"></i> Reactivate
                                </a>
                            </li>
                            {{/is_archived}}
                            {{#can_delete}}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#"
                                   data-action="delete-program" data-programid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-trash fa-fw"></i> Delete
                                </a>
                            </li>
                            {{/can_delete}}
                        </ul>
                    </div>
                </td>
                {{/can_manage}}
            </tr>
            {{/programs}}
        </tbody>
    </table>
</div></div>
{{/has_data}}

{{^has_data}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-trophy fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No certification programs yet</h5>
    <p class="text-muted mb-3">Build multi-level certification tracks that employees progress through sequentially.</p>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-program">
        <i class="fa fa-plus fa-fw"></i> Create First Program
    </a>
    {{/can_manage}}
</div></div>
{{/has_data}}

</div>
{{#js}}
require(['local_airpay_programs/program_actions'], function(ProgramActions) {
    ProgramActions.init();
});
{{/js}}
