{{!
    Airpay Certification Programs — datatable-driven admin listing.
    @template local_airpay_programs/manage
}}
<style>
    [data-region="airpay-programs"] .ap-filter-bar { background: var(--ap-color-bg-surface, #fff); border: 1px solid var(--ap-color-border, #e2e6ef); border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; }
    [data-region="airpay-programs"] .btn-group .btn.active { background: var(--ap-color-primary, #0066A7); color: #fff; border-color: var(--ap-color-primary, #0066A7); }
</style>

<div data-region="airpay-programs">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Certification Programs</h2>
        <p class="text-muted mb-0">Multi-level programmes — levels, courses, completion criteria.</p>
    </div>
    {{#can_create}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-program">
        <i class="fa fa-plus fa-fw"></i> New Program
    </a>
    {{/can_create}}
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
        <div class="text-muted small text-uppercase">Total Programs</div>
    </div></div></div>
    <div class="col-md-4 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active_count}}</div>
        <div class="text-muted small text-uppercase">Active</div>
    </div></div></div>
    <div class="col-md-4 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{completed_count}}</div>
        <div class="text-muted small text-uppercase">Completed</div>
    </div></div></div>
</div>

<div class="ap-filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="small text-muted mb-1 d-block">Status</label>
            <div class="btn-group btn-group-sm" role="group" data-airpay-programs-status>
                <button type="button" class="btn btn-light active" data-status="all">All</button>
                <button type="button" class="btn btn-light"        data-status="1">Active</button>
                <button type="button" class="btn btn-light"        data-status="2">Completed</button>
                <button type="button" class="btn btn-light"        data-status="0">Cancelled</button>
            </div>
        </div>
    </div>
</div>

<div data-airpay-table
     data-endpoint="local_airpay_programs_list_programs"
     data-columns="{{{columns_json}}}"
     data-search-placeholder="Search program name or description…"
     data-perpage="25">
</div>

</div>

{{#js}}
require([
    'theme_airpayux/datatable',
    'local_airpay_programs/program_actions'
], function(Datatable, ProgramActions) {
    Datatable.init();
    if (ProgramActions && ProgramActions.init) ProgramActions.init();

    var root = document.querySelector('[data-airpay-table]');
    var dt = Datatable.getInstance(root);
    if (!dt) return;

    document.querySelectorAll('[data-airpay-programs-status] [data-status]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var s = e.target.dataset.status;
            document.querySelectorAll('[data-airpay-programs-status] [data-status]').forEach(function(b) {
                b.classList.toggle('active', b === e.target);
            });
            dt.setFilter('status', s);
        });
    });
});
{{/js}}
