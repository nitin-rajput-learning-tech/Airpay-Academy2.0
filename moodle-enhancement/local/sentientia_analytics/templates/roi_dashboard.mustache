{{!
    @template local_sentientia_analytics/roi_dashboard

    Training ROI surface.
    Rendered only when sentientia.analytics.roi.enabled is ON.

    Context: one object, "roi", built by
    \local_sentientia_analytics\roi_calculator::export_for_template().
    Every figure arrives formatted (currency symbol, separators, units), in the
    viewer's language. (Until 2026-11-19 index.php flattened the ROI array to
    roi_roi_pct, roi_total_benefit, ... keys this template never read, so the
    card printed a lone "%" and headings with no figures.)

        roi.roi_description      - string
        roi.roi_empty            - bool: no cost to divide by, or no completion in the period
        roi.empty_state          - object for theme_sentientia/components/empty_state (when roi_empty)
        roi.can_configure        - bool: viewer may change the assumptions
        roi.settings_url         - string: admin settings page for the assumptions
        roi.uses_defaults        - bool: every assumption is still the built-in default
        roi.roi_pct_display      - string, e.g. "-73%"
        roi.roi_positive         - bool
        roi.roi_negative         - bool
        roi.summary              - string: plain-language sentence
        roi.total_benefit        - string, e.g. "₹1,250,000"
        roi.total_cost           - string
        roi.net_benefit          - string
        roi.benefits[], roi.costs[]
          .name                  - string
          .value                 - string
          .formula               - string: how the value was worked out
        roi.assumptions[]
          .assumption_label      - string
          .assumption_value      - string, with unit
          .is_default            - bool

    Example context (json):
    {
        "roi": {
            "roi_description": "Estimated return on training investment.",
            "roi_empty": false,
            "can_configure": true,
            "settings_url": "#",
            "uses_defaults": true,
            "roi_pct_display": "-73%",
            "roi_positive": false,
            "roi_negative": true,
            "summary": "For the year to date, estimated training costs exceeded estimated benefits by ₹1,000.",
            "total_benefit": "₹500",
            "total_cost": "₹1,500",
            "net_benefit": "-₹1,000",
            "benefits": [{"name": "Productivity gain", "value": "₹500", "formula": "1 completion × 1 h × ₹500 per hour"}],
            "costs": [{"name": "Platform", "value": "₹1,500", "formula": "Flat amount"}],
            "assumptions": [{"assumption_label": "Hourly rate", "assumption_value": "₹500 per hour", "is_default": true}]
        }
    }
}}
{{#roi}}
<div class="airpay-analytics__card airpay-analytics__card--roi">
    <div class="airpay-analytics__card-header">
        <h3>
            <i class="fa fa-line-chart" aria-hidden="true"></i>
            {{# str }}roi_heading, local_sentientia_analytics{{/ str }}
        </h3>
    </div>
    <p class="airpay-analytics__card-desc">{{roi_description}}</p>

    {{#roi_empty}}
    {{#empty_state}}
    {{> theme_sentientia/components/empty_state }}
    {{/empty_state}}
    {{/roi_empty}}

    {{^roi_empty}}
    {{#uses_defaults}}
    <p class="airpay-analytics__roi-notice" role="note">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        <span>{{# str }}roi_defaults_notice, local_sentientia_analytics{{/ str }}</span>
        {{#can_configure}}<a href="{{settings_url}}">{{# str }}roi_settings_link, local_sentientia_analytics{{/ str }}</a>{{/can_configure}}
    </p>
    {{/uses_defaults}}

    {{! Hero ROI number }}
    <div class="airpay-analytics__roi-hero">
        <div class="airpay-analytics__roi-score {{#roi_positive}}airpay-analytics__roi-score--positive{{/roi_positive}}{{#roi_negative}}airpay-analytics__roi-score--negative{{/roi_negative}}">
            <span class="airpay-analytics__roi-score-label">{{# str }}roi_pct, local_sentientia_analytics{{/ str }}</span>
            <span class="airpay-analytics__roi-score-value">
                {{#roi_positive}}<i class="fa fa-arrow-up" aria-hidden="true"></i>{{/roi_positive}}
                {{#roi_negative}}<i class="fa fa-arrow-down" aria-hidden="true"></i>{{/roi_negative}}
                {{roi_pct_display}}
            </span>
        </div>
        <div class="airpay-analytics__roi-summary">
            <p>{{summary}}</p>
            <p>{{# str }}roi_net_benefit, local_sentientia_analytics{{/ str }}: <strong>{{net_benefit}}</strong></p>
        </div>
    </div>

    <div class="airpay-analytics__roi-grid">

        {{! Benefit breakdown }}
        <div class="airpay-analytics__roi-panel">
            <h4>{{# str }}roi_benefits_heading, local_sentientia_analytics{{/ str }}</h4>
            <p class="airpay-analytics__roi-total airpay-analytics__roi-total--benefit">
                <span>{{# str }}roi_total_benefit, local_sentientia_analytics{{/ str }}</span>
                <strong>{{total_benefit}}</strong>
            </p>
            <table class="airpay-analytics__table airpay-analytics__table--roi">
                <tbody>
                    {{#benefits}}
                    <tr>
                        <td>{{name}}<small class="airpay-analytics__roi-formula">{{formula}}</small></td>
                        <td class="text-end"><strong>{{value}}</strong></td>
                    </tr>
                    {{/benefits}}
                </tbody>
            </table>
        </div>

        {{! Cost breakdown }}
        <div class="airpay-analytics__roi-panel">
            <h4>{{# str }}roi_costs_heading, local_sentientia_analytics{{/ str }}</h4>
            <p class="airpay-analytics__roi-total airpay-analytics__roi-total--cost">
                <span>{{# str }}roi_total_cost, local_sentientia_analytics{{/ str }}</span>
                <strong>{{total_cost}}</strong>
            </p>
            <table class="airpay-analytics__table airpay-analytics__table--roi">
                <tbody>
                    {{#costs}}
                    <tr>
                        <td>{{name}}<small class="airpay-analytics__roi-formula">{{formula}}</small></td>
                        <td class="text-end"><strong>{{value}}</strong></td>
                    </tr>
                    {{/costs}}
                </tbody>
            </table>
        </div>
    </div>

    {{! Assumptions transparency panel }}
    <details class="airpay-analytics__assumptions">
        <summary>
            <i class="fa fa-info-circle" aria-hidden="true"></i>
            {{# str }}roi_assumptions_heading, local_sentientia_analytics{{/ str }}
        </summary>
        <p class="airpay-analytics__assumptions-note">
            {{# str }}roi_assumptions_note, local_sentientia_analytics{{/ str }}
            {{#can_configure}}<a href="{{settings_url}}">{{# str }}roi_settings_link, local_sentientia_analytics{{/ str }}</a>{{/can_configure}}
        </p>
        <table class="airpay-analytics__table airpay-analytics__table--roi">
            <tbody>
                {{#assumptions}}
                <tr>
                    <td>{{assumption_label}}</td>
                    <td class="text-end">
                        <strong>{{assumption_value}}</strong>
                        {{#is_default}}<span class="airpay-analytics__roi-default">({{# str }}roi_default_marker, local_sentientia_analytics{{/ str }})</span>{{/is_default}}
                    </td>
                </tr>
                {{/assumptions}}
            </tbody>
        </table>
    </details>
    {{/roi_empty}}
</div>
{{/roi}}
