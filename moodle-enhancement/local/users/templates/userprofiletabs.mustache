{{!
    Airpay Academy — User Profile Tabs
    PRESERVES: All data-class, data-action, data-status, id attributes,
    cardPaginate AJAX loading, profiledatadisplay/profiledisplay/profileskilldatadisplay click handlers.
}}

<div class="userprfltabs_container w-full pull-left">
    <div class="ap-profile-tabs">
        <div class="ap-profile-tabs__scroll">
            {{#pluginslist}}
                {{#users}}
                <button class="ap-profile-tabs__tab ap-profile-tabs__tab--active profiledisplay"
                        data-class="users" data-action="display_userprofile" data-status="users" id="{{userid}}">
                    <i class="fa fa-user"></i>
                    <span>{{#str}}profile, local_users{{/str}}</span>
                </button>
                {{/users}}

                {{#courses}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="courses" data-action="display_courses" data-status="courses" id="{{userid}}">
                    <i class="fa fa-book"></i>
                    <span>{{#str}}courses, local_users{{/str}}</span>
                </button>
                {{/courses}}

                {{#classroom}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="classroom" data-action="display_classroom" data-status="classroom" id="{{userid}}">
                    <i class="fa fa-desktop"></i>
                    <span>{{#str}}classroom, local_users{{/str}}</span>
                </button>
                {{/classroom}}

                {{#learningplan}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="learningplan" data-action="display_learningplan" data-status="learningplan" id="{{userid}}">
                    <i class="fa fa-map"></i>
                    <span>{{#str}}learningplans, local_users{{/str}}</span>
                </button>
                {{/learningplan}}

                {{#onlineexams}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="onlineexams" data-action="display_onlineexams" data-status="onlineexams" id="{{userid}}">
                    <i class="fa fa-file-text"></i>
                    <span>{{#str}}onlineexams, local_users{{/str}}</span>
                </button>
                {{/onlineexams}}

                {{#program}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="program" data-action="display_program" data-status="program" id="{{userid}}">
                    <i class="fa fa-cubes"></i>
                    <span>{{#str}}programs, local_users{{/str}}</span>
                </button>
                {{/program}}

                {{#certification}}
                <button class="ap-profile-tabs__tab profiledatadisplay"
                        data-class="certification" data-action="display_certification" data-status="certification" id="{{userid}}">
                    <i class="fa fa-certificate"></i>
                    <span>{{#str}}certifications, local_users{{/str}}</span>
                </button>
                {{/certification}}

                {{#skills}}
                <button class="ap-profile-tabs__tab profileskilldatadisplay"
                        data-class="skillrepository" data-action="display_skillrepository" data-status="skillrepository" id="{{userid}}">
                    <i class="fa fa-line-chart"></i>
                    <span>{{#str}}competencyprogress, local_users{{/str}}</span>
                </button>
                {{/skills}}
            {{/pluginslist}}
        </div>
    </div>
</div>

{{#options}}
    <div class="w-100 pull-left" id="{{targetID}}" data-region="{{targetID}}-preview-container">
        <div data-region="{{targetID}}-count-container"></div>
        <div data-region="{{targetID}}-list-container"></div>
    </div>
{{/options}}

<div class="skillprfltabs_container w-full pull-left"></div>

<div class="tab-content w-100 pull-left">
    <div class="tab-pane active" id="profile_tab" role="tabpanel">
        {{> local_users/userprofile }}
    </div>
</div>

{{#js}}
require(['core/ajax', 'core/templates', 'jquery'], function(Ajax, Templates, $){
    // Tab active state management.
    function setActiveTab(el) {
        $('.ap-profile-tabs__tab').removeClass('ap-profile-tabs__tab--active');
        $(el).addClass('ap-profile-tabs__tab--active');
    }

    $(".profiledatadisplay").click(function(){
        if ($(this).hasClass('ap-profile-tabs__tab--active')){
            return true;
        }
        setActiveTab(this);
        $(".tab-content").css('display','none');
        $("#display_modulesdata").css('display','block');
        $(".skillprfltabs_container").css('display','none');
        var moduletype = $(this).data('status');

        var servicename = 'local_users_profile_moduledata';

        var targetid = $(this).data('action');
        var userid = $(this).attr('id');
        var options = {targetID: 'display_modulesdata',
                    templateName: "local_"+moduletype+"/userprofile",
                    methodName: servicename,
                    perPage: 4,
                    cardClass: 'col-md-6 col-12',
                    viewType: 'card'};
        var dataoptions = {moduletype: moduletype,userid:userid,contextid: 1};
        var filterdata = {};
        require(['local_costcenter/cardPaginate'], function(cardPaginate) {
            cardPaginate.reload(options, dataoptions,filterdata);
        });
    });

    $(".profiledisplay").click(function(){
        setActiveTab(this);
        $(".tab-content").css('display','block');
        $("#display_modulesdata").css('display','none');
        $(".skillprfltabs_container").css('display','none');
    });
    $(".profileskilldatadisplay").click(function(){
        if ($(this).hasClass('ap-profile-tabs__tab--active')){
            return true;
        }
        setActiveTab(this);
        $(".tab-content").css('display','none');
        $("#display_modulesdata").css('display','none');
        $(".skillprfltabs_container").css('display','block');
        var moduletype = $(this).data('status');
        var targetid = $(this).data('action');
        var userid = $(this).attr('id');
        var options = {targetID: 'display_modulesdata',
                    templateName: "local_users/userprofile",
                    methodName: "local_users_skillprofile"
                    };
        var dataoptions = {moduletype: moduletype,userid:userid,contextid: 1};
        var filterdata = {};
        var params = {};
        params.userid = userid;

        var promise = Ajax.call([{
            methodname: "local_users_skillprofile",
            args: params
        }]);
        promise[0].done(function(resp){
            Templates.render('local_users/skillprofiletabs', resp).then(function(html,js) {
                var container = $('.skillprfltabs_container');
                Templates.replaceNodeContents(container, html, js);
            });
        });
    });
});
{{/js}}
