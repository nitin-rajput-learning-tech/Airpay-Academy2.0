{{!
    @template local_sentientia_courses/enrolledusers
}}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">{{ course_name }}</h2>
            <code class="small text-muted">{{ course_short }}</code>
        </div>
        <div class="d-flex gap-2">
            {{#can_enrol}}
            <button type="button" class="btn btn-primary btn-sm"
                    data-action="enrol-user-modal" data-courseid="{{ courseid }}"
                    data-coursename="{{ course_name }}">
                <i class="fa fa-user-plus"></i> Enrol user
            </button>
            <a href="{{{ bulk_enrol_url }}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-upload"></i> Bulk enrol (CSV)
            </a>
            <a href="{{{ bulk_unenrol_url }}}" class="btn btn-outline-danger btn-sm">
                <i class="fa fa-user-times"></i> Bulk unenrol (CSV)
            </a>
            {{/can_enrol}}
            <a href="{{{ back_url }}}" class="btn btn-link"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
    </div>

    {{! KPI Summary — Phase B0+: migrated to tokens-aware stat_card partial }}
    {{#has_kpi_tiles}}
    <div class="airpay-stat-grid mb-4">
        {{#kpi_tiles}}
        {{> theme_sentientia/components/stat_card }}
        {{/kpi_tiles}}
    </div>
    {{/has_kpi_tiles}}

    <div data-region="datatable"
         data-component="local_sentientia_courses"
         data-ws-name="local_sentientia_courses_list_course_enrolments"
         data-columns="{{ columns_json }}"
         data-default-sort="lastname"
         data-default-sortdir="asc"
         data-extra-args='{{ extra_args_json }}'>
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['theme_sentientia/datatable', 'local_sentientia_courses/enrolledusers'],
    function(Datatable, Mod) {
        Datatable.init(document.querySelector('[data-region="datatable"]'));
        Mod.init({{ courseid }}, '{{ course_name }}');
    });
{{/js}}
