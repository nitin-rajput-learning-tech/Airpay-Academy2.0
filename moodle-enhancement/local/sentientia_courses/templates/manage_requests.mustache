{{!
    Airpay Courses — admin pending-requests inbox.

    @template local_sentientia_courses/manage_requests
    @package  local_sentientia_courses
    Sprint D (2026-05-13)

    Context vars:
      pending       array — one entry per pending request:
                      id, courseid, coursename, courseshort,
                      requester_name, requester_email,
                      tenant_id, tenant_name, requested_human
      has_pending   bool
      count         int
      sesskey       string
      post_url      string — POST target for both approve + reject forms
}}
<div class="airpay-courses-inbox">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">
                <i class="fa fa-inbox fa-fw text-primary"></i>
                Course-share requests
                {{# count }}
                <span class="badge bg-warning text-dark ms-2">{{ count }} pending</span>
                {{/ count }}
            </h2>
            <div class="small text-muted">
                Managers from other tenants have asked for these courses to be
                added to their tenant catalogues. Approving fires the share
                immediately; rejecting keeps the request in the history with
                your optional rationale.
            </div>
        </div>
    </div>

    {{# has_pending }}
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Requester</th>
                        <th>Tenant</th>
                        <th>Requested</th>
                        <th style="width: 260px;">Decision</th>
                    </tr>
                </thead>
                <tbody>
                    {{# pending }}
                    <tr>
                        <td>
                            <div style="font-weight: 600;">{{ coursename }}</div>
                            <div class="small text-muted"><code>{{ courseshort }}</code></div>
                        </td>
                        <td>
                            <div>{{ requester_name }}</div>
                            <div class="small text-muted">{{ requester_email }}</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary">{{ tenant_name }}</span>
                        </td>
                        <td>
                            <span class="small text-muted">{{ requested_human }}</span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <form method="POST" action="{{{ post_url }}}" class="m-0">
                                    <input type="hidden" name="sesskey"   value="{{ sesskey }}">
                                    <input type="hidden" name="action"    value="approve">
                                    <input type="hidden" name="requestid" value="{{ id }}">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fa fa-check fa-fw"></i> Approve
                                    </button>
                                </form>
                                <form method="POST" action="{{{ post_url }}}" class="m-0">
                                    <input type="hidden" name="sesskey"   value="{{ sesskey }}">
                                    <input type="hidden" name="action"    value="reject">
                                    <input type="hidden" name="requestid" value="{{ id }}">
                                    <input type="hidden" name="reason"
                                           value="" placeholder="(optional)">
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="var r=prompt('Optional rejection reason (shown to requester):'); if(r!==null){this.form.reason.value=r;return true;}return false;">
                                        <i class="fa fa-times fa-fw"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{/ pending }}
                </tbody>
            </table>
        </div>
    </div>
    {{/ has_pending }}
    {{^ has_pending }}
    <div class="alert alert-light text-center">
        <i class="fa fa-check-circle fa-fw text-success"></i>
        No pending course-share requests. You're all caught up.
    </div>
    {{/ has_pending }}

    <div class="alert alert-info mt-3" role="alert">
        <i class="fa fa-shield fa-fw"></i>
        Every approval and rejection is recorded as an audit event
        (<code>course_share_request_approved</code> / <code>course_share_request_rejected</code>).
        Approval additionally fires <code>course_share_created</code> when the
        active share row is inserted.
    </div>

</div>
