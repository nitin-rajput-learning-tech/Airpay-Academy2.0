{{!
    @template local_sentientia_cart/daily_sums

    Daily payment sums report — finance reconciliation.
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}exportreport_daily, local_sentientia_cart{{/str}}</h2>
        <a href="{{{ export_url }}}" class="btn btn-outline-primary btn-sm">
            <i class="fa fa-download"></i> CSV
        </a>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="from" class="form-control" value="{{ from }}">
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="to" class="form-control" value="{{ to }}">
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
    </form>

    <div data-region="daily-sums-table"
         data-from="{{ from }}" data-to="{{ to }}">
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['core/ajax'], function(Ajax) {
    var region = document.querySelector('[data-region="daily-sums-table"]');
    if (!region) return;
    var from = region.dataset.from;
    var to   = region.dataset.to;
    Ajax.call([{
        methodname: 'local_sentientia_cart_daily_sums',
        args: { from: from, to: to }
    }])[0].then(function(resp) {
        var rows = resp.days || [];
        if (!rows.length) {
            region.innerHTML = '<div class="alert alert-info">No ledger entries in this range.</div>';
            return;
        }
        var html = '<table class="table table-sm"><thead><tr>'
            + '<th>Date</th><th>Gateway</th><th>Currency</th>'
            + '<th class="text-end">Inflow</th><th class="text-end">Outflow</th>'
            + '<th class="text-end">Net</th><th class="text-end">Payments</th>'
            + '<th class="text-end">Refunds</th></tr></thead><tbody>';
        rows.forEach(function(r) {
            html += '<tr>'
                + '<td>' + r.day + '</td>'
                + '<td>' + r.gateway + '</td>'
                + '<td>' + r.currency + '</td>'
                + '<td class="text-end">' + r.inflow.toFixed(2) + '</td>'
                + '<td class="text-end text-danger">' + r.outflow.toFixed(2) + '</td>'
                + '<td class="text-end fw-semibold">' + r.net.toFixed(2) + '</td>'
                + '<td class="text-end">' + r.payments + '</td>'
                + '<td class="text-end">' + r.refunds + '</td>'
                + '</tr>';
        });
        html += '</tbody></table>';
        region.innerHTML = html;
    });
});
{{/js}}
