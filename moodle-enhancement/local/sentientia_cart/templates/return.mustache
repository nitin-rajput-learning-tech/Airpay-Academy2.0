{{!
    @template local_sentientia_cart/return

    Order outcome page — paid / pending / failed.
}}
<div class="airpay-return container py-4">
    {{#is_paid}}
    <div class="text-center mb-4">
        <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
        <h2 class="mt-3">{{#str}}ordersuccess, local_sentientia_cart{{/str}}</h2>
        <p class="text-muted">Order #{{ orderid }} · {{ total_str }}</p>
    </div>
    <div class="d-flex justify-content-center gap-2">
        {{#invoice_url}}
        <a href="{{{ invoice_url }}}" target="_blank" class="btn btn-outline-primary">
            <i class="fa fa-file-pdf"></i> {{#str}}downloadinvoice, local_sentientia_cart{{/str}}
        </a>
        {{/invoice_url}}
        <a href="{{{ catalog_url }}}" class="btn btn-primary">
            Start learning <i class="fa fa-arrow-right"></i>
        </a>
        <a href="{{{ history_url }}}" class="btn btn-link">View all orders</a>
    </div>
    {{/is_paid}}

    {{#is_pending}}
    <div class="text-center mb-4">
        <div class="spinner-border text-primary" role="status"></div>
        <h2 class="mt-3">{{#str}}orderpending, local_sentientia_cart{{/str}}</h2>
        <p class="text-muted">Order #{{ orderid }} · {{ total_str }}</p>
        {{#is_manual}}
        <div class="alert alert-info text-start mt-3">
            <strong>Manual payment selected.</strong> Please complete bank transfer to
            the account details emailed to you. Your courses will activate once
            payment is confirmed by our finance team (typically 24-48h).
        </div>
        {{/is_manual}}
        {{^is_manual}}
        <p class="small text-muted">If your payment was successful but this page
            keeps showing "pending", refresh in a few seconds — confirmation can
            take up to a minute.</p>
        {{/is_manual}}
    </div>
    <div class="d-flex justify-content-center">
        <a href="{{{ history_url }}}" class="btn btn-primary">View orders</a>
    </div>
    {{/is_pending}}

    {{#is_failed}}
    <div class="text-center mb-4">
        <i class="fa fa-times-circle text-danger" style="font-size: 5rem;"></i>
        <h2 class="mt-3">Payment failed</h2>
        <p class="text-muted">Order #{{ orderid }} · {{ total_str }}</p>
        <p>Your card was not charged. Please try again or contact support.</p>
    </div>
    <div class="d-flex justify-content-center">
        <a href="{{{ history_url }}}" class="btn btn-link">View orders</a>
        <a href="{{{ catalog_url }}}" class="btn btn-primary ms-2">Try again</a>
    </div>
    {{/is_failed}}
</div>
