{{!
    @template local_sentientia_cart/set_price

    Bulk course pricing page.
}}
<div class="container">
    <h2 class="mb-3">Course pricing ({{ total }} courses)</h2>
    <p class="text-muted">
        Set a non-zero price to enable purchase via cart. Set to 0 to make free.
        Pricing is stored as Moodle <code>enrol_fee</code> instances.
    </p>

    <table class="table table-hover table-sm">
        <thead>
            <tr>
                <th>Course</th>
                <th>Short name</th>
                <th>Current price</th>
                <th style="width:200px;">Update</th>
            </tr>
        </thead>
        <tbody>
        {{#rows}}
        <tr data-courseid="{{ id }}">
            <td><strong>{{ fullname }}</strong></td>
            <td><code>{{ shortname }}</code></td>
            <td>{{#has_price}}<span class="badge bg-success">{{ currency }} {{ price }}</span>{{/has_price}}
                {{^has_price}}<span class="text-muted">Free</span>{{/has_price}}
            </td>
            <td>
                <div class="input-group input-group-sm">
                    <input type="number" min="0" step="0.01" class="form-control price-input"
                           placeholder="0.00" value="{{ price }}">
                    <button class="btn btn-outline-primary" data-action="save-price"
                            data-courseid="{{ id }}">Save</button>
                </div>
            </td>
        </tr>
        {{/rows}}
        </tbody>
    </table>
</div>

{{#js}}
require(['local_sentientia_cart/set_price'], function(SetPrice) { SetPrice.init(); });
{{/js}}
