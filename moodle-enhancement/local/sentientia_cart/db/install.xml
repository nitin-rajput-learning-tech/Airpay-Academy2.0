<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_cart/db" VERSION="20260511"
       COMMENT="Airpay Cart — e-commerce for external tenants. 6 tables.">

  <TABLES>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_id — unique order ID generator
         Just an autoincrement sequence so order numbers are gap-free and
         globally unique. Order numbers are humans see this.
         Mirror of BizLMS biz_cart_id pattern.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_id" COMMENT="Order number sequence">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"
               COMMENT="Order number (human-visible)"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK user — who owns this slot"/>
        <FIELD NAME="reserved" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Timestamp when reserved"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_history — cart contents + order header
         One row per cart-stage AND per completed order. While 'open' it
         tracks the user's current cart. Once 'paid'/'failed'/'cancelled'
         it becomes the order record.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_history" COMMENT="Cart + order history">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="FK local_sentientia_cart_id.id — null until checkout"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK user.id"/>
        <FIELD NAME="costcenterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant root id derived from user.open_path top component"/>
        <FIELD NAME="items_json" TYPE="text" NOTNULL="false"
               COMMENT="JSON: [{courseid, price, name, discount_pct}] snapshot at order time"/>
        <FIELD NAME="subtotal" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="discount_amount" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="tax_amount" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="total_amount" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="INR"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="open"
               COMMENT="open|pending|paid|failed|cancelled|refunded|partial_refund|abandoned|part_cancelled (the last two only on rows imported from BizLMS)"/>
        <FIELD NAME="gateway" TYPE="char" LENGTH="30" NOTNULL="false"
               COMMENT="airpay|manual|stripe — gateway used for payment"/>
        <FIELD NAME="gateway_ref" TYPE="char" LENGTH="120" NOTNULL="false"
               COMMENT="Gateway transaction reference"/>
        <FIELD NAME="billing_name" TYPE="char" LENGTH="200" NOTNULL="false"/>
        <FIELD NAME="billing_email" TYPE="char" LENGTH="200" NOTNULL="false"/>
        <FIELD NAME="billing_phone" TYPE="char" LENGTH="40" NOTNULL="false"/>
        <FIELD NAME="billing_address" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="billing_gstn" TYPE="char" LENGTH="20" NOTNULL="false"
               COMMENT="Customer GSTN for B2B billing"/>
        <FIELD NAME="notes" TYPE="text" NOTNULL="false"
               COMMENT="Admin/staff notes"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timepaid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="legacy_source" TYPE="char" LENGTH="20" NOTNULL="false"
               COMMENT="ADR-032: bizlms on a row imported from BizLMS (frozen, admin-only history), NULL on every native row. mark_paid, mark_failed and refund refuse a row that has it."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_orderid" UNIQUE="false" FIELDS="orderid"/>
        <INDEX NAME="idx_user_status" UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_status_time" UNIQUE="false" FIELDS="status, timecreated"/>
      </INDEXES>
    </TABLE>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_ledger — IMMUTABLE financial event log
         Every payment, refund, partial-refund event is appended here.
         INSERT-ONLY by design. Used as the source of truth for finance
         reconciliation.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_ledger" COMMENT="Append-only payment ledger">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="historyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK local_sentientia_cart_history.id"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK local_sentientia_cart_id.id (denormalised for fast lookup)"/>
        <FIELD NAME="event_type" TYPE="char" LENGTH="30" NOTNULL="true"
               COMMENT="payment_received|refund_full|refund_partial|chargeback; rows imported from BizLMS also use legacy_credit_redeemed|legacy_credit_payout|legacy_credit_correction|legacy_cash_drawer|legacy_cancel_to_credit|legacy_sale_without_order|legacy_other"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="Positive for inflow, negative for refund/chargeback"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="INR"/>
        <FIELD NAME="gateway" TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="gateway_ref" TYPE="char" LENGTH="120" NOTNULL="false"/>
        <FIELD NAME="initiatedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK user.id — who initiated the event (0 = gateway webhook)"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false"
               COMMENT="Refund reason or event notes"/>
        <FIELD NAME="payload_json" TYPE="text" NOTNULL="false"
               COMMENT="Raw gateway webhook payload (audit)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_history" UNIQUE="false" FIELDS="historyid"/>
        <INDEX NAME="idx_order" UNIQUE="false" FIELDS="orderid"/>
        <INDEX NAME="idx_event_time" UNIQUE="false" FIELDS="event_type, timecreated"/>
      </INDEXES>
    </TABLE>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_credits — store credit / wallet
         Each user has a credit balance maintained here. Credits earned
         from refunds (credit-instead-of-refund), promotions, etc.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_credits" COMMENT="User credit balances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="balance" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="INR"/>
        <FIELD NAME="lifetime_earned" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lifetime_spent" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_invoices — issued invoices with sequential numbering
         GST-compliant: each invoice has unique number in our prefix
         (e.g. AIRPAY-2026-0001), date, line items, GST breakdown.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_invoices" COMMENT="Issued invoices (GST-compliant)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="historyid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="invoice_number" TYPE="char" LENGTH="50" NOTNULL="true"
               COMMENT="Human-visible invoice number e.g. AIRPAY-2026-0001"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="costcenterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="billing_name" TYPE="char" LENGTH="200" NOTNULL="true"/>
        <FIELD NAME="billing_email" TYPE="char" LENGTH="200" NOTNULL="false"/>
        <FIELD NAME="billing_phone" TYPE="char" LENGTH="40" NOTNULL="false"/>
        <FIELD NAME="billing_address" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="billing_gstn" TYPE="char" LENGTH="20" NOTNULL="false"/>
        <FIELD NAME="line_items_json" TYPE="text" NOTNULL="true"
               COMMENT="Locked snapshot of items at invoice issue"/>
        <FIELD NAME="subtotal" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true"/>
        <FIELD NAME="cgst" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="Central GST (9% of subtotal for intra-state)"/>
        <FIELD NAME="sgst" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="State GST (9% of subtotal for intra-state)"/>
        <FIELD NAME="igst" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="Integrated GST (18% of subtotal for inter-state)"/>
        <FIELD NAME="total" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="INR"/>
        <FIELD NAME="pdf_filename" TYPE="char" LENGTH="200" NOTNULL="false"
               COMMENT="Cached PDF filename in moodledata"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="issued"
               COMMENT="issued|cancelled|credit_note_issued|legacy_external (an ERPNext invoice imported from BizLMS: shown as a reference, never re-issued)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="unique_invoice_number" TYPE="unique" FIELDS="invoice_number"/>
        <KEY NAME="fk_history" TYPE="foreign" FIELDS="historyid" REFTABLE="local_sentientia_cart_history" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_time" UNIQUE="false" FIELDS="userid, timecreated"/>
        <INDEX NAME="idx_orderid" UNIQUE="false" FIELDS="orderid"/>
      </INDEXES>
    </TABLE>

    <!-- ────────────────────────────────────────────────────────────────
         local_sentientia_cart_credit_txn — BizLMS credit journal (ADR-032)
         One row per row of the BizLMS local_biz_cart_credits journal.
         Frozen, admin-only history written only by the cart importer;
         nothing in the runtime acts on it. The balance a user held at
         cutover is the local_sentientia_cart_credits row.
         ──────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_sentientia_cart_credit_txn" COMMENT="Credit transactions imported from BizLMS (frozen history)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK user.id - the credit holder"/>
        <FIELD NAME="costcenterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant root of the holder at import time; 0 when it could not be resolved"/>
        <FIELD NAME="event_type" TYPE="char" LENGTH="30" NOTNULL="true"
               COMMENT="earned_cancellation|redeemed|payout|correction|legacy_unclassified"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="Signed change of the balance"/>
        <FIELD NAME="balance_after" TYPE="number" LENGTH="14" DECIMALS="2" NOTNULL="true" DEFAULT="0"
               COMMENT="Balance after this booking, as BizLMS recorded it"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="INR"/>
        <FIELD NAME="historyid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="FK local_sentientia_cart_history.id of the order that caused it, when known"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="Order number of that order"/>
        <FIELD NAME="ledgerid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="FK local_sentientia_cart_ledger.id of the matching ledger row, when known"/>
        <FIELD NAME="initiatedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK user.id - who made the booking (BizLMS usermodified)"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_time" UNIQUE="false" FIELDS="userid, timecreated"/>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
