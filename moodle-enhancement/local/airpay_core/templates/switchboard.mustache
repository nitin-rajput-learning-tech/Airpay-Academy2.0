{{!
    The Switchboard — Phase A0 (2026-05-14) + Session 2 (2026-05-20).

    @template local_airpay_core/switchboard
    @package  local_airpay_core

    One screen, every feature flag, super-admin only.

    Session 2 / ADR-002 (2026-05-20) — added the customer-scope tab strip
    above the existing tenant-scope tab strip, gated on
    {{ customer_layer_on }}. When OFF the template renders identically
    to Phase A0.

    Context vars:
      customer_layer_on   bool    — gate flag for the customer scope layer
      customer_id         int     — currently viewed customer (0 = all)
      tenant_id           int     — currently viewed tenant root (0 = all)
      scope_label         string  — display label of current (customer, tenant) pair
      scope_banner        string  — the alert-banner copy for current scope
      is_global           bool    — true when (customer=0, tenant=0)
      is_customer_only    bool    — true when (customer>0, tenant=0)
      is_customer_tenant  bool    — true when (customer>0, tenant>0)
      is_legacy_tenant    bool    — true when (customer=0, tenant>0)
      customers           array of {id, name, url, is_active, is_default} (empty when layer OFF)
      tenants             array of {id, name, url, is_active}
      categories          array of {category, category_label, flags[]}
        each flag: {key, description, default, default_label,
                    resolved, resolved_label, is_on, is_off, is_default,
                    has_global_override, has_customer_override,
                    has_tenant_override, has_legacy_tenant_override,
                    inherits_from, inherits_from_global,
                    inherits_from_customer, inherits_from_tenant,
                    tri_state}
      sesskey             string
      post_url            string
      history_url         string
      flag_count          int
}}
<div class="airpay-switchboard">

    <div class="ap-switchboard-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">
                <i class="fa fa-toggle-on fa-fw text-primary"></i>
                The Switchboard
            </h2>
            <div class="small text-muted">
                {{ flag_count }} feature flags across the platform. Each toggle takes effect within 60 seconds.
                Every change is audit-logged with who, when, and an optional reason.
                <a href="{{{ history_url }}}">See change history →</a>
            </div>
        </div>
    </div>

    {{# customer_layer_on }}
    {{! ─── Customer tabs (Session 2 — gated) ───────────────────── }}
    <div class="mb-3">
        <div class="small text-muted text-uppercase mb-1" style="letter-spacing: 0.5px; font-weight: 600;">
            <i class="fa fa-building fa-fw"></i>
            Customer scope
        </div>
        <ul class="nav nav-pills mb-2" role="tablist">
            {{# customers }}
            <li class="nav-item">
                <a class="nav-link {{# is_active }}active{{/ is_active }}"
                   href="{{{ url }}}" role="tab">
                    {{# is_active }}<i class="fa fa-check fa-fw"></i> {{/ is_active }}
                    {{ name }}
                </a>
            </li>
            {{/ customers }}
        </ul>
    </div>
    {{/ customer_layer_on }}

    {{! ─── Tenant tabs (Phase A0 — always rendered) ────────────── }}
    <div class="mb-3">
        {{# customer_layer_on }}
        <div class="small text-muted text-uppercase mb-1" style="letter-spacing: 0.5px; font-weight: 600;">
            <i class="fa fa-users fa-fw"></i>
            Tenant scope
        </div>
        {{/ customer_layer_on }}
        <ul class="nav nav-tabs mb-2" role="tablist">
            {{# tenants }}
            <li class="nav-item">
                <a class="nav-link {{# is_active }}active{{/ is_active }}"
                   href="{{{ url }}}" role="tab">
                    {{# is_active }}<i class="fa fa-check fa-fw"></i> {{/ is_active }}
                    {{ name }}
                </a>
            </li>
            {{/ tenants }}
        </ul>
    </div>

    {{! ─── Scope banner ────────────────────────────────────────── }}
    {{# is_global }}
    <div class="alert alert-info" role="alert">
        <i class="fa fa-info-circle fa-fw"></i>
        {{{ scope_banner }}}
    </div>
    {{/ is_global }}
    {{# is_legacy_tenant }}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-info-circle fa-fw"></i>
        {{{ scope_banner }}}
    </div>
    {{/ is_legacy_tenant }}
    {{# is_customer_only }}
    <div class="alert alert-primary" role="alert">
        <i class="fa fa-building fa-fw"></i>
        {{{ scope_banner }}}
    </div>
    {{/ is_customer_only }}
    {{# is_customer_tenant }}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-info-circle fa-fw"></i>
        {{{ scope_banner }}}
    </div>
    {{/ is_customer_tenant }}

    {{! ─── Pending-changes banner (revealed by JS) ───────────────── }}
    <div class="ap-switchboard-banner sticky-top bg-warning text-dark p-3 mb-3 rounded shadow-sm"
         data-banner-region style="display: none;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fa fa-exclamation-triangle fa-fw"></i>
                <strong><span data-change-count>0</span> flag(s) modified</strong>
                — review and apply when ready.
            </div>
            <div>
                <button type="button" class="btn btn-sm btn-light me-2" data-action="discard">
                    Discard
                </button>
                <button type="button" class="btn btn-sm btn-primary" data-action="open-apply">
                    Review &amp; apply…
                </button>
            </div>
        </div>
    </div>

    {{! ─── Flag categories ────────────────────────────────────────── }}
    <form method="POST" action="{{{ post_url }}}" id="ap-switchboard-form" data-region="switchboard-form">
        <input type="hidden" name="sesskey" value="{{ sesskey }}">
        <input type="hidden" name="changes" value="{}" data-changes-payload>
        <input type="hidden" name="reason" value="" data-reason-input>

        {{# categories }}
        <section class="airpay-switchboard__category mb-4">
            <h3 class="ap-switchboard-category-title">
                {{ category_label }}
                <span class="badge bg-light text-dark ms-2">{{ flags.length }}</span>
            </h3>
            <div class="card border-0 shadow-sm">
                <ul class="list-group list-group-flush">
                    {{# flags }}
                    <li class="list-group-item ap-flag-row" data-flag-row data-flag-key="{{ key }}"
                        data-flag-tri-state="{{ tri_state }}">
                        <div class="row align-items-center g-3">
                            <div class="col-12 col-md-7">
                                <div class="ap-flag-row__key">
                                    <code>{{ key }}</code>
                                    {{# has_tenant_override }}
                                    <span class="badge bg-warning text-dark ms-2"
                                          title="This flag has a tenant-within-customer override.">tenant override</span>
                                    {{/ has_tenant_override }}
                                    {{# has_customer_override }}{{^ has_tenant_override }}
                                    <span class="badge bg-primary ms-2"
                                          title="This flag has a customer-wide override.">customer override</span>
                                    {{/ has_tenant_override }}{{/ has_customer_override }}
                                    {{# has_legacy_tenant_override }}{{^ has_tenant_override }}{{^ has_customer_override }}
                                    <span class="badge bg-warning text-dark ms-2"
                                          title="Legacy tenant override (no customer scope).">legacy tenant override</span>
                                    {{/ has_customer_override }}{{/ has_tenant_override }}{{/ has_legacy_tenant_override }}
                                    {{# has_global_override }}{{^ has_tenant_override }}{{^ has_customer_override }}{{^ has_legacy_tenant_override }}
                                    <span class="badge bg-secondary ms-2"
                                          title="This flag has a global override.">global override</span>
                                    {{/ has_legacy_tenant_override }}{{/ has_customer_override }}{{/ has_tenant_override }}{{/ has_global_override }}
                                    {{# inherits_from_customer }}
                                    <span class="badge bg-info text-dark ms-2"
                                          title="No tenant override — inheriting the customer-wide value.">inheriting customer</span>
                                    {{/ inherits_from_customer }}
                                    {{# inherits_from_tenant }}
                                    <span class="badge bg-info text-dark ms-2"
                                          title="No customer override — inheriting the legacy tenant value.">inheriting tenant</span>
                                    {{/ inherits_from_tenant }}
                                    {{# inherits_from_global }}
                                    <span class="badge bg-info text-dark ms-2"
                                          title="No customer or tenant override — inheriting the global default.">inheriting global</span>
                                    {{/ inherits_from_global }}
                                </div>
                                <div class="small text-muted mt-1">{{ description }}</div>
                                <div class="small text-muted mt-1">
                                    <i class="fa fa-cog fa-fw"></i>
                                    Default: <strong>{{ default_label }}</strong>
                                    &nbsp;·&nbsp;
                                    Current: <strong>{{ resolved_label }}</strong>
                                </div>
                            </div>
                            <div class="col-12 col-md-5">
                                <div class="btn-group w-100" role="group">
                                    <button type="button" class="btn btn-outline-success btn-sm
                                            {{# is_on }}active{{/ is_on }}"
                                            data-action="toggle-on" aria-label="Force ON for this flag">
                                        ON
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm
                                            {{# is_off }}active{{/ is_off }}"
                                            data-action="toggle-off" aria-label="Force OFF for this flag">
                                        OFF
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm
                                            {{# is_default }}active{{/ is_default }}"
                                            data-action="toggle-default"
                                            aria-label="Use registered default for this flag">
                                        Use default
                                    </button>
                                </div>
                            </div>
                        </div>
                    </li>
                    {{/ flags }}
                </ul>
            </div>
        </section>
        {{/ categories }}
    </form>

    {{! ─── Apply modal (revealed by JS) ──────────────────────────── }}
    <div class="modal fade" id="ap-apply-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Review changes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Every change is recorded in the audit log. An optional reason helps future-you remember why.</p>
                    <ul data-change-list class="list-unstyled mb-3"></ul>
                    <label class="form-label" for="ap-reason-field">Reason (optional)</label>
                    <input type="text" class="form-control" id="ap-reason-field"
                           maxlength="255"
                           placeholder="e.g. Disabling AI assistant during vendor outage">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-action="confirm-apply">
                        Apply changes
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .ap-switchboard-category-title {
        font-weight: 600; color: #1a1a2e; margin-bottom: 12px;
        font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .ap-flag-row { padding: 16px 20px; }
    .ap-flag-row__key code {
        font-size: 0.9rem; background: #f5f5f5; padding: 2px 6px;
        border-radius: 4px; color: #0066A7;
    }
    .ap-flag-row[data-flag-modified="1"] {
        background: #fffce6; border-left: 4px solid #d97706;
    }
    .airpay-switchboard__category {
        scroll-margin-top: 60px;
    }
    /* Session 2 — customer-scope tabs visually distinct from tenant tabs. */
    .airpay-switchboard .nav-pills .nav-link {
        background: #f0f4f9;
        color: #0066A7;
        font-weight: 500;
        margin-right: 4px;
    }
    .airpay-switchboard .nav-pills .nav-link.active {
        background: #0066A7;
        color: #fff;
    }
</style>

{{# js }}
require(['local_airpay_core/switchboard'], function(Switchboard) {
    Switchboard.init();
});
{{/ js }}
