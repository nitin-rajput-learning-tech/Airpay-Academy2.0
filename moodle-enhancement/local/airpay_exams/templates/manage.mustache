{{!
    Airpay Online Exams — admin exam management.
    Queries Moodle quiz activities as the exam engine.

    @template local_airpay_exams/manage
    @package  local_airpay_exams
}}

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Online Exams</h2>
        <p class="text-muted mb-0">Manage assessments, track attempts, and monitor scores across your organisation.</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
            <div class="text-muted small text-uppercase">Total Exams</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-accent, #0f7a73);">{{total_attempts}}</div>
            <div class="text-muted small text-uppercase">Total Attempts</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{total_passed}}</div>
            <div class="text-muted small text-uppercase">Completed</div>
        </div></div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body py-3">
    <form method="get" action="{{{filter_url}}}" class="d-flex flex-wrap align-items-end gap-3">
        <div class="flex-grow-1" style="min-width: 180px;">
            <label class="small text-muted mb-1 d-block">Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fa fa-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Exam or course name..." value="{{search}}">
            </div>
        </div>
        {{#has_org_options}}
        <div style="min-width: 160px;">
            <label class="small text-muted mb-1 d-block">Organisation</label>
            <select name="orgid" class="form-select form-select-sm">
                <option value="0">All</option>
                {{#org_options}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/org_options}}
            </select>
        </div>
        {{/has_org_options}}
        <div style="min-width: 120px;">
            <label class="small text-muted mb-1 d-block">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="all" {{#status_all}}selected{{/status_all}}>All</option>
                <option value="open" {{#status_open}}selected{{/status_open}}>Open</option>
                <option value="closed" {{#status_closed}}selected{{/status_closed}}>Closed</option>
            </select>
        </div>
        <div><button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-filter fa-fw"></i> Filter</button></div>
    </form>
</div></div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        {{#has_exams}}Showing {{showing_from}}&ndash;{{showing_to}} of {{filtered_count}} exams{{/has_exams}}
        {{^has_exams}}No exams found{{/has_exams}}
    </span>
</div>

{{#has_exams}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Exam Name</th>
            <th>Course</th>
            <th>Organisation</th>
            <th class="text-center">Attempts</th>
            <th class="text-center">Completed</th>
            <th class="text-center">Avg Score</th>
            <th>Time Limit</th>
            <th>Closes</th>
            <th>Status</th>
            {{#can_manage}}<th class="text-end pe-3">Actions</th>{{/can_manage}}
        </tr></thead>
        <tbody>
            {{#exams}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td class="small">{{coursename}}</td>
                <td class="small">{{orgname}}</td>
                <td class="text-center">{{attempts}}</td>
                <td class="text-center">{{finished}}</td>
                <td class="text-center fw-semibold">{{avg_score}}</td>
                <td class="small">{{timelimit}}</td>
                <td class="text-muted small">{{closes}}</td>
                <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                {{#can_manage}}
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{{viewurl}}}"><i class="fa fa-eye fa-fw"></i> Preview</a></li>
                            <li><a class="dropdown-item" href="{{{editurl}}}"><i class="fa fa-pencil fa-fw"></i> Edit</a></li>
                            <li><a class="dropdown-item" href="{{{reporturl}}}"><i class="fa fa-chart-bar fa-fw"></i> Results</a></li>
                        </ul>
                    </div>
                </td>
                {{/can_manage}}
            </tr>
            {{/exams}}
        </tbody>
    </table>
</div></div>
{{/has_exams}}

{{^has_exams}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-edit fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No exams found</h5>
    <p class="text-muted mb-0">Create quiz activities within courses to use as online exams.</p>
</div></div>
{{/has_exams}}

{{#has_pagination}}
<nav class="mt-3 d-flex justify-content-center"><ul class="pagination pagination-sm">
    {{#has_prev}}<li class="page-item"><a class="page-link" href="{{{prev_url}}}">&laquo;</a></li>{{/has_prev}}
    {{#pagination_pages}}<li class="page-item {{#isactive}}active{{/isactive}}"><a class="page-link" href="{{{url}}}">{{pagenum}}</a></li>{{/pagination_pages}}
    {{#has_next}}<li class="page-item"><a class="page-link" href="{{{next_url}}}">&raquo;</a></li>{{/has_next}}
</ul></nav>
{{/has_pagination}}
