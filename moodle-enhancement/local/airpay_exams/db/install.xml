<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_exams/db" VERSION="20260416"
       COMMENT="Airpay Online Exams — replaces BizLMS local_onlinetests">
  <TABLES>
    <TABLE NAME="local_airpay_exams" COMMENT="Online exam records (fork of local_onlinetests)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="254" NOTNULL="true"/>
        <FIELD NAME="quizid"          TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK to mdl_quiz.id — the underlying Moodle quiz"/>
        <FIELD NAME="costcenterid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant org ID"/>
        <FIELD NAME="departmentid"    TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="categoryid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="P1 #23: tagging — references mdl_course_categories.id (same taxonomy as courses). 0 = uncategorised."/>
        <FIELD NAME="open_path"       TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="duration"        TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Exam duration in seconds"/>
        <FIELD NAME="passinggrade"    TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="1"
               COMMENT="1=active, 0=inactive"/>
        <FIELD NAME="visible"         TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_quiz"  TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_quizid"     UNIQUE="false" FIELDS="quizid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
