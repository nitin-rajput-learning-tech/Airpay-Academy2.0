<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_exams/db" VERSION="20260416"
       COMMENT="Airpay Online Exams — replaces BizLMS local_onlinetests">
  <TABLES>
    <TABLE NAME="local_airpay_exams" COMMENT="Online exam records (fork of local_onlinetests)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="254" NOTNULL="true"/>
        <FIELD NAME="quizid"          TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK to mdl_quiz.id — the underlying Moodle quiz"/>
        <FIELD NAME="costcenterid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant org ID"/>
        <FIELD NAME="departmentid"    TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="categoryid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="P1 #23: tagging — references mdl_course_categories.id (same taxonomy as courses). 0 = uncategorised."/>
        <FIELD NAME="open_path"       TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="duration"        TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Exam duration in seconds"/>
        <FIELD NAME="passinggrade"    TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="1"
               COMMENT="1=active, 0=inactive"/>
        <FIELD NAME="visible"         TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_quiz"  TYPE="foreign" FIELDS="quizid" REFTABLE="quiz" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_quizid"     UNIQUE="false" FIELDS="quizid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_exams_remind_sent"
           COMMENT="P1 #33: tracks every deadline-reminder notification fired by the exam_reminder scheduled task. Schema mirrors P1 #28's local_airpay_courses_remind_sent but keyed on the exam id (which wraps a quiz) instead of a course id. Closes audit item #16 from parity-audit-2026-05-15/airpay_exams.md.">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"      TYPE="int" LENGTH="10" NOTNULL="true"
               COMMENT="User who received the reminder"/>
        <FIELD NAME="examid"      TYPE="int" LENGTH="10" NOTNULL="true"
               COMMENT="FK to local_airpay_exams.id (NOT the quiz id)"/>
        <FIELD NAME="days_before_deadline" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"
               COMMENT="Which bucket fired (e.g. 7, 3, 1). One row per (user × exam × bucket × deadline) tuple."/>
        <FIELD NAME="deadline_ts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Unix ts of quiz.timeclose at send time. Including this in the dedupe key means an admin re-opening the quiz (new timeclose) starts a fresh reminder cycle."/>
        <FIELD NAME="timesent"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_exam" TYPE="foreign" FIELDS="examid" REFTABLE="local_airpay_exams" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_exam_bucket" UNIQUE="true"
               FIELDS="userid, examid, days_before_deadline, deadline_ts"
               COMMENT="Dedupe key"/>
        <INDEX NAME="idx_timesent" UNIQUE="false" FIELDS="timesent"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
