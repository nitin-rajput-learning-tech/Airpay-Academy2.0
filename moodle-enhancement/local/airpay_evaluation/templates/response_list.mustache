{{!
    @template local_airpay_evaluation/response_list
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">{{ eval_name }}</h2>
            <div class="small text-muted">
                {{ total }} individual responses
                {{#is_anonymous}}· <span class="badge bg-info">Anonymous</span>{{/is_anonymous}}
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="{{{ aggregate_url }}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-bar-chart"></i> Aggregate view
            </a>
            <a href="{{{ analysis_url }}}" class="btn btn-outline-primary btn-sm">
                <i class="fa fa-chart-bar"></i> Analysis
            </a>
        </div>
    </div>

    {{#has_rows}}
    <table class="table table-hover">
        <thead><tr>
            <th>#</th>
            <th>Submitted</th>
            {{^is_anonymous}}<th>Respondent</th>{{/is_anonymous}}
            <th>Context</th>
            <th></th>
        </tr></thead>
        <tbody>
            {{#rows}}
            <tr>
                <td><code>#{{ id }}</code></td>
                <td class="small">{{ submitted_at }}</td>
                {{^is_anonymous}}
                <td>
                    <strong>{{ user_name }}</strong>
                    {{#user_email}}<br><code class="small">{{ user_email }}</code>{{/user_email}}
                </td>
                {{/is_anonymous}}
                <td class="small text-muted">{{ context }}</td>
                <td>
                    <a href="{{{ detail_url }}}" class="btn btn-sm btn-link">
                        <i class="fa fa-eye"></i> Drill-down
                    </a>
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    {{/has_rows}}
    {{^has_rows}}
    <div class="alert alert-info">No responses submitted yet.</div>
    {{/has_rows}}
</div>
