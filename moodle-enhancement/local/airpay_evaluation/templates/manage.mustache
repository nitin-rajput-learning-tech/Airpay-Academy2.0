{{!
    Airpay Training Evaluations — feedback form management.
    @template local_airpay_evaluation/manage
}}

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Training Evaluations</h2>
        <p class="text-muted mb-0">Manage post-training feedback forms and Kirkpatrick evaluation surveys.</p>
    </div>
    <a href="#" class="btn btn-primary btn-sm"><i class="fa fa-plus fa-fw"></i> Create Evaluation</a>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total}}</div>
            <div class="text-muted small text-uppercase">Custom Evaluations</div>
        </div></div>
    </div>
    <div class="col-md-6 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-accent, #0f7a73);">{{feedback_count}}</div>
            <div class="text-muted small text-uppercase">Moodle Feedback Activities</div>
        </div></div>
    </div>
</div>

{{#has_evals}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Evaluation Name</th>
            <th class="text-end pe-3">Actions</th>
        </tr></thead>
        <tbody>
            {{#evals}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td class="text-end pe-3">
                    <a href="#" class="btn btn-sm btn-outline-secondary"><i class="fa fa-eye fa-fw"></i> View</a>
                </td>
            </tr>
            {{/evals}}
        </tbody>
    </table>
</div></div>
{{/has_evals}}

{{^has_evals}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-clipboard fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No custom evaluations yet</h5>
    <p class="text-muted mb-3">Create post-training feedback forms to measure learner satisfaction and training effectiveness.</p>
    {{#has_feedback}}
    <p class="text-muted small">You have {{feedback_count}} Moodle Feedback activities that can be used for course-level evaluations.</p>
    {{/has_feedback}}
    <a href="#" class="btn btn-primary btn-sm"><i class="fa fa-plus fa-fw"></i> Create First Evaluation</a>
</div></div>
{{/has_evals}}
