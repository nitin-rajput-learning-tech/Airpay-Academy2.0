<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_ai/db" VERSION="20260804"
       COMMENT="Sentientia AI Gateway - spend ledger">
  <TABLES>
    <TABLE NAME="local_sentientia_ai_ledger"
           COMMENT="One row per gateway call (mock, live, failed, denied). The spend/quota source of truth.">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"
               COMMENT="Primary key"/>
        <FIELD NAME="component"        TYPE="char"   LENGTH="100" NOTNULL="true"
               COMMENT="Calling plugin frankenstyle, e.g. local_sentientia_aiquiz"/>
        <FIELD NAME="purpose"          TYPE="char"   LENGTH="100" NOTNULL="true" DEFAULT=""
               COMMENT="Component-declared purpose slug, e.g. quiz_generation"/>
        <FIELD NAME="userid"           TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="FK to mdl_user.id - the user whose action triggered the call"/>
        <FIELD NAME="customerid"       TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="1"
               COMMENT="Sentientia customer id (Phase 0: 1=Airpay)"/>
        <FIELD NAME="tenantid"         TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="BizLMS costcenter tenant id (1/77/177), 0=unscoped/CLI"/>
        <FIELD NAME="model"            TYPE="char"   LENGTH="100" NOTNULL="true" DEFAULT=""
               COMMENT="Model identifier used (empty for mock)"/>
        <FIELD NAME="prompttokens"     TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Input tokens reported by the API (0 for mock)"/>
        <FIELD NAME="completiontokens" TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Output tokens reported by the API (0 for mock)"/>
        <FIELD NAME="estcost"          TYPE="number" LENGTH="12"  DECIMALS="6" NOTNULL="true" DEFAULT="0"
               COMMENT="ESTIMATED cost in USD from the pricing map - budgeting signal, not an invoice"/>
        <FIELD NAME="mode"             TYPE="char"   LENGTH="10"  NOTNULL="true"
               COMMENT="mock | live | failed | denied"/>
        <FIELD NAME="error"            TYPE="char"   LENGTH="255" NOTNULL="true" DEFAULT=""
               COMMENT="Failure/denial reason (never contains the API key)"/>
        <FIELD NAME="timecreated"      TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_component"        UNIQUE="false" FIELDS="component"
               COMMENT="Per-feature spend reporting"/>
        <INDEX NAME="idx_timecreated"      UNIQUE="false" FIELDS="timecreated"
               COMMENT="Daily/monthly quota window scans"/>
        <INDEX NAME="idx_customer_time"    UNIQUE="false" FIELDS="customerid, timecreated"
               COMMENT="Per-customer quota window scans"/>
        <INDEX NAME="idx_userid"           UNIQUE="false" FIELDS="userid"
               COMMENT="Privacy provider export/delete lookups"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
