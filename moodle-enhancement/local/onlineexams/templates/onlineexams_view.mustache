{{#response}}
{{#viewtypeCard}}
<div class="ap-exam-grid">
    {{#records}}
    {{#hascourses}}
    <div class="{{cardClass}} catcourses_list {{course_class}}">
        <div class="ap-exam-card">

            {{! ═══ IMAGE HEADER with stats overlay + actions ═══ }}
            <div class="ap-exam-card__image-section">
                <div class="ap-exam-card__image" style="background-image: url('{{{courseimage}}}');" title="{{coursename}}">

                    {{! Action dropdown (gear icon) }}
                    {{#actions}}
                    <div class="dropdown ap-exam-card__actions">
                        <button data-toggle="dropdown" aria-expanded="false" class="ap-exam-card__action-btn">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            {{#update}}
                            {{#editcourse}}{{{editcourse}}}{{/editcourse}}
                            {{/update}}
                            {{#update}}
                            {{#auto_enrol}}
                            <a href="{{auto_enrol}}" class="dropdown-item" title="{{#str}}auto_enrol, local_onlineexams{{/str}}">
                                <i class="fa fa-user-circle-o fa-fw"></i> Auto Enrol
                            </a>
                            {{/auto_enrol}}
                            {{/update}}
                            {{#enrol}}
                            <a href="{{enrollusers}}" class="dropdown-item" title="{{#str}}userenrolments, local_onlineexams{{/str}}">
                                <i class="fa fa-user fa-fw"></i> User Enrollments
                            </a>
                            {{/enrol}}
                            {{#update}}
                            {{#update_status}}{{{update_status}}}{{/update_status}}
                            {{/update}}
                            {{#deleteaction}}{{{deleteaction}}}{{/deleteaction}}
                        </div>
                    </div>
                    {{/actions}}

                    {{! Stats overlay at bottom of image }}
                    <div class="ap-exam-card__stats-overlay">
                        <div class="ap-exam-card__stat">
                            <i class="fa fa-users"></i>
                            <span>{{enrolled_count}}</span>
                            <small>Enrolled</small>
                        </div>
                        <div class="ap-exam-card__stat">
                            <i class="fa fa-check-circle"></i>
                            <span>{{completed_count}}</span>
                            <small>Passed</small>
                        </div>
                    </div>
                </div>
            </div>

            {{! ═══ CARD BODY ═══ }}
            <div class="ap-exam-card__body">
                {{! Exam name }}
                <h4 class="ap-exam-card__title">
                    {{^coursenameCut}}
                    <a href="{{courseurl}}" title="{{coursename}}">{{coursename}}</a>
                    {{/coursenameCut}}
                    {{#coursenameCut}}
                    <a href="{{courseurl}}" title="{{coursename}}">{{coursenameCut}}</a>
                    {{/coursenameCut}}
                </h4>

                {{! Description }}
                {{#onlineexamsummary}}
                <p class="ap-exam-card__desc">{{onlineexamsummary}}</p>
                {{/onlineexamsummary}}
                {{^onlineexamsummary}}
                <p class="ap-exam-card__desc ap-exam-card__desc--empty">{{#str}}noonlineexamdesc, local_onlineexams{{/str}}</p>
                {{/onlineexamsummary}}

                {{! Exam meta: grades + dates }}
                <div class="ap-exam-card__meta">
                    <div class="ap-exam-card__meta-row">
                        <div class="ap-exam-card__meta-item">
                            <i class="fa fa-trophy"></i>
                            <span>Max: <strong>{{maxgrade}}</strong></span>
                        </div>
                        <div class="ap-exam-card__meta-item">
                            <i class="fa fa-star-o"></i>
                            <span>Pass: <strong>{{passgrade}}</strong></span>
                        </div>
                    </div>
                    <div class="ap-exam-card__date">
                        <i class="fa fa-calendar"></i>
                        {{examfromdate}} — {{examtodate}}
                    </div>
                </div>

                {{! Start Exam CTA }}
                <a href="{{courseurl}}" class="ap-exam-card__cta">
                    <i class="fa fa-pencil-square-o"></i> Start Exam
                </a>
            </div>
        </div>
    </div>
    {{/hascourses}}
    <div class="col-md-12">{{{pagination}}}</div>
    {{#nocourses}}
    <div class="ap-exam-grid__empty">
        <i class="fa fa-pencil-square-o"></i>
        <p>No exams available.</p>
    </div>
    {{/nocourses}}
    {{/records}}
</div>
{{/viewtypeCard}}
{{/response}}

<style>
/* ═══ Modern Online Exam Cards ═══ */
.ap-exam-grid { display: flex; flex-wrap: wrap; gap: 0; }
.ap-exam-card {
    background: var(--ap-surface, #fff);
    border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex; flex-direction: column;
    margin-bottom: 16px; height: 100%;
}
.ap-exam-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,51,102,0.1);
}

/* Image header */
.ap-exam-card__image-section { position: relative; }
.ap-exam-card__image {
    height: 160px; background-size: cover; background-position: center;
    background-color: #e8f2f9; position: relative;
    display: flex; flex-direction: column; justify-content: space-between;
}

/* Action button on image */
.ap-exam-card__actions { position: absolute; top: 8px; right: 8px; }
.ap-exam-card__action-btn {
    width: 32px; height: 32px; border-radius: 8px;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    border: none; color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
}
.ap-exam-card__action-btn:hover { background: rgba(0,0,0,0.7); }
.ap-exam-card .dropdown-menu {
    border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border: 1px solid #e3eaf3; padding: 6px; min-width: 180px;
}
.ap-exam-card .dropdown-item {
    border-radius: 6px; padding: 8px 12px; font-size: 13px;
    transition: background 0.1s;
}
.ap-exam-card .dropdown-item:hover { background: #e8f2f9; }

/* Stats overlay at bottom of image */
.ap-exam-card__stats-overlay {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; gap: 0;
    background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
}
.ap-exam-card__stat {
    flex: 1; display: flex; align-items: center; gap: 6px;
    padding: 8px 12px; color: #fff; font-size: 12px;
}
.ap-exam-card__stat i { font-size: 11px; opacity: 0.8; }
.ap-exam-card__stat span { font-weight: 700; font-size: 14px; }
.ap-exam-card__stat small { font-size: 10px; opacity: 0.7; }
.ap-exam-card__stat + .ap-exam-card__stat {
    border-left: 1px solid rgba(255,255,255,0.2);
}

/* Card body */
.ap-exam-card__body { padding: 14px 16px 16px; flex: 1; display: flex; flex-direction: column; }
.ap-exam-card__title {
    margin: 0 0 8px; font-size: 15px; font-weight: 700; line-height: 1.3;
}
.ap-exam-card__title a {
    color: #1a1a2e; text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ap-exam-card__title a:hover { color: #0066A7; }
.ap-exam-card__desc {
    font-size: 13px; color: #607286; line-height: 1.5; margin: 0 0 12px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    flex: 1;
}
.ap-exam-card__desc--empty { color: #8896a6; font-style: italic; }

/* Meta section */
.ap-exam-card__meta { margin-bottom: 12px; }
.ap-exam-card__meta-row { display: flex; gap: 16px; margin-bottom: 6px; }
.ap-exam-card__meta-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; color: #607286;
}
.ap-exam-card__meta-item i { color: #d97706; font-size: 12px; }
.ap-exam-card__meta-item strong { color: #1a1a2e; }
.ap-exam-card__date {
    font-size: 12px; color: #8896a6;
}
.ap-exam-card__date i { margin-right: 4px; color: #0066A7; }

/* Start Exam CTA */
.ap-exam-card__cta {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: 10px; margin-top: auto;
    background: linear-gradient(135deg, #0066A7, #0f7a73);
    color: #fff; border-radius: 8px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    transition: opacity 0.15s;
}
.ap-exam-card__cta:hover { opacity: 0.9; color: #fff; text-decoration: none; }

/* Empty state */
.ap-exam-grid__empty {
    width: 100%; text-align: center; padding: 48px 24px; color: #8896a6;
}
.ap-exam-grid__empty i { font-size: 48px; margin-bottom: 12px; display: block; opacity: 0.4; }

/* Mobile */
@media (max-width: 590px) {
    .ap-exam-card__image { height: 120px; }
    .ap-exam-card__stats-overlay { flex-direction: row; }
}

/* Dark mode */
body.dark-mode .ap-exam-card { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-exam-card:hover { box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
body.dark-mode .ap-exam-card__title a { color: #e8eaed; }
body.dark-mode .ap-exam-card__desc { color: #9ca3b4; }
body.dark-mode .ap-exam-card__meta-item { color: #9ca3b4; }
body.dark-mode .ap-exam-card__meta-item strong { color: #e8eaed; }
body.dark-mode .ap-exam-card .dropdown-menu { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-exam-card .dropdown-item:hover { background: #22252f; }
</style>
