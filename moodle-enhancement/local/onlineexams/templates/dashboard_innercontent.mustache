{{#onlineexams_view_count}}
{{#card_view}}
<div class="userdashboard_content">
    <div id="{{{subtab}}}" class="tab-pane divslider active active_subtab">
    <div class="ap-dash-courses userdashboard_content userdashboard_ctype_elearning">
        {{#moduledetails}}
        <div class="col-sm-4 col-12 tabs_cmn_class onlineexams_inprogress_slide {{{subtab}}} {{indexClass}} ctype_elearning d-flex" data-index="{{index}}">
            <div class="ap-dash-course-card">
                <a href="{{{course_url}}}" class="ap-dash-course-card__image-link">
                    <div class="ap-dash-course-card__image" style="background-image:url('{{course_image_url}}');">
                        <div class="ap-dash-course-card__exam-badge">
                            <i class="fa fa-pencil-square-o"></i> Exam
                        </div>
                    </div>
                </a>
                <div class="ap-dash-course-card__content">
                    <div class="ap-dash-course-card__top">
                        <h4 class="ap-dash-course-card__title">
                            <a href="{{course_url}}" title="{{{course_fullname}}}">{{course_fullname}}</a>
                        </h4>
                        {{#onlineexamsummary}}
                        <p class="ap-dash-course-card__desc">{{{onlineexamsummary}}}</p>
                        {{/onlineexamsummary}}
                        {{#fullonlineexamsummary}}
                        <a href="#" data-toggle="popover" title="{{course_fullname}}" data-content="{{fullonlineexamsummary}}" style="font-size:12px; color:var(--ap-primary);">view more</a>
                        {{/fullonlineexamsummary}}
                    </div>
                    <div class="ap-dash-course-card__bottom">
                        <span class="ap-dash-course-card__lastaccess">
                            <i class="fa fa-clock-o"></i> {{{lastaccessdate}}}
                        </span>
                        <a href="{{{course_url}}}" class="ap-dash-course-card__cta">
                            {{label_name}} <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/moduledetails}}
        {{#viewMoreCard}}
        {{/viewMoreCard}}
    </div>
    </div>
</div>
{{/card_view}}

{{#list_view}}
<div class="ap-dash-courses-table-wrap">
<table class="ap-dash-courses-table generaltable" id="userdashboard_table_content">
    <thead>
        <tr>
            <th>{{#str}}coursename, local_onlineexams{{/str}}</th>
            <th></th>
            <th>{{#str}}coursedescription, local_onlineexams{{/str}}</th>
            <th>{{#str}}lastaccess, local_onlineexams{{/str}}</th>
            <th>{{#str}}progress, local_onlineexams{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#moduledetails}}
        <tr>
            <td><a href="{{course_url}}" title="{{{course_fullname}}}" class="ap-dash-courses-table__name">{{course_fullname}}</a></td>
            <td>
                {{#course_completedon}}
                <a href="{{{course_url}}}" class="ap-badge ap-badge--success">{{#str}}completed_course, block_userdashboard{{/str}}</a>
                {{/course_completedon}}
                {{^course_completedon}}
                <a href="{{{course_url}}}" class="ap-dash-course-card__cta" style="font-size:12px; padding:4px 12px;">{{label_name}}</a>
                {{/course_completedon}}
                {{{copyaction}}}
            </td>
            <td class="ap-dash-courses-table__desc">{{{onlineexamsummary}}}</td>
            <td>{{{lastaccessdate}}}</td>
            <td><strong>{{progress}}%</strong></td>
        </tr>
        {{/moduledetails}}
    </tbody>
</table>
</div>
{{/list_view}}
{{/onlineexams_view_count}}

{{^onlineexams_view_count}}
    {{> block_userdashboard/userdashboard_nodata_text}}
{{/onlineexams_view_count}}

{{#enableslider}}
    {{> block_userdashboard/userdashboard_enable_slider}}
{{/enableslider}}

<style>
/* Exam badge on dashboard card */
.ap-dash-course-card__exam-badge {
    position: absolute; top: 8px; left: 8px;
    background: rgba(220,38,38,0.85); color: #fff;
    padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;
    backdrop-filter: blur(4px);
}
</style>
