{{!
    @template local_sentientia_notifications/logs
}}
<div class="container-fluid">
    <h2 class="mb-3">Notification logs <span class="badge bg-secondary">{{ total }}</span></h2>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm">
                {{#status_options}}
                <option value="{{ value }}" {{#selected}}selected{{/selected}}>{{ label }}</option>
                {{/status_options}}
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Channel</label>
            <select name="channel" class="form-select form-select-sm">
                {{#channels}}
                <option value="{{ value }}" {{#selected}}selected{{/selected}}>{{ label }}</option>
                {{/channels}}
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Rule type</label>
            <select name="ruletype" class="form-select form-select-sm">
                {{#ruletype_options}}
                <option value="{{ value }}" {{#selected}}selected{{/selected}}>{{ label }}</option>
                {{/ruletype_options}}
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label small">From</label>
            <input type="date" name="from" class="form-control form-control-sm" value="{{ filter_from }}">
        </div>
        <div class="col-md-1">
            <label class="form-label small">To</label>
            <input type="date" name="to" class="form-control form-control-sm" value="{{ filter_to }}">
        </div>
        <div class="col-md-2">
            <label class="form-label small">Search (subject / email)</label>
            <input type="text" name="q" class="form-control form-control-sm" value="{{ filter_search }}">
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Apply filters</button>
            <a href="{{{ #moodle_url }}}/local/sentientia_notifications/logs.php{{{ /moodle_url }}}"
               class="btn btn-link btn-sm">Reset</a>
        </div>
    </form>

    {{#has_rows}}
    <div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>Time</th>
                <th>Rule</th>
                <th>Recipient</th>
                <th>Channel</th>
                <th>Subject</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td class="small text-nowrap">{{ placed_on }}</td>
                <td>
                    <strong>{{ rule_name }}</strong>
                    <br><code class="small text-muted">{{ rule_type }}</code>
                </td>
                <td><strong>{{ user_name }}</strong><br><code class="small">{{ user_email }}</code></td>
                <td><span class="badge bg-light text-dark">{{ channel }}</span></td>
                <td>{{ subject }}</td>
                <td><span class="{{ status_css }}">{{ status }}</span></td>
                <td>
                    <a href="{{{ detail_url }}}" class="btn btn-sm btn-link" title="Detail">
                        <i class="fa fa-info-circle"></i>
                    </a>
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    </div>
    {{/has_rows}}
    {{^has_rows}}
    <div class="alert alert-info">No notification logs match the current filters.</div>
    {{/has_rows}}

    <nav class="d-flex justify-content-between mt-3">
        {{#has_prev}}<a href="{{{ prev_url }}}" class="btn btn-link">← Prev</a>{{/has_prev}}
        {{^has_prev}}<span></span>{{/has_prev}}
        {{#has_next}}<a href="{{{ next_url }}}" class="btn btn-link">Next →</a>{{/has_next}}
    </nav>
</div>
