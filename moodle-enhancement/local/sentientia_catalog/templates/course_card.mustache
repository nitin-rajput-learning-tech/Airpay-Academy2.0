{{!
    Course catalogue card. Used in /local/sentientia_catalog/index.php
    (and the carousel sections).

    Iter 5 (Phase B0 — 2026-05-14): removed the hover-only overlay
    that duplicated summary + CTA already visible in the card body.
    The overlay was invisible on touch devices — mobile learners saw
    less than desktop. Now the summary is part of the persistent body,
    so every viewer sees the same content. Hover still gets the lift
    affordance via .airpay-catalog__card:hover in styles.css.
}}
<article class="airpay-catalog__card" aria-labelledby="course-{{id}}-title">
    <a href="{{detailurl}}" class="airpay-catalog__card-link"
       aria-label="View details for {{fullname}}">
        <div class="airpay-catalog__card-thumb airpay-catalog__card-thumb--v{{thumb_variant}}">
            {{#has_image}}
            <img class="airpay-catalog__card-img" src="{{imageurl}}" alt="" loading="lazy" aria-hidden="true">
            {{/has_image}}
            {{^has_image}}
            <span class="airpay-catalog__card-code" aria-hidden="true">{{{shortname}}}</span>
            {{/has_image}}
            {{#is_new}}
            <span class="airpay-catalog__badge airpay-catalog__badge--new"
                  aria-label="New course">NEW</span>
            {{/is_new}}
            {{#is_completed}}
            <span class="airpay-catalog__badge airpay-catalog__badge--done"
                  aria-label="Completed">
                <i class="fa fa-check" aria-hidden="true"></i>
            </span>
            {{/is_completed}}
            <span class="airpay-catalog__card-type" aria-hidden="true">{{type}}</span>
            {{#has_level}}
            <span class="airpay-catalog__card-difficulty airpay-catalog__card-difficulty--{{level_class}}"
                  aria-label="Difficulty: {{level}}">{{level}}</span>
            {{/has_level}}
        </div>
    </a>

    {{! Bookmark heart — separate click target so it doesn't navigate.
        aria-pressed reflects saved state for screen reader users. }}
    <button class="airpay-catalog__bookmark"
            type="button"
            data-courseid="{{id}}"
            aria-label="{{#is_bookmarked}}Remove {{fullname}} from saved{{/is_bookmarked}}{{^is_bookmarked}}Save {{fullname}} for later{{/is_bookmarked}}"
            aria-pressed="{{#is_bookmarked}}true{{/is_bookmarked}}{{^is_bookmarked}}false{{/is_bookmarked}}">
        <i class="fa fa-heart" aria-hidden="true"></i>
    </button>

    <div class="airpay-catalog__card-body">
        <h4 class="airpay-catalog__card-title" id="course-{{id}}-title">
            <a href="{{detailurl}}">{{{fullname}}}</a>
        </h4>

        {{! Iter 5 — summary now persistent (was hover-overlay only).
            The CSS clamps to 2 lines so card heights stay aligned. }}
        {{#summary}}
        <p class="airpay-catalog__card-summary">{{{summary}}}</p>
        {{/summary}}

        <div class="airpay-catalog__card-meta">
            <span class="airpay-catalog__card-category">{{{categoryname}}}</span>
            {{#has_level}}
            <span class="airpay-catalog__card-level">{{level}}</span>
            {{/has_level}}
        </div>

        {{! Sprint C — provenance badge for cross-tenant shared courses. }}
        {{#is_borrowed}}
        <div class="airpay-catalog__card-provenance"
             title="This course is provided by {{provider_tenant_name}} Academy.">
            <i class="fa fa-handshake" aria-hidden="true"></i>
            {{#str}}provenance_provided_by, local_sentientia_catalog, {{provider_tenant_name}}{{/str}}
        </div>
        {{/is_borrowed}}

        <div class="airpay-catalog__card-footer">
            <span class="airpay-catalog__card-enrolled" aria-label="{{enrolled_count}} learners enrolled">
                <i class="fa fa-users" aria-hidden="true"></i> {{enrolled_count}}
            </span>
            {{#is_enrolled}}
            <a href="{{viewurl}}" class="airpay-catalog__btn airpay-catalog__btn--continue">
                {{#str}}continue, local_sentientia_catalog{{/str}}
            </a>
            {{/is_enrolled}}
            {{^is_enrolled}}
            <a href="{{detailurl}}" class="airpay-catalog__btn airpay-catalog__btn--enroll">
                {{#str}}enroll, local_sentientia_catalog{{/str}}
            </a>
            {{/is_enrolled}}
        </div>
    </div>
</article>
