{{!
    @template local_sentientia_content_market/browse

    Content Marketplace browse page.
    Mirrors airpay-catalog__ BEM conventions from sentientia_catalog.

    Context variables:
        baseurl         - string  Base URL for filter/search links
        query           - string  Current search query (HTML-escaped)
        has_query       - bool    Whether a search query is active
        items           - array   Catalog items (see below)
        has_items       - bool    Whether items is non-empty
        total           - int     Total matching items across all pages
        page            - int     Current page (1-based)
        total_pages     - int     Total pages available
        has_prev        - bool    Whether there is a previous page
        has_next        - bool    Whether there is a next page
        prev_page       - int     Previous page number
        next_page       - int     Next page number
        providers       - array   [{key, label, active}]
        provider_filter - string  Active provider filter value
        level_filter    - string  Active level filter value
        type_filter     - string  Active content type filter value
        can_manage      - bool    User has manageproviders capability
        can_sync        - bool    User has syncproviders capability
        sesskey         - string  CSRF sesskey

    Item context:
        id             - int
        title          - string (format_string'd)
        description    - string (format_text'd)
        provider       - string
        content_type   - string
        level          - string
        language       - string
        duration_mins  - int|null
        thumbnail_url  - string|null
        provider_url   - string|null
        has_thumbnail  - bool
        has_url        - bool
        is_free        - bool
        price_usd      - string|null (formatted)
}}
<div class="airpay-catalog local-sentientia-content-market">

    {{! Page heading }}
    <div class="local-cm__header">
        <h1 class="local-cm__title">
            <i class="fa fa-th" aria-hidden="true"></i>
            {{#str}}browse_heading, local_sentientia_content_market{{/str}}
        </h1>
        <p class="local-cm__desc">{{#str}}browse_desc, local_sentientia_content_market{{/str}}</p>
        {{#can_sync}}
        <a href="{{baseurl}}?sync=1&sesskey={{sesskey}}" class="btn btn-sm btn-outline-secondary local-cm__sync-btn">
            <i class="fa fa-refresh" aria-hidden="true"></i>
            {{#str}}sync_now, local_sentientia_content_market{{/str}}
        </a>
        {{/can_sync}}
    </div>

    {{! Search bar }}
    <form method="get" action="{{baseurl}}" class="local-cm__search-form" role="search">
        <div class="local-cm__search-wrap">
            <input type="search"
                   name="q"
                   value="{{query}}"
                   class="local-cm__search-input form-control"
                   placeholder="{{#str}}search_placeholder, local_sentientia_content_market{{/str}}"
                   aria-label="{{#str}}search_placeholder, local_sentientia_content_market{{/str}}">
            <button type="submit" class="local-cm__search-btn btn btn-primary">
                <i class="fa fa-search" aria-hidden="true"></i>
                <span class="sr-only">{{#str}}search_button, local_sentientia_content_market{{/str}}</span>
            </button>
        </div>

        {{! Provider filter chips }}
        <div class="local-cm__provider-filters" role="group" aria-label="{{#str}}filter_provider, local_sentientia_content_market{{/str}}">
            <a href="{{baseurl}}{{#has_query}}?q={{query}}{{/has_query}}"
               class="local-cm__filter-chip {{^provider_filter}}local-cm__filter-chip--active{{/provider_filter}}">
                {{#str}}filter_all_providers, local_sentientia_content_market{{/str}}
            </a>
            {{#providers}}
            <a href="{{baseurl}}?provider={{key}}{{#has_query}}&q={{query}}{{/has_query}}"
               class="local-cm__filter-chip {{#active}}local-cm__filter-chip--active{{/active}}">
                {{label}}
            </a>
            {{/providers}}
        </div>
    </form>

    {{! Results header }}
    <div class="local-cm__results-header">
        <span class="local-cm__results-count">
            {{#str}}results_count, local_sentientia_content_market, {{total}}{{/str}}
        </span>
    </div>

    {{! Item grid }}
    {{#has_items}}
    <div class="airpay-catalog__grid local-cm__grid" id="local-cm-grid">
        {{#items}}
        <div class="airpay-catalog__card local-cm__card">
            {{! Thumbnail }}
            <div class="airpay-catalog__card-thumb local-cm__card-thumb">
                {{#has_thumbnail}}
                <img class="local-cm__card-img" src="{{thumbnail_url}}" alt="" loading="lazy" aria-hidden="true">
                {{/has_thumbnail}}
                {{^has_thumbnail}}
                <div class="local-cm__card-thumb-placeholder">
                    <i class="fa fa-play-circle" aria-hidden="true"></i>
                </div>
                {{/has_thumbnail}}

                {{! Provider badge }}
                <span class="local-cm__provider-badge local-cm__provider-badge--{{provider}}">{{provider}}</span>

                {{! Content type badge }}
                {{#content_type}}
                <span class="local-cm__type-badge">{{content_type}}</span>
                {{/content_type}}
            </div>

            {{! Card body }}
            <div class="airpay-catalog__card-body local-cm__card-body">
                <h4 class="airpay-catalog__card-title local-cm__card-title">{{title}}</h4>

                {{! Meta row: level + duration }}
                <div class="local-cm__card-meta">
                    {{#level}}
                    <span class="local-cm__badge local-cm__badge--level">
                        <i class="fa fa-signal" aria-hidden="true"></i> {{level}}
                    </span>
                    {{/level}}
                    {{#duration_mins}}
                    <span class="local-cm__badge local-cm__badge--duration">
                        <i class="fa fa-clock-o" aria-hidden="true"></i> {{duration_mins}} min
                    </span>
                    {{/duration_mins}}
                    <span class="local-cm__badge local-cm__badge--lang">{{language}}</span>
                </div>

                {{! Pricing }}
                <div class="local-cm__card-price">
                    {{#is_free}}
                    <span class="local-cm__price local-cm__price--free">
                        {{#str}}free_label, local_sentientia_content_market{{/str}}
                    </span>
                    {{/is_free}}
                    {{^is_free}}
                    {{#price_usd}}
                    <span class="local-cm__price">
                        {{#str}}price_label, local_sentientia_content_market, {{price_usd}}{{/str}}
                    </span>
                    {{/price_usd}}
                    {{/is_free}}
                </div>

                {{! Action button }}
                {{#has_url}}
                <a href="{{provider_url}}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-sm btn-outline-primary local-cm__launch-btn">
                    <i class="fa fa-external-link" aria-hidden="true"></i>
                    {{#str}}view_on_provider, local_sentientia_content_market, {{provider}}{{/str}}
                </a>
                {{/has_url}}
                {{^has_url}}
                <span class="text-muted small">No link available</span>
                {{/has_url}}
            </div>
        </div>
        {{/items}}
    </div>

    {{! Pagination }}
    {{#total_pages}}
    <nav class="local-cm__pagination" aria-label="Pagination">
        {{#has_prev}}
        <a href="{{baseurl}}?page={{prev_page}}{{#has_query}}&q={{query}}{{/has_query}}{{#provider_filter}}&provider={{provider_filter}}{{/provider_filter}}"
           class="btn btn-outline-secondary local-cm__page-btn">
            <i class="fa fa-chevron-left" aria-hidden="true"></i>
            {{#str}}page_prev, local_sentientia_content_market{{/str}}
        </a>
        {{/has_prev}}
        <span class="local-cm__page-indicator">{{page}} / {{total_pages}}</span>
        {{#has_next}}
        <a href="{{baseurl}}?page={{next_page}}{{#has_query}}&q={{query}}{{/has_query}}{{#provider_filter}}&provider={{provider_filter}}{{/provider_filter}}"
           class="btn btn-outline-secondary local-cm__page-btn">
            {{#str}}page_next, local_sentientia_content_market{{/str}}
            <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
        {{/has_next}}
    </nav>
    {{/total_pages}}

    {{/has_items}}

    {{! Empty state }}
    {{^has_items}}
    <div class="local-cm__empty">
        <i class="fa fa-search fa-3x text-muted" aria-hidden="true"></i>
        <p class="local-cm__empty-title">{{#str}}no_results, local_sentientia_content_market{{/str}}</p>
        <p class="local-cm__empty-hint text-muted">{{#str}}no_results_hint, local_sentientia_content_market{{/str}}</p>
    </div>
    {{/has_items}}

</div>

<style>
/* ── Content Marketplace BEM component styles ────────────────────
   Scoped to .local-sentientia-content-market to avoid polluting global
   namespace. Design tokens: mirrors airpay-catalog__ conventions.    */

.local-sentientia-content-market .local-cm__header {
    margin-bottom: 24px;
}
.local-sentientia-content-market .local-cm__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 8px;
}
.local-sentientia-content-market .local-cm__desc {
    color: #5a6070;
    margin-bottom: 12px;
}
.local-sentientia-content-market .local-cm__search-form {
    margin-bottom: 20px;
}
.local-sentientia-content-market .local-cm__search-wrap {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
}
.local-sentientia-content-market .local-cm__search-input {
    flex: 1;
    border-radius: 8px;
}
.local-sentientia-content-market .local-cm__provider-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}
.local-sentientia-content-market .local-cm__filter-chip {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
    border: 1px solid #e2e6ef;
    background: #fff;
    color: #5a6070;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background var(--ap-transition-quick, 150ms ease-out),
                color var(--ap-transition-quick, 150ms ease-out);
}
.local-sentientia-content-market .local-cm__filter-chip:hover,
.local-sentientia-content-market .local-cm__filter-chip--active {
    background: #0066A7;
    color: #fff;
    border-color: #0066A7;
}
.local-sentientia-content-market .local-cm__results-header {
    margin-bottom: 16px;
    color: #5a6070;
    font-size: 0.875rem;
}
.local-sentientia-content-market .local-cm__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
}
.local-sentientia-content-market .local-cm__card {
    background: #fff;
    border: 1px solid #e2e6ef;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
}
.local-sentientia-content-market .local-cm__card-thumb {
    position: relative;
    height: 160px;
    background: #F2F4FB;
    overflow: hidden;
}
.local-sentientia-content-market .local-cm__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.local-sentientia-content-market .local-cm__card-thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #a0a9b8;
    font-size: 2.5rem;
}
.local-sentientia-content-market .local-cm__provider-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0,0,0,0.6);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.local-sentientia-content-market .local-cm__provider-badge--go1 { background: #1d3880; }
.local-sentientia-content-market .local-cm__provider-badge--udemy_business { background: #5624d0; }
.local-sentientia-content-market .local-cm__provider-badge--coursera { background: #0056d2; }
.local-sentientia-content-market .local-cm__provider-badge--skillsoft { background: #e84b2f; }
.local-sentientia-content-market .local-cm__type-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0,102,167,0.85);
    color: #fff;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: capitalize;
}
.local-sentientia-content-market .local-cm__card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
}
.local-sentientia-content-market .local-cm__card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a1a2e;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.local-sentientia-content-market .local-cm__card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.local-sentientia-content-market .local-cm__badge {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 20px;
    border: 1px solid #e2e6ef;
    color: #5a6070;
    background: #f8f9fc;
}
.local-sentientia-content-market .local-cm__card-price {
    margin-top: auto;
}
.local-sentientia-content-market .local-cm__price {
    font-weight: 600;
    font-size: 0.875rem;
    color: #1a1a2e;
}
.local-sentientia-content-market .local-cm__price--free {
    color: #16a34a;
    background: #f0fdf4;
    padding: 2px 10px;
    border-radius: 20px;
    border: 1px solid #bbf7d0;
}
.local-sentientia-content-market .local-cm__launch-btn {
    margin-top: 4px;
    border-radius: 8px;
    font-size: 0.8rem;
}
.local-sentientia-content-market .local-cm__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
}
.local-sentientia-content-market .local-cm__page-indicator {
    font-size: 0.875rem;
    color: #5a6070;
}
.local-sentientia-content-market .local-cm__empty {
    text-align: center;
    padding: 64px 24px;
    color: #5a6070;
}
.local-sentientia-content-market .local-cm__empty-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 16px;
}

@media (max-width: 590px) {
    .local-sentientia-content-market .local-cm__grid {
        grid-template-columns: 1fr;
    }
    .local-sentientia-content-market .local-cm__search-wrap {
        flex-direction: column;
    }
}
</style>
