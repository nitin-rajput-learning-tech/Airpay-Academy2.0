<div class="w-full pull-left udb_tab_content elearning_courses active" id="elearning_courses">
    <div class="ap-dash-module-wrap">
        <div class="ap-dash-module-wrap__header">
            {{> block_userdashboard/userdashboard_count_info}}
            {{> local_courses/userdashboard_inner_tab}}
        </div>
        <div class="ap-dash-module-wrap__body">
            <div class="ap-dash-module-wrap__search">
                <i class="fa fa-search ap-dash-module-wrap__search-icon"></i>
                <input id="userdashboard_filter" class="dashboard_filter ap-dash-module-wrap__search-input" type="text" name="dashboard_filter"
                       placeholder="Search courses..."
                       data-pluginname="local_courses" data-tabname="{{tabname}}"
                       data-templatename="local_courses/dashboard_innercontent"
                       data-status="{{status}}" value="{{{filter_text}}}">
            </div>
            <div class="divslide">
                {{> local_courses/dashboard_innercontent}}
            </div>
        </div>
    </div>
</div>

<style>
.ap-dash-module-wrap {
    background: var(--ap-surface, #fff);
    border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: 12px; overflow: hidden;
}
.ap-dash-module-wrap__header { padding: 14px 16px 0; }
.ap-dash-module-wrap__body { padding: 0 16px 16px; }
.ap-dash-module-wrap__search {
    position: relative; max-width: 280px; margin-bottom: 12px;
}
.ap-dash-module-wrap__search-icon {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    color: var(--ap-text-muted); font-size: 13px;
}
.ap-dash-module-wrap__search-input {
    width: 100%; padding: 7px 10px 7px 32px;
    border: 1px solid var(--ap-border); border-radius: 8px;
    font-size: 13px; font-family: var(--ap-font);
    transition: border-color 0.15s;
}
.ap-dash-module-wrap__search-input:focus {
    outline: none; border-color: var(--ap-primary);
    box-shadow: 0 0 0 3px rgba(0,102,167,0.1);
}
body.dark-mode .ap-dash-module-wrap { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-dash-module-wrap__search-input { background: #22252f; border-color: #2d3140; color: #e8eaed; }
</style>
