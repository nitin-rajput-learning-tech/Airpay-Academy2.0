{{#response}}
{{#viewtypeCard}}
<div class="ap-courses-grid">
    {{#records}}
    {{#hascourses}}
    <div class="{{cardClass}} catcourses_list {{course_class}}">
        <div class="ap-course-mgmt-card">

            {{! Image with type badge + action gear + stats overlay }}
            <div class="ap-course-mgmt-card__image-section">
                <div class="ap-course-mgmt-card__image" style="background-image: url('{{{courseimage}}}');" title="{{coursename}}">
                    {{! Course type badge }}
                    <div class="ap-course-mgmt-card__type">{{{coursetype}}}</div>

                    {{! Action dropdown }}
                    {{#actions}}
                    <div class="dropdown ap-course-mgmt-card__actions">
                        <button data-toggle="dropdown" aria-expanded="false" class="ap-course-mgmt-card__action-btn">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            {{#update}}
                            {{#editcourse}}{{{editcourse}}}{{/editcourse}}
                            {{/update}}
                            {{#enrol}}
                            <a href="{{enrollusers}}" class="dropdown-item" title="{{#str}}userenrolments, local_courses{{/str}}">
                                <i class="fa fa-user fa-fw"></i> User Enrollments
                            </a>
                            {{/enrol}}
                            {{#update}}
                            {{#auto_enrol}}
                            <a href="{{auto_enrol}}" class="dropdown-item" title="{{#str}}auto_enrol, local_courses{{/str}}">
                                <i class="fa fa-user-circle-o fa-fw"></i> Auto Enrol
                            </a>
                            {{/auto_enrol}}
                            {{/update}}
                            {{#update_status}}{{{update_status}}}{{/update_status}}
                            {{#grade_view}}
                            <a class="dropdown-item" href="{{grader}}" title="{{#str}}grader, local_courses{{/str}}">
                                <i class="fa fa-pie-chart fa-fw"></i> Grader
                            </a>
                            {{/grade_view}}
                            {{#request_view}}
                            <a class="dropdown-item" href="{{requestlink}}" title="{{#str}}request, local_request{{/str}}">
                                <i class="fa fa-share-square fa-fw"></i> Request
                            </a>
                            {{/request_view}}
                            {{#deleteaction}}{{{deleteaction}}}{{/deleteaction}}
                            {{#viewpaymentlog}}
                            <a class="dropdown-item" href="{{viewpaymentlog}}" title="{{#str}}viewpaymentlog, local_courses{{/str}}">
                                <i class="fa fa-history fa-fw"></i> {{#str}}viewpaymentlog, local_courses{{/str}}
                            </a>
                            {{/viewpaymentlog}}
                        </div>
                    </div>
                    {{/actions}}

                    {{! Stats overlay }}
                    <div class="ap-course-mgmt-card__stats-overlay">
                        <div class="ap-course-mgmt-card__stat">
                            <i class="fa fa-users"></i>
                            <span>{{enrolled_count}}</span>
                            <small>Enrolled</small>
                        </div>
                        <div class="ap-course-mgmt-card__stat">
                            <i class="fa fa-check-circle"></i>
                            <span>{{completed_count}}</span>
                            <small>Completed</small>
                        </div>
                    </div>
                </div>
            </div>

            {{! Card body }}
            <div class="ap-course-mgmt-card__body">
                <h4 class="ap-course-mgmt-card__title">
                    {{^coursenameCut}}
                    <a href="{{courseurl}}" title="{{coursename}}">{{coursename}}</a>
                    {{/coursenameCut}}
                    {{#coursenameCut}}
                    <a href="{{courseurl}}" title="{{coursename}}">{{coursenameCut}}</a>
                    {{/coursenameCut}}
                </h4>

                <div class="ap-course-mgmt-card__category">
                    <i class="fa fa-folder-o"></i>
                    {{#catnamestring}}{{catnamestring}}{{/catnamestring}}{{^catnamestring}}N/A{{/catnamestring}}
                </div>

                {{#coursesummary}}
                <p class="ap-course-mgmt-card__desc">{{coursesummary}}</p>
                {{/coursesummary}}
                {{^coursesummary}}
                <p class="ap-course-mgmt-card__desc ap-course-mgmt-card__desc--empty">{{#str}}nocoursedesc, local_courses{{/str}}</p>
                {{/coursesummary}}

                <div class="ap-course-mgmt-card__rating">
                    <i class="fa fa-star" style="color:#fbbf24;"></i>
                    <span>{{ratings_value}}</span>
                    <small>{{#str}}pluginname, local_ratings{{/str}}</small>
                </div>
            </div>

            {{! Quick action footer }}
            <a href="{{courseurl}}" class="ap-course-mgmt-card__cta">
                View Course <i class="fa fa-arrow-right"></i>
            </a>
        </div>
    </div>
    {{/hascourses}}
    <div class="col-md-12">{{{pagination}}}</div>
    {{#nocourses}}
    <div class="ap-courses-grid__empty">
        <i class="fa fa-book"></i>
        <p>No courses available.</p>
    </div>
    {{/nocourses}}
    {{/records}}
</div>
{{/viewtypeCard}}
{{/response}}

<style>
/* ═══ Modern Course Management Cards ═══ */
.ap-courses-grid { display: flex; flex-wrap: wrap; gap: 0; }
.ap-course-mgmt-card {
    background: var(--ap-surface, #fff);
    border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex; flex-direction: column;
    height: 100%; margin-bottom: 16px;
}
.ap-course-mgmt-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,51,102,0.1);
}

/* Image */
.ap-course-mgmt-card__image-section { position: relative; }
.ap-course-mgmt-card__image {
    height: 160px; background-size: cover; background-position: center;
    background-color: linear-gradient(135deg, #0066A7, #0f7a73);
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
}
.ap-course-mgmt-card__type {
    position: absolute; top: 8px; left: 8px;
    font-size: 11px; font-weight: 600;
}
.ap-course-mgmt-card__type span {
    background: rgba(255,255,255,0.2); color: #fff;
    padding: 2px 8px; border-radius: 10px; font-size: 11px;
    text-transform: uppercase; backdrop-filter: blur(4px);
}
.ap-course-mgmt-card__actions { position: absolute; top: 8px; right: 8px; }
.ap-course-mgmt-card__action-btn {
    width: 32px; height: 32px; border-radius: 8px;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    border: none; color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
}
.ap-course-mgmt-card__action-btn:hover { background: rgba(0,0,0,0.7); }
.ap-course-mgmt-card .dropdown-menu {
    border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border: 1px solid var(--ap-border); padding: 6px; min-width: 180px;
}
.ap-course-mgmt-card .dropdown-item {
    border-radius: 6px; padding: 8px 12px; font-size: 13px; transition: background 0.1s;
}
.ap-course-mgmt-card .dropdown-item:hover { background: #e8f2f9; }

/* Stats overlay */
.ap-course-mgmt-card__stats-overlay {
    position: absolute; bottom: 0; left: 0; right: 0;
    display: flex; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
}
.ap-course-mgmt-card__stat {
    flex: 1; display: flex; align-items: center; gap: 6px;
    padding: 8px 12px; color: #fff; font-size: 12px;
}
.ap-course-mgmt-card__stat i { font-size: 11px; opacity: 0.8; }
.ap-course-mgmt-card__stat span { font-weight: 700; font-size: 14px; }
.ap-course-mgmt-card__stat small { font-size: 10px; opacity: 0.7; }
.ap-course-mgmt-card__stat + .ap-course-mgmt-card__stat { border-left: 1px solid rgba(255,255,255,0.2); }

/* Body */
.ap-course-mgmt-card__body { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; }
.ap-course-mgmt-card__title { margin: 0 0 6px; font-size: 15px; font-weight: 700; line-height: 1.3; }
.ap-course-mgmt-card__title a {
    color: var(--ap-text, #1a1a2e); text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ap-course-mgmt-card__title a:hover { color: var(--ap-primary, #0066A7); }
.ap-course-mgmt-card__category {
    font-size: 12px; color: var(--ap-primary, #0066A7); margin-bottom: 8px;
}
.ap-course-mgmt-card__category i { margin-right: 4px; font-size: 11px; }
.ap-course-mgmt-card__desc {
    font-size: 13px; color: var(--ap-text-secondary, #607286); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin: 0 0 10px; flex: 1;
}
.ap-course-mgmt-card__desc--empty { color: var(--ap-text-muted, #8896a6); font-style: italic; }
.ap-course-mgmt-card__rating {
    display: flex; align-items: center; gap: 4px;
    font-size: 13px; color: var(--ap-text-secondary);
}
.ap-course-mgmt-card__rating span { font-weight: 700; color: var(--ap-text, #1a1a2e); }
.ap-course-mgmt-card__rating small { color: var(--ap-text-muted); font-size: 11px; }

/* CTA */
.ap-course-mgmt-card__cta {
    display: flex; justify-content: center; align-items: center; gap: 6px;
    padding: 10px; border-top: 1px solid var(--ap-border, #e3eaf3);
    font-size: 13px; font-weight: 600; color: var(--ap-primary, #0066A7); text-decoration: none;
    transition: background 0.15s;
}
.ap-course-mgmt-card__cta:hover { background: var(--ap-primary-light, #e8f2f9); text-decoration: none; }

/* Empty */
.ap-courses-grid__empty { width: 100%; text-align: center; padding: 48px 24px; color: var(--ap-text-muted); }
.ap-courses-grid__empty i { font-size: 48px; display: block; margin-bottom: 12px; opacity: 0.4; }

/* Dark mode */
body.dark-mode .ap-course-mgmt-card { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-course-mgmt-card:hover { box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
body.dark-mode .ap-course-mgmt-card__title a { color: #e8eaed; }
body.dark-mode .ap-course-mgmt-card__desc { color: #9ca3b4; }
body.dark-mode .ap-course-mgmt-card__rating span { color: #e8eaed; }
body.dark-mode .ap-course-mgmt-card__cta { border-color: #2d3140; }
body.dark-mode .ap-course-mgmt-card .dropdown-menu { background: #1a1d27; border-color: #2d3140; }
</style>
