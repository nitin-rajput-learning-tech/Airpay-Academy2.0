{{#courses_view_count}}
{{#card_view}}
<div class="userdashboard_content">
    <div id="{{{subtab}}}" class="tab-pane divslider active active_subtab">
    <div class="ap-dash-courses userdashboard_content userdashboard_ctype_elearning">
        {{#moduledetails}}
        <div class="col-sm-6 col-md-5 col-12 tabs_cmn_class courses_inprogress_slide {{{subtab}}} {{indexClass}} ctype_elearning d-flex" data-index="{{index}}">
            <div class="ap-dash-course-card">
                {{! Image with progress ring }}
                <a href="{{{course_url}}}" class="ap-dash-course-card__image-link">
                    <div class="ap-dash-course-card__image" style="background-image:url('{{course_image_url}}');">
                        <div class="ap-dash-course-card__progress-ring">
                            <svg width="44" height="44" viewBox="0 0 44 44">
                                <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="3"/>
                                <circle cx="22" cy="22" r="18" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round"
                                        stroke-dasharray="113.1" stroke-dashoffset="{{progress_offset}}"
                                        style="transform:rotate(-90deg); transform-origin:center; transition:stroke-dashoffset 0.8s ease;"/>
                            </svg>
                            <span class="ap-dash-course-card__progress-label">{{progress}}%</span>
                        </div>
                    </div>
                </a>

                {{! Content }}
                <div class="ap-dash-course-card__content">
                    <div class="ap-dash-course-card__top">
                        <h4 class="ap-dash-course-card__title">
                            <a href="{{course_url}}" title="{{{course_fullname}}}">{{course_fullname}}</a>
                        </h4>
                        {{#coursesummary}}
                        <p class="ap-dash-course-card__desc">{{{coursesummary}}}</p>
                        {{/coursesummary}}
                    </div>
                    <div class="ap-dash-course-card__bottom">
                        <span class="ap-dash-course-card__lastaccess">
                            <i class="fa fa-clock-o"></i> {{{lastaccessdate}}}
                        </span>
                        <a href="{{{course_url}}}" class="ap-dash-course-card__cta">
                            {{label_name}} <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/moduledetails}}
        {{#viewMoreCard}}
        {{/viewMoreCard}}
    </div>
    </div>
</div>
{{/card_view}}

{{#list_view}}
<div class="ap-dash-courses-table-wrap">
<table class="ap-dash-courses-table generaltable" id="userdashboard_table_content">
    <thead>
        <tr>
            <th>{{#str}}coursename, local_courses{{/str}}</th>
            <th></th>
            <th>{{#str}}coursedescription, local_courses{{/str}}</th>
            <th>{{#str}}lastaccess, local_courses{{/str}}</th>
            <th>{{#str}}progress, local_courses{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#moduledetails}}
        <tr>
            <td>
                <a href="{{course_url}}" title="{{{course_fullname}}}" class="ap-dash-courses-table__name">{{course_fullname}}</a>
            </td>
            <td>
                {{#course_completedon}}
                <a href="{{{course_url}}}" class="ap-badge ap-badge--success">{{#str}}completed_course, block_userdashboard{{/str}}</a>
                {{/course_completedon}}
                {{^course_completedon}}
                <a href="{{{course_url}}}" class="ap-dash-course-card__cta" style="font-size:12px; padding:4px 12px;">{{label_name}}</a>
                {{/course_completedon}}
                {{{copyaction}}}
            </td>
            <td class="ap-dash-courses-table__desc">{{{coursesummary}}}</td>
            <td>{{{lastaccessdate}}}</td>
            <td><strong>{{progress}}%</strong></td>
        </tr>
        {{/moduledetails}}
    </tbody>
</table>
</div>
{{/list_view}}
{{/courses_view_count}}

{{^courses_view_count}}
    {{> block_userdashboard/userdashboard_nodata_text}}
{{/courses_view_count}}

{{#enableslider}}
    {{> block_userdashboard/userdashboard_enable_slider}}
{{/enableslider}}

<style>
/* Dashboard course cards */
.ap-dash-courses { display: flex; flex-wrap: wrap; gap: 0; }
.ap-dash-course-card {
    display: flex; background: var(--ap-surface, #fff);
    border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: 12px; overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    height: 100%; width: 100%; margin-bottom: 12px;
}
.ap-dash-course-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,51,102,0.08);
}

/* Image with progress ring */
.ap-dash-course-card__image-link { flex-shrink: 0; text-decoration: none; }
.ap-dash-course-card__image {
    width: 140px; height: 100%;
    background-size: cover; background-position: center;
    background-color: #e8f2f9;
    display: flex; align-items: flex-end; justify-content: flex-end;
    padding: 8px; min-height: 120px;
    position: relative;
}
.ap-dash-course-card__progress-ring { position: relative; }
.ap-dash-course-card__progress-ring svg { display: block; }
.ap-dash-course-card__progress-label {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 10px; font-weight: 700; color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}

/* Content */
.ap-dash-course-card__content {
    flex: 1; padding: 12px 14px; display: flex; flex-direction: column;
    justify-content: space-between; min-width: 0;
}
.ap-dash-course-card__title { margin: 0 0 4px; font-size: 14px; font-weight: 700; line-height: 1.3; }
.ap-dash-course-card__title a {
    color: var(--ap-text, #1a1a2e); text-decoration: none;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ap-dash-course-card__title a:hover { color: var(--ap-primary, #0066A7); }
.ap-dash-course-card__desc {
    font-size: 12px; color: var(--ap-text-secondary, #607286); margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ap-dash-course-card__bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
.ap-dash-course-card__lastaccess {
    font-size: 11px; color: var(--ap-text-muted, #8896a6);
    display: flex; align-items: center; gap: 4px;
}
.ap-dash-course-card__cta {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
    background: var(--ap-gradient, linear-gradient(135deg, #0066A7, #0f7a73));
    color: #fff; text-decoration: none; white-space: nowrap;
    transition: opacity 0.15s;
}
.ap-dash-course-card__cta:hover { opacity: 0.9; color: #fff; text-decoration: none; }

/* Table view */
.ap-dash-courses-table-wrap { overflow-x: auto; }
.ap-dash-courses-table { width: 100%; font-size: 13px; }
.ap-dash-courses-table th { font-size: 11px; text-transform: uppercase; color: var(--ap-text-muted); letter-spacing: 0.3px; }
.ap-dash-courses-table__name { font-weight: 600; color: var(--ap-text); text-decoration: none; }
.ap-dash-courses-table__name:hover { color: var(--ap-primary); }
.ap-dash-courses-table__desc { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ap-text-secondary); }

/* Mobile */
@media (max-width: 590px) {
    .ap-dash-course-card { flex-direction: column; }
    .ap-dash-course-card__image { width: 100%; height: 100px; min-height: 100px; }
}

/* Dark mode */
body.dark-mode .ap-dash-course-card { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-dash-course-card__title a { color: #e8eaed; }
body.dark-mode .ap-dash-course-card__desc { color: #9ca3b4; }
</style>
