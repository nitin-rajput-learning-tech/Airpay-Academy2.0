<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_gamification/db" VERSION="20260409"
       COMMENT="Airpay Academy Gamification — points, badges, streaks">
  <TABLES>

    <TABLE NAME="local_airpay_points_log"
           COMMENT="Point awards log — every point transaction">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="action"       TYPE="char" LENGTH="50" NOTNULL="true"
               COMMENT="course_completed|quiz_passed|quiz_perfect|daily_login|streak_7|streak_30|first_course|learning_path"/>
        <FIELD NAME="points"       TYPE="int"  LENGTH="6"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK to mdl_course.id (null for non-course actions)"/>
        <FIELD NAME="description"  TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid"      UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_action"      UNIQUE="false" FIELDS="action"/>
        <INDEX NAME="idx_timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="idx_userid_action" UNIQUE="false" FIELDS="userid, action"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_badges"
           COMMENT="Badge definitions">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"           TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="description"    TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="icon"           TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="fa-trophy"
               COMMENT="Font Awesome icon class or emoji"/>
        <FIELD NAME="criteria_type"  TYPE="char" LENGTH="50"  NOTNULL="true"
               COMMENT="courses_completed|quizzes_perfect|streak_days|points_total|first_course|compliance_complete"/>
        <FIELD NAME="criteria_value" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="1"
               COMMENT="Number needed to earn (e.g., 5 courses, 30 days)"/>
        <FIELD NAME="sort_order"     TYPE="int"  LENGTH="4"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_criteria_type" UNIQUE="false" FIELDS="criteria_type"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_user_badges"
           COMMENT="Badges earned by users">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="badgeid"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeearned" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user"   TYPE="foreign" FIELDS="userid"  REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_badge"  TYPE="foreign" FIELDS="badgeid" REFTABLE="local_airpay_badges" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid"        UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_userid_badge"  UNIQUE="true"  FIELDS="userid, badgeid"
               COMMENT="Each user can earn each badge only once"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_streaks"
           COMMENT="Daily login streak tracking">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"          TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="current_streak"  TYPE="int" LENGTH="6"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="longest_streak"  TYPE="int" LENGTH="6"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="last_login_date" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT=""
               COMMENT="YYYY-MM-DD format — date of last counted login"/>
        <FIELD NAME="total_points"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Cached total points for fast leaderboard queries"/>
        <FIELD NAME="timemodified"    TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid"       UNIQUE="true"  FIELDS="userid"
               COMMENT="One streak record per user"/>
        <INDEX NAME="idx_total_points" UNIQUE="false" FIELDS="total_points"
               COMMENT="Leaderboard sorting"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
