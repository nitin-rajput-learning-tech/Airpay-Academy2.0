{{!
    Airpay Classroom — per-session attendance marking page.

    @template local_airpay_classroom/attendance
    @package  local_airpay_classroom

    Context vars:
      sessionid          int
      classroomid        int
      classroom_name     string format_string'd
      session_title      string format_string'd
      session_time       string e.g. "Mon, 06 May 2026 · 09:00 – 13:00"
      session_location   string
      has_location       bool
      rows               array of {userid, fullname, email, is_absent, is_present, is_late, is_excused, marked_at}
      has_rows           bool
      roster_size        int
      count_*            int — present|late|excused|absent
      can_attend         bool
      back_url           URL back to view.php?id=N&tab=sessions
}}
<div data-region="airpay-attendance"
     data-sessionid="{{ sessionid }}"
     data-classroomid="{{ classroomid }}">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-3">
        <div>
            <a href="{{{ back_url }}}" class="small text-muted text-decoration-none">
                <i class="fa fa-angle-left fa-fw"></i> Back to {{ classroom_name }}
            </a>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">{{ page_heading }}</h2>
            <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
                <span><i class="fa fa-calendar fa-fw"></i> {{ session_time }}</span>
                {{# has_location }}
                <span>·</span>
                <span><i class="fa fa-map-marker fa-fw"></i> {{ session_location }}</span>
                {{/ has_location }}
                <span>·</span>
                <span>{{ roster_size }} on roster</span>
            </div>
        </div>
    </div>

    {{! ── Live counts strip ──────────────────────────────────────────── }}
    <div class="row mb-3" data-region="attendance-summary">
        <div class="col-md-3 col-6 mb-2"><div class="card border-0 shadow-sm">
            <div class="card-body text-center py-2">
                <div style="font-size: 1.6rem; font-weight: 800; color: var(--ap-color-success, #16a34a);"
                     data-counter="present">{{ count_present }}</div>
                <div class="text-muted small text-uppercase">{{# str }}attendance_status_present, local_airpay_classroom{{/ str }}</div>
            </div>
        </div></div>
        <div class="col-md-3 col-6 mb-2"><div class="card border-0 shadow-sm">
            <div class="card-body text-center py-2">
                <div style="font-size: 1.6rem; font-weight: 800; color: var(--ap-color-warning, #d97706);"
                     data-counter="late">{{ count_late }}</div>
                <div class="text-muted small text-uppercase">{{# str }}attendance_status_late, local_airpay_classroom{{/ str }}</div>
            </div>
        </div></div>
        <div class="col-md-3 col-6 mb-2"><div class="card border-0 shadow-sm">
            <div class="card-body text-center py-2">
                <div style="font-size: 1.6rem; font-weight: 800; color: var(--ap-color-info, #0066A7);"
                     data-counter="excused">{{ count_excused }}</div>
                <div class="text-muted small text-uppercase">{{# str }}attendance_status_excused, local_airpay_classroom{{/ str }}</div>
            </div>
        </div></div>
        <div class="col-md-3 col-6 mb-2"><div class="card border-0 shadow-sm">
            <div class="card-body text-center py-2">
                <div style="font-size: 1.6rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);"
                     data-counter="absent">{{ count_absent }}</div>
                <div class="text-muted small text-uppercase">{{# str }}attendance_status_absent, local_airpay_classroom{{/ str }}</div>
            </div>
        </div></div>
    </div>

    {{# has_rows }}
    {{! ── Bulk actions ─────────────────────────────────────────────── }}
    {{# can_attend }}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <button type="button" class="btn btn-outline-success btn-sm" data-action="mark-all-present">
                <i class="fa fa-check fa-fw"></i> {{# str }}mark_all_present, local_airpay_classroom{{/ str }}
            </button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted" data-region="dirty-hint" hidden>
                <i class="fa fa-circle text-warning"></i> Unsaved changes
            </span>
            <button type="button" class="btn btn-primary btn-sm" data-action="save-attendance">
                <i class="fa fa-save fa-fw"></i> {{# str }}save_attendance, local_airpay_classroom{{/ str }}
            </button>
        </div>
    </div>
    {{/ can_attend }}

    {{! ── Roster ───────────────────────────────────────────────────── }}
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" data-region="attendance-grid">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 40%;">Name</th>
                    <th scope="col" class="text-center" style="width: 13%;">{{# str }}attendance_status_absent, local_airpay_classroom{{/ str }}</th>
                    <th scope="col" class="text-center" style="width: 13%;">{{# str }}attendance_status_present, local_airpay_classroom{{/ str }}</th>
                    <th scope="col" class="text-center" style="width: 13%;">{{# str }}attendance_status_late, local_airpay_classroom{{/ str }}</th>
                    <th scope="col" class="text-center" style="width: 13%;">{{# str }}attendance_status_excused, local_airpay_classroom{{/ str }}</th>
                    <th scope="col" style="width: 8%;">Last marked</th>
                </tr>
            </thead>
            <tbody>
                {{# rows }}
                <tr data-userid="{{ userid }}">
                    <td>
                        <div class="fw-semibold">{{ fullname }}</div>
                        <div class="small text-muted">{{ email }}</div>
                    </td>
                    <td class="text-center">
                        <input type="radio" name="att_{{ userid }}" value="0" data-userid="{{ userid }}" data-status="0"
                            {{# is_absent }}checked{{/ is_absent }}
                            {{^ can_attend }}disabled{{/ can_attend }}
                            aria-label="Mark absent">
                    </td>
                    <td class="text-center">
                        <input type="radio" name="att_{{ userid }}" value="1" data-userid="{{ userid }}" data-status="1"
                            {{# is_present }}checked{{/ is_present }}
                            {{^ can_attend }}disabled{{/ can_attend }}
                            aria-label="Mark present">
                    </td>
                    <td class="text-center">
                        <input type="radio" name="att_{{ userid }}" value="2" data-userid="{{ userid }}" data-status="2"
                            {{# is_late }}checked{{/ is_late }}
                            {{^ can_attend }}disabled{{/ can_attend }}
                            aria-label="Mark late">
                    </td>
                    <td class="text-center">
                        <input type="radio" name="att_{{ userid }}" value="3" data-userid="{{ userid }}" data-status="3"
                            {{# is_excused }}checked{{/ is_excused }}
                            {{^ can_attend }}disabled{{/ can_attend }}
                            aria-label="Mark excused">
                    </td>
                    <td class="small text-muted">{{ marked_at }}</td>
                </tr>
                {{/ rows }}
            </tbody>
        </table>
        </div>
    </div>
    {{/ has_rows }}

    {{^ has_rows }}
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted fst-italic mb-2">{{# str }}no_attendance_yet, local_airpay_classroom{{/ str }}</p>
            <a href="{{{ back_url }}}" class="btn btn-outline-primary btn-sm">
                Back to classroom — enrol users first
            </a>
        </div>
    </div>
    {{/ has_rows }}

</div>

{{# js }}
require(['local_airpay_classroom/attendance'], function(Attendance) {
    Attendance.init({{ sessionid }});
});
{{/ js }}
