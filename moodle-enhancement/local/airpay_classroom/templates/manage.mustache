{{!
    Airpay Classroom Training — ILT session management.
    @template local_airpay_classroom/manage
}}
<style>
    [data-region="airpay-classroom"] .dropdown-toggle.no-arrow::after { display: none !important; }
    [data-region="airpay-classroom"] .dropdown-toggle.no-arrow { box-shadow: none; background: none; border: none; }
    [data-region="airpay-classroom"] .dropdown-toggle.no-arrow:hover { color: var(--ap-color-primary, #0066A7) !important; }
</style>

<div data-region="airpay-classroom">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Classroom Training</h2>
        <p class="text-muted mb-0">Manage instructor-led sessions, attendance, and trainer assignments.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-classroom">
        <i class="fa fa-plus fa-fw"></i> Create Classroom
    </a>
    {{/can_manage}}
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total}}</div>
            <div class="text-muted small text-uppercase">Total Classrooms</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active}}</div>
            <div class="text-muted small text-uppercase">Active</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-accent, #0f7a73);">{{completed}}</div>
            <div class="text-muted small text-uppercase">Completed</div>
        </div></div>
    </div>
</div>

{{#has_data}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Classroom Name</th>
            <th>Location</th>
            <th class="text-center">Capacity</th>
            <th class="text-center">Enrolled</th>
            <th>Status</th>
            {{#can_manage}}<th class="text-end pe-3">Actions</th>{{/can_manage}}
        </tr></thead>
        <tbody>
            {{#classrooms}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td class="small text-muted">{{location}}</td>
                <td class="text-center">{{capacity}}</td>
                <td class="text-center">{{enrolled}}</td>
                <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                {{#can_manage}}
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 dropdown-toggle no-arrow"
                                data-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="edit-classroom" data-classroomid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-pencil fa-fw"></i> Edit
                                </a>
                            </li>
                            {{#is_active}}
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="complete-classroom" data-classroomid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-check-circle fa-fw text-success"></i> Mark Completed
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="cancel-classroom" data-classroomid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-ban fa-fw text-warning"></i> Cancel
                                </a>
                            </li>
                            {{/is_active}}
                            {{^is_active}}
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="reopen-classroom" data-classroomid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-undo fa-fw text-primary"></i> Reopen
                                </a>
                            </li>
                            {{/is_active}}
                            {{#can_delete}}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#"
                                   data-action="delete-classroom" data-classroomid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-trash fa-fw"></i> Delete
                                </a>
                            </li>
                            {{/can_delete}}
                        </ul>
                    </div>
                </td>
                {{/can_manage}}
            </tr>
            {{/classrooms}}
        </tbody>
    </table>
</div></div>
{{/has_data}}

{{^has_data}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-calendar fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No classrooms yet</h5>
    <p class="text-muted mb-3">Schedule instructor-led training sessions for your teams.</p>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-classroom">
        <i class="fa fa-plus fa-fw"></i> Create First Classroom
    </a>
    {{/can_manage}}
</div></div>
{{/has_data}}

</div>
{{#js}}
require(['local_airpay_classroom/classroom_actions'], function(ClassroomActions) {
    ClassroomActions.init();
});
{{/js}}
