{{!
    Airpay Learning Paths — admin management.
    @template local_airpay_learningpath/manage
}}
<style>
    [data-region="airpay-learningpath"] .dropdown-toggle.no-arrow::after { display: none !important; }
    [data-region="airpay-learningpath"] .dropdown-toggle.no-arrow { box-shadow: none; background: none; border: none; }
    [data-region="airpay-learningpath"] .dropdown-toggle.no-arrow:hover { color: var(--ap-color-primary, #0066A7) !important; }
</style>

<div data-region="airpay-learningpath">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Learning Paths</h2>
        <p class="text-muted mb-0">Create ordered course sequences to guide employees through structured learning journeys.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-path">
        <i class="fa fa-plus fa-fw"></i> Create Path
    </a>
    {{/can_manage}}
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total}}</div>
            <div class="text-muted small text-uppercase">Total Paths</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active}}</div>
            <div class="text-muted small text-uppercase">Active</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{archived}}</div>
            <div class="text-muted small text-uppercase">Archived</div>
        </div></div>
    </div>
</div>

{{#has_data}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Path Name</th>
            <th>Description</th>
            <th class="text-center">Courses</th>
            <th>Status</th>
            {{#can_manage}}<th class="text-end pe-3">Actions</th>{{/can_manage}}
        </tr></thead>
        <tbody>
            {{#paths}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td class="small text-muted" style="max-width: 400px;">{{#description}}{{.}}{{/description}}{{^description}}—{{/description}}</td>
                <td class="text-center">{{coursecount}}</td>
                <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                {{#can_manage}}
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 dropdown-toggle no-arrow"
                                data-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li>
                                <a class="dropdown-item" href="#"
                                   data-action="edit-path" data-pathid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-pencil fa-fw"></i> Edit
                                </a>
                            </li>
                            <li>
                                {{#is_active}}
                                <a class="dropdown-item" href="#"
                                   data-action="archive-path" data-pathid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-archive fa-fw text-warning"></i> Archive
                                </a>
                                {{/is_active}}
                                {{^is_active}}
                                <a class="dropdown-item" href="#"
                                   data-action="activate-path" data-pathid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-undo fa-fw text-success"></i> Activate
                                </a>
                                {{/is_active}}
                            </li>
                            {{#can_delete}}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#"
                                   data-action="delete-path" data-pathid="{{id}}" data-name="{{name}}">
                                    <i class="fa fa-trash fa-fw"></i> Delete
                                </a>
                            </li>
                            {{/can_delete}}
                        </ul>
                    </div>
                </td>
                {{/can_manage}}
            </tr>
            {{/paths}}
        </tbody>
    </table>
</div></div>
{{/has_data}}

{{^has_data}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-map-signs fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No learning paths yet</h5>
    <p class="text-muted mb-3">Design structured learning journeys by ordering courses into sequential paths.</p>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-path">
        <i class="fa fa-plus fa-fw"></i> Create First Path
    </a>
    {{/can_manage}}
</div></div>
{{/has_data}}

</div>
{{#js}}
require(['local_airpay_learningpath/path_actions'], function(PathActions) {
    PathActions.init();
});
{{/js}}
