<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_programs/db" VERSION="20260930"
       COMMENT="Airpay Certification Programs — multi-level certification tracks">
  <TABLES>
    <TABLE NAME="local_sentientia_programs" COMMENT="Certification programs (replaces BizLMS local_program)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="254" NOTNULL="true"/>
        <FIELD NAME="description"     TYPE="text" NOTNULL="false"
               COMMENT="P1 #9 (2026-05-16): now rendered via rich-text editor on edit form"/>
        <FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1"
               COMMENT="P1 #9 (2026-05-16): FORMAT_HTML(1) | FORMAT_PLAIN(2) | FORMAT_MARKDOWN(4)"/>
        <FIELD NAME="costcenterid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant org ID"/>
        <FIELD NAME="open_path"       TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="1"
               COMMENT="0=draft, 1=active, 2=archived"/>
        <FIELD NAME="visible"         TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="startdate"       TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="P1 #9 (2026-05-16): UNIX ts; program becomes enrollable from this date"/>
        <FIELD NAME="enddate"         TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="P1 #9 (2026-05-16): UNIX ts; program closes for new enrolments after this date"/>
        <FIELD NAME="completion_required"  TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"
               COMMENT="1=all levels required, 0=any level completes program"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_status"     UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_levels" COMMENT="Levels within a program (sequential certification tiers)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="programid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="254" NOTNULL="true"/>
        <FIELD NAME="description"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sortorder"       TYPE="int"  LENGTH="6"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completion_required"  TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"
               COMMENT="1=must complete to proceed, 0=optional"/>
        <FIELD NAME="completion_rule" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="all"
               COMMENT="all = every mandatory course completes the level, any = one mandatory course is enough (ADR-032, BizLMS coursetracking OR)"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"     TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_program"  TYPE="foreign" FIELDS="programid" REFTABLE="local_sentientia_programs" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_program_sort" UNIQUE="false" FIELDS="programid, sortorder"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_courses" COMMENT="Courses assigned to a level">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="levelid"         TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sortorder"       TYPE="int"  LENGTH="6"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="mandatory"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_level"  TYPE="foreign" FIELDS="levelid" REFTABLE="local_sentientia_programs_levels" REFFIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_level_course" UNIQUE="true" FIELDS="levelid, courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_users" COMMENT="User enrolments in programs">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="programid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="currentlevelid" TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Current level user is on (NULL = not started)"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"
               COMMENT="0=enrolled, 1=in_progress, 2=completed"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecompleted"   TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="enrolledby"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Actor: the user who enrolled this learner (0 = unknown). Anonymised when that user is erased (ADR-032)"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"     TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_program"  TYPE="foreign" FIELDS="programid" REFTABLE="local_sentientia_programs" REFFIELDS="id"/>
        <KEY NAME="fk_user"     TYPE="foreign" FIELDS="userid"    REFTABLE="user"                   REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_program_user" UNIQUE="true"  FIELDS="programid, userid"/>
        <INDEX NAME="idx_status"       UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_lvlcomp" COMMENT="Stored level completions per learner (ADR-032: BizLMS local_bc_level_completions, completed rows only). The history readers and the program state read it.">
      <FIELDS>
        <FIELD NAME="id"                 TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="programid"          TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="levelid"            TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"             TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status"             TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"
               COMMENT="0=not completed, 1=completed"/>
        <FIELD NAME="timecompleted"      TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="When the level was completed (NULL when the source never recorded it)"/>
        <FIELD NAME="completedcourseids" TYPE="text" NOTNULL="false"
               COMMENT="Audit only: the course ids BizLMS recorded for the completion. Its format was inconsistent"/>
        <FIELD NAME="source"             TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="bizlms"
               COMMENT="Where the row came from: bizlms for imported rows"/>
        <FIELD NAME="timecreated"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_program" TYPE="foreign" FIELDS="programid" REFTABLE="local_sentientia_programs" REFFIELDS="id"/>
        <KEY NAME="fk_level"   TYPE="foreign" FIELDS="levelid"   REFTABLE="local_sentientia_programs_levels" REFFIELDS="id"/>
        <KEY NAME="fk_user"    TYPE="foreign" FIELDS="userid"    REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_level_user"   UNIQUE="true"  FIELDS="levelid, userid"/>
        <INDEX NAME="idx_program_user" UNIQUE="false" FIELDS="programid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_trainers" COMMENT="Trainers assigned to a program (ADR-032: BizLMS local_program_trainers, imported only when that table holds rows; no Sentientia writer yet)">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="programid"      TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="The trainer"/>
        <FIELD NAME="feedbackid"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Evaluation form id (evaluation ids are preserved by the import)"/>
        <FIELD NAME="feedback_score" TYPE="char" LENGTH="45" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="assignedby"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Actor: the user who assigned the trainer (0 = unknown)"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_program" TYPE="foreign" FIELDS="programid" REFTABLE="local_sentientia_programs" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_program_user" UNIQUE="false" FIELDS="programid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_programs_trainerfb" COMMENT="Feedback given on a program trainer (ADR-032: BizLMS local_program_trainerfb, imported only when that table holds rows; no Sentientia writer yet)">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="programtrainerid" TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="The local_sentientia_programs_trainers row the feedback is about"/>
        <FIELD NAME="programid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="trainerid"        TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="The trainer the feedback is about (a user id)"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="The learner who gave the feedback (NULL when unknown or anonymised)"/>
        <FIELD NAME="score"            TYPE="char" LENGTH="45" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_program" TYPE="foreign" FIELDS="programid" REFTABLE="local_sentientia_programs" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_trainer" UNIQUE="false" FIELDS="programtrainerid"/>
        <INDEX NAME="idx_program_user" UNIQUE="false" FIELDS="programid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
