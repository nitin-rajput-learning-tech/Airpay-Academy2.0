<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>{{firstname}}</strong>,</p>
    <p style="margin:0 0 16px;">
        We received a request to reset your {{tenant_name}} password.
        Click the button below to set a new password.
    </p>
</td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
    <td align="center" bgcolor="#0066A7" style="background-color:#0066A7; border-radius:8px;">
        <a href="{{reset_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
            Reset Password
        </a>
    </td>
</tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; line-height:20px;">
    <p style="margin:0 0 8px;">This link expires in <strong>{{reset_expiry}}</strong>.</p>
    <p style="margin:0 0 8px;">If you didn't request this, please ignore this email — your password will remain unchanged.</p>
</td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0; border-top:1px solid #e2e6ef; padding-top:12px;">
<tr>
    <td style="font-family:'Montserrat',Arial,sans-serif; font-size:11px; color:#8890a0;">
        Request from IP: {{ip_address}}<br/>
        If this wasn't you, contact <a href="mailto:{{support_email}}" style="color:#0066A7; text-decoration:none;">{{support_email}}</a> immediately.
    </td>
</tr>
</table>
