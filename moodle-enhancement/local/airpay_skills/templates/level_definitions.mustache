{{!
   Skill-level definitions admin — one skill, all its levels.
}}
<div class="ap-card mb-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div>
      <a href="{{ admin_url }}" class="text-muted text-decoration-none small">
        <i class="fa fa-chevron-left me-1"></i>Skills Management
      </a>
      <h1 class="h3 m-0 mt-1">
        Level definitions: <strong>{{ skill.name }}</strong>
      </h1>
      <p class="text-muted small mb-0">
        Category: <span class="badge" style="background-color: {{ skill.category_color }}; color: #fff;">{{ skill.category_name }}</span>
        &middot; Max level: {{ skill.max_level }}
      </p>
    </div>
  </div>

  <div class="alert alert-info">
    Define what each level means. Required-level checks for designations
    + course-completion-to-skill-credit decisions read from these definitions.
  </div>

  <table class="table table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th style="width:80px;">Level</th>
        <th style="width:200px;">Label</th>
        <th>Description</th>
        <th style="width:120px;">Status</th>
        <th style="width:90px;">Action</th>
      </tr>
    </thead>
    <tbody>
      {{# levels }}
      <tr>
        <td><strong>L{{ level }}</strong></td>
        <td>{{ label }}</td>
        <td>{{# description }}{{ description }}{{/ description }}{{^ description }}<em class="text-muted">No description</em>{{/ description }}</td>
        <td>
          {{# saved }}<span class="badge bg-success">Saved</span>{{/ saved }}
          {{^ saved }}<span class="badge bg-secondary">Default</span>{{/ saved }}
        </td>
        <td>
          <button type="button" class="btn btn-sm btn-link text-muted p-1"
                  data-action="edit-level"
                  data-skillid="{{ skill.id }}"
                  data-level="{{ level }}">
            <i class="fa fa-pencil"></i>
          </button>
        </td>
      </tr>
      {{/ levels }}
    </tbody>
  </table>
</div>
