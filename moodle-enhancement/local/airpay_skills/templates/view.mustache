{{!
    @template local_airpay_skills/view
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">{{ name }}</h2>
            <div class="small text-muted">
                <i class="fa fa-tag"></i> {{ category_name }}
                · Max level: <strong>{{ max_level }}</strong>
            </div>
        </div>
        <a href="{{{ back_url }}}" class="btn btn-link">
            <i class="fa fa-arrow-left"></i> All skills
        </a>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link {{#tab_overview_active}}active{{/tab_overview_active}}"
               href="{{{ tab_overview_url }}}">Overview</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#tab_levels_active}}active{{/tab_levels_active}}"
               href="{{{ tab_levels_url }}}">
                Levels <span class="badge bg-secondary ms-1">{{ count_levels }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#tab_designations_active}}active{{/tab_designations_active}}"
               href="{{{ tab_designations_url }}}">
                Designations <span class="badge bg-secondary ms-1">{{ count_designations }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#tab_courses_active}}active{{/tab_courses_active}}"
               href="{{{ tab_courses_url }}}">
                Courses <span class="badge bg-secondary ms-1">{{ count_courses }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#tab_learners_active}}active{{/tab_learners_active}}"
               href="{{{ tab_learners_url }}}">
                Learners <span class="badge bg-secondary ms-1">{{ count_learners }}</span>
            </a>
        </li>
    </ul>

    {{#tab_overview_active}}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            {{#has_description}}
            <h5>About this skill</h5>
            {{{ description }}}
            {{/has_description}}
            {{^has_description}}
            <p class="text-muted">No description set.</p>
            {{/has_description}}
        </div>
    </div>
    {{/tab_overview_active}}

    {{#tab_levels_active}}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Level definitions</h5>
        <a href="{{{ edit_url }}}" class="btn btn-outline-primary btn-sm">
            <i class="fa fa-pencil"></i> Edit definitions
        </a>
    </div>
    {{#has_levels}}
    <table class="table">
        <thead><tr><th>Level</th><th>Name</th><th>Description</th></tr></thead>
        <tbody>
            {{#levels}}
            <tr>
                <td><span class="badge bg-primary">L{{ level_index }}</span></td>
                <td><strong>{{ name }}</strong></td>
                <td>{{{ description }}}</td>
            </tr>
            {{/levels}}
        </tbody>
    </table>
    {{/has_levels}}
    {{^has_levels}}
    <div class="alert alert-warning">
        No level definitions configured. Click "Edit definitions" to add the {{ max_level }} level entries for this skill.
    </div>
    {{/has_levels}}
    {{/tab_levels_active}}

    {{#tab_designations_active}}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Designations expecting this skill</h5>
        <a href="{{{ matrix_url }}}" class="btn btn-outline-primary btn-sm">
            <i class="fa fa-th"></i> Designation matrix
        </a>
    </div>
    {{#has_designations}}
    <table class="table">
        <thead><tr><th>Designation</th><th>Required level</th></tr></thead>
        <tbody>
            {{#designations}}
            <tr>
                <td>{{ designation }}</td>
                <td><span class="badge bg-primary">L{{ required_level }}</span></td>
            </tr>
            {{/designations}}
        </tbody>
    </table>
    {{/has_designations}}
    {{^has_designations}}
    <div class="alert alert-info">
        No designations have this skill expected yet.
        Use the <strong>Designation matrix</strong> to map this skill to roles.
    </div>
    {{/has_designations}}
    {{/tab_designations_active}}

    {{#tab_courses_active}}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Courses developing this skill</h5>
        <a href="{{{ map_url }}}" class="btn btn-outline-primary btn-sm">
            <i class="fa fa-link"></i> Course mapping
        </a>
    </div>
    {{#has_courses}}
    <table class="table">
        <thead><tr><th>Course</th><th>Short name</th><th>Visibility</th><th></th></tr></thead>
        <tbody>
            {{#courses}}
            <tr>
                <td><strong>{{ fullname }}</strong></td>
                <td><code>{{ shortname }}</code></td>
                <td>{{#visible}}<span class="badge bg-success">Visible</span>{{/visible}}
                    {{^visible}}<span class="badge bg-secondary">Hidden</span>{{/visible}}
                </td>
                <td><a href="{{{ view_url }}}" class="btn btn-sm btn-link">
                    <i class="fa fa-users"></i> Enrolments
                </a></td>
            </tr>
            {{/courses}}
        </tbody>
    </table>
    {{/has_courses}}
    {{^has_courses}}
    <div class="alert alert-info">
        No courses mapped to this skill yet.
        Use the <strong>Course mapping</strong> page to link courses that develop this skill.
    </div>
    {{/has_courses}}
    {{/tab_courses_active}}

    {{#tab_learners_active}}
    <h5>Learners with this skill</h5>
    {{#has_learners}}
    <table class="table">
        <thead><tr><th>Name</th><th>Email</th><th>Current level</th><th>Updated</th></tr></thead>
        <tbody>
            {{#learners}}
            <tr>
                <td>{{ fullname }}</td>
                <td><code class="small">{{ email }}</code></td>
                <td><span class="badge bg-primary">L{{ current_level }}</span></td>
                <td class="small text-muted">{{ updated_on }}</td>
            </tr>
            {{/learners}}
        </tbody>
    </table>
    {{/has_learners}}
    {{^has_learners}}
    <div class="alert alert-info">
        No learners have this skill recorded yet.
        Skills are added as users complete mapped courses or pass assessments.
    </div>
    {{/has_learners}}
    {{/tab_learners_active}}
</div>
