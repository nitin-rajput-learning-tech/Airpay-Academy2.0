{{!
    @template local_airpay_skills/dashboard
    Skills Dashboard — gap analysis, radar chart, recommended courses.
}}
<div class="ap-skills">

    {{! KPI Summary }}
    <div class="ap-skills__summary">
        <div class="ap-skills__summary-ring">
            <svg width="90" height="90" viewBox="0 0 90 90">
                <circle cx="45" cy="45" r="38" fill="none" stroke="var(--ap-border, #e3eaf3)" stroke-width="6"/>
                <circle cx="45" cy="45" r="38" fill="none" stroke="var(--ap-primary, #0066A7)" stroke-width="6"
                        stroke-linecap="round" stroke-dasharray="238.76"
                        stroke-dashoffset="{{summary_offset}}"
                        style="transform:rotate(-90deg); transform-origin:center; transition: stroke-dashoffset 1s ease;"/>
            </svg>
            <span class="ap-skills__summary-pct">{{summary.percentage}}%</span>
        </div>
        <div class="ap-skills__summary-text">
            <h3>Skill Readiness</h3>
            <p>{{summary.met}} of {{summary.total}} skills met for <strong>{{designation}}</strong></p>
            {{#summary.gaps}}
            <span class="ap-skills__summary-gaps">
                <i class="fa fa-exclamation-triangle"></i> {{summary.gaps}} skill gaps to close
            </span>
            {{/summary.gaps}}
            {{^summary.gaps}}
            <span class="ap-skills__summary-complete">
                <i class="fa fa-check-circle"></i> All skills met!
            </span>
            {{/summary.gaps}}
        </div>
    </div>

    {{! Radar Chart (Canvas — rendered by JS below) }}
    {{#has_radar}}
    <div class="ap-skills__section">
        <h3 class="ap-skills__section-title"><i class="fa fa-line-chart"></i> Skills Radar</h3>
        <div class="ap-skills__radar-wrap">
            <canvas id="ap-skills-radar" width="360" height="360"></canvas>
        </div>
    </div>
    {{/has_radar}}

    {{! Gap Analysis Table }}
    {{#has_data}}
    <div class="ap-skills__section">
        <h3 class="ap-skills__section-title"><i class="fa fa-th-list"></i> Gap Analysis</h3>
        <div class="ap-skills__gap-list">
            {{#skills}}
            <div class="ap-skills__gap-item ap-skills__gap-item--{{status}}">
                <div class="ap-skills__gap-info">
                    <span class="ap-skills__gap-name">{{skill_name}}</span>
                    <span class="ap-skills__gap-category" {{#category_color}}style="background:{{category_color}}20; color:{{category_color}};"{{/category_color}}>
                        {{category_name}}
                    </span>
                </div>
                <div class="ap-skills__gap-levels">
                    <div class="ap-skills__gap-bar-wrap">
                        <div class="ap-skills__gap-bar" style="width:{{progress_pct}}%;"></div>
                    </div>
                    <span class="ap-skills__gap-current">{{current_label}}</span>
                    <span class="ap-skills__gap-arrow">→</span>
                    <span class="ap-skills__gap-required">{{required_label}}</span>
                </div>
                <div class="ap-skills__gap-status">
                    {{#is_met}}<span class="ap-badge ap-badge--success"><i class="fa fa-check"></i> Met</span>{{/is_met}}
                    {{#is_partial}}<span class="ap-badge ap-badge--warning"><i class="fa fa-arrow-up"></i> In Progress</span>{{/is_partial}}
                    {{#is_missing}}<span class="ap-badge ap-badge--danger"><i class="fa fa-times"></i> Missing</span>{{/is_missing}}
                </div>
            </div>
            {{/skills}}
        </div>
    </div>
    {{/has_data}}

    {{! Recommended Courses }}
    {{#has_recommendations}}
    <div class="ap-skills__section">
        <h3 class="ap-skills__section-title"><i class="fa fa-graduation-cap"></i> Recommended to Close Gaps</h3>
        <div class="ap-skills__recs">
            {{#recommendations}}
            <a href="{{detailurl}}" class="ap-skills__rec-card">
                <div class="ap-skills__rec-icon">
                    <i class="fa fa-book"></i>
                </div>
                <div class="ap-skills__rec-info">
                    <h5>{{coursename}}</h5>
                    <span>Teaches: {{skill_name}} → {{teaches_label}}</span>
                </div>
                <i class="fa fa-chevron-right ap-skills__rec-arrow"></i>
            </a>
            {{/recommendations}}
        </div>
    </div>
    {{/has_recommendations}}

    {{^has_data}}
    <div class="ap-empty-state">
        <i class="fa fa-line-chart ap-empty-state__icon"></i>
        <h4 class="ap-empty-state__title">No skills data yet</h4>
        <p class="ap-empty-state__message">Skills are mapped to your role. Contact your L&D team if your designation isn't set.</p>
    </div>
    {{/has_data}}
</div>

{{! Radar Chart JS — uses data injected from PHP }}
{{#has_radar}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var canvas = document.getElementById('ap-skills-radar');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var labels = {{{radar_labels}}};
    var current = {{{radar_current}}};
    var required = {{{radar_required}}};
    var n = labels.length;
    if (n < 3) return;

    var cx = 180, cy = 180, maxR = 140;
    var maxVal = 5;

    function getPoint(i, val) {
        var angle = (Math.PI * 2 / n) * i - Math.PI / 2;
        var r = (val / maxVal) * maxR;
        return { x: cx + r * Math.cos(angle), y: cy + r * Math.sin(angle) };
    }

    // Draw grid rings.
    ctx.strokeStyle = '#e3eaf3';
    ctx.lineWidth = 1;
    for (var ring = 1; ring <= 5; ring++) {
        ctx.beginPath();
        for (var i = 0; i <= n; i++) {
            var p = getPoint(i % n, ring);
            i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
        }
        ctx.closePath();
        ctx.stroke();
    }

    // Draw spokes.
    for (var i = 0; i < n; i++) {
        var p = getPoint(i, maxVal);
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
    }

    // Draw required (filled background).
    ctx.fillStyle = 'rgba(0,102,167,0.1)';
    ctx.strokeStyle = '#0066A7';
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 3]);
    ctx.beginPath();
    for (var i = 0; i < n; i++) {
        var p = getPoint(i, required[i]);
        i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Draw current (solid line).
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(15,122,115,0.2)';
    ctx.strokeStyle = '#0f7a73';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (var i = 0; i < n; i++) {
        var p = getPoint(i, current[i]);
        i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Draw dots.
    for (var i = 0; i < n; i++) {
        var p = getPoint(i, current[i]);
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#0f7a73';
        ctx.fill();
    }

    // Labels.
    ctx.fillStyle = '#1a1a2e';
    ctx.font = '11px Montserrat, sans-serif';
    ctx.textAlign = 'center';
    for (var i = 0; i < n; i++) {
        var p = getPoint(i, maxVal + 0.7);
        ctx.fillText(labels[i], p.x, p.y + 4);
    }
});
</script>
{{/has_radar}}
