<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_skills/db" VERSION="20260410"
       COMMENT="Airpay Skills Matrix - competency framework for fintech">
  <TABLES>

    <TABLE NAME="local_airpay_skill_cats"
           COMMENT="Skill categories (Compliance, Technical, Leadership, etc.)">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="icon"        TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="fa-cogs"/>
        <FIELD NAME="color"       TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="#0066A7"/>
        <FIELD NAME="sort_order"  TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
    </TABLE>

    <TABLE NAME="local_airpay_skills"
           COMMENT="Individual skills within categories">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="max_level"   TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="5"
               COMMENT="Scale: 1=Awareness, 2=Basic, 3=Intermediate, 4=Advanced, 5=Expert"/>
        <FIELD NAME="sort_order"  TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_cat"  TYPE="foreign" FIELDS="categoryid" REFTABLE="local_airpay_skill_cats" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_categoryid" UNIQUE="false" FIELDS="categoryid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_role_skills"
           COMMENT="Required skills per role/designation">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="designation"    TYPE="char" LENGTH="200" NOTNULL="true"
               COMMENT="Maps to user.open_designation field"/>
        <FIELD NAME="skillid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="required_level" TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="3"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_skill" TYPE="foreign" FIELDS="skillid" REFTABLE="local_airpay_skills" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_designation"       UNIQUE="false" FIELDS="designation"/>
        <INDEX NAME="idx_designation_skill" UNIQUE="true"  FIELDS="designation, skillid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_course_skills"
           COMMENT="Which skills a course teaches">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"      TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="skillid"       TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="teaches_level" TYPE="int" LENGTH="2"  NOTNULL="true" DEFAULT="1"
               COMMENT="Level this course can bring you to (1-5)"/>
        <FIELD NAME="timecreated"   TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="fk_skill"  TYPE="foreign" FIELDS="skillid"  REFTABLE="local_airpay_skills" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_courseid"       UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_course_skill"   UNIQUE="true"  FIELDS="courseid, skillid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_skill_levels"
           COMMENT="Per-skill level definitions (e.g. Python L1='Hello world', L5='Architect Python infra'). One row per (skillid, level) pair.">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="skillid"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="level"       TYPE="int"  LENGTH="2"   NOTNULL="true" DEFAULT="1"
               COMMENT="Level number (1-5; capped by parent skill.max_level)"/>
        <FIELD NAME="label"       TYPE="char" LENGTH="100" NOTNULL="true"
               COMMENT="Short display label (e.g. 'Awareness', 'Basic', 'Expert')"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"
               COMMENT="Markdown describing what this level requires / demonstrates"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_skill" TYPE="foreign" FIELDS="skillid" REFTABLE="local_airpay_skills" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_skill_level" UNIQUE="true" FIELDS="skillid, level"
               COMMENT="One level definition per skill+level pair"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_user_skills"
           COMMENT="User's current skill levels (earned through courses/assessments)">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="skillid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="current_level" TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="source"        TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="course"
               COMMENT="course|assessment|manual|import"/>
        <FIELD NAME="source_id"     TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Course ID or assessment ID that granted this level"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user"  TYPE="foreign" FIELDS="userid"  REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_skill" TYPE="foreign" FIELDS="skillid" REFTABLE="local_airpay_skills" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid"       UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_user_skill"   UNIQUE="true"  FIELDS="userid, skillid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_user_skill_hist"
           COMMENT="P1 #22: append-only audit log of every skill-level change. Lets HR answer 'when did Alice's Python level go from 2 to 4?'. Closes audit item #23 from parity-audit-2026-05-15/airpay_skills.md.">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="The user whose level changed"/>
        <FIELD NAME="skillid"          TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK to local_airpay_skills.id"/>
        <FIELD NAME="previous_level"   TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"
               COMMENT="Level before the change (0 = had no level before)"/>
        <FIELD NAME="new_level"        TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"
               COMMENT="Level after the change"/>
        <FIELD NAME="source"           TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="course"
               COMMENT="course|assessment|manual|import — what triggered the change"/>
        <FIELD NAME="source_id"        TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Course/assessment id when source != manual"/>
        <FIELD NAME="changed_by_userid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="Acting user id (null for cron-driven/auto changes)"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user"  TYPE="foreign" FIELDS="userid"  REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_skill" TYPE="foreign" FIELDS="skillid" REFTABLE="local_airpay_skills" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <!-- NB: a single-column FK on userid implicitly creates an index
             on `userid`, so we do NOT declare one here. -->
        <INDEX NAME="idx_user_skill_t" UNIQUE="false" FIELDS="userid, skillid, timecreated"
               COMMENT="Skill-specific timeline: 'show me Alice's Python progression'"/>
        <INDEX NAME="idx_changed_by"   UNIQUE="false" FIELDS="changed_by_userid"
               COMMENT="Reverse lookup: 'show me every level change Bob made as a manager'"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
