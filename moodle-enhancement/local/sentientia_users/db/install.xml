<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_users/db" VERSION="20260516"
       COMMENT="W1-6 (2026-05-16) — HRMS sync runs + error log for 24-column Darwinbox/SAP CSV bulk import">

  <TABLES>

    <TABLE NAME="local_sentientia_users_sync_runs"
           COMMENT="One row per HRMS bulk-import event. Source: web upload or cron pull.">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="filename"       TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""
               COMMENT="Original uploaded filename for audit"/>
        <FIELD NAME="source"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="web"
               COMMENT="web | cron | api"/>
        <FIELD NAME="costcenterid"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant root the caller was scoped to (0 = siteadmin global)"/>
        <FIELD NAME="totalrows"      TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="insertedcount"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="updatedcount"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="skippedcount"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Rows skipped because no change needed (idempotent re-runs)"/>
        <FIELD NAME="errorcount"     TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="warningcount"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Includes pass-2 unresolved manager links"/>
        <FIELD NAME="suspendedcount" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="Users moved to suspended state via employee_status enum"/>
        <FIELD NAME="usercreated"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"
               COMMENT="FK to mdl_user.id of admin who ran the import"/>
        <FIELD NAME="status"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="completed"
               COMMENT="queued | running | completed | failed"/>
        <FIELD NAME="error_summary"  TYPE="text" NOTNULL="false"
               COMMENT="Top-level fatal-error string when status=failed"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_time"       UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="idx_status"     UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_users_sync_errors"
           COMMENT="One row per CSV row that failed validation or upsert during an HRMS sync.">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="runid"            TYPE="int"  LENGTH="10" NOTNULL="true"
               COMMENT="FK to local_sentientia_users_sync_runs.id"/>
        <FIELD NAME="csv_line_number"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Row number in the source CSV (header = 1, first data row = 2)"/>
        <FIELD NAME="email"            TYPE="char" LENGTH="254" NOTNULL="true" DEFAULT="-"/>
        <FIELD NAME="employee_code"    TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="-"/>
        <FIELD NAME="username"         TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="-"/>
        <FIELD NAME="firstname"        TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="lastname"         TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="error_message"    TYPE="text" NOTNULL="true"
               COMMENT="Pipe-separated list of validation messages for this row"/>
        <FIELD NAME="mandatory_fields" TYPE="text" NOTNULL="false"
               COMMENT="Comma-separated list of fields that failed mandatory check"/>
        <FIELD NAME="severity"         TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="error"
               COMMENT="error | warning"/>
        <FIELD NAME="modified_by"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_runid" TYPE="foreign" FIELDS="runid"
             REFTABLE="local_sentientia_users_sync_runs" REFFIELDS="id"
             COMMENT="FK implicitly indexes runid — no separate idx_runid"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_severity" UNIQUE="false" FIELDS="severity"/>
        <INDEX NAME="idx_email"    UNIQUE="false" FIELDS="email"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
