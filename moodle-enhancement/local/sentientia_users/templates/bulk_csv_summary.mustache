{{!
   Bulk CSV processing summary.
   Context vars:
     has_summary       bool
     total             int
     succeeded[], skipped[], failed[]   row arrays
}}
{{# has_summary }}
<div class="ap-card mt-3" data-region="ap-bulk-csv-summary">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h2 class="h5 m-0">Result</h2>
    <div class="d-flex gap-2 small">
      <span class="badge bg-success">{{ succeeded_count }} succeeded</span>
      <span class="badge"
            style="background-color: #5a6070; color: #fff;">{{ skipped_count }} skipped</span>
      <span class="badge bg-danger">{{ failed_count }} failed</span>
      <span class="text-muted">of {{ total }}</span>
    </div>
  </div>

  {{# has_succeeded }}
  <h3 class="h6 text-success">Succeeded</h3>
  <table class="table table-sm align-middle mb-3">
    <thead><tr><th>Email</th><th>Action</th><th>User ID</th></tr></thead>
    <tbody>
      {{# succeeded }}
      <tr>
        <td>{{ email }}</td>
        <td><span class="badge bg-primary">{{ action }}</span></td>
        <td><code>{{ userid }}</code></td>
      </tr>
      {{/ succeeded }}
    </tbody>
  </table>
  {{/ has_succeeded }}

  {{# has_skipped }}
  <h3 class="h6 mt-3" style="color:#5a6070;">Skipped</h3>
  <table class="table table-sm align-middle mb-3">
    <thead><tr><th>Email</th><th>Action</th><th>Reason</th></tr></thead>
    <tbody>
      {{# skipped }}
      <tr>
        <td>{{ email }}</td>
        <td>{{ action }}</td>
        <td class="small">{{ reason }}</td>
      </tr>
      {{/ skipped }}
    </tbody>
  </table>
  {{/ has_skipped }}

  {{# has_failed }}
  <h3 class="h6 text-danger mt-3">Failed</h3>
  <table class="table table-sm align-middle mb-0">
    <thead><tr><th>Email</th><th>Action</th><th>Error</th></tr></thead>
    <tbody>
      {{# failed }}
      <tr>
        <td>{{ email }}</td>
        <td>{{ action }}</td>
        <td class="small text-danger">{{ error }}</td>
      </tr>
      {{/ failed }}
    </tbody>
  </table>
  {{/ has_failed }}
</div>
{{/ has_summary }}
