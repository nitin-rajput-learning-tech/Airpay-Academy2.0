{{!
    @template local_sentientia_users/skillprofile
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">{{ fullname }}</h2>
            <div class="small text-muted">
                {{#has_designation}}<span class="badge bg-secondary">{{ designation }}</span>{{/has_designation}}
                {{^has_designation}}<span class="text-warning">No designation set — expectations unknown.</span>{{/has_designation}}
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="{{{ profile_url }}}" class="btn btn-link"><i class="fa fa-user"></i> Full profile</a>
            <a href="{{{ grade_url }}}" target="_blank" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-graduation-cap"></i> Gradebook
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;">{{ skill_count }}</div>
                <div class="text-muted small text-uppercase">Skills tracked</div>
            </div></div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:var(--ap-color-warning,#d97706);">{{ gap_count }}</div>
                <div class="text-muted small text-uppercase">Skills with gap</div>
            </div></div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:var(--ap-color-primary,#0066A7);">{{ recommendations.length }}</div>
                <div class="text-muted small text-uppercase">Recommended courses</div>
            </div></div>
        </div>
    </div>

    {{#has_skills}}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent"><strong>Skill levels</strong></div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr>
                    <th>Skill</th>
                    <th>Current</th>
                    <th>Expected</th>
                    <th style="width:40%;">Progress</th>
                </tr></thead>
                <tbody>
                {{#skill_rows}}
                <tr>
                    <td><a href="{{{ view_url }}}">{{ name }}</a></td>
                    <td><span class="badge bg-primary">L{{ current }}</span></td>
                    <td>{{#expected}}<span class="badge bg-secondary">L{{ expected }}</span>{{/expected}}
                        {{^expected}}<span class="text-muted small">—</span>{{/expected}}</td>
                    <td>
                        <div class="progress" style="height:8px;">
                            {{#current}}
                            <div class="progress-bar bg-success" role="progressbar"
                                style="width: {{#current}}{{current}}{{/current}}0%;"></div>
                            {{/current}}
                        </div>
                    </td>
                </tr>
                {{/skill_rows}}
                </tbody>
            </table>
        </div>
    </div>
    {{/has_skills}}
    {{^has_skills}}
    <div class="alert alert-info">No skills tracked for this user yet.</div>
    {{/has_skills}}

    {{#has_gaps}}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent">
            <strong>Skills with gap ({{ gap_count }})</strong>
            <span class="text-muted small">— current level below designation-expected</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>Skill</th><th>Current</th><th>Expected</th><th>Gap</th></tr></thead>
                <tbody>
                {{#gap_rows}}
                <tr>
                    <td><a href="{{{ view_url }}}">{{ name }}</a></td>
                    <td><span class="badge bg-primary">L{{ current }}</span></td>
                    <td><span class="badge bg-secondary">L{{ expected }}</span></td>
                    <td><span class="badge bg-warning">+{{ gap }}</span></td>
                </tr>
                {{/gap_rows}}
                </tbody>
            </table>
        </div>
    </div>
    {{/has_gaps}}

    {{#has_recs}}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent">
            <strong>Recommended courses</strong>
            <span class="text-muted small">— courses mapped to your gap skills</span>
        </div>
        <div class="card-body p-0">
            <div class="row m-0">
                {{#recommendations}}
                <div class="col-md-6 col-lg-4 p-3">
                    <div class="card h-100 border">
                        <div class="card-body">
                            <h6><a href="{{{ view_url }}}">{{ fullname }}</a></h6>
                            <code class="small">{{ shortname }}</code>
                        </div>
                    </div>
                </div>
                {{/recommendations}}
            </div>
        </div>
    </div>
    {{/has_recs}}
</div>
