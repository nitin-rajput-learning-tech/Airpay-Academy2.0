<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_notifications/db" VERSION="20260409"
       COMMENT="Airpay Smart Notifications — rules engine + notification log">
  <TABLES>

    <TABLE NAME="local_airpay_notif_rules"
           COMMENT="Notification rule definitions">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"        TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="rule_type"   TYPE="char" LENGTH="50"  NOTNULL="true"
               COMMENT="deadline_approaching|course_not_started|streak_broken|manager_nudge|achievement_earned|new_course"/>
        <FIELD NAME="channel"     TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="inapp"
               COMMENT="inapp|email|push|whatsapp"/>
        <FIELD NAME="trigger_days" TYPE="int" LENGTH="4"   NOTNULL="true" DEFAULT="3"
               COMMENT="Days before/after event to trigger"/>
        <FIELD NAME="audience"    TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="learner"
               COMMENT="learner|manager|admin|all"/>
        <FIELD NAME="enabled"     TYPE="int"  LENGTH="1"   NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="template"    TYPE="text" NOTNULL="false"
               COMMENT="Mustache-compatible message template with {{placeholders}}"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_rule_type" UNIQUE="false" FIELDS="rule_type"/>
        <INDEX NAME="idx_enabled"   UNIQUE="false" FIELDS="enabled"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_notif_log"
           COMMENT="Sent notification log — prevents duplicates + audit trail">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ruleid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="channel"     TYPE="char" LENGTH="50"  NOTNULL="true" DEFAULT="inapp"/>
        <FIELD NAME="subject"     TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="message"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="status"      TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="sent"
               COMMENT="sent|read|failed"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeread"    TYPE="int"  LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid"       UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_userid_status" UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="idx_ruleid_userid" UNIQUE="false" FIELDS="ruleid, userid, courseid"
               COMMENT="Prevent duplicate sends for same rule+user+course"/>
        <INDEX NAME="idx_timecreated"  UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_airpay_notif_prefs"
           COMMENT="User notification preferences">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"       TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="channel_inapp" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="channel_email" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="channel_push"  TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="digest_frequency" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="daily"
               COMMENT="none|daily|weekly"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid" UNIQUE="true" FIELDS="userid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
