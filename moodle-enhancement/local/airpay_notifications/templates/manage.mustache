{{!
    Airpay Notification Rules — admin management.
    @template local_airpay_notifications/manage
}}

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Notification Rules</h2>
        <p class="text-muted mb-0">Configure automated email and in-app notifications triggered by learner events.</p>
    </div>
    <a href="#" class="btn btn-primary btn-sm"><i class="fa fa-plus fa-fw"></i> Create Rule</a>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total}}</div>
            <div class="text-muted small text-uppercase">Total Rules</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active}}</div>
            <div class="text-muted small text-uppercase">Active</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{inactive}}</div>
            <div class="text-muted small text-uppercase">Disabled</div>
        </div></div>
    </div>
</div>

{{#has_rules}}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead><tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
            <th class="ps-3">Rule Name</th>
            <th>Type</th>
            <th>Status</th>
            <th class="text-end pe-3">Actions</th>
        </tr></thead>
        <tbody>
            {{#rules}}
            <tr>
                <td class="ps-3 fw-semibold">{{name}}</td>
                <td><span class="badge bg-light text-dark">{{type}}</span></td>
                <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="fa fa-pencil fa-fw"></i> Edit</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fa fa-paper-plane fa-fw"></i> Test Send</a></li>
                            <li>
                                {{#enabled}}
                                <a class="dropdown-item text-warning" href="#"><i class="fa fa-pause fa-fw"></i> Disable</a>
                                {{/enabled}}
                                {{^enabled}}
                                <a class="dropdown-item text-success" href="#"><i class="fa fa-play fa-fw"></i> Enable</a>
                                {{/enabled}}
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
            {{/rules}}
        </tbody>
    </table>
</div></div>
{{/has_rules}}

{{^has_rules}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-bell fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No notification rules yet</h5>
    <p class="text-muted mb-3">Set up automated reminders for deadlines, completions, and engagement milestones.</p>
    <a href="#" class="btn btn-primary btn-sm"><i class="fa fa-plus fa-fw"></i> Create First Rule</a>
</div></div>
{{/has_rules}}
