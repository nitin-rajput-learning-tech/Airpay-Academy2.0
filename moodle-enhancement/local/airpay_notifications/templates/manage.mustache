{{!
    Airpay Notification Rules — datatable-driven admin listing.
    @template local_airpay_notifications/manage
}}
<style>
    [data-region="airpay-notifications"] .ap-filter-bar { background: var(--ap-color-bg-surface, #fff); border: 1px solid var(--ap-color-border, #e2e6ef); border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; }
    [data-region="airpay-notifications"] .btn-group .btn.active { background: var(--ap-color-primary, #0066A7); color: #fff; border-color: var(--ap-color-primary, #0066A7); }
</style>

<div data-region="airpay-notifications">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Notification Rules</h2>
        <p class="text-muted mb-0">Define when and how learners and managers get notified about deadlines and milestones.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-rule">
        <i class="fa fa-plus fa-fw"></i> New Rule
    </a>
    {{/can_manage}}
</div>

{{! KPI Summary — Phase B0+: migrated to tokens-aware stat_card partial }}
{{#has_kpi_tiles}}
<div class="airpay-stat-grid mb-4">
    {{#kpi_tiles}}
    {{> theme_airpayux/components/stat_card }}
    {{/kpi_tiles}}
</div>
{{/has_kpi_tiles}}

<div class="ap-filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="small text-muted mb-1 d-block">Status</label>
            <div class="btn-group btn-group-sm" role="group" data-airpay-notif-enabled>
                <button type="button" class="btn btn-light active" data-enabled="all">All</button>
                <button type="button" class="btn btn-light"        data-enabled="1">Enabled</button>
                <button type="button" class="btn btn-light"        data-enabled="0">Disabled</button>
            </div>
        </div>
    </div>
</div>

<div data-airpay-table
     data-endpoint="local_airpay_notifications_list_rules"
     data-columns="{{{columns_json}}}"
     data-search-placeholder="Search rule name…"
     data-perpage="25">
</div>

</div>

{{#js}}
require([
    'theme_airpayux/datatable',
    'local_airpay_notifications/rule_actions'
], function(Datatable, RuleActions) {
    Datatable.init();
    if (RuleActions && RuleActions.init) RuleActions.init();

    var root = document.querySelector('[data-airpay-table]');
    var dt = Datatable.getInstance(root);
    if (!dt) return;

    document.querySelectorAll('[data-airpay-notif-enabled] [data-enabled]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var v = e.target.dataset.enabled;
            document.querySelectorAll('[data-airpay-notif-enabled] [data-enabled]').forEach(function(b) {
                b.classList.toggle('active', b === e.target);
            });
            dt.setFilter('enabled', v);
        });
    });
});
{{/js}}
