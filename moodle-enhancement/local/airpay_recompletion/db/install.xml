<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/airpay_recompletion/db" VERSION="20260511"
       COMMENT="Airpay Recompletion — annual / periodic course completion reset.">

  <TABLES>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_recompletion_rules — rule definitions
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_recompletion_rules" COMMENT="Recompletion rule definitions">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"           TYPE="char" LENGTH="200" NOTNULL="true"/>
        <FIELD NAME="courseid"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="0 = all courses with completion enabled, else specific course"/>
        <FIELD NAME="period_days"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="365"
               COMMENT="Reset every N days. 365=annual, 90=quarterly."/>
        <FIELD NAME="trigger_type"   TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="completion"
               COMMENT="completion|enrolment|fixed — what the period counts from. Named '_type' to avoid the MariaDB reserved word 'trigger'."/>
        <FIELD NAME="fixed_date"     TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Unix ts if trigger=fixed"/>
        <FIELD NAME="reset_grades"   TYPE="int"  LENGTH="1" NOTNULL="true" DEFAULT="1"
               COMMENT="Also reset grades when resetting completion"/>
        <FIELD NAME="reset_attempts" TYPE="int"  LENGTH="1" NOTNULL="true" DEFAULT="1"
               COMMENT="Also reset quiz attempts"/>
        <FIELD NAME="enabled"        TYPE="int"  LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="costcenterid"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant scope; 0 = all tenants"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="last_run_at"    TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Last successful cron pass"/>
        <FIELD NAME="last_run_resets" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="Count of users reset on last run"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_enabled" UNIQUE="false" FIELDS="enabled"/>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>

    <!-- ───────────────────────────────────────────────────────────────
         local_airpay_recompletion_history — append-only audit log
         Every reset event is recorded for compliance auditors. Cannot
         be deleted (privacy.php redacts userid only on DSR).
         ─────────────────────────────────────────────────────────────── -->
    <TABLE NAME="local_airpay_recompletion_history" COMMENT="Append-only reset audit log">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ruleid"         TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="reason"         TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="cron"
               COMMENT="cron|manual|bulk"/>
        <FIELD NAME="reset_by_userid" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="Admin who triggered (NULL for cron)"/>
        <FIELD NAME="previous_timecompleted" TYPE="int" LENGTH="10" NOTNULL="false"
               COMMENT="When the user last completed before reset"/>
        <FIELD NAME="reset_grades"   TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reset_attempts" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="dryrun"         TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_rule"   TYPE="foreign" FIELDS="ruleid"   REFTABLE="local_airpay_recompletion_rules" REFFIELDS="id"/>
        <KEY NAME="fk_user"   TYPE="foreign" FIELDS="userid"   REFTABLE="user"   REFFIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_userid_course" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="idx_ruleid_time"   UNIQUE="false" FIELDS="ruleid, timecreated"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
