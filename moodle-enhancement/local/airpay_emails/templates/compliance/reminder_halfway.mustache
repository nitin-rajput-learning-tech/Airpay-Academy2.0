{{!
    Compliance: Halfway Reminder — 50%+ time elapsed, <50% progress.
    Context: firstname, course_name, course_url, progress, deadline_date,
             deadline_days, days_elapsed, dashboard_url
    Urgency: WARNING (amber #d97706)
}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">

    <p style="margin:0 0 16px;">Hi <strong>{{firstname}}</strong>,</p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#fef3c7" style="background-color:#fef3c7; padding:12px 16px; border-radius:8px; border-left:4px solid #d97706;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#d97706; font-weight:600;">
                Halfway Check
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                {{days_elapsed}} days have passed and your progress is at <strong>{{progress}}%</strong>.
                You have <strong>{{deadline_days}} days</strong> remaining to complete this course.
            </span>
        </td>
    </tr>
    </table>

</td></tr>
</table>

{{> local_airpay_emails/partials/course_info_box}}

{{< local_airpay_emails/partials/cta_button}}
    {{$cta_url}}{{course_url}}{{/cta_url}}
    {{$cta_text}}Continue Course{{/cta_text}}
    {{$cta_color}}#d97706{{/cta_color}}
{{/ local_airpay_emails/partials/cta_button}}

{{> local_airpay_emails/partials/footer_note}}
