{{!
    Compliance: Weekly Escalation — sent to MANAGER with overdue team members.
    Context: manager_name, team_overdue_count, overdue_members [{name, course, days_overdue, progress}],
             reports_url, dashboard_url
    Urgency: CRITICAL (red #dc2626)
}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">

    <p style="margin:0 0 16px;">Hi <strong>{{manager_name}}</strong>,</p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#fef2f2" style="background-color:#fef2f2; padding:14px 16px; border-radius:8px; border-left:4px solid #dc2626;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:16px; font-weight:700; color:#dc2626;">
                Weekly Compliance Escalation
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#5a6070; line-height:22px;">
                <strong>{{team_overdue_count}} team member(s)</strong> have overdue mandatory compliance courses.
                Please follow up to ensure timely completion.
            </span>
        </td>
    </tr>
    </table>

</td></tr>
</table>

<!-- Team member table -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
       style="margin:16px 0; border:1px solid #e2e6ef; border-radius:8px; overflow:hidden;">
    <!-- Header -->
    <tr>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">
            Employee
        </td>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef;">
            Course
        </td>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef; text-align:center;">
            Overdue
        </td>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid #e2e6ef; text-align:center;">
            Progress
        </td>
    </tr>
    {{#overdue_members}}
    <tr>
        <td style="padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; border-bottom:1px solid #f0f2f7;">
            <strong>{{name}}</strong>
        </td>
        <td style="padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; border-bottom:1px solid #f0f2f7;">
            {{course}}
        </td>
        <td style="padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#dc2626; font-weight:600; border-bottom:1px solid #f0f2f7; text-align:center;">
            {{days_overdue}}d
        </td>
        <td style="padding:10px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; border-bottom:1px solid #f0f2f7; text-align:center;">
            {{progress}}%
        </td>
    </tr>
    {{/overdue_members}}
</table>

{{< local_airpay_emails/partials/cta_button}}
    {{$cta_url}}{{reports_url}}{{/cta_url}}
    {{$cta_text}}View Compliance Report{{/cta_text}}
    {{$cta_color}}#dc2626{{/cta_color}}
{{/ local_airpay_emails/partials/cta_button}}

{{> local_airpay_emails/partials/footer_note}}
