<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>{{firstname}}</strong>,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#e5f4f3" style="background-color:#e5f4f3; padding:14px 16px; border-radius:8px; border-left:4px solid #0f7a73;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:16px; color:#0f7a73; font-weight:600;">
                &#127891; New Course Available
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#1a1a2e; font-weight:600; line-height:24px;">
                {{course_name}}
            </span>
        </td>
    </tr>
    </table>
    {{#course_description}}
    <p style="margin:0 0 16px; font-size:14px; color:#5a6070; line-height:22px;">
        {{course_description}}
    </p>
    {{/course_description}}
    <p style="margin:0 0 16px; font-size:13px; color:#8890a0;">
        Added by: {{added_by}}
    </p>
</td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
    <td align="center" bgcolor="#0f7a73" style="background-color:#0f7a73; border-radius:8px;">
        <a href="{{course_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
            View Course
        </a>
    </td>
</tr>
</table>
{{> local_airpay_emails/partials/footer_note}}
