{{!
    Notification: Deadline Approaching — course deadline X days away.
    Context: firstname, course_name, course_url, deadline_date, deadline_days, progress
}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>{{firstname}}</strong>,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#e5f4f3" style="background-color:#e5f4f3; padding:12px 16px; border-radius:8px; border-left:4px solid #0f7a73;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#0f7a73; font-weight:600;">
                &#128197; Deadline in {{deadline_days}} days
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                Your course <strong>{{course_name}}</strong> is due on <strong>{{deadline_date}}</strong>.
            </span>
        </td>
    </tr>
    </table>
</td></tr>
</table>
{{> local_airpay_emails/partials/course_info_box}}
{{< local_airpay_emails/partials/cta_button}}
    {{$cta_url}}{{course_url}}{{/cta_url}}
    {{$cta_text}}Go to Course{{/cta_text}}
    {{$cta_color}}#0f7a73{{/cta_color}}
{{/ local_airpay_emails/partials/cta_button}}
{{> local_airpay_emails/partials/footer_note}}
