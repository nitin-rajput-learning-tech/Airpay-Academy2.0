<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>{{manager_name}}</strong>,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#e8f2f9" style="background-color:#e8f2f9; padding:12px 16px; border-radius:8px; border-left:4px solid #0066A7;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#0066A7; font-weight:600;">
                Team Learning Update
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                <strong>{{overdue_count}} team member(s)</strong> have overdue courses that need attention.
            </span>
        </td>
    </tr>
    </table>
</td></tr>
</table>
<!-- Team list -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:16px 0; border:1px solid #e2e6ef; border-radius:8px; overflow:hidden;">
    <tr>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; border-bottom:1px solid #e2e6ef;">Employee</td>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; border-bottom:1px solid #e2e6ef;">Course</td>
        <td bgcolor="#f8f9fc" style="background-color:#f8f9fc; padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:12px; font-weight:600; color:#5a6070; border-bottom:1px solid #e2e6ef; text-align:center;">Overdue</td>
    </tr>
    {{#overdue_members}}
    <tr>
        <td style="padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; border-bottom:1px solid #f0f2f7;">{{name}}</td>
        <td style="padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; border-bottom:1px solid #f0f2f7;">{{course}}</td>
        <td style="padding:8px 14px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#dc2626; font-weight:600; border-bottom:1px solid #f0f2f7; text-align:center;">{{days_overdue}}d</td>
    </tr>
    {{/overdue_members}}
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
    <td align="center" bgcolor="#0066A7" style="background-color:#0066A7; border-radius:8px;">
        <a href="{{team_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
            View Team Dashboard
        </a>
    </td>
</tr>
</table>
{{> local_airpay_emails/partials/footer_note}}
