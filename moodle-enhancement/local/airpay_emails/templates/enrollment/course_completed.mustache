<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">

    <p style="margin:0 0 8px; font-size:24px; font-weight:700; color:#16a34a; text-align:center;">
        &#127942; Congratulations!
    </p>
    <p style="margin:0 0 20px; text-align:center; font-size:14px; color:#5a6070;">
        <strong>{{firstname}}</strong>, you have successfully completed
    </p>

    <!-- Achievement card -->
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 20px;">
    <tr>
        <td align="center" bgcolor="#f0fdf4" style="background-color:#f0fdf4; padding:20px; border-radius:12px; border:2px solid #16a34a;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:18px; font-weight:700; color:#1a1a2e; display:block; margin-bottom:8px;">
                {{course_name}}
            </span>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td style="padding:4px 16px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                    Completed: <strong>{{completion_date}}</strong>
                </td>
                {{#score}}
                <td style="padding:4px 16px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                    Score: <strong style="color:#16a34a;">{{score}}%</strong>
                </td>
                {{/score}}
            </tr>
            </table>
        </td>
    </tr>
    </table>

    {{#has_certificate}}
    {{!
        Sprint B (2026-05-13): the certificate PDF is ATTACHED to this
        email by email_to_user() — it ships under the filename
        "Airpay-certificate-<code>.pdf". The CTA below is a fallback
        for clients that hide attachments or for re-downloading later
        from the verification URL.
    }}
    <p style="margin:0 0 8px; text-align:center; font-size:14px; color:#5a6070;">
        Your certificate is <strong>attached to this email</strong> as a PDF.<br>
        You can also view it online or re-download it any time:
    </p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
    <tr>
        <td align="center" bgcolor="#16a34a" style="background-color:#16a34a; border-radius:8px;">
            <a href="{{certificate_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
                View certificate online
            </a>
        </td>
    </tr>
    </table>
    {{/has_certificate}}

    {{^has_certificate}}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
    <tr>
        <td align="center" bgcolor="#16a34a" style="background-color:#16a34a; border-radius:8px;">
            <a href="{{dashboard_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
                Back to Dashboard
            </a>
        </td>
    </tr>
    </table>
    {{/has_certificate}}

</td></tr>
</table>
{{> local_airpay_emails/partials/footer_note}}
