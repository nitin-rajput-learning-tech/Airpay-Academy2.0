<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>Admin</strong>,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#fef2f2" style="background-color:#fef2f2; padding:14px 16px; border-radius:8px; border-left:4px solid #7c3aed;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#7c3aed; font-weight:600;">
                &#128274; DPDP Act Request: {{request_type}}
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                A user has submitted a data {{request_type}} request under the Digital Personal Data Protection Act, 2023.
            </span>
        </td>
    </tr>
    </table>
    <!-- Request details -->
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0 16px; background-color:#f8f9fc; border-radius:8px; padding:12px 16px;">
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; width:120px;">User</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; font-weight:600;">{{fullname}} ({{email}})</td></tr>
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Request Type</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; font-weight:600;">{{request_type}}</td></tr>
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Submitted</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; font-weight:600;">{{request_date}}</td></tr>
    {{#request_reason}}
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Reason</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e;">{{request_reason}}</td></tr>
    {{/request_reason}}
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Response Due</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#dc2626; font-weight:600;">{{response_deadline}}</td></tr>
    </table>
    <p style="margin:0 0 16px; font-size:14px; color:#5a6070;">
        Under the DPDP Act 2023, this request must be processed within <strong>30 days</strong>.
    </p>
</td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
    <td align="center" bgcolor="#7c3aed" style="background-color:#7c3aed; border-radius:8px;">
        <a href="{{admin_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
            Review Request
        </a>
    </td>
</tr>
</table>
{{> local_airpay_emails/partials/footer_note}}
