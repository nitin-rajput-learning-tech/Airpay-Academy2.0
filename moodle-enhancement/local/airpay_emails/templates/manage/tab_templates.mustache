{{!
    Templates tab — list all templates with override status.
    Context: tabdata {categories [{category, catkey, templates [{key, label, has_override, source, is_bizlms}]}],
             total_airpay, total_bizlms, total_overrides}
}}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
        <span style="font-size:14px; color:#5a6070;">
            {{tabdata.total_airpay}} Airpay templates
            {{#tabdata.total_bizlms}}· {{tabdata.total_bizlms}} legacy templates{{/tabdata.total_bizlms}}
            {{#tabdata.total_overrides}}· <span class="ap-manage-badge ap-manage-badge--override">{{tabdata.total_overrides}} overrides</span>{{/tabdata.total_overrides}}
        </span>
    </div>
</div>

{{#tabdata.categories}}
<div class="ap-manage-card" style="margin-bottom:20px;">
    <h3 style="font-size:15px; font-weight:600; color:#1a1a2e; margin:0 0 12px;">
        {{category}}
        <span style="font-size:12px; color:#8890a0; font-weight:400;">({{templates.length}} templates)</span>
    </h3>
    <table class="ap-manage-table">
        <thead>
            <tr>
                <th style="width:35%;">Template</th>
                <th style="width:20%;">Key</th>
                <th style="width:15%;">Source</th>
                <th style="width:15%;">Status</th>
                <th style="width:15%; text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#templates}}
            <tr>
                <td>
                    <strong>{{label}}</strong>
                </td>
                <td>
                    <code style="font-size:11px; color:#5a6070; background:#f0f2f7; padding:2px 6px; border-radius:4px;">
                        {{key}}
                    </code>
                </td>
                <td>
                    {{#is_bizlms}}
                    <span class="ap-manage-badge ap-manage-badge--bizlms">Legacy</span>
                    {{/is_bizlms}}
                    {{^is_bizlms}}
                        {{#has_override}}
                        <span class="ap-manage-badge ap-manage-badge--override">{{source}}</span>
                        {{/has_override}}
                        {{^has_override}}
                        <span class="ap-manage-badge ap-manage-badge--file">file</span>
                        {{/has_override}}
                    {{/is_bizlms}}
                </td>
                <td>
                    {{#is_bizlms}}
                        {{#active}}<span class="ap-manage-badge ap-manage-badge--enabled">Active</span>{{/active}}
                        {{^active}}<span class="ap-manage-badge ap-manage-badge--disabled">Inactive</span>{{/active}}
                    {{/is_bizlms}}
                    {{^is_bizlms}}
                    <span class="ap-manage-badge ap-manage-badge--enabled">Active</span>
                    {{/is_bizlms}}
                </td>
                <td style="text-align:right;">
                    {{#is_bizlms}}
                    <a href="{{preview_url}}?template={{key}}&tenant={{tenant_id}}" class="ap-manage-btn ap-manage-btn--outline ap-manage-btn--sm" target="_blank">
                        <i class="fa fa-eye"></i> View
                    </a>
                    {{/is_bizlms}}
                    {{^is_bizlms}}
                    <a href="{{preview_url}}?template={{key}}&tenant={{tenant_id}}" class="ap-manage-btn ap-manage-btn--outline ap-manage-btn--sm" target="_blank">
                        <i class="fa fa-eye"></i> Preview
                    </a>
                    <a href="{{manage_url}}/../editor.php?template={{key}}&tenant={{tenant_id}}" class="ap-manage-btn ap-manage-btn--primary ap-manage-btn--sm">
                        <i class="fa fa-paint-brush"></i> Design Studio
                    </a>
                    {{/is_bizlms}}
                </td>
            </tr>
            {{/templates}}
        </tbody>
    </table>
</div>
{{/tabdata.categories}}

{{^tabdata.categories}}
<div class="ap-manage-empty">
    <i class="fa fa-envelope-o"></i>
    No templates found.
</div>
{{/tabdata.categories}}
