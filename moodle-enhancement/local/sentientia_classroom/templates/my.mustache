{{!
    @template local_sentientia_classroom/my

    The learner's own classrooms (ADR-032 imported history, flag sentientia.classroom.import_history).

    Context variables required for this template:
    * has_classrooms - bool
    * classrooms - array of:
        name, status_label, status_css, location, has_location, training_dates, has_training_dates,
        completed (bool), completed_on, hours, has_hours, has_sessions,
        sessions - array of: title, when, location, has_attendance, attendance, badge

    Example context (json):
    {
        "has_classrooms": true,
        "classrooms": [{
            "name": "Fraud awareness workshop",
            "status_label": "Completed",
            "status_css": "badge-info",
            "location": "Mumbai HQ - Room 4",
            "has_location": true,
            "training_dates": "03 Feb 2025 – 04 Feb 2025",
            "has_training_dates": true,
            "completed": true,
            "completed_on": "04 Feb 2025",
            "hours": 8,
            "has_hours": true,
            "has_sessions": true,
            "sessions": [{
                "title": "Day 1",
                "when": "03 Feb 2025 10:00",
                "location": "Mumbai HQ - Room 4",
                "has_attendance": true,
                "attendance": "Present",
                "badge": "badge-success"
            }]
        }]
    }
}}
<div data-region="my-classrooms">
    {{^ has_classrooms }}
    <p class="text-muted">{{# str }}my_none, local_sentientia_classroom{{/ str }}</p>
    {{/ has_classrooms }}

    {{# classrooms }}
    <section class="card border-0 shadow-sm mb-4" aria-label="{{ name }}">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <h3 class="h5 mb-0">{{ name }}</h3>
                <span class="badge {{ status_css }}">{{ status_label }}</span>
            </div>
            <div class="small text-muted mb-3">
                {{# has_training_dates }}<span><i class="fa fa-calendar fa-fw" aria-hidden="true"></i> {{ training_dates }}</span>{{/ has_training_dates }}
                {{# has_location }}<span class="ms-3"><i class="fa fa-map-marker fa-fw" aria-hidden="true"></i> {{ location }}</span>{{/ has_location }}
            </div>

            <div class="d-flex flex-wrap gap-4 mb-3">
                <div>
                    <div class="small text-uppercase text-muted">{{# str }}roster_completion, local_sentientia_classroom{{/ str }}</div>
                    <div>
                        {{# completed }}{{# str }}roster_completed, local_sentientia_classroom{{/ str }}{{/ completed }}
                        {{^ completed }}{{# str }}roster_pending, local_sentientia_classroom{{/ str }}{{/ completed }}
                    </div>
                </div>
                {{# completed_on }}
                <div>
                    <div class="small text-uppercase text-muted">{{# str }}roster_completed_on, local_sentientia_classroom{{/ str }}</div>
                    <div>{{ completed_on }}</div>
                </div>
                {{/ completed_on }}
                {{# has_hours }}
                <div>
                    <div class="small text-uppercase text-muted">{{# str }}roster_hours, local_sentientia_classroom{{/ str }}</div>
                    <div>{{ hours }}</div>
                </div>
                {{/ has_hours }}
            </div>

            {{# has_sessions }}
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <caption class="sr-only visually-hidden">{{# str }}my_sessions_caption, local_sentientia_classroom, {{ name }}{{/ str }}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{# str }}my_session, local_sentientia_classroom{{/ str }}</th>
                            <th scope="col">{{# str }}my_when, local_sentientia_classroom{{/ str }}</th>
                            <th scope="col">{{# str }}location, local_sentientia_classroom{{/ str }}</th>
                            <th scope="col">{{# str }}my_attendance, local_sentientia_classroom{{/ str }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{# sessions }}
                        <tr>
                            <td>{{ title }}</td>
                            <td>{{ when }}</td>
                            <td>{{ location }}</td>
                            <td>{{# has_attendance }}<span class="badge {{ badge }}">{{ attendance }}</span>{{/ has_attendance }}</td>
                        </tr>
                        {{/ sessions }}
                    </tbody>
                </table>
            </div>
            {{/ has_sessions }}
        </div>
    </section>
    {{/ classrooms }}
</div>
