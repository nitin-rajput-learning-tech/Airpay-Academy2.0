{{!
    @template local_sentientia_request/pending
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}pendingapprovals, local_sentientia_request{{/str}}</h2>
        {{#has_viewall_cap}}
        <a href="{{{ allrequests_url }}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-list"></i>
            {{#str}}allrequests, local_sentientia_request{{/str}}
        </a>
        {{/has_viewall_cap}}
    </div>

    <div data-region="datatable"
         data-component="local_sentientia_request"
         data-ws-name="local_sentientia_request_list_pending"
         data-columns="{{ columns_json }}"
         data-default-sort="timedue"
         data-default-sortdir="asc"
         data-extra-args='{}'>
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['theme_airpayux/datatable', 'local_sentientia_request/decide'],
    function(Datatable, Decide) {
        Datatable.init(document.querySelector('[data-region="datatable"]'));
        Decide.init();
    });
{{/js}}
