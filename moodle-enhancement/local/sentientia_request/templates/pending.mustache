{{!
    @template local_sentientia_request/pending
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}pendingapprovals, local_sentientia_request{{/str}}</h2>
        {{#has_viewall_cap}}
        <a href="{{{ allrequests_url }}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-list"></i>
            {{#str}}allrequests, local_sentientia_request{{/str}}
        </a>
        {{/has_viewall_cap}}
    </div>

    {{!
        WF-022: data-region must be "airpay-datatable" (not "datatable") —
        theme_sentientia/datatable's init() scans for
        `[data-airpay-table], [data-region="airpay-datatable"]`. With the wrong
        region the table never instantiated and hung on the static "Loading..."
        placeholder forever. Bug #12 fixed this on my_requests.mustache but
        missed pending + all_requests. Datatable.init() also takes no args.
    }}
    <div data-region="airpay-datatable"
         data-component="local_sentientia_request"
         data-ws-name="local_sentientia_request_list_pending"
         data-columns="{{ columns_json }}"
         data-default-sort="timedue"
         data-default-sortdir="asc"
         data-extra-args='{}'>
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['theme_sentientia/datatable', 'local_sentientia_request/decide'],
    function(Datatable, Decide) {
        Datatable.init();
        Decide.init();
    });
{{/js}}
