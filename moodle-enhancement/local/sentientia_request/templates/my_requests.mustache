{{!
    @template local_sentientia_request/my_requests
}}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{#str}}myrequests, local_sentientia_request{{/str}}</h2>
        {{#has_pending_cap}}
        <a href="{{{ pending_url }}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-check-square"></i>
            {{#str}}pendingapprovals, local_sentientia_request{{/str}}
        </a>
        {{/has_pending_cap}}
    </div>

    {{!
        Bug fix 2026-05-22 (Goal A audit, Bug #6):
        data-region was "datatable" but theme_airpayux/datatable's
        init() looks for `[data-airpay-table], [data-region="airpay-datatable"]`.
        Renamed to airpay-datatable so the selector matches.
        Also Datatable.init() takes no args — removed the bogus call
        argument; init() walks the DOM itself.
    }}
    <div data-region="airpay-datatable"
         data-component="local_sentientia_request"
         data-ws-name="local_sentientia_request_list_mine"
         data-columns="{{ columns_json }}"
         data-default-sort="timecreated"
         data-default-sortdir="desc"
         data-extra-args='{}'>
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['theme_airpayux/datatable', 'local_sentientia_request/my_requests'],
    function(Datatable, M) {
        Datatable.init();
        M.init();
    });
{{/js}}
