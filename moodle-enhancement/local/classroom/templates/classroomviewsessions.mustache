{{#response}}
{{#viewtypeCard}}
<div id="sessions_tab_content">
    {{#records.0}}
    <div class="ap-sessions-table-wrap">
        <table class="ap-sessions-table" id="sessionsdata">
            <thead>
                <tr>
                    {{#classroomname}}<th>{{#str}}classroomname,local_classroom{{/str}}</th>{{/classroomname}}
                    <th>{{#str}}name{{/str}}</th>
                    <th>{{#str}}startdate, local_classroom{{/str}}</th>
                    <th>{{#str}}enddate, local_classroom{{/str}}</th>
                    <th>{{#str}}type,local_classroom{{/str}}</th>
                    <th>{{#str}}recordinglink,local_classroom{{/str}}</th>
                    <th>{{#str}}messagelink,local_classroom{{/str}}</th>
                    <th>{{#str}}room,local_classroom{{/str}}</th>
                    <th>{{#str}}status,local_classroom{{/str}}</th>
                    <th>{{#str}}attended_sessions_users,local_classroom{{/str}}</th>
                    <th>{{#str}}faculty,local_classroom{{/str}}</th>
                    {{#action}}{{^classroomname}}{{#createsession}}<th>{{#str}}actions{{/str}}</th>{{/createsession}}{{/classroomname}}{{/action}}
                </tr>
            </thead>
    {{/records.0}}
            <tbody>
            {{#records}}
            <tr>
                {{#classroomname}}<td><strong>{{classroomname}}</strong></td>{{/classroomname}}
                <td><strong>{{name}}</strong></td>
                <td class="ap-sessions-table__date"><i class="fa fa-calendar"></i> {{starttime}}</td>
                <td class="ap-sessions-table__date"><i class="fa fa-calendar"></i> {{endtime}}</td>
                <td>{{{link}}}</td>
                <td>
                    {{{recordinglink}}}
                    <div class="modal fade" id="myRecordModal" role="dialog">
                        <div class="modal-dialog">
                            <div class="modal-content" style="border-radius:12px; overflow:hidden;">
                                <div class="modal-header" style="border-bottom:1px solid var(--ap-border);">
                                    <h4 class="modal-title" style="font-size:16px; font-weight:700;">Recorded Video</h4>
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                </div>
                                <div class="modal-body">
                                    <video src="{{recordurl}}" id="classroomvideo" class="video-js vjs-default-skin vjs-layout-large" controls preload="auto" width="468" height="315"></video>
                                </div>
                                <div class="modal-footer" style="border-top:1px solid var(--ap-border);">
                                    <button type="button" class="btn btn-default classroomvideo-close" data-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                <td>{{{messagelink}}}</td>
                <td>{{room}}</td>
                <td>
                    <span class="ap-badge {{#status}}ap-badge--{{status}}{{/status}}">{{status}}</span>
                </td>
                <td><strong>{{attendacecount}}</strong></td>
                <td>{{{trainer}}}</td>
                {{^classroomname}}{{#action}}
                <td class="ap-sessions-table__actions">
                    {{#editicon}}
                    <a href="javascript:void(0);" title="{{#str}}edit{{/str}}" class="ap-sessions-table__action-btn"
                       onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:1, component:'local_classroom', callback:'session_form', form_status:0, plugintype: 'local_classroom', pluginname: 'session', id: {{id}}, cid: {{classroomid}}, title: 'updatesession'}) })(event)">
                        <i class="fa fa-pencil"></i>
                    </a>
                    {{/editicon}}
                    {{#deleteicon}}
                    <a href="javascript:void(0);" title="{{#str}}delete{{/str}}" class="ap-sessions-table__action-btn ap-sessions-table__action-btn--danger"
                       onclick="(function(e){ require('local_classroom/classroom').deleteConfirm({action:'deletesession', classroomid: {{classroomid}}, id: {{id}}, sessionname:'{{sessionname}}'}) })(event)">
                        <i class="fa fa-trash"></i>
                    </a>
                    {{/deleteicon}}
                    {{#assignrolesicon}}
                    <a href="{{cfgwwwroot}}/local/classroom/attendance.php?cid={{classroomid}}&sid={{id}}" title="{{#str}}attendace,local_classroom{{/str}}" class="ap-sessions-table__action-btn">
                        <i class="fa fa-user-plus"></i>
                    </a>
                    {{/assignrolesicon}}
                </td>
                {{/action}}{{/classroomname}}
            </tr>
            {{/records}}
            </tbody>
        </table>
    </div>
</div>
{{/viewtypeCard}}
{{/response}}

<style>
.ap-sessions-table-wrap { overflow-x: auto; }
.ap-sessions-table {
    width: 100%; border-collapse: collapse;
    font-size: 13px; font-family: var(--ap-font);
}
.ap-sessions-table th {
    padding: 10px 12px; text-align: left;
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.3px; color: var(--ap-text-muted, #8896a6);
    background: var(--ap-surface-alt, #f8f9fc);
    border-bottom: 2px solid var(--ap-border, #e3eaf3);
    white-space: nowrap;
}
.ap-sessions-table td {
    padding: 10px 12px; border-bottom: 1px solid #f3f5f9;
    color: var(--ap-text, #1a1a2e); vertical-align: middle;
}
.ap-sessions-table tr:hover td { background: var(--ap-surface-alt, #f8f9fc); }
.ap-sessions-table__date { white-space: nowrap; font-size: 12px; color: var(--ap-text-secondary); }
.ap-sessions-table__date i { color: var(--ap-primary); margin-right: 4px; }
.ap-sessions-table__actions { white-space: nowrap; }
.ap-sessions-table__action-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 6px;
    color: var(--ap-text-secondary); transition: all 0.15s;
    text-decoration: none;
}
.ap-sessions-table__action-btn:hover { background: var(--ap-primary-light, #e8f2f9); color: var(--ap-primary); }
.ap-sessions-table__action-btn--danger:hover { background: #fef2f2; color: var(--ap-danger); }
.ap-badge--completed { background: #dcfce7; color: #16a34a; }
.ap-badge--pending { background: #fef3c7; color: #d97706; }
body.dark-mode .ap-sessions-table th { background: #22252f; color: #9ca3b4; border-color: #2d3140; }
body.dark-mode .ap-sessions-table td { border-color: #2d3140; color: #e8eaed; }
body.dark-mode .ap-sessions-table tr:hover td { background: #22252f; }
</style>
