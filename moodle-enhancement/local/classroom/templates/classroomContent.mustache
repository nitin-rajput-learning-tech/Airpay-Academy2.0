{{! ═══ CLASSROOM DETAIL VIEW ═══ }}

{{! Action buttons (admin only) }}
{{#action}}
<div class="ap-classroom-detail-actions">
    {{#assignusers}}
    <a href="{{assignusersurl}}" class="ap-classroom-detail-actions__btn" title="{{#str}}assignusers,local_classroom{{/str}}">
        <i class="fa fa-user-plus"></i> Assign Users
    </a>
    {{/assignusers}}
    {{^assignusers}}
    {{#unenroll}}
    <button class="ap-classroom-detail-actions__btn ap-classroom-detail-actions__btn--danger"
            onclick="(function(e){ require('local_classroom/classroom').deleteConfirm({action:'unenrollclassroom', id: {{classroomid}}, classroomid: {{classroomid}},classroomname:'{{classname_string}}'}) })(event)">
        <i class="fa fa-user-times"></i> Unenroll
    </button>
    {{/unenroll}}
    {{/assignusers}}
    {{#edit}}
    <button class="ap-classroom-detail-actions__btn"
            onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:1, component:'local_classroom', callback:'classroom_form', form_status:0, plugintype: 'local', pluginname: 'classroom', id: {{classroomid}} }) })(event)">
        <i class="fa fa-pencil"></i> Edit
    </button>
    {{/edit}}
    {{#classroomcompletion}}
    <button class="ap-classroom-detail-actions__btn"
            onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:1, component:'local_classroom', callback:'classroom_completion_form', form_status:0, plugintype: 'local', pluginname: 'classroom_completion_settings', id: {{classroomcompletion_id}}, cid: {{classroomid}} }) })(event)">
        <i class="fa fa-tags"></i> Completion
    </button>
    {{/classroomcompletion}}
    {{#classroom_actionstatus}}
    <div class="ap-classroom-detail-actions__btn">{{{.}}}</div>
    {{/classroom_actionstatus}}
</div>
{{/action}}

{{#classroom}}
<div class="ap-classroom-detail">

    {{! ═══ HERO HEADER ═══ }}
    <div class="ap-classroom-detail__hero">
        <div class="ap-classroom-detail__hero-image" style="background-image: url('{{classroomlogoimg}}');" title="{{classname}}">
            {{#classroom_status}}
            <span class="ap-badge ap-badge--info ap-classroom-detail__status">{{classroom_status}}</span>
            {{/classroom_status}}
        </div>
        <div class="ap-classroom-detail__hero-info">
            <h1 class="ap-classroom-detail__title">{{classname_string}}</h1>
            <div class="ap-classroom-detail__dates">
                <i class="fa fa-calendar"></i>
                {{#userdate}}{{startdate}}, %d/%m/%Y %H:%M{{/userdate}} — {{#userdate}}{{enddate}}, %d/%m/%Y %H:%M{{/userdate}}
            </div>
            <div class="ap-classroom-detail__social">
                {{{display_ratings}}} {{{display_like}}} {{{display_review}}}
            </div>
        </div>
    </div>

    {{! ═══ CONTENT (2-column) ═══ }}
    <div class="ap-classroom-detail__body">
        {{! Left: Description + Details }}
        <div class="ap-classroom-detail__main">
            <div class="ap-classroom-detail__section">
                <h3 class="ap-classroom-detail__section-title">{{#str}}summary{{/str}}</h3>
                {{#isdescription}}
                    {{^descriptionstring}}<div class="ap-classroom-detail__desc">{{{description}}}</div>{{/descriptionstring}}
                    {{#descriptionstring}}
                    <div class="ap-classroom-detail__desc">
                        {{descriptionstring}}...
                        {{#fullonlineexamsummary}}<a href="#" data-toggle="popover" title="{{classname}}" data-content="{{fullonlineexamsummary}}">{{#str}}more{{/str}}</a>{{/fullonlineexamsummary}}
                    </div>
                    {{/descriptionstring}}
                {{/isdescription}}
                {{^isdescription}}
                <div class="ap-classroom-detail__desc" style="color:var(--ap-text-muted); font-style:italic;">{{#str}}nocoursedesc, local_classroom{{/str}}</div>
                {{/isdescription}}
            </div>

            {{! Details grid }}
            <div class="ap-classroom-detail__section">
                <div class="ap-classroom-detail__meta-grid">
                    <div class="ap-classroom-detail__meta-item">
                        <i class="fa fa-map-marker"></i>
                        <div><span class="ap-classroom-detail__meta-label">{{#str}}classroom_location, local_classroom{{/str}}</span>
                        <span class="ap-classroom-detail__meta-value">{{#classroomlocation}}{{classroomlocation}}{{/classroomlocation}}{{^classroomlocation}}N/A{{/classroomlocation}}</span></div>
                    </div>
                    <div class="ap-classroom-detail__meta-item">
                        <i class="fa fa-building-o"></i>
                        <div><span class="ap-classroom-detail__meta-label">{{#str}}department, local_classroom{{/str}}</span>
                        <span class="ap-classroom-detail__meta-value" title="{{classroomdepartmenttitle}}">{{#classroomdepartment}}{{classroomdepartment}}{{/classroomdepartment}}{{^classroomdepartment}}N/A{{/classroomdepartment}}</span></div>
                    </div>
                    <div class="ap-classroom-detail__meta-item">
                        <i class="fa fa-cogs"></i>
                        <div><span class="ap-classroom-detail__meta-label">{{#str}}classroomskill, local_classroom{{/str}}</span>
                        <span class="ap-classroom-detail__meta-value">{{#classroomskill}}{{classroomskill}}{{/classroomskill}}{{^classroomskill}}N/A{{/classroomskill}}</span></div>
                    </div>
                    <div class="ap-classroom-detail__meta-item">
                        <i class="fa fa-signal"></i>
                        <div><span class="ap-classroom-detail__meta-label">{{#str}}classroomlevel, local_classroom{{/str}}</span>
                        <span class="ap-classroom-detail__meta-value">{{#classroomlevel}}{{classroomlevel}}{{/classroomlevel}}{{^classroomlevel}}N/A{{/classroomlevel}}</span></div>
                    </div>
                </div>
            </div>

            {{! Trainers }}
            <div class="ap-classroom-detail__section">
                <h3 class="ap-classroom-detail__section-title"><i class="fa fa-chalkboard-teacher"></i> {{#str}}trainers, local_classroom{{/str}}</h3>
                <div class="ap-classroom-detail__trainers {{#trainerpagination}}scroll_trainers{{/trainerpagination}}">
                    {{#trainers}}
                    <div class="ap-classroom-detail__trainer">
                        <div class="ap-classroom-detail__trainer-pic">{{{classroomtrainerpic}}}</div>
                        <div>
                            <span class="ap-classroom-detail__trainer-name">{{trainername}}</span>
                            <span class="ap-classroom-detail__trainer-email">{{traineremail}}</span>
                        </div>
                    </div>
                    {{/trainers}}
                    {{^trainers}}
                    <p style="color:var(--ap-text-muted); font-style:italic;">{{#str}}no_trainer_assigned, local_classroom{{/str}}</p>
                    {{/trainers}}
                    {{#trainerpagination}}
                    <div class="ap-classroom-detail__trainer-nav">
                        <button class="trainer-prev"><i class="fa fa-chevron-left"></i></button>
                        <button class="trainer-next"><i class="fa fa-chevron-right"></i></button>
                    </div>
                    {{/trainerpagination}}
                </div>
            </div>
        </div>

        {{! Right: Seats + Progress }}
        <div class="ap-classroom-detail__sidebar">
            <div class="ap-classroom-detail__sidebar-card">
                <h4 class="ap-classroom-detail__sidebar-title">{{#str}}seats_allocation, local_classroom{{/str}}</h4>
                <div class="ap-classroom-detail__seats">
                    <span class="ap-classroom-detail__seats-count">{{allocatedseats}}/{{totalseats}}</span>
                    <div class="ap-classroom-detail__progress-track">
                        <div class="ap-classroom-detail__progress-fill" style="width:{{seats_progress}}%;"></div>
                    </div>
                    <small>{{seats_progress}}% filled</small>
                </div>

                <h4 class="ap-classroom-detail__sidebar-title" style="margin-top:20px;">{{#str}}users_completions, local_classroom{{/str}}</h4>
                <div class="ap-classroom-detail__seats">
                    <span class="ap-classroom-detail__seats-count">{{completed_seats}}/{{allocatedseats}}</span>
                    <div class="ap-classroom-detail__progress-track">
                        <div class="ap-classroom-detail__progress-fill ap-classroom-detail__progress-fill--success" style="width:{{completion_seats_progress}}%;"></div>
                    </div>
                    <small>{{completion_seats_progress}}% completed</small>
                </div>

                {{#waitinglist_users_tab}}
                <h4 class="ap-classroom-detail__sidebar-title" style="margin-top:20px;">{{#str}}user_waiting_list, local_classroom{{/str}}</h4>
                <div class="ap-classroom-detail__seats">
                    <span class="ap-classroom-detail__seats-count">{{waitingseats}}</span>
                    <small>waiting</small>
                </div>
                {{/waitinglist_users_tab}}

                {{#certificate_exists}}
                {{#certificate_download}}
                <a href="{{config.wwwroot}}/admin/tool/certificate/view.php?code={{certid}}" class="ap-btn-gradient" style="width:100%; justify-content:center; margin-top:20px;">
                    <i class="fa fa-download"></i> Download Certificate
                </a>
                {{/certificate_download}}
                {{/certificate_exists}}
            </div>
        </div>
    </div>

    {{! ═══ INNER TABS (Sessions, Courses, Users, Feedbacks, etc.) ═══ }}
    <div class="ap-classroom-detail__tabs-section">
        <nav class="ap-tabs" role="tablist">
            {{#session_tab}}
            <a class="ap-tab ap-tab--active classroommodules" role="tab" data-toggle="tab" data-module="sessions" data-status="1" href="javascript:void(0);">
                <i class="fa fa-calendar-check-o"></i> {{#str}}sessions, local_classroom{{/str}}
            </a>
            {{/session_tab}}
            {{#course_tab}}
            <a class="ap-tab classroommodules" role="tab" data-toggle="tab" data-module="courses" data-status="2" href="javascript:void(0);">
                <i class="fa fa-book"></i> {{#str}}courses, local_classroom{{/str}}
            </a>
            {{/course_tab}}
            {{#user_tab}}
            <a class="ap-tab classroommodules" role="tab" data-toggle="tab" data-module="users" data-status="3" href="javascript:void(0);">
                <i class="fa fa-users"></i> {{#str}}users, local_classroom{{/str}}
            </a>
            {{/user_tab}}
            {{#feedback_tab}}
            <a class="ap-tab classroommodules" role="tab" data-toggle="tab" data-module="feedbacks" data-status="4" href="javascript:void(0);">
                <i class="fa fa-comments"></i> {{#str}}pluginname, local_evaluation{{/str}}
            </a>
            {{/feedback_tab}}
            {{#completion_settings_tab}}
            <a class="ap-tab informationdata" role="tab" data-toggle="tab" data-module="completioninfo" data-status="6" href="javascript:void(0);"
               onclick="(function(e){ require('local_classroom/classroom').completionInfo({contextid:1, classroomid: {{classroomid}}, name:'completioninfo'}) })(event)">
                <i class="fa fa-check-square-o"></i> {{#str}}completion_settings_tab, local_classroom{{/str}}
            </a>
            {{/completion_settings_tab}}
            {{#user_tab}}
            {{#target_audience_tab}}
            <a class="ap-tab informationdata" role="tab" data-toggle="tab" data-module="targetaudience" data-status="7" href="javascript:void(0);"
               onclick="(function(e){ require('local_classroom/classroom').completionInfo({contextid:1, classroomid: {{classroomid}}, name:'targetaudience'}) })(event)">
                <i class="fa fa-bullseye"></i> {{#str}}target_audience_tab, local_classroom{{/str}}
            </a>
            {{/target_audience_tab}}
            {{/user_tab}}
            {{#requested_users_tab}}
            <a class="ap-tab classroommodules" role="tab" data-toggle="tab" data-module="requestedusers" data-status="5" href="javascript:void(0);">
                <i class="fa fa-hand-paper-o"></i> {{#str}}requested_users_tab, local_classroom{{/str}}
            </a>
            {{/requested_users_tab}}
            {{#waitinglist_users_tab}}
            <a class="ap-tab classroommodules" role="tab" data-toggle="tab" data-module="waitinglistusers" data-status="8" href="javascript:void(0);">
                <i class="fa fa-clock-o"></i> {{#str}}waitinglist_users_tab, local_classroom{{/str}}
            </a>
            {{/waitinglist_users_tab}}
        </nav>

        {{! Tab Panes — IDs and data-region attributes CRITICAL for cardPaginate }}
        <div id="classroommodulescontent">
            <div class="tab-content">
                <div class="tab-pane active" id="sessions" role="tabpanel">
                    {{#createsession}}
                    <div style="margin:12px 0;">
                        <button class="ap-btn-gradient" onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:1, component:'local_classroom', callback:'session_form', form_status:0, plugintype: 'local_classroom', pluginname: 'session', id:0, cid: {{classroomid}}, title: 'addsession' }) })(event)">
                            <i class="fa fa-plus"></i> Add Session
                        </button>
                    </div>
                    {{/createsession}}
                    <div id="sessions_tabdata" data-region="sessions_tabdata-preview-container">
                        <div data-region="sessions_tabdata-count-container"></div>
                        <div data-region="sessions_tabdata-list-container" id="sessionsid"></div>
                    </div>
                </div>

                <div class="tab-pane" id="courses" role="tabpanel">
                    {{#assign_courses}}
                    <div style="margin:12px 0;">
                        <button class="ap-btn-gradient" onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:1, component:'local_classroom', callback:'course_form', form_status:0, plugintype: 'local_classroom', pluginname: 'course', id:0, cid: {{classroomid}} }) })(event)">
                            <i class="fa fa-plus"></i> Assign Courses
                        </button>
                    </div>
                    {{/assign_courses}}
                    <div id="courses_tabdata" data-region="courses_tabdata-preview-container">
                        <div data-region="courses_tabdata-count-container"></div>
                        <div data-region="courses_tabdata-list-container" id="coursesid"></div>
                    </div>
                </div>

                <div class="tab-pane" id="users" role="tabpanel">
                    {{#assignusers}}
                    <div style="margin:12px 0;">
                        <a href="{{config.wwwroot}}/local/classroom/enrollusers.php?cid={{classroomid}}" class="ap-btn-gradient">
                            <i class="fa fa-user-plus"></i> {{#str}}viewclassroom_assign_users, local_classroom{{/str}}
                        </a>
                    </div>
                    {{/assignusers}}
                    <div id="users_tabdata" data-region="users_tabdata-preview-container">
                        <div data-region="users_tabdata-count-container"></div>
                        <div data-region="users_tabdata-list-container" id="usersid"></div>
                    </div>
                </div>

                <div class="tab-pane" id="feedbacks" role="tabpanel">
                    {{#createfeedback}}
                    <div style="margin:12px 0;">
                        <button class="ap-btn-gradient" onclick="(function(e){ require('local_evaluation/newevaluation').init('createevaluationmodal',1, -1,{{classroomid}},'classroom') })(event)">
                            <i class="fa fa-plus"></i> {{#str}}createevaluation, local_evaluation{{/str}}
                        </button>
                    </div>
                    {{/createfeedback}}
                    <div id="feedbacks_tabdata" data-region="feedbacks_tabdata-preview-container">
                        <div data-region="feedbacks_tabdata-count-container"></div>
                        <div data-region="feedbacks_tabdata-list-container" id="feedbacksid"></div>
                    </div>
                </div>

                <div class="tab-pane" id="completioninfo" role="tabpanel"><div class="completioninfo"></div></div>
                <div class="tab-pane" id="targetaudience" role="tabpanel"><div class="targetaudience"></div></div>

                <div class="tab-pane" id="requestedusers" role="tabpanel">
                    <div id="requestedusers_tabdata" data-region="requestedusers_tabdata-preview-container">
                        <div data-region="requestedusers_tabdata-count-container"></div>
                        <div data-region="requestedusers_tabdata-list-container" id="requestedusersid"></div>
                    </div>
                </div>

                <div class="tab-pane" id="waitinglistusers" role="tabpanel">
                    <div id="waitinglistusers_tabdata" data-region="waitinglistusers_tabdata-preview-container">
                        <div data-region="waitinglistusers_tabdata-count-container"></div>
                        <div data-region="waitinglistusers_tabdata-list-container" id="waitinglistusersid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Classroom Detail */
.ap-classroom-detail { max-width: 1200px; margin: 0 auto; font-family: var(--ap-font); }
.ap-classroom-detail-actions { display: flex; gap: 8px; justify-content: flex-end; margin-bottom: 12px; flex-wrap: wrap; }
.ap-classroom-detail-actions__btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 500;
    background: var(--ap-surface); border: 1px solid var(--ap-border); color: var(--ap-text-secondary);
    text-decoration: none; cursor: pointer; transition: all 0.15s; font-family: inherit;
}
.ap-classroom-detail-actions__btn:hover { border-color: var(--ap-primary); color: var(--ap-primary); background: var(--ap-primary-light, #e8f2f9); }
.ap-classroom-detail-actions__btn--danger:hover { border-color: var(--ap-danger); color: var(--ap-danger); background: #fef2f2; }

/* Hero */
.ap-classroom-detail__hero {
    display: flex; gap: 24px; background: var(--ap-surface);
    border: 1px solid var(--ap-border); border-radius: 16px;
    overflow: hidden; margin-bottom: 20px;
}
.ap-classroom-detail__hero-image {
    width: 280px; min-height: 200px; flex-shrink: 0;
    background-size: cover; background-position: center; background-color: #e8f2f9;
    position: relative;
}
.ap-classroom-detail__status { position: absolute; top: 12px; left: 12px; }
.ap-classroom-detail__hero-info { padding: 24px; flex: 1; display: flex; flex-direction: column; justify-content: center; }
.ap-classroom-detail__title { font-size: 24px; font-weight: 800; color: var(--ap-text); margin: 0 0 8px; }
.ap-classroom-detail__dates { font-size: 14px; color: var(--ap-text-secondary); margin-bottom: 12px; }
.ap-classroom-detail__dates i { color: var(--ap-primary); margin-right: 6px; }

/* Body 2-col */
.ap-classroom-detail__body { display: grid; grid-template-columns: 1fr 320px; gap: 20px; margin-bottom: 24px; }
.ap-classroom-detail__main { min-width: 0; }
.ap-classroom-detail__section {
    background: var(--ap-surface); border: 1px solid var(--ap-border);
    border-radius: 12px; padding: 20px; margin-bottom: 16px;
}
.ap-classroom-detail__section-title {
    font-size: 15px; font-weight: 700; color: var(--ap-text); margin: 0 0 12px;
    display: flex; align-items: center; gap: 8px;
}
.ap-classroom-detail__section-title i { color: var(--ap-primary); }
.ap-classroom-detail__desc { font-size: 14px; line-height: 1.6; color: var(--ap-text-secondary); }

/* Meta grid */
.ap-classroom-detail__meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.ap-classroom-detail__meta-item { display: flex; gap: 10px; }
.ap-classroom-detail__meta-item > i { width: 16px; text-align: center; color: var(--ap-primary); margin-top: 2px; }
.ap-classroom-detail__meta-label { display: block; font-size: 11px; color: var(--ap-text-muted); text-transform: uppercase; letter-spacing: 0.3px; }
.ap-classroom-detail__meta-value { display: block; font-size: 14px; font-weight: 600; color: var(--ap-text); }

/* Trainers */
.ap-classroom-detail__trainers { display: flex; flex-wrap: wrap; gap: 12px; }
.ap-classroom-detail__trainer { display: flex; align-items: center; gap: 10px; min-width: 200px; }
.ap-classroom-detail__trainer-pic img, .ap-classroom-detail__trainer-pic .userpicture { width: 36px; height: 36px; border-radius: 50%; }
.ap-classroom-detail__trainer-name { display: block; font-size: 13px; font-weight: 600; color: var(--ap-text); }
.ap-classroom-detail__trainer-email { display: block; font-size: 12px; color: var(--ap-text-muted); }
.ap-classroom-detail__trainer-nav { display: flex; gap: 6px; }
.ap-classroom-detail__trainer-nav button {
    width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--ap-border);
    background: var(--ap-surface); cursor: pointer; display: flex; align-items: center; justify-content: center;
    color: var(--ap-text-secondary); transition: all 0.15s;
}
.ap-classroom-detail__trainer-nav button:hover { border-color: var(--ap-primary); color: var(--ap-primary); }

/* Sidebar */
.ap-classroom-detail__sidebar-card {
    background: var(--ap-surface); border: 1px solid var(--ap-border);
    border-radius: 12px; padding: 20px; position: sticky; top: 80px;
}
.ap-classroom-detail__sidebar-title { font-size: 13px; font-weight: 700; color: var(--ap-text-muted); text-transform: uppercase; letter-spacing: 0.3px; margin: 0 0 8px; }
.ap-classroom-detail__seats { margin-bottom: 4px; }
.ap-classroom-detail__seats-count { font-size: 22px; font-weight: 800; color: var(--ap-text); }
.ap-classroom-detail__progress-track { height: 6px; background: var(--ap-border); border-radius: 3px; margin: 6px 0 4px; }
.ap-classroom-detail__progress-fill { height: 100%; background: var(--ap-gradient); border-radius: 3px; transition: width 0.5s; }
.ap-classroom-detail__progress-fill--success { background: var(--ap-success, #16a34a); }
.ap-classroom-detail__seats small { font-size: 12px; color: var(--ap-text-muted); }

/* Inner tabs section */
.ap-classroom-detail__tabs-section {
    background: var(--ap-surface); border: 1px solid var(--ap-border);
    border-radius: 12px; padding: 20px; overflow: hidden;
}
#classroommodulescontent .tab-pane { display: none; }
#classroommodulescontent .tab-pane.active { display: block; }

/* Hide old extended menu */
.classview_topcontainer .course_extended_menu_list { display: none !important; }

/* Responsive */
@media (max-width: 992px) {
    .ap-classroom-detail__body { grid-template-columns: 1fr; }
    .ap-classroom-detail__sidebar-card { position: static; }
}
@media (max-width: 590px) {
    .ap-classroom-detail__hero { flex-direction: column; }
    .ap-classroom-detail__hero-image { width: 100%; min-height: 160px; }
    .ap-classroom-detail__meta-grid { grid-template-columns: 1fr; }
}

/* Dark mode */
body.dark-mode .ap-classroom-detail__hero,
body.dark-mode .ap-classroom-detail__section,
body.dark-mode .ap-classroom-detail__sidebar-card,
body.dark-mode .ap-classroom-detail__tabs-section { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-classroom-detail__title { color: #e8eaed; }
body.dark-mode .ap-classroom-detail__desc { color: #9ca3b4; }
body.dark-mode .ap-classroom-detail__meta-value { color: #e8eaed; }
body.dark-mode .ap-classroom-detail__seats-count { color: #e8eaed; }
body.dark-mode .ap-classroom-detail__progress-track { background: #2d3140; }
</style>

{{! ═══ JAVASCRIPT — PRESERVED from original ═══ }}
{{#js}}
require(['jquery'], function($) {
    $(document).ready(function() {
        $(".trainer-next, .trainer-prev").click(function() {
            var div = $(".ap-classroom-detail__trainer")[0] || $(".trainers_scroll")[0];
            if (!div) return;
            var html = $(div).html();
            $(div).remove();
            $(".ap-classroom-detail__trainers, .topcontent_right_bottom").append(
                "<div class='ap-classroom-detail__trainer'>" + html + "</div>"
            );
        });
    });

    // Inner tab switching with cardPaginate.
    $('.classroommodules').click(function() {
        var classroommodule = $(this).data('module');
        if ($(this).hasClass('ap-tab--active') || $(this).find('a').hasClass('active')) {
            return true;
        }
        $('.classroommodules, .informationdata').removeClass('ap-tab--active');
        $(this).addClass('ap-tab--active');
        $(".tab-pane").removeClass('active');
        $("#" + classroommodule).addClass('active');

        var status = $(this).data('status');
        var targetid = classroommodule + '_tabdata';
        var options = {
            targetID: targetid,
            templateName: 'local_classroom/classroomview' + classroommodule,
            methodName: 'local_classroom_classroomview' + classroommodule,
            perPage: 5,
            cardClass: 'col-md-12 col-12',
            viewType: 'card'
        };
        var dataoptions = {tabname: classroommodule, classroomid: {{classroomid}}, contextid: 1};
        var filterdata = {};

        for (var i = 1; i <= 8; i++) {
            if (status != i) {
                switch (i) {
                    case 1: $("#sessionsid").empty(); break;
                    case 2: $("#coursesid").empty(); break;
                    case 3: $("#usersid").empty(); break;
                    case 4: $("#feedbacksid").empty(); break;
                    case 5: $("#requestedusersid").empty(); break;
                    case 6: $(".completioninfo").empty(); break;
                    case 7: $(".targetaudience").empty(); break;
                    case 8: $("#waitinglistusersid").empty(); break;
                }
            }
        }
        require(['local_costcenter/cardPaginate'], function(cardPaginate) {
            cardPaginate.reload(options, dataoptions, filterdata);
        });
    });

    // informationdata tab handling (completion, target audience).
    $('.informationdata').click(function() {
        $('.classroommodules, .informationdata').removeClass('ap-tab--active');
        $(this).addClass('ap-tab--active');
        var module = $(this).data('module');
        $(".tab-pane").removeClass('active');
        $("#" + module).addClass('active');
    });
});
{{/js}}
{{/classroom}}
