{{#response}}
{{#viewtypeCard}}
<div id="users_tab_content">
    <div class="ap-sessions-table-wrap">
    <table class="ap-sessions-table" id="coursesdata">
        <thead>
            <tr>
                <th>{{#str}}employee,local_classroom{{/str}}</th>
                <th>{{#str}}employeeid,local_classroom{{/str}}</th>
                <th>{{#str}}email{{/str}}</th>
                <th>{{#str}}supervisor,local_classroom{{/str}}</th>
                <th>{{#str}}attended_sessions,local_classroom{{/str}}</th>
                <th>{{#str}}attended_hours,local_classroom{{/str}}</th>
                <th>{{#str}}status{{/str}}</th>
                {{#mapped_certificate}}<th>{{#str}}downloadcertificate,local_classroom{{/str}}</th>{{/mapped_certificate}}
            </tr>
        </thead>
        <tbody>
        {{#records}}
        <tr>
            <td>{{{name}}}</td>
            <td>{{employeeid}}</td>
            <td style="font-size:12px; color:var(--ap-text-secondary);">{{email}}</td>
            <td>{{supervisor}}</td>
            <td><strong>{{attendedsessions}}</strong></td>
            <td>{{hours}}</td>
            <td>
                {{#completionstatus}}<span class="ap-badge ap-badge--success"><i class="fa fa-check"></i> Done</span>{{/completionstatus}}
                {{^completionstatus}}<span class="ap-badge ap-badge--muted"><i class="fa fa-times"></i> Pending</span>{{/completionstatus}}
            </td>
            {{#mapped_certificate}}
            <td>
                {{#downloadcertificate}}
                <a href="{{wwwroot}}/admin/tool/certificate/view.php?code={{certid}}" title="{{#str}}download_certificate, local_classroom{{/str}}" class="ap-sessions-table__action-btn">
                    <i class="fa fa-download"></i>
                </a>
                {{/downloadcertificate}}
                {{^downloadcertificate}}
                <span style="font-size:12px; color:var(--ap-text-muted);">{{#str}}notassigned, local_classroom{{/str}}</span>
                {{/downloadcertificate}}
            </td>
            {{/mapped_certificate}}
        </tr>
        {{/records}}
        </tbody>
    </table>
    </div>
</div>
{{/viewtypeCard}}
{{/response}}
