{{! ═══ CLASSROOM PAGE — Action Bar + Tabs + Content ═══ }}

{{! Action buttons (reports, request, location, create) }}
<div class="ap-classroom-actions">
    {{#reports.0}}
    <div class="dropdown">
        <a href="#" class="ap-classroom-actions__btn" data-toggle="dropdown" aria-expanded="false" title="{{#str}}classroom_reports,local_classroom{{/str}}">
            <i class="fa fa-signal"></i> Reports
        </a>
        <div class="dropdown-menu dropdown-menu-right" role="menu">
            {{#reports}}
            <a href="{{config.wwwroot}}/blocks/learnerscript/viewreport.php?id={{classroomid}}" class="dropdown-item" target="_blank">
                {{name}}
            </a>
            {{/reports}}
        </div>
    </div>
    {{/reports.0}}
    {{#request_url}}
    <a href="{{request_url}}" class="ap-classroom-actions__btn" title="{{#str}}requestforenroll,local_classroom{{/str}}">
        <i class="fa fa-share-square"></i>
    </a>
    {{/request_url}}
    {{#location_url}}
    <a href="{{location_url}}" class="ap-classroom-actions__btn" title="{{#str}}location,local_classroom{{/str}}">
        <i class="fa fa-map-marker"></i>
    </a>
    {{/location_url}}
    {{#creataclassroom}}
    <button class="ap-btn-gradient" onclick="(function(e){ require('local_classroom/ajaxforms').init({contextid:{{contextid}}, component:'local_classroom', callback:'classroom_form', form_status:0, plugintype: '{{plugintype}}', pluginname: '{{plugin_name}}', id:0, title: 'createclassroom' }) })(event)">
        <i class="fa fa-plus"></i> New Classroom
    </button>
    {{/creataclassroom}}
</div>

{{! Status Tabs — data-status and data-module attributes are CRITICAL for cardPaginate JS }}
<div id="status_tabs">
    <div class="ap-classroom-tabs">
        <nav class="ap-tabs" role="tablist">
            {{#all_tab}}
            <a class="ap-tab ap-tab--active classroomstatus" role="tab" data-toggle="tab" data-status="-1" data-module="all" href="javascript:void(0);" title="{{#str}}allclasses, local_classroom{{/str}}">
                <i class="fa fa-list-ul"></i> {{#str}}allclasses, local_classroom{{/str}}
            </a>
            {{/all_tab}}
            {{#new_tab}}
            <a class="ap-tab classroomstatus" role="tab" data-toggle="tab" data-status="0" data-module="new" href="javascript:void(0);" title="{{#str}}newclasses, local_classroom{{/str}}">
                <i class="fa fa-bullhorn"></i> {{#str}}newclasses, local_classroom{{/str}}
            </a>
            {{/new_tab}}
            {{#active_tab}}
            <a class="ap-tab classroomstatus" role="tab" data-toggle="tab" data-status="1" data-module="active" href="javascript:void(0);" title="{{#str}}activeclasses, local_classroom{{/str}}">
                <i class="fa fa-thumbs-o-up"></i> {{#str}}activeclasses, local_classroom{{/str}}
            </a>
            {{/active_tab}}
            {{#hold_tab}}
            <a class="ap-tab classroomstatus" role="tab" data-toggle="tab" data-status="2" data-module="hold" href="javascript:void(0);" title="{{#str}}holdclasses, local_classroom{{/str}}">
                <i class="fa fa-hand-o-up"></i> {{#str}}holdclasses, local_classroom{{/str}}
            </a>
            {{/hold_tab}}
            {{#cancelled_tab}}
            <a class="ap-tab classroomstatus" role="tab" data-toggle="tab" data-status="3" data-module="cancelled" href="javascript:void(0);" title="{{#str}}cancelledclasses, local_classroom{{/str}}">
                <i class="fa fa-lock"></i> {{#str}}cancelledclasses, local_classroom{{/str}}
            </a>
            {{/cancelled_tab}}
            {{#completed_tab}}
            <a class="ap-tab classroomstatus" role="tab" data-toggle="tab" data-status="4" data-module="completed" href="javascript:void(0);" title="{{#str}}completedclasses, local_classroom{{/str}}">
                <i class="fa fa-flag-o"></i> {{#str}}completedclasses, local_classroom{{/str}}
            </a>
            {{/completed_tab}}
        </nav>

        {{! View toggle }}
        {{#viewcardlist}}
        <a class="ap-classroom-tabs__view-toggle" href="{{cardlisturl}}" title="{{cardlistlabel}}">
            <i class="{{cardlistclass}}"></i>
        </a>
        {{/viewcardlist}}
    </div>

    {{! Tab Panes — IDs and data-region attributes are CRITICAL for cardPaginate AJAX injection }}
    <div class="tab-content">
        {{! All tab (active by default) }}
        <div class="tab-pane active" id="all_tab">
            <div class="card-paginate_wrap" id="all" data-region="all-preview-container">
                <div data-region="all-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="all-list-container" id="allid"></div>
            </div>
        </div>

        {{! Status-specific tab panes (same structure, different IDs) }}
        <div class="tab-pane" id="new_tab">
            <div class="card-paginate_wrap" id="new" data-region="new-preview-container">
                <div data-region="new-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="new-list-container" id="newid"></div>
            </div>
        </div>
        <div class="tab-pane" id="active_tab">
            <div class="card-paginate_wrap" id="active" data-region="active-preview-container">
                <div data-region="active-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="active-list-container" id="activeid"></div>
            </div>
        </div>
        <div class="tab-pane" id="hold_tab">
            <div class="card-paginate_wrap" id="hold" data-region="hold-preview-container">
                <div data-region="hold-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="hold-list-container" id="holdid"></div>
            </div>
        </div>
        <div class="tab-pane" id="cancelled_tab">
            <div class="card-paginate_wrap" id="cancelled" data-region="cancelled-preview-container">
                <div data-region="cancelled-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="cancelled-list-container" id="cancelledid"></div>
            </div>
        </div>
        <div class="tab-pane" id="completed_tab">
            <div class="card-paginate_wrap" id="completed" data-region="completed-preview-container">
                <div data-region="completed-count-container"></div>
                <div class="ap-classroom-search">
                    <i class="fa fa-search ap-classroom-search__icon"></i>
                    <input id="global_filter" class="global filter ap-classroom-search__input" type="text" name="search_query" placeholder="Search classrooms...">
                </div>
                <div data-region="completed-list-container" id="completedid"></div>
            </div>
        </div>
    </div>
</div>

<style>
/* Classroom Actions Bar */
.ap-classroom-actions {
    display: flex; align-items: center; justify-content: flex-end;
    gap: 8px; margin-bottom: 16px; flex-wrap: wrap;
}
.ap-classroom-actions__btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 500;
    color: var(--ap-text-secondary, #607286);
    background: var(--ap-surface, #fff);
    border: 1px solid var(--ap-border, #e3eaf3);
    text-decoration: none; transition: all 0.15s; cursor: pointer;
}
.ap-classroom-actions__btn:hover { border-color: var(--ap-primary, #0066A7); color: var(--ap-primary); background: var(--ap-primary-light, #e8f2f9); }

/* Tabs container */
.ap-classroom-tabs {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 16px;
}
.ap-classroom-tabs .ap-tabs { flex: 1; }
.ap-classroom-tabs__view-toggle {
    padding: 8px 12px; color: var(--ap-text-secondary);
    text-decoration: none; border-radius: 8px;
    transition: background 0.15s;
}
.ap-classroom-tabs__view-toggle:hover { background: var(--ap-surface-alt, #f8f9fc); }

/* Tab active override for classroomstatus clicks */
.ap-classroom-tabs .classroomstatus.ap-tab--active,
.ap-classroom-tabs .classroomstatus a.active,
.ap-classroom-tabs .ap-tab.active {
    color: var(--ap-primary, #0066A7) !important;
    border-bottom-color: var(--ap-primary) !important;
    font-weight: 600;
}

/* Search bar in each tab pane */
.ap-classroom-search {
    position: relative; max-width: 320px; margin-bottom: 16px;
}
.ap-classroom-search__icon {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    color: var(--ap-text-muted, #8896a6); font-size: 13px;
}
.ap-classroom-search__input {
    width: 100%; padding: 8px 12px 8px 36px;
    border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: 8px; font-size: 13px;
    font-family: var(--ap-font, 'Montserrat', sans-serif);
    transition: border-color 0.15s;
}
.ap-classroom-search__input:focus {
    outline: none; border-color: var(--ap-primary, #0066A7);
    box-shadow: 0 0 0 3px rgba(0,102,167,0.1);
}

/* Hide the old BizLMS extended menu since we replaced it */
.course_extended_menu_list { display: none !important; }
.course_contextmenu_extended { display: none !important; }

/* Override tab pane visibility for BizLMS cardPaginate compatibility */
#status_tabs .tab-pane { display: none; }
#status_tabs .tab-pane.active { display: block; }

/* Dark mode */
body.dark-mode .ap-classroom-actions__btn { background: #1a1d27; border-color: #2d3140; color: #9ca3b4; }
body.dark-mode .ap-classroom-search__input { background: #1a1d27; border-color: #2d3140; color: #e8eaed; }
</style>

{{! ═══ JAVASCRIPT — PRESERVED EXACTLY from original ═══ }}
{{! This JS block drives cardPaginate tab switching + search. }}
{{! DO NOT modify variable names or cardPaginate.reload() calls. }}
{{#js}}
require(['jquery', 'local_costcenter/cardPaginate'], function($, cardPaginate) {
    // Tab click handler — switches status and reloads cards.
    $('.classroomstatus').click(function(){
        if ($(this).hasClass('ap-tab--active') || $(this).find('a').hasClass('active')){
            return true;
        }

        // Update active tab styling.
        $('.classroomstatus').removeClass('ap-tab--active');
        $(this).addClass('ap-tab--active');

        var classroomstatus = $(this).data('status');
        var classroommodule = $(this).data('module');

        $('#status_tabs .tab-pane').removeClass('active');
        $('#status_tabs #'+classroommodule+'_tab').addClass('active');

        var options = {targetID: classroommodule,
                    templateName: '{{ templatename }}',
                    methodName: 'local_classroom_get_classrooms',
                    perPage: {{ perpage }},
                    cardClass: '{{ cardclass }}',
                    viewType:  '{{ view_type }}'
                };

        var dataoptions = {status: classroomstatus};

        // Clear other tab containers.
        for(i = -1; i<=4; i++){
            if(classroomstatus != i){
                switch(i){
                    case -1: $("#allid").empty(); break;
                    case 0: $("#newid").empty(); break;
                    case 1: $("#activeid").empty(); break;
                    case 2: $("#holdid").empty(); break;
                    case 3: $("#cancelledid").empty(); break;
                    case 4: $("#completedid").empty(); break;
                }
            }
        }
        cardPaginate.reload(options, dataoptions);
    });

    // Search with debounce.
    var search_interval = 100;
    var timer;
    $(document).on('keyup', '#global_filter', function(){
        var searchval = $(this).val();
        var thiselement = $('.classroomstatus.ap-tab--active').length ?
            $('.classroomstatus.ap-tab--active') :
            $('.classroomstatus a.active').parent();
        var classroomstatus = thiselement.data('status');
        var classroommodule = thiselement.data('module');

        var options = {targetID: classroommodule,
                    templateName: '{{ templatename }}',
                    methodName: 'local_classroom_get_classrooms',
                    perPage: {{ perpage }},
                    cardClass: '{{ cardclass }}',
                    viewType: '{{ view_type }}'
                };

        var dataoptions = {status: classroomstatus, search_query: searchval};
        timer = setTimeout(function(){
            cardPaginate.reload(options, dataoptions);
        }, search_interval);
    });
    $(document).on('keydown', '#global_filter', function(){
        clearTimeout(timer);
    });
});
{{/js}}
