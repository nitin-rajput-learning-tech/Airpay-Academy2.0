{{!
    @template local_airpay_cart/redirect_to_gateway

    Auto-submitting form that POSTs to the payment gateway with all
    required params. Shows a "Redirecting to gateway..." message while
    the form auto-submits via JS on page load.
}}
<div class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Redirecting...</span>
    </div>
    <h4 class="mt-3">Redirecting you to {{ gateway }} payment gateway...</h4>
    <p class="text-muted">If you are not redirected within 3 seconds,
        <a href="#" onclick="document.getElementById('airpay-cart-gateway-form').submit();
            return false;">click here</a>.</p>
</div>

<form id="airpay-cart-gateway-form" method="POST" action="{{ action_url }}"
      style="display:none;">
    {{#params}}
    <input type="hidden" name="{{ key }}" value="{{ value }}"/>
    {{/params}}
</form>

<script>
    setTimeout(function() {
        document.getElementById('airpay-cart-gateway-form').submit();
    }, 500);
</script>
