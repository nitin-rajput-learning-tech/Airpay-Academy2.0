{{!
    @template local_airpay_courses/bulk_unenrol_summary
}}
<div class="container">
    <h3 class="mb-3">
        {{#dryrun}}Dry-run result{{/dryrun}}
        {{^dryrun}}Bulk unenrol complete{{/dryrun}}
    </h3>

    <div class="row mb-4">
        <div class="col-md-4 mb-2">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:var(--ap-color-success,#16a34a);">
                    {{ processed }}
                </div>
                <div class="text-muted small text-uppercase">
                    {{#dryrun}}Would unenrol{{/dryrun}}
                    {{^dryrun}}Unenrolled{{/dryrun}}
                </div>
            </div></div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:var(--ap-color-text-secondary,#5a6070);">
                    {{ skipped }}
                </div>
                <div class="text-muted small text-uppercase">Skipped</div>
            </div></div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:var(--ap-color-danger,#dc2626);">
                    {{ failed }}
                </div>
                <div class="text-muted small text-uppercase">Failed</div>
            </div></div>
        </div>
    </div>

    <h5>Per-row report</h5>
    <table class="table table-sm">
        <thead><tr><th>Status</th><th>Line</th><th>Message</th></tr></thead>
        <tbody>
            {{#report}}
            <tr>
                <td>
                    {{#status}}
                    <span class="badge bg-{{#status}}{{=<% %>=}}{{#=<% %>=}}{{/status}}{{status}}">{{ status }}</span>
                    {{/status}}
                </td>
                <td><code class="small">{{ line }}</code></td>
                <td>{{ msg }}</td>
            </tr>
            {{/report}}
        </tbody>
    </table>
    {{#report_truncated}}<p class="text-muted small">(Report truncated to first 50 rows)</p>{{/report_truncated}}

    <a href="javascript:history.back()" class="btn btn-link">← Back</a>
</div>
