{{!
    Airpay Course Management — datatable-driven admin listing.

    @template local_airpay_courses/manage
    @package  local_airpay_courses
}}
<style>
    [data-region="airpay-courses"] .ap-filter-bar { background: var(--ap-color-bg-surface, #fff); border: 1px solid var(--ap-color-border, #e2e6ef); border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; }
    [data-region="airpay-courses"] .btn-group .btn { border-color: var(--ap-color-border, #e2e6ef); }
    [data-region="airpay-courses"] .btn-group .btn.active { background: var(--ap-color-primary, #0066A7); color: #fff; border-color: var(--ap-color-primary, #0066A7); }
</style>

<div data-region="airpay-courses">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Course Management</h2>
        <p class="text-muted mb-0">Build, organise, and manage learning content across categories.</p>
    </div>
    {{#can_create}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-course">
        <i class="fa fa-plus fa-fw"></i> New Course
    </a>
    {{/can_create}}
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
            <div class="text-muted small text-uppercase">Total Courses</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{visible_count}}</div>
            <div class="text-muted small text-uppercase">Visible</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-text-secondary, #5a6070);">{{hidden_count}}</div>
            <div class="text-muted small text-uppercase">Hidden</div>
        </div></div>
    </div>
</div>

<div class="ap-filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        {{#has_cat_options}}
        <div>
            <label class="small text-muted mb-1 d-block">Category</label>
            <select class="form-select form-select-sm" data-airpay-courses-filter="categoryid" style="min-width: 220px;">
                <option value="0">All Categories</option>
                {{#cat_options}}
                <option value="{{id}}">{{name}}</option>
                {{/cat_options}}
            </select>
        </div>
        {{/has_cat_options}}

        <div>
            <label class="small text-muted mb-1 d-block">Visibility</label>
            <div class="btn-group btn-group-sm" role="group" data-airpay-courses-visibility>
                <button type="button" class="btn btn-light active"  data-visibility="all">All</button>
                <button type="button" class="btn btn-light"         data-visibility="visible">Visible</button>
                <button type="button" class="btn btn-light"         data-visibility="hidden">Hidden</button>
            </div>
        </div>
    </div>
</div>

<div data-airpay-table
     data-endpoint="local_airpay_courses_list_courses"
     data-columns="{{columns_json}}"
     data-search-placeholder="Search course name, code, or ID number…"
     data-perpage="25">
</div>

</div>

{{#js}}
require([
    'theme_airpayux/datatable',
    'local_airpay_courses/course_actions'
], function(Datatable, CourseActions) {
    Datatable.init();
    CourseActions.init();

    var root = document.querySelector('[data-airpay-table]');
    var dt = Datatable.getInstance(root);
    if (!dt) return;

    document.querySelectorAll('[data-airpay-courses-filter]').forEach(function(el) {
        el.addEventListener('change', function(e) {
            var key = e.target.dataset.airpayCoursesFilter;
            dt.setFilter(key, parseInt(e.target.value, 10) || 0);
        });
    });

    document.querySelectorAll('[data-airpay-courses-visibility] [data-visibility]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var v = e.target.dataset.visibility;
            document.querySelectorAll('[data-airpay-courses-visibility] [data-visibility]').forEach(function(b) {
                b.classList.toggle('active', b === e.target);
            });
            dt.setFilter('visibility', v);
        });
    });
});
{{/js}}
