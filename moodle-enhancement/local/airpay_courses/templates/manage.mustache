{{!
    Airpay Course Management — admin course listing.

    @template local_airpay_courses/manage
    @package  local_airpay_courses
}}
<style>
    [data-region="airpay-courses"] .dropdown-toggle.no-arrow::after { display: none !important; }
    [data-region="airpay-courses"] .dropdown-toggle.no-arrow { box-shadow: none; background: none; border: none; }
    [data-region="airpay-courses"] .dropdown-toggle.no-arrow:hover { color: var(--ap-color-primary, #0066A7) !important; }
</style>

<div data-region="airpay-courses">

{{! ── Header ────────────────────────────────────────── }}
<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Course Management</h2>
        <p class="text-muted mb-0">Manage courses, enrolments, and completion tracking across your organisation.</p>
    </div>
    <div class="d-flex gap-2">
        {{#can_create}}
        <a href="#" class="btn btn-primary btn-sm" data-action="create-course">
            <i class="fa fa-plus fa-fw"></i> Create Course
        </a>
        {{/can_create}}
    </div>
</div>

{{! ── KPI Cards ─────────────────────────────────────── }}
<div class="row mb-4">
    <div class="col-6 col-md-3 mb-2">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-3">
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
                <div class="text-muted small text-uppercase">Total Courses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-2">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-3">
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{visible_count}}</div>
                <div class="text-muted small text-uppercase">Active</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-2">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-3">
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-accent, #0f7a73);">{{total_enrolments}}</div>
                <div class="text-muted small text-uppercase">Enrolments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-2">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-3">
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--ap-color-warning, #d97706);">{{total_completions}}</div>
                <div class="text-muted small text-uppercase">Completions</div>
            </div>
        </div>
    </div>
</div>

{{! ── Filter Bar ────────────────────────────────────── }}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" action="{{{filter_url}}}" class="d-flex flex-wrap align-items-end gap-3">
            <div class="flex-grow-1" style="min-width: 180px;">
                <label class="small text-muted mb-1 d-block">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fa fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Course name or code..." value="{{search}}">
                </div>
            </div>
            {{#has_org_options}}
            <div style="min-width: 160px;">
                <label class="small text-muted mb-1 d-block">Organisation</label>
                <select name="orgid" class="form-select form-select-sm">
                    <option value="0">All</option>
                    {{#org_options}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/org_options}}
                </select>
            </div>
            {{/has_org_options}}
            {{#has_cat_options}}
            <div style="min-width: 140px;">
                <label class="small text-muted mb-1 d-block">Category</label>
                <select name="catid" class="form-select form-select-sm">
                    <option value="0">All</option>
                    {{#cat_options}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/cat_options}}
                </select>
            </div>
            {{/has_cat_options}}
            <div style="min-width: 120px;">
                <label class="small text-muted mb-1 d-block">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="visible" {{#status_visible}}selected{{/status_visible}}>Active</option>
                    <option value="hidden" {{#status_hidden}}selected{{/status_hidden}}>Hidden</option>
                    <option value="all" {{#status_all}}selected{{/status_all}}>All</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-filter fa-fw"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

{{! ── Results Count ─────────────────────────────────── }}
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        {{#has_courses}}Showing {{showing_from}}&ndash;{{showing_to}} of {{filtered_count}} courses{{/has_courses}}
        {{^has_courses}}No courses match your filters{{/has_courses}}
    </span>
</div>

{{! ── Data Table ────────────────────────────────────── }}
{{#has_courses}}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr style="background: var(--ap-color-primary, #0066A7); color: #fff;">
                    <th class="ps-3">
                        <a href="{{{sort_name.url}}}" class="text-white text-decoration-none">
                            Course Name <i class="fa {{sort_name.icon}} ms-1"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{{sort_shortname.url}}}" class="text-white text-decoration-none">
                            Code <i class="fa {{sort_shortname.icon}} ms-1"></i>
                        </a>
                    </th>
                    <th>Category</th>
                    <th>Organisation</th>
                    <th class="text-center">
                        <a href="{{{sort_enrolled.url}}}" class="text-white text-decoration-none">
                            Enrolled <i class="fa {{sort_enrolled.icon}} ms-1"></i>
                        </a>
                    </th>
                    <th class="text-center">
                        <a href="{{{sort_completed.url}}}" class="text-white text-decoration-none">
                            Completed <i class="fa {{sort_completed.icon}} ms-1"></i>
                        </a>
                    </th>
                    <th class="text-center">Rate</th>
                    <th>Status</th>
                    {{#can_manage}}<th class="text-end pe-3">Actions</th>{{/can_manage}}
                </tr>
            </thead>
            <tbody>
                {{#courses}}
                <tr>
                    <td class="ps-3">
                        <a href="{{{courseurl}}}" class="fw-semibold text-decoration-none">{{fullname}}</a>
                    </td>
                    <td class="text-muted small">{{shortname}}</td>
                    <td class="small">{{categoryname}}</td>
                    <td class="small">{{orgname}}</td>
                    <td class="text-center">{{enrolled}}</td>
                    <td class="text-center">{{completed}}</td>
                    <td class="text-center fw-semibold {{rate_color}}">{{completion_rate}}%</td>
                    <td><span class="badge {{statuscss}}">{{statuslabel}}</span></td>
                    {{#can_manage}}
                    <td class="text-end pe-3">
                        <div class="dropdown">
                            <button type="button" class="btn btn-sm btn-link text-muted p-0 dropdown-toggle no-arrow" data-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                                <i class="fa fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right">
                                <li><a class="dropdown-item" href="{{{courseurl}}}"><i class="fa fa-eye fa-fw"></i> View Course</a></li>
                                <li>
                                    <a class="dropdown-item" href="#"
                                       data-action="edit-course" data-courseid="{{id}}" data-coursename="{{fullname}}">
                                        <i class="fa fa-pencil fa-fw"></i> Edit
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="{{{enrollurl}}}"><i class="fa fa-users fa-fw"></i> Enrolments</a></li>
                                <li>
                                    {{#isvisible}}
                                    <a class="dropdown-item" href="#"
                                       data-action="hide-course" data-courseid="{{id}}" data-coursename="{{fullname}}">
                                        <i class="fa fa-eye-slash fa-fw text-warning"></i> Hide from learners
                                    </a>
                                    {{/isvisible}}
                                    {{^isvisible}}
                                    <a class="dropdown-item" href="#"
                                       data-action="show-course" data-courseid="{{id}}" data-coursename="{{fullname}}">
                                        <i class="fa fa-eye fa-fw text-success"></i> Show to learners
                                    </a>
                                    {{/isvisible}}
                                </li>
                                {{#can_delete}}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="#"
                                       data-action="delete-course" data-courseid="{{id}}" data-coursename="{{fullname}}">
                                        <i class="fa fa-trash fa-fw"></i> Delete
                                    </a>
                                </li>
                                {{/can_delete}}
                            </ul>
                        </div>
                    </td>
                    {{/can_manage}}
                </tr>
                {{/courses}}
            </tbody>
        </table>
    </div>
</div>
{{/has_courses}}

{{^has_courses}}
<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <i class="fa fa-book fa-3x text-muted mb-3 d-block"></i>
        <h5 class="text-muted">No courses found</h5>
        <p class="text-muted mb-0">Try adjusting your filters or search criteria.</p>
    </div>
</div>
{{/has_courses}}

{{#has_pagination}}
<nav class="mt-3 d-flex justify-content-center">
    <ul class="pagination pagination-sm">
        {{#has_prev}}<li class="page-item"><a class="page-link" href="{{{prev_url}}}">&laquo;</a></li>{{/has_prev}}
        {{#pagination_pages}}<li class="page-item {{#isactive}}active{{/isactive}}"><a class="page-link" href="{{{url}}}">{{pagenum}}</a></li>{{/pagination_pages}}
        {{#has_next}}<li class="page-item"><a class="page-link" href="{{{next_url}}}">&raquo;</a></li>{{/has_next}}
    </ul>
</nav>
{{/has_pagination}}

</div>
{{#js}}
require(['local_airpay_courses/course_actions'], function(CourseActions) {
    CourseActions.init();
});
{{/js}}
