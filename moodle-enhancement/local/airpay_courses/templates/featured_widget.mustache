{{!
   Featured-courses widget — rendered on the learner dashboard.

   Context vars:
     has_courses    bool — false if no curated courses for this user
     courses[]      { courseid, fullname, shortname, snippet, has_snippet,
                       label, has_label, viewurl, enrolurl }
     more_url       string — link to full catalog
}}
{{# has_courses }}
<section class="ap-featured-widget mb-4" data-region="ap-featured-widget"
         aria-labelledby="ap-featured-widget-heading">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <h2 id="ap-featured-widget-heading" class="h5 m-0">
      <i class="fa fa-star text-warning me-2" aria-hidden="true"></i>Featured for you
    </h2>
    <a href="{{ more_url }}" class="small text-decoration-none">
      Browse all courses <i class="fa fa-chevron-right ms-1" aria-hidden="true"></i>
    </a>
  </div>
  <div class="row g-3">
    {{# courses }}
    <div class="col-md-6 col-lg-4">
      <div class="ap-card ap-card--inset h-100 d-flex flex-column">
        {{# has_label }}
        <span class="badge bg-primary mb-2 align-self-start">{{ label }}</span>
        {{/ has_label }}
        <h3 class="h6 mb-1">
          <a href="{{ viewurl }}" class="text-decoration-none">{{ fullname }}</a>
        </h3>
        <code class="small text-muted mb-2">{{ shortname }}</code>
        {{# has_snippet }}
        <p class="small text-muted mb-3">{{ snippet }}</p>
        {{/ has_snippet }}
        <div class="mt-auto d-flex gap-2">
          <a href="{{ enrolurl }}" class="btn btn-primary btn-sm">
            <i class="fa fa-sign-in me-1" aria-hidden="true"></i>Enrol
          </a>
          <a href="{{ viewurl }}" class="btn btn-outline-secondary btn-sm">
            Preview
          </a>
        </div>
      </div>
    </div>
    {{/ courses }}
  </div>
</section>
{{/ has_courses }}
