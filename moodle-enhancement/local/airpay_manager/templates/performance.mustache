{{!
    @template local_airpay_manager/performance
}}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Team performance</h2>
        <div>
            {{#periods}}
            <a href="?period={{ days }}" class="btn btn-sm {{#selected}}btn-primary{{/selected}}{{^selected}}btn-outline-secondary{{/selected}}">
                {{ label }}
            </a>
            {{/periods}}
        </div>
    </div>

    <div data-region="team-performance-table" data-period="{{ period_days }}">
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['core/ajax', 'core/notification'], function(Ajax, Notification) {
    var region = document.querySelector('[data-region="team-performance-table"]');
    if (!region) return;

    Ajax.call([{
        methodname: 'local_airpay_manager_team_performance',
        args: { managerid: 0, period_days: parseInt(region.dataset.period, 10) }
    }])[0].then(function(resp) {
        var team = resp.team || [];
        if (resp.message) {
            region.innerHTML = '<div class="alert alert-info">' + resp.message + '</div>';
            return;
        }
        if (team.length === 0) {
            region.innerHTML = '<div class="alert alert-info">'
                + 'No direct reports assigned to you. (Team relationships are based on '
                + 'the <code>user.open_managerid</code> column.)</div>';
            return;
        }
        var totalCompletions = team.reduce(function(s, m) { return s + m.completions; }, 0);
        var totalAttempts    = team.reduce(function(s, m) { return s + m.attempts; }, 0);
        var avgCompletion    = team.reduce(function(s, m) { return s + m.completion_pct; }, 0) / team.length;
        var activeCount      = team.filter(function(m) { return m.is_active; }).length;

        var html = ''
            + '<div class="row mb-4">'
            + '  <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">'
            + '    <div style="font-size:2rem;font-weight:800;">' + team.length + '</div>'
            + '    <div class="text-muted small text-uppercase">Team size</div>'
            + '  </div></div></div>'
            + '  <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">'
            + '    <div style="font-size:2rem;font-weight:800;color:var(--ap-color-success,#16a34a);">'
            +      activeCount + '</div>'
            + '    <div class="text-muted small text-uppercase">Active in period</div>'
            + '  </div></div></div>'
            + '  <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">'
            + '    <div style="font-size:2rem;font-weight:800;">' + totalCompletions + '</div>'
            + '    <div class="text-muted small text-uppercase">Completions</div>'
            + '  </div></div></div>'
            + '  <div class="col-md-3 mb-2"><div class="card border-0 shadow-sm"><div class="card-body text-center py-3">'
            + '    <div style="font-size:2rem;font-weight:800;">' + avgCompletion.toFixed(1) + '%</div>'
            + '    <div class="text-muted small text-uppercase">Avg completion</div>'
            + '  </div></div></div>'
            + '</div>';

        html += '<table class="table table-hover">'
            + '<thead><tr><th>Name</th><th>Designation</th>'
            + '<th class="text-center">Active?</th>'
            + '<th class="text-end">Completions (period)</th>'
            + '<th class="text-end">Attempts (period)</th>'
            + '<th>Total enrolled</th>'
            + '<th>Completion %</th>'
            + '<th>Last access</th></tr></thead><tbody>';

        team.forEach(function(m) {
            html += '<tr>'
                + '<td><strong>' + m.fullname + '</strong>'
                + '  <br><code class="small">' + m.email + '</code></td>'
                + '<td>' + (m.designation || '—') + '</td>'
                + '<td class="text-center">'
                + '  ' + (m.is_active ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>')
                + '</td>'
                + '<td class="text-end"><strong>' + m.completions + '</strong></td>'
                + '<td class="text-end">' + m.attempts + '</td>'
                + '<td>' + m.enrolled + '</td>'
                + '<td>'
                + '  <div class="progress" style="height:6px;width:100px;">'
                + '    <div class="progress-bar bg-success" style="width:' + m.completion_pct + '%"></div>'
                + '  </div>'
                + '  <span class="small">' + m.completion_pct + '%</span>'
                + '</td>'
                + '<td class="small text-muted">' + m.last_access + '</td>'
                + '</tr>';
        });

        html += '</tbody></table>';
        region.innerHTML = html;
    }).catch(Notification.exception);
});
{{/js}}
