{{!
    Airpay User Engine — admin user management (datatable-driven).

    @template local_airpay_users/manage
    @package  local_airpay_users
}}
<style>
    [data-region="airpay-users"] .ap-filter-bar { background: var(--ap-color-bg-surface, #fff); border: 1px solid var(--ap-color-border, #e2e6ef); border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; }
    [data-region="airpay-users"] .ap-filter-bar .form-select-sm,
    [data-region="airpay-users"] .ap-filter-bar .btn-group-sm > .btn { font-size: 0.85rem; }
    [data-region="airpay-users"] .ap-filter-bar .btn-group .btn { border-color: var(--ap-color-border, #e2e6ef); }
    [data-region="airpay-users"] .ap-filter-bar .btn-group .btn.active { background: var(--ap-color-primary, #0066A7); color: #fff; border-color: var(--ap-color-primary, #0066A7); }
</style>

<div data-region="airpay-users">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">User Management</h2>
        <p class="text-muted mb-0">Manage employee accounts, roles, and access across your organisation.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{{export_url}}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-download fa-fw"></i> Export CSV
        </a>
        {{#can_create}}
        <a href="#" class="btn btn-primary btn-sm" data-action="create-user">
            <i class="fa fa-plus fa-fw"></i> Add User
        </a>
        {{/can_create}}
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-primary, #0066A7);">{{total_count}}</div>
            <div class="text-muted small text-uppercase">Total Users</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-success, #16a34a);">{{active_count}}</div>
            <div class="text-muted small text-uppercase">Active</div>
        </div></div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-3">
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--ap-color-danger, #dc2626);">{{suspended_count}}</div>
            <div class="text-muted small text-uppercase">Suspended</div>
        </div></div>
    </div>
</div>

<div class="ap-filter-bar">
    <div class="d-flex flex-wrap align-items-end gap-3">
        {{#has_org_options}}
        <div>
            <label for="airpay-users-orgid" class="small text-muted mb-1 d-block">Organisation</label>
            <select id="airpay-users-orgid" class="form-select form-select-sm" data-airpay-users-filter="orgid" style="min-width: 200px;" aria-label="Filter users by organisation">
                <option value="0">All Organisations</option>
                {{#org_options}}
                <option value="{{id}}">{{name}}</option>
                {{/org_options}}
            </select>
        </div>
        {{/has_org_options}}

        <div>
            <label class="small text-muted mb-1 d-block">Status</label>
            <div class="btn-group btn-group-sm" role="group" data-airpay-users-status>
                <button type="button" class="btn btn-light active"      data-status="active">Active</button>
                <button type="button" class="btn btn-light"             data-status="suspended">Suspended</button>
                <button type="button" class="btn btn-light"             data-status="all">All</button>
            </div>
        </div>
    </div>
</div>

<div data-airpay-bulk-bar style="display: none;" class="alert alert-info py-2 px-3 mb-3 d-flex justify-content-between align-items-center">
    <div>
        <i class="fa fa-check-square fa-fw"></i>
        <strong data-airpay-bulk-count>0</strong> selected
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-warning" data-bulk-action="suspend">
            <i class="fa fa-ban fa-fw"></i> Suspend
        </button>
        <button type="button" class="btn btn-sm btn-outline-success" data-bulk-action="activate">
            <i class="fa fa-undo fa-fw"></i> Activate
        </button>
        <button type="button" class="btn btn-sm btn-link text-muted" data-bulk-action="clear">
            Cancel
        </button>
    </div>
</div>

<div data-airpay-table
     data-endpoint="local_airpay_users_list_users"
     data-columns="{{{columns_json}}}"
     data-search-placeholder="Search by name, email, or employee ID…"
     data-perpage="25"
     data-selectable="1">
</div>

</div>

{{#js}}
require([
    'theme_airpayux/datatable',
    'local_airpay_users/user_actions',
    'core/ajax',
    'core/notification',
    'core/str'
], function(Datatable, UserActions, Ajax, Notification, Str) {
    Datatable.init();
    UserActions.init();

    var root = document.querySelector('[data-airpay-table]');
    var dt = Datatable.getInstance(root);
    if (!dt) return;

    dt.setFilter('status', 'active');

    document.querySelectorAll('[data-airpay-users-filter]').forEach(function(el) {
        el.addEventListener('change', function(e) {
            var key = e.target.dataset.airpayUsersFilter;
            var val = e.target.value;
            dt.setFilter(key, parseInt(val, 10) || 0);
        });
    });

    document.querySelectorAll('[data-airpay-users-status] [data-status]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var status = e.target.dataset.status;
            document.querySelectorAll('[data-airpay-users-status] [data-status]').forEach(function(b) {
                b.classList.toggle('active', b === e.target);
            });
            dt.setFilter('status', status);
        });
    });

    // ── Bulk action bar ──────────────────────────────────────────────
    var bar = document.querySelector('[data-airpay-bulk-bar]');
    var countEl = document.querySelector('[data-airpay-bulk-count]');
    document.addEventListener('airpay:datatable:selection', function(e) {
        var n = e.detail.selected.length;
        countEl.textContent = n;
        bar.style.display = n > 0 ? '' : 'none';
    });

    var runBulk = function(action) {
        var ids = dt.getSelected();
        if (!ids.length) return;
        Str.get_string('confirm', 'core').then(function(confirmLabel) {
            Notification.confirm(
                'Bulk ' + action,
                'Are you sure you want to ' + action + ' ' + ids.length + ' user(s)?',
                confirmLabel, null,
                function() {
                    Ajax.call([{
                        methodname: 'local_airpay_users_bulk_action',
                        args: {action: action, userids: ids}
                    }])[0].then(function(res) {
                        Notification.addNotification({
                            message: 'Bulk ' + action + ': ' + res.count + ' user(s) updated'
                                + (res.skipped ? ' (' + res.skipped + ' skipped)' : ''),
                            type: 'success'
                        });
                        dt.clearSelection();
                        dt.refresh();
                        return null;
                    }).catch(Notification.exception);
                }
            );
            return null;
        }).catch(Notification.exception);
    };

    document.querySelectorAll('[data-bulk-action]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var action = e.currentTarget.dataset.bulkAction;
            if (action === 'clear') {
                dt.clearSelection();
                return;
            }
            runBulk(action);
        });
    });
});
{{/js}}
