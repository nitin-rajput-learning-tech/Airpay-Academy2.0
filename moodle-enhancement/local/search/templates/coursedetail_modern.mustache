<div class="ap-coursedet">

    {{! ═══ Hero Banner ═══ }}
    <div class="ap-coursedet__hero" style="background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.75)), url('{{imageurl}}');">
        <div class="ap-coursedet__hero-content">
            <nav class="ap-coursedet__breadcrumb">
                <a href="{{catalogurl}}">Catalog</a>
                <span>/</span>
                <a href="{{catalogurl}}?category={{categoryid}}">{{categoryname}}</a>
                <span>/</span>
                <span>{{coursename}}</span>
            </nav>
            <h1 class="ap-coursedet__title">{{coursename}}</h1>
            <div class="ap-coursedet__meta-tags">
                <span class="ap-badge ap-badge--info">{{categoryname}}</span>
                {{#has_level}}<span class="ap-badge ap-badge--accent">{{level}}</span>{{/has_level}}
                {{#has_skill}}<span class="ap-badge ap-badge--success">{{skill}}</span>{{/has_skill}}
                <span class="ap-badge ap-badge--muted">{{type}}</span>
            </div>
            <div class="ap-coursedet__hero-stats">
                <span><i class="fa fa-users"></i> {{enrolled_count}} enrolled</span>
                <span><i class="fa fa-check-circle"></i> {{completed_count}} completed</span>
                {{#completion_rate}}<span><i class="fa fa-trophy" style="color:#fbbf24;"></i> {{completion_rate}}% completion rate</span>{{/completion_rate}}
            </div>
        </div>
    </div>

    {{! ═══ Main Content (2-column) ═══ }}
    <div class="ap-coursedet__body">
        <div class="ap-coursedet__main">

            {{! About / Description }}
            <div class="ap-coursedet__section">
                <h3 class="ap-coursedet__section-title">About This Course</h3>
                <div class="ap-coursedet__description">{{{description}}}</div>
            </div>

            {{! What You'll Learn — auto-generated from section names }}
            {{#has_modules}}
            <div class="ap-coursedet__section">
                <h3 class="ap-coursedet__section-title">What You'll Learn</h3>
                <div class="ap-coursedet__highlights">
                    {{#modules}}
                    <div class="ap-coursedet__highlight">
                        <i class="fa fa-check-circle"></i>
                        <span>{{name}} <small>({{activity_count}} activities)</small></span>
                    </div>
                    {{/modules}}
                </div>
            </div>
            {{/has_modules}}

            {{! Course Modules / Content Accordion }}
            {{#has_modules}}
            <div class="ap-coursedet__section">
                <h3 class="ap-coursedet__section-title">
                    Course Content
                    <span class="ap-coursedet__section-badge">{{total_sections}} sections · {{total_activities}} activities</span>
                </h3>
                <div class="ap-coursedet__modules">
                    {{#modules}}
                    <div class="ap-coursedet__module">
                        <div class="ap-coursedet__module-header" onclick="this.parentElement.classList.toggle('ap-coursedet__module--open')">
                            <div class="ap-coursedet__module-left">
                                <i class="fa fa-chevron-right ap-coursedet__module-arrow"></i>
                                <span class="ap-coursedet__module-name">{{name}}</span>
                            </div>
                            <span class="ap-coursedet__module-count">{{activity_count}} activities</span>
                        </div>
                        <div class="ap-coursedet__module-body">
                            {{#activities}}
                            <div class="ap-coursedet__activity {{#is_complete}}ap-coursedet__activity--done{{/is_complete}}">
                                {{#is_complete}}
                                <i class="fa fa-check-circle ap-coursedet__activity-icon ap-coursedet__activity-icon--done"></i>
                                {{/is_complete}}
                                {{#is_progress}}
                                <i class="fa fa-play-circle ap-coursedet__activity-icon ap-coursedet__activity-icon--progress"></i>
                                {{/is_progress}}
                                {{^is_complete}}{{^is_progress}}
                                {{#is_locked}}
                                <i class="fa fa-lock ap-coursedet__activity-icon ap-coursedet__activity-icon--locked"></i>
                                {{/is_locked}}
                                {{^is_locked}}
                                <i class="fa {{icon}} ap-coursedet__activity-icon"></i>
                                {{/is_locked}}
                                {{/is_progress}}{{/is_complete}}
                                <span {{#is_complete}}style="text-decoration: line-through; opacity: 0.6;"{{/is_complete}}>{{name}}</span>
                            </div>
                            {{/activities}}
                        </div>
                    </div>
                    {{/modules}}
                </div>
            </div>
            {{/has_modules}}

            {{! Share }}
            <div class="ap-coursedet__section">
                <h3 class="ap-coursedet__section-title">Share This Course</h3>
                <div class="ap-coursedet__share">
                    <a href="https://wa.me/?text={{sharetext}}" target="_blank" class="ap-coursedet__share-btn ap-coursedet__share-btn--whatsapp">
                        <i class="fa fa-whatsapp"></i> WhatsApp
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{shareurl}}" target="_blank" class="ap-coursedet__share-btn ap-coursedet__share-btn--linkedin">
                        <i class="fa fa-linkedin"></i> LinkedIn
                    </a>
                    <a href="https://twitter.com/intent/tweet?text={{sharetext}}" target="_blank" class="ap-coursedet__share-btn ap-coursedet__share-btn--twitter">
                        <i class="fa fa-twitter"></i> Twitter
                    </a>
                    <button onclick="navigator.clipboard.writeText('{{shareurl}}');this.innerHTML='<i class=\'fa fa-check\'></i> Copied!';setTimeout(()=>this.innerHTML='<i class=\'fa fa-link\'></i> Copy Link',2000);" class="ap-coursedet__share-btn ap-coursedet__share-btn--copy">
                        <i class="fa fa-link"></i> Copy Link
                    </button>
                </div>
            </div>

            {{! Related Courses }}
            {{#has_related}}
            <div class="ap-coursedet__section">
                <h3 class="ap-coursedet__section-title">Related Courses</h3>
                <div class="ap-coursedet__related">
                    {{#related_courses}}
                    <a href="{{detailurl}}" class="ap-coursedet__related-card">
                        <div class="ap-coursedet__related-thumb">
                            <span>{{shortname}}</span>
                        </div>
                        <div class="ap-coursedet__related-info">
                            <h5>{{fullname}}</h5>
                            <span class="ap-coursedet__related-cta">View Details <i class="fa fa-arrow-right"></i></span>
                        </div>
                    </a>
                    {{/related_courses}}
                </div>
            </div>
            {{/has_related}}
        </div>

        {{! ═══ Sidebar (Sticky) ═══ }}
        <div class="ap-coursedet__sidebar">
            <div class="ap-coursedet__sidebar-card">
                {{! Enroll / Continue CTA }}
                {{#is_enrolled}}
                <a href="{{viewurl}}" class="ap-btn-gradient ap-coursedet__cta">
                    <i class="fa fa-play-circle"></i> Continue Learning
                </a>
                {{#has_progress}}
                <div class="ap-coursedet__sidebar-progress">
                    <div class="ap-coursedet__sidebar-progress-header">
                        <span>Progress</span><span>{{progress}}%</span>
                    </div>
                    <div class="ap-coursedet__sidebar-progress-bar">
                        <div class="ap-coursedet__sidebar-progress-fill" style="width:{{progress}}%;"></div>
                    </div>
                </div>
                {{/has_progress}}
                {{/is_enrolled}}
                {{^is_enrolled}}
                {{#can_selfenrol}}
                <a href="{{enrolurl}}" class="ap-btn-gradient ap-coursedet__cta">
                    <i class="fa fa-sign-in"></i> Enroll Now — Free
                </a>
                {{/can_selfenrol}}
                {{^can_selfenrol}}
                <div class="ap-coursedet__sidebar-notice">
                    <i class="fa fa-info-circle"></i> Contact your L&D team for enrollment.
                </div>
                {{/can_selfenrol}}
                {{/is_enrolled}}

                {{! Social Proof }}
                <div class="ap-coursedet__social-proof">
                    <div class="ap-coursedet__social-proof-item">
                        <i class="fa fa-users"></i>
                        <strong>{{enrolled_count}}</strong> learners enrolled
                    </div>
                    {{#completion_rate}}
                    <div class="ap-coursedet__social-proof-item">
                        <i class="fa fa-trophy"></i>
                        <strong>{{completion_rate}}%</strong> completion rate
                    </div>
                    {{/completion_rate}}
                    {{#has_certificate}}
                    <div class="ap-coursedet__social-proof-item">
                        <i class="fa fa-certificate"></i>
                        <strong>Certificate</strong> on completion
                    </div>
                    {{/has_certificate}}
                </div>

                {{! Course Meta }}
                <div class="ap-coursedet__meta-list">
                    <div class="ap-coursedet__meta-item">
                        <i class="fa fa-folder-o"></i><span>Category</span><strong>{{categoryname}}</strong>
                    </div>
                    {{#has_level}}<div class="ap-coursedet__meta-item">
                        <i class="fa fa-signal"></i><span>Level</span><strong>{{level}}</strong>
                    </div>{{/has_level}}
                    {{#has_skill}}<div class="ap-coursedet__meta-item">
                        <i class="fa fa-cogs"></i><span>Skill</span><strong>{{skill}}</strong>
                    </div>{{/has_skill}}
                    <div class="ap-coursedet__meta-item">
                        <i class="fa fa-list-ul"></i><span>Content</span><strong>{{total_sections}} sections</strong>
                    </div>
                    <div class="ap-coursedet__meta-item">
                        <i class="fa fa-puzzle-piece"></i><span>Activities</span><strong>{{total_activities}}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ═══ Course Detail — Modern LXP Design ═══ */
.ap-coursedet { max-width: 1200px; margin: 0 auto; font-family: var(--ap-font, 'Montserrat', sans-serif); }

/* Hero */
.ap-coursedet__hero {
    background-size: cover; background-position: center;
    border-radius: 0 0 var(--ap-radius-lg, 20px) var(--ap-radius-lg, 20px);
    padding: 60px 40px 40px; color: #fff; margin-bottom: 24px;
    min-height: 240px; display: flex; align-items: flex-end;
}
.ap-coursedet__breadcrumb { font-size: 13px; margin-bottom: 12px; opacity: 0.8; }
.ap-coursedet__breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; }
.ap-coursedet__breadcrumb a:hover { color: #fff; text-decoration: underline; }
.ap-coursedet__breadcrumb span { margin: 0 6px; }
.ap-coursedet__title { font-size: 28px; font-weight: 800; margin: 0 0 12px; line-height: 1.2; }
.ap-coursedet__meta-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.ap-coursedet__hero-stats { display: flex; gap: 20px; font-size: 14px; opacity: 0.9; }
.ap-coursedet__hero-stats i { margin-right: 4px; }

/* Body 2-column */
.ap-coursedet__body { display: grid; grid-template-columns: 1fr 340px; gap: 24px; }
.ap-coursedet__main { min-width: 0; }

/* Sections */
.ap-coursedet__section {
    background: var(--ap-surface, #fff); border: 1px solid var(--ap-border, #e3eaf3);
    border-radius: var(--ap-radius-sm, 12px); padding: 24px; margin-bottom: 20px;
}
.ap-coursedet__section-title {
    font-size: 17px; font-weight: 700; color: var(--ap-text, #1a1a2e);
    margin: 0 0 16px; position: relative; padding-bottom: 10px;
    display: flex; align-items: center; gap: 10px;
}
.ap-coursedet__section-title::after {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 40px; height: 3px; border-radius: 2px;
    background: var(--ap-gradient, linear-gradient(135deg, #0066A7, #0f7a73));
}
.ap-coursedet__section-badge {
    font-size: 12px; font-weight: 400; color: var(--ap-text-muted, #8896a6);
    margin-left: auto;
}
.ap-coursedet__description { font-size: 14px; line-height: 1.7; color: var(--ap-text-secondary, #607286); }

/* What You'll Learn */
.ap-coursedet__highlights { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.ap-coursedet__highlight {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 13px; color: var(--ap-text, #1a1a2e);
}
.ap-coursedet__highlight i { color: #16a34a; margin-top: 2px; flex-shrink: 0; }
.ap-coursedet__highlight small { color: var(--ap-text-muted); }

/* Modules accordion */
.ap-coursedet__module {
    border: 1px solid var(--ap-border, #e3eaf3); border-radius: 10px;
    margin-bottom: 8px; overflow: hidden;
}
.ap-coursedet__module-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; cursor: pointer; transition: background 0.15s;
    font-size: 14px; font-weight: 600; color: var(--ap-text, #1a1a2e);
}
.ap-coursedet__module-header:hover { background: var(--ap-surface-alt, #f8f9fc); }
.ap-coursedet__module-left { display: flex; align-items: center; gap: 10px; }
.ap-coursedet__module-arrow { font-size: 11px; color: var(--ap-text-muted); transition: transform 0.2s; }
.ap-coursedet__module--open .ap-coursedet__module-arrow { transform: rotate(90deg); }
.ap-coursedet__module-count { font-size: 12px; color: var(--ap-text-muted); font-weight: 400; }
.ap-coursedet__module-body {
    display: none; padding: 0 16px 12px; border-top: 1px solid var(--ap-border);
}
.ap-coursedet__module--open .ap-coursedet__module-body { display: block; }
.ap-coursedet__activity {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 0; font-size: 13px; color: var(--ap-text-secondary);
    border-bottom: 1px solid #f3f5f9;
}
.ap-coursedet__activity:last-child { border-bottom: none; }
.ap-coursedet__activity-icon { width: 20px; text-align: center; color: var(--ap-primary, #0066A7); flex-shrink: 0; }
.ap-coursedet__activity-icon--done { color: #16a34a !important; }
.ap-coursedet__activity-icon--progress { color: #0066A7 !important; }
.ap-coursedet__activity-icon--locked { color: #d1d5db !important; }
.ap-coursedet__activity--done { opacity: 0.65; }

/* Share buttons */
.ap-coursedet__share { display: flex; gap: 8px; flex-wrap: wrap; }
.ap-coursedet__share-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 8px; color: #fff;
    font-size: 13px; font-weight: 500; text-decoration: none; border: none;
    cursor: pointer; transition: opacity 0.15s, transform 0.1s; font-family: inherit;
}
.ap-coursedet__share-btn:hover { opacity: 0.85; color: #fff; transform: translateY(-1px); }
.ap-coursedet__share-btn--whatsapp { background: #25D366; }
.ap-coursedet__share-btn--linkedin { background: #0077B5; }
.ap-coursedet__share-btn--twitter { background: #1DA1F2; }
.ap-coursedet__share-btn--copy { background: #6b7280; }

/* Related Courses */
.ap-coursedet__related { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.ap-coursedet__related-card {
    display: flex; gap: 12px; padding: 12px; border-radius: 10px;
    border: 1px solid var(--ap-border); text-decoration: none;
    transition: all 0.2s;
}
.ap-coursedet__related-card:hover { border-color: var(--ap-primary); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
.ap-coursedet__related-thumb {
    width: 56px; height: 56px; border-radius: 10px; flex-shrink: 0;
    background: linear-gradient(135deg, #0066A7, #0f7a73);
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.6); font-size: 0.7rem; font-weight: 700;
}
.ap-coursedet__related-info { min-width: 0; }
.ap-coursedet__related-info h5 {
    margin: 0; font-size: 13px; font-weight: 600; color: var(--ap-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ap-coursedet__related-cta { font-size: 12px; color: var(--ap-primary); font-weight: 500; }

/* Sidebar */
.ap-coursedet__sidebar-card {
    background: var(--ap-surface); border: 1px solid var(--ap-border);
    border-radius: var(--ap-radius-sm); padding: 24px;
    position: sticky; top: 80px;
}
.ap-coursedet__cta {
    width: 100%; justify-content: center; margin-bottom: 16px;
    display: flex; align-items: center; gap: 8px;
    padding: 12px 20px; border-radius: 10px; font-size: 15px; font-weight: 700;
    background: var(--ap-gradient, linear-gradient(135deg, #0066A7, #0f7a73));
    color: #fff; text-decoration: none; transition: opacity 0.15s;
}
.ap-coursedet__cta:hover { opacity: 0.9; color: #fff; }

/* Sidebar progress */
.ap-coursedet__sidebar-progress { margin-bottom: 16px; }
.ap-coursedet__sidebar-progress-header {
    display: flex; justify-content: space-between; font-size: 12px; color: #5a6070; margin-bottom: 4px;
}
.ap-coursedet__sidebar-progress-bar { height: 6px; background: #e2e6ef; border-radius: 3px; }
.ap-coursedet__sidebar-progress-fill {
    height: 100%; background: linear-gradient(90deg, #0066A7, #0f7a73);
    border-radius: 3px; transition: width 0.5s;
}

/* Sidebar notice */
.ap-coursedet__sidebar-notice {
    padding: 12px; background: #fef3c7; border-radius: 8px;
    font-size: 13px; color: #92400e; margin-bottom: 16px;
}

/* Social proof */
.ap-coursedet__social-proof {
    display: flex; flex-direction: column; gap: 8px;
    margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--ap-border, #e3eaf3);
}
.ap-coursedet__social-proof-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--ap-text-secondary);
}
.ap-coursedet__social-proof-item i { width: 18px; text-align: center; color: var(--ap-primary); }
.ap-coursedet__social-proof-item strong { color: var(--ap-text); }

/* Meta list */
.ap-coursedet__meta-list { display: flex; flex-direction: column; gap: 0; }
.ap-coursedet__meta-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 0; border-bottom: 1px solid #f3f5f9;
    font-size: 13px; color: var(--ap-text-secondary);
}
.ap-coursedet__meta-item:last-child { border-bottom: none; }
.ap-coursedet__meta-item i { width: 20px; text-align: center; color: var(--ap-primary); }
.ap-coursedet__meta-item strong { margin-left: auto; color: var(--ap-text); font-weight: 600; }

/* Responsive */
@media (max-width: 992px) {
    .ap-coursedet__body { grid-template-columns: 1fr; }
    .ap-coursedet__sidebar-card { position: static; }
    .ap-coursedet__related { grid-template-columns: 1fr; }
}
@media (max-width: 590px) {
    .ap-coursedet__hero { padding: 30px 20px 24px; min-height: 180px; }
    .ap-coursedet__title { font-size: 22px; }
    .ap-coursedet__hero-stats { flex-direction: column; gap: 6px; }
    .ap-coursedet__highlights { grid-template-columns: 1fr; }
    .ap-coursedet__share { flex-direction: column; }
    .ap-coursedet__share-btn { justify-content: center; }
}

/* Dark mode */
body.dark-mode .ap-coursedet__section { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-coursedet__section-title { color: #e8eaed; }
body.dark-mode .ap-coursedet__description { color: #9ca3b4; }
body.dark-mode .ap-coursedet__module { border-color: #2d3140; }
body.dark-mode .ap-coursedet__module-header { color: #e8eaed; }
body.dark-mode .ap-coursedet__module-header:hover { background: #22252f; }
body.dark-mode .ap-coursedet__sidebar-card { background: #1a1d27; border-color: #2d3140; }
body.dark-mode .ap-coursedet__meta-item { border-color: #2d3140; color: #9ca3b4; }
body.dark-mode .ap-coursedet__meta-item strong { color: #e8eaed; }
body.dark-mode .ap-coursedet__activity { border-color: #2d3140; color: #9ca3b4; }
body.dark-mode .ap-coursedet__highlight { color: #e8eaed; }
body.dark-mode .ap-coursedet__related-card { border-color: #2d3140; }
body.dark-mode .ap-coursedet__related-card:hover { border-color: #0066A7; }
body.dark-mode .ap-coursedet__related-info h5 { color: #e8eaed; }
body.dark-mode .ap-coursedet__social-proof { border-color: #2d3140; }
body.dark-mode .ap-coursedet__social-proof-item { color: #9ca3b4; }
body.dark-mode .ap-coursedet__social-proof-item strong { color: #e8eaed; }
</style>
