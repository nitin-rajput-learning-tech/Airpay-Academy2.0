{
  "version": 1,
  "about": "Persona journeys for persona_journeys.mjs (LOCAL XAMPP ONLY). One entry per persona in the Phase 1 table of docs/cutover/UAT-VALIDATION-PLAN-2026-09-03.md. Personas come from provision_local_personas.php; {{...}} placeholders resolve from .journey-context.local.json (seed_journey_content.php) and .personas.local.json (user ids only). {{re:...}} is the same value regex-escaped. Every step also gets the cross-cutting checks (HTTP < 400, no error box / debug text / [[missing]] strings / Coding error, console errors, no horizontal scroll at 590 and 390 px, desktop + mobile screenshot).",
  "fields": {
    "id": "step slug (used in file names, --from, --steps)",
    "url": "path to open; omit when a handler navigates",
    "handler": "named handler in persona_journeys.mjs (enrolFree, langToggle, tableSearch, csvExport, cartAddSession, cartAddDb, cartCleanup)",
    "landing": "true = console errors on this page FAIL the step (UAT plan: zero JS errors on every persona landing page); otherwise they only turn PASS into CHECK",
    "access": "ok (default): page must render for this persona | refused: page must refuse (error box / permission text / redirect to dashboard) | either: record which happened",
    "flag": "feature flag key; the step is SKIPped with 'flag off' when the flag is off for the persona's tenant",
    "waitFor": "CSS selector that must appear (AJAX tables)",
    "page": "false = no browser page (CSV download via the session)",
    "isolation": "oneOnlyCourseNames: the page text must not contain any /1-only course name",
    "expect.heading": "regex vs document title + h1/h2 text (hard)",
    "expect.text / selectors": "arrays; every entry must match / exist (hard, polled up to 15 s)",
    "expect.softText / softSelectors": "a miss gives CHECK, not FAIL",
    "expect.denyText / denySelectors": "none may match / exist (hard)",
    "expect.finalUrl": "regex vs final path+query (hard); without it a silent redirect elsewhere gives CHECK",
    "expect.lang / devanagari": "html lang attribute prefix / Devanagari text present (hard)",
    "macro": "langPair: expands to lang-<to> steps (langs) then lang-en; back:false omits the final lang-en (the journey switches back itself). url = the page the toggle starts from"
  },
  "personas": {
    "learner": {
      "username": "vp_learner1",
      "tenant": 1,
      "label": "Learner / employee (Airpay /1)",
      "validates": "onboarding, dashboard, catalog + one-click enrol, course player (Page), my courses, certificates, EN <-> HI, profile/privacy pages",
      "steps": [
        { "id": "onboarding", "name": "Onboarding wizard (or redirect once completed)", "url": "/local/sentientia_pages/onboarding.php", "access": "either" },
        { "macro": "onboard" },
        { "id": "dashboard", "name": "Dashboard", "url": "/my/dashboard.php", "landing": true },
        { "id": "catalog", "name": "Course catalog", "url": "/local/sentientia_catalog/index.php",
          "expect": { "heading": "Course Catalog|Catalog", "softSelectors": ["[class*='airpay-catalog']"] } },
        { "id": "catalog-search", "name": "Catalog search finds the seeded free course", "url": "/local/sentientia_catalog/index.php?q=VP+Journey+Free",
          "expect": { "text": ["{{re:courses.free1.fullname}}"] } },
        { "id": "enrol-free", "name": "One-click enrol into a free course", "handler": "enrolFree", "args": { "course": "free1" },
          "expect": { "finalUrl": "/course/view\\.php\\?id={{courses.free1.id}}", "text": ["{{re:courses.free1.fullname}}"] } },
        { "id": "course-open", "name": "Open the course", "url": "/course/view.php?id={{courses.free1.id}}",
          "expect": { "text": ["{{re:courses.free1.fullname}}", "VP Journey Page"] } },
        { "id": "page-activity", "name": "Open a Page activity", "url": "/mod/page/view.php?id={{courses.free1.pagecmid}}",
          "expect": { "text": ["VP journey page body text"] } },
        { "id": "my-courses", "name": "My courses lists the enrolled course", "url": "/local/sentientia_catalog/mycourses.php",
          "expect": { "text": ["{{re:courses.free1.fullname}}"] } },
        { "id": "certificates", "name": "My certificates", "url": "/local/sentientia_pages/certificates.php",
          "expect": { "heading": "My Certificates" } },
        { "id": "profile", "name": "Own profile", "url": "/local/sentientia_users/profile.php?id={{me}}",
          "expect": { "text": ["VP\\s+Learner"] } },
        { "id": "privacy", "name": "My privacy & data", "url": "/local/sentientia_privacy/index.php",
          "expect": { "heading": "Privacy" } },
        { "id": "privacy-policy", "name": "Privacy policy", "url": "/local/sentientia_users/privacypolicy.php",
          "expect": { "heading": "Privacy Policy" } },
        { "id": "notifications", "name": "In-app notifications", "url": "/message/output/popup/notifications.php" },
        { "macro": "langPair", "url": "/my/dashboard.php", "langs": ["hi"], "back": false },
        { "id": "lang-hi-catalog", "name": "Catalog stays in Hindi", "url": "/local/sentientia_catalog/index.php",
          "expect": { "lang": "hi", "devanagari": true } },
        { "id": "lang-en-back", "name": "Back to English (session)", "handler": "langToggle", "args": { "to": "en", "url": "/local/sentientia_catalog/index.php" } },
        { "id": "deny-manage-users", "name": "Learner cannot open Manage Users", "url": "/local/sentientia_users/index.php", "access": "refused" },
        { "id": "deny-compliance", "name": "Learner cannot open the compliance report", "url": "/local/sentientia_compliance_report/index.php", "access": "refused" }
      ]
    },

