{{#show}}
    <div>
        <a href = "{{link}}"> {{stringname}} </a>
        {{#count}}
            <span>{{count}}</span>
        {{/count}}
        {{^count}}
            <span><i class="fa fa-times"></i></span>
        {{/count}}
    </div>
{{/show}}
{{#show2}}
