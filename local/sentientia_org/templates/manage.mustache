{{!
    Airpay Organisation Management — hierarchical org tree with CRUD.
    @template local_sentientia_org/manage
}}
<style>
    [data-region="airpay-org"] .dropdown-toggle.no-arrow::after { display: none !important; }
    [data-region="airpay-org"] .dropdown-toggle.no-arrow { box-shadow: none; background: none; border: none; }
    [data-region="airpay-org"] .dropdown-toggle.no-arrow:hover { color: var(--ap-color-primary, #0066A7) !important; }
    [data-region="airpay-org"] .org-tenant-card {
        border: 1px solid var(--ap-color-border, #e2e6ef);
        border-radius: 12px;
        margin-bottom: 14px;
        background: var(--ap-color-bg-surface, #fff);
    }
    [data-region="airpay-org"] .org-tenant-card .tenant-row {
        padding: 16px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }
    [data-region="airpay-org"] .org-tenant-card .tenant-row:hover { background: rgba(0,102,167,0.03); }
    [data-region="airpay-org"] .tenant-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1.1rem;
        color: #fff;
    }
    [data-region="airpay-org"] .org-children-wrap {
        border-top: 1px solid var(--ap-color-border, #e2e6ef);
        padding: 8px 0;
        background: rgba(0,102,167,0.015);
    }
    [data-region="airpay-org"] .org-row {
        padding: 10px 18px 10px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.04);
    }
    [data-region="airpay-org"] .org-row:last-child { border-bottom: none; }
    [data-region="airpay-org"] .org-row:hover { background: rgba(0,102,167,0.04); }
    [data-region="airpay-org"] .org-row.depth-2 { padding-left: 56px; }
    [data-region="airpay-org"] .org-row.depth-3 { padding-left: 92px; }
    [data-region="airpay-org"] .org-row.depth-4 { padding-left: 128px; }
    [data-region="airpay-org"] .org-row.depth-5 { padding-left: 164px; }
    [data-region="airpay-org"] .org-row .org-meta {
        display: flex; align-items: center; gap: 12px;
    }
    [data-region="airpay-org"] .branding-dot {
        display: inline-block;
        width: 12px; height: 12px;
        border-radius: 50%;
        margin-left: 6px;
        vertical-align: middle;
        border: 1px solid rgba(0,0,0,0.08);
    }
    [data-region="airpay-org"] .org-row.hidden-org { opacity: 0.55; }
    [data-region="airpay-org"] .toggle-arrow {
        transition: transform 0.2s ease;
        color: var(--ap-color-text-secondary, #5a6070);
    }
    [data-region="airpay-org"] [aria-expanded="true"] .toggle-arrow {
        transform: rotate(90deg);
    }
</style>

<div data-region="airpay-org">

<div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Organisation Structure</h2>
        <p class="text-muted mb-0">Manage tenants, departments, and branding overrides.</p>
    </div>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-org">
        <i class="fa fa-plus fa-fw"></i> Add Organisation
    </a>
    {{/can_manage}}
</div>

{{! KPI Summary — Phase B0+: migrated to tokens-aware stat_card partial }}
{{#has_kpi_tiles}}
<div class="airpay-stat-grid mb-4">
    {{#kpi_tiles}}
    {{> theme_sentientia/components/stat_card }}
    {{/kpi_tiles}}
</div>
{{/has_kpi_tiles}}

{{! ── Tenants (depth=1) — collapsible cards ─── }}
{{#has_tenants}}
{{#tenants}}
<div class="org-tenant-card {{^visible}}hidden-org{{/visible}}">
    <a class="tenant-row text-decoration-none text-reset"
       data-toggle="collapse" href="#org-{{id}}-children"
       role="button" aria-expanded="false" aria-controls="org-{{id}}-children">
        <div class="org-meta">
            <div class="tenant-icon" style="background: {{#has_brand}}{{brand_color}}{{/has_brand}}{{^has_brand}}var(--ap-color-primary, #0066A7){{/has_brand}};">
                <i class="fa fa-building"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold">
                    {{fullname}}
                    {{#has_brand}}<span class="branding-dot" style="background: {{brand_color}};" title="Branded: {{brand_color}}"></span>{{/has_brand}}
                </h5>
                <span class="text-muted small">{{shortname}} &middot; Path: {{path}}</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small d-none d-md-inline"><i class="fa fa-sitemap fa-fw"></i> {{child_count}} units</span>
            <span class="text-muted small d-none d-md-inline"><i class="fa fa-users fa-fw"></i> {{user_count}} users</span>
            <span class="badge {{visiblecss}}">{{visiblelabel}}</span>
            {{#can_manage}}
            <span class="dropdown" onclick="event.stopPropagation();">
                <button type="button" class="btn btn-sm btn-link text-muted p-0 dropdown-toggle no-arrow"
                        data-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="fa fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li>
                        <a class="dropdown-item" href="#"
                           data-action="edit-org" data-orgid="{{id}}" data-name="{{fullname}}">
                            <i class="fa fa-pencil fa-fw"></i> Edit Settings
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#"
                           data-action="add-child-org" data-parentid="{{id}}" data-name="{{fullname}}">
                            <i class="fa fa-plus fa-fw text-success"></i> Add Sub-org
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="#"
                           data-action="toggle-org" data-orgid="{{id}}" data-name="{{fullname}}" data-visible="{{visible_int}}">
                            {{#visible}}<i class="fa fa-eye-slash fa-fw text-warning"></i> Hide{{/visible}}
                            {{^visible}}<i class="fa fa-eye fa-fw text-success"></i> Show{{/visible}}
                        </a>
                    </li>
                </ul>
            </span>
            {{/can_manage}}
            {{#has_children}}
            <i class="fa fa-chevron-right toggle-arrow"></i>
            {{/has_children}}
        </div>
    </a>

    {{#has_children}}
    <div class="collapse" id="org-{{id}}-children">
        <div class="org-children-wrap">
            {{#children}}
            {{> local_sentientia_org/org_node }}
            {{/children}}
        </div>
    </div>
    {{/has_children}}
</div>
{{/tenants}}
{{/has_tenants}}

{{^has_tenants}}
<div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
    <i class="fa fa-sitemap fa-3x text-muted mb-3 d-block"></i>
    <h5 class="text-muted">No organisations yet</h5>
    <p class="text-muted mb-3">Create your first tenant to start building the org hierarchy.</p>
    {{#can_manage}}
    <a href="#" class="btn btn-primary btn-sm" data-action="create-org">
        <i class="fa fa-plus fa-fw"></i> Create First Tenant
    </a>
    {{/can_manage}}
</div></div>
{{/has_tenants}}

</div>
{{#js}}
require(['local_sentientia_org/org_actions'], function(OrgActions) {
    OrgActions.init();
});
{{/js}}
