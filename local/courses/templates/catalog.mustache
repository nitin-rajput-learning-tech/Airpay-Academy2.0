{{!
    @template local_courses/catalog

    This template renders the courses content for the courses plugin.

    Example context (json):
    {}
}}
{{#response}}
    {{! card view }}
    {{#viewtypeCard}}
        <div class="row clearfix">
            {{#records}}
                {{# hascourses}}
                        <div class="{{cardClass}} catcourses_list {{course_class}} ">
                            <div class="d-flex course_container">
                                <div class="courseimg_container ">
                                    <div style="background-image: url('{{{ courseimage }}}');" alt="{{ coursename }}" class="courseimg courseimg_bg h-100" >
                                        <!-- <div class="course_progress_container d-flex align-items-center">
                                            <div class="progress_circular" style="background-image:conic-gradient(white 0%,transparent 0%);">
                                            </div>
                                            <div class="progress_status">Completed</div>
                                            <div class="progress_percentage">0%</div>
                                        </div> -->
                                    </div>
                                </div>
                                <div class="coursecontent   d-flex flex-column justify-content-between">

                                    <div class="d-flex mt-1">
                                        <h5 class="flex-grow-1 course_name m-0">
                                            {{^ coursenameCut}}
                                            <a href="{{ courseurl }}" title="{{ coursename }}">{{ coursename }}</a>
                                            {{/ coursenameCut}}
                                            {{# coursenameCut}}
                                            <a href="{{ courseurl }}" title="{{ coursename }}">{{ coursenameCut }}</a>
                                            {{/ coursenameCut}}
                                        </h5>
                                        {{#actions}}
                                        <div>
                                            <div class="showoptions{{courseid}} actionicons">
                                                <span  class="showoptions" data-action="showoptions{{courseid}}" onmouseenter="(function(e){ require('theme_epsilon/quickactions').quickactionsCall({ selector:'showoptions{{courseid}}' }) })(event)" onmouseleave="(function(e){require('theme_epsilon/quickactions').quickactionsCall({ selector:'showoptions{{courseid}}' }) })(event)"><i class="fa fa-ellipsis-h options"></i></span>
                                                <ul class="col-md-12 col-sm-12 col-12 p-0 options_container" id="showoptions{{courseid}}">

                                                    {{#deleteaction}}<li>{{{ deleteaction }}}</li>{{/deleteaction}}


                                                        {{#enrol}}
                                                        <li>
                                                            <a href="{{ enrollusers }}" title= "{{#str}}userenrolments, local_courses{{/str}}" ><i class="fa fa-user" aria-hidden="true"></i></a>
                                                        </li>
                                                        {{/enrol}}
                                                        {{#update}}
                                                        {{#auto_enrol}}
                                                        <li>
                                                        <a href="{{ auto_enrol }}" title= "{{#str}}auto_enrol, local_courses{{/str}}"><i class="fa fa-user-circle-o" aria-hidden="true"></i></a>
                                                        </li>
                                                        {{/auto_enrol}}
                                                        {{/update}}
                                                        {{#update}}
                                                        {{# editcourse}}
                                                        <li>
                                                        {{{ editcourse }}}
                                                        </li>
                                                        {{/ editcourse}}
                                                        {{# update_status}}
                                                        <li>
                                                            {{{update_status}}}
                                                        </li>
                                                        {{/ update_status}}
                                                        {{/update}}
                                                        {{#grade_view}}
                                                        <li>
                                                        <a href="{{ grader }}" title= "{{#str}}grader, local_courses{{/str}}"><i class="fa fa-pie-chart" aria-hidden="true"></i></a>
                                                        </li>
                                                        {{/grade_view}}
                                                        {{#request_view}}
                                                    <li>
                                                        <a href="{{ requestlink }}" title= "{{#str}}request, local_request{{/str}}"><i class="fa fa-share-square" aria-hidden="true"></i></a>
                                                    </li>
                                                    {{/request_view}}

                                                    </ul>
                                                </div>

                                        </div>
                                        {{/actions}}
                                    </div>
                                    <div class="coursedesc mb-2">
                                        {{# coursesummary }}
                                            <p class="desc" title = "Course Descripton" >{{ coursesummary }}</p>
                                        {{/ coursesummary }}
                                        {{^ coursesummary }}
                                            <p class="alert alert-info text-center mt-1">{{#str}}nocoursedesc, local_courses{{/str}}</p>
                                        {{/ coursesummary }}
                                    </div>
                                    <!--<div class="d-flex mb-2">
                                        <span class="text-muted">{{#str}}category, local_courses{{/str}} : </span> <span class="ml-1">{{#catnamestring}}{{catnamestring}}{{/catnamestring}}{{^catnamestring}}N/A{{/catnamestring}}</span>
                                    </div>-->
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="d-flex">
                                                <!--<span class="text-muted">{{#str}}open_skillcourse, local_courses{{/str}} : </span> <span class="ml-1">{{skillname}}</span>-->
                                                <span class="text-muted">{{#str}}category, local_courses{{/str}} : </span> <span class="ml-1">{{#catnamestring}}{{catnamestring}}{{/catnamestring}}{{^catnamestring}}N/A{{/catnamestring}}</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="d-flex">
                                                <span class="text-muted">Tags : </span> <span class="ml-1">{{{tagstring}}}</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="courseinfo_container">
                                        <div class="info_container enrolment_info">
                                            <div class="icon"></div>
                                            <span class="info_value">{{enrolled_count}}</span>
                                            <span class="info_title">Enrollments</span>
                                        </div>
                                        <div class="info_container points_info">
                                            <div class="icon"></div>
                                            <span class="info_value">{{points}}</span>
                                            <span class="info_title">{{#str}}points, local_courses{{/str}}</span>
                                        </div>
                                        <div class="info_container rating_info">
                                            <div class="icon"></div>
                                            <span class="info_value">{{ratings_value}}</span>
                                            <span class="info_title">{{#str}}pluginname, local_ratings{{/str}}</span>
                                        </div>
                                        <div class="info_container completed_info">
                                            <div class="icon"></div>
                                            <span class="info_value">{{completed_count}}</span>
                                            <span class="info_title">Completed</span>
                                        </div>
                                    </div>

                                    <div class="d-flex coursetype coursetypes_container">
                                        <span class="text-muted mr-1">
                                            Type :
                                        </span>
                                        {{{coursetype}}}

                                    </div>
                                </div>


                            </div>

                        </div>
                {{/ hascourses}}
                <div class="col-md-12">{{{ pagination }}}</div>
                {{# nocourses}}
                  <div class='w-full pull-left text-center alert alert-info'>No courses available.</div>
                {{/ nocourses}}
            {{/records}}
        </div>
    {{/viewtypeCard}}
{{/response}}


