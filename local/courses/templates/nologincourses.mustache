{{!
    @template local_courses/nologincourses

    TODO describe template test

    Example context (json):
    {
    }
}}

<div id="cardCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
    <div class="carousel-inner">
        {{#courses}}
            <div class="carousel-item {{active}}">
                <div class="d-flex justify-content-center">
                    {{#courseone}}
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card border rounded-4 p-0 h-100 d-flex flex-column">
                            <div class="position-relative">
                                <img src="{{courseimage}}" class="card-img-top" alt="courseimage">
                                <span class="badge bg-dark position-absolute">{{coursetype}}</span>
                            </div>
                            <div class="card-body p-3 d-flex flex-column flex-1">
                                <h5 class="card-title fs-6 course_name"><b>{{name}}</b></h5>
                                <p class="d-flex justify-content-between">
                                    {{#courseprice}}
                                    <span class="text-primary mr-4"><span><i class="fa fa-inr" aria-hidden="true"></i></span><span>{{courseprice}}</span></span>
                                    {{/courseprice}}
                                    <span class="text-muted mr-4"><small><span>{{#str}}category, local_courses{{/str}} : </span><span>{{categoryname}}</span></small></span>
                                </p>
                                <p class="card-text small">{{summary}}</p>
                                <div class="d-flex justify-content-center mt-auto">
                                   {{#price_status}}
                                        <a href="{{buy}}" class="btn btn-sm view_btn"><b>Buy</b></a>
                                        <a href="{{addtocart}}" class="btn btn-sm  btn-primary "><b>Add to Cart</b></a>
                                    {{/price_status}}
                                    {{^price_status}}
                                        <a href="{{viewmoreurl}}" class="btn btn-sm"><b>View Details</b></a>
                                    {{/price_status}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/courseone}}
                    {{#coursetwo}}
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card border rounded-4 p-0 h-100 d-flex flex-column">
                            <div class="position-relative">
                                <img src="{{courseimage}}" class="card-img-top" alt="courseimage">
                                <span class="badge bg-dark position-absolute">{{coursetype}}</span>
                            </div>
                            <div class="card-body p-3  d-flex flex-column flex-1">
                                <h5 class="card-title fs-6 course_name"><b>{{name}}</b></h5>
                                <p class="d-flex justify-content-between">
    		                        {{#courseprice}}
    		                        <span class="text-primary mr-4"><span><i class="fa fa-inr" aria-hidden="true"></i></span><span>{{courseprice}}</span></span>
    		                        {{/courseprice}}
    		                        <span class="text-muted mr-4"><small><span>{{#str}}category, local_courses{{/str}} : </span><span>{{categoryname}}</span></small></span>
    		                    </p>
                                <p class="card-text small">{{summary}}</p>
                                <div class="d-flex justify-content-center mt-auto">
                                    {{#price_status}}
                                        <a href="{{buy}}" class="btn btn-sm view_btn"><b>Buy</b></a>
                                        <a href="{{addtocart}}" class="btn btn-sm btn-primary view_btn"><b>Add to Cart</b></a>
                                    {{/price_status}}
                                    {{^price_status}}
                                        <a href="{{viewmoreurl}}" class="btn btn-sm view_btn"><b>View Details</b></a>
                                    {{/price_status}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/coursetwo}}
                    {{#coursethree}}
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card border rounded-4 p-0 h-100 d-flex flex-column">
                            <div class="position-relative">
                                <img src="{{courseimage}}" class="card-img-top" alt="courseimage">
                                <span class="badge bg-dark position-absolute">{{coursetype}}</span>
                            </div>
                            <div class="card-body p-3  d-flex flex-column flex-1">
                                <h5 class="card-title fs-6 course_name"><b>{{name}}</b></h5>
                                <p class="d-flex justify-content-between">
                                    {{#courseprice}}
                                    <span class="text-primary"><span><i class="fa fa-inr" aria-hidden="true"></i></span><span>{{courseprice}}</span></span>
                                    {{/courseprice}}
                                    <span class="text-muted mr-4"><small><span>{{#str}}category, local_courses{{/str}} : </span><span>{{categoryname}}</span></small></span>
                                </p>
                                <p class="card-text small">{{summary}}</p>
                                <div class="d-flex justify-content-center mt-auto">
                                    {{#price_status}}
                                        <a href="{{buy}}" class="btn btn-sm view_btn"><b>Buy</b></a>
                                        <a href="{{addtocart}}" class="btn btn-sm btn-primary"><b>Add to Cart</b></a>
                                    {{/price_status}}
                                    {{^price_status}}
                                        <a href="{{viewmoreurl}}" class="btn btn-sm view_btn"><b>View Details</b></a>
                                    {{/price_status}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/coursethree}}
                </div>
            </div>
        {{/courses}}
    </div>
</div>
