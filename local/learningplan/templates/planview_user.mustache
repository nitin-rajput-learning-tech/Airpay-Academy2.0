<div class="w-full pull-left planview_container">
	<ul class="course_extended_menu_list">
		{{{challenge_element}}}
		{{# certificate_exists }}
            {{# certificate_download }}
                    <li>
	                    <a class="course_extended_menu_itemlink" title="{{#str}} download_certificate, local_courses {{/ str}}" class="course_extended_menu_itemlink" href="{{ config.wwwroot}}/admin/tool/certificate/view.php?code={{certificateid}}" target = "_blank"><i class="icon fa fa-download" aria-hidden="true"></i>
	                    </a>
                    </li>
            {{/ certificate_download }}
            {{^ certificate_download }}
                    <li>
                        <a class="course_extended_menu_itemlink" title="{{# str}} unableto_download_msg, tool_certificate, Learning path {{/str}}" class="course_extended_menu_itemlink" href="javascript: void(0)" target="_blank"><i class="icon fa fa-download" aria-hidden="true"></i>
                        </a>
                    </li>
            {{/ certificate_download }}
        {{/ certificate_exists }}
	</ul>
	<div class="col-lg-12 col-md-12 pull-left p-0 planview_topcontent">
		<div class="col-lg-3 col-md-3 pull-left d-none-1023 p-0">
			<div style="background-image: url('{{ lpimgurl }}');height:207px;" alt="{{ lpname }}" title="{{ lpname }}" class="lpimg_bg" ></div>

		{{{display_ratings}}}
		{{{display_like}}}
		</div>
		
		{{# needenrol}}
		<a class='btn btn-primary pull-right mr-15' href='javascript:void(0)' onclick='(function(e){
		require("local_learningplan/courseenrol").enrolUser({planid:{{{planid}}}, userid:{{{userid}}}, planname:"{{{lpname}}}" }) })(event)'><i class="fa fa-pencil-square-o" aria-hidden="true"></i>{{# str}} enrol , local_learningplan{{/ str}}</a>
		{{/ needenrol}}
	
		<div class="col-lg-9 col-md-9 pull-left d-block-1023">
			<!--<h4 class='pull-left mb-5 lp_name'>{{ lpname }}</h4>-->	
			<div class="w-full pull-left pb-10">
				<span class="w-full pull-left mb-1"><b>{{#str}}description{{/str}}:</b></span>
				<div class="w-full pull-left description">
					{{# description_string }}
						<p class="m-0">{{{ description_string }}}</p>
					{{/ description_string }}
					{{^ description_string }}
						<p class="alert alert-info text-center m-0">{{#str}}nocoursedesc, local_courses{{/str}}</p>
					{{/ description_string }}
				</div>
			</div>
			<!--<div class="w-full pull-left mt-5 mb-5"><img src="{{ lpcoursespath }}" class="w-full" height="40"/></div>-->
			<div class="w-full pull-left coursepath">{{# lpcoursespath }} {{{lpcoursespath}}} {{/ lpcoursespath }} {{^ lpcoursespath }} <span class="w-full pull-left text-xs-center alert alert-info mt-1 m-0">{{#str}}assign_users_to_see_path, local_learningplan{{/str}}</span> {{/ lpcoursespath }}</div>
			<div class="col-lg-12 col-md-12 pull-left p-0">
				<div class="col-lg-6 col-md-6 pull-left pl-0">
					<div class="w-full pull-left mb-1">
						<span class="w-full pull-left"><b>{{#str}}details{{/str}} :</b></span>
					</div>
					<div class="w-full pull-left">
						<span class="text-muted" style="min-width: 100px;float: left;">{{#str}}learningplan,local_learningplan{{/str}}
						<span style="margin-right: 10px;float: right;">:</span> 
						</span><span style="color:#333;"><b>{{ plan_learningplan_code }}</b></span>
					</div>
					<div class="w-full pull-left">
						<span class="text-muted" style="min-width: 100px;float: left;">{{#str}}learningplan_index_credits, local_learningplan {{/str}} 
						<span style="margin-right: 10px;float: right;">:</span> 
						</span><span style="color:#333;"><b>{{ lplancredits }}</b></span>
					</div>
				</div>
				<div class="col-lg-6 col-md-6 pull-left pl-0">
					<div class="w-full pull-left mb-1">
						<span class="w-full pull-left"><b>{{#str}} assigned_courses, local_learningplan {{/str}} :</b></span>
					</div>
					<div class="w-full pull-left">
						<span class="text-muted" style="min-width: 100px;float: left;">{{#str}}mandatory, local_learningplan {{/str}}  
						<span style="margin-right: 10px;float: right;">:</span> 
						</span><span style="color:#333;"><b>{{ mandatarycourses_count }}</b></span>
					</div>
					<div class="w-full pull-left">
						<span class="text-muted" style="min-width: 100px;float: left;">{{#str}}optional,local_learningplan{{/str}}
						<span style="margin-right: 10px;float: right;">:</span> 
						</span><span style="color:#333;"><b>{{ optionalcourses_count }}</b></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- <div class="w-full pull-left m-15"><h4 class="lp_name">{{lpname}}</h4></div> -->



