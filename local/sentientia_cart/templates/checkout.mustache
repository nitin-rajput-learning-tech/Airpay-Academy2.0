{{!
    @template local_sentientia_cart/checkout

    Checkout form — billing details + gateway selection + place order.
}}
<div class="airpay-checkout container">
    <h2 class="mb-4">{{#str}}checkout, local_sentientia_cart{{/str}}</h2>

    <form method="POST" action="{{{ #moodle_url }}}/local/sentientia_cart/checkout.php{{{ /moodle_url }}}" class="row">
        <input type="hidden" name="sesskey" value="{{ sesskey }}"/>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <strong>{{#str}}billingdetails, local_sentientia_cart{{/str}}</strong>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="billing_name">{{#str}}billingname, local_sentientia_cart{{/str}} *</label>
                        <input type="text" id="billing_name" name="billing_name" class="form-control"
                               value="{{ default_name }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="billing_email">{{#str}}billingemail, local_sentientia_cart{{/str}} *</label>
                        <input type="email" id="billing_email" name="billing_email" class="form-control"
                               value="{{ default_email }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="billing_phone">{{#str}}billingphone, local_sentientia_cart{{/str}}</label>
                        <input type="tel" id="billing_phone" name="billing_phone" class="form-control"
                               value="{{ default_phone }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="billing_address">{{#str}}billingaddress, local_sentientia_cart{{/str}}</label>
                        <textarea id="billing_address" name="billing_address" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="billing_gstn">{{#str}}billinggstn, local_sentientia_cart{{/str}}</label>
                        <input type="text" id="billing_gstn" name="billing_gstn" class="form-control"
                               placeholder="e.g. 27AAAAA0000A1Z5">
                        <small class="form-text text-muted">For B2B with input tax credit.</small>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <strong>{{#str}}paymentmethod, local_sentientia_cart{{/str}}</strong>
                </div>
                <div class="card-body">
                    {{#gateways}}
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="gateway"
                               id="gw_{{ name }}" value="{{ name }}" {{#first}}checked{{/first}}>
                        <label class="form-check-label" for="gw_{{ name }}">{{ label }}</label>
                    </div>
                    {{/gateways}}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top:20px;">
                <div class="card-body">
                    <h5 class="card-title mb-3">Order summary</h5>
                    {{#items}}
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-truncate me-2" style="max-width:70%;">{{ name }}</span>
                        <span>{{ price_str }}</span>
                    </div>
                    {{/items}}
                    <hr/>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span>{{#str}}subtotal, local_sentientia_cart{{/str}}</span>
                        <span>{{ subtotal_str }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>{{#str}}tax, local_sentientia_cart{{/str}}</span>
                        <span>{{ tax_str }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>{{#str}}total, local_sentientia_cart{{/str}}</strong>
                        <strong>{{ total_str }}</strong>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-lock"></i> {{#str}}placeorder, local_sentientia_cart{{/str}}
                    </button>
                    <a href="{{{ back_url }}}" class="btn btn-link w-100 mt-2">
                        <i class="fa fa-arrow-left"></i> Back to cart
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
