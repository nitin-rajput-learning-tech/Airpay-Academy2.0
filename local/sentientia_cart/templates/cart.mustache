{{!
    @template local_sentientia_cart/cart

    My Cart — list current cart items + totals + checkout CTA.

    Classes:
        airpay-cart                  — page container
        airpay-cart__item            — one item row
        airpay-cart__summary         — totals box

    Context variables:
        has_items, items[], item_count
        subtotal_str, tax_str, total_str
        currency_symbol, checkout_url, history_url, catalog_url
}}
<div class="airpay-cart container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">{{#str}}mycart, local_sentientia_cart{{/str}}</h2>
        <a href="{{{ history_url }}}" class="btn btn-link text-decoration-none">
            <i class="fa fa-history"></i> {{#str}}orderhistory, local_sentientia_cart{{/str}}
        </a>
    </div>

    {{^has_items}}
    <div class="text-center py-5">
        <i class="fa fa-shopping-cart" style="font-size: 4rem; color: var(--ap-color-text-muted, #9ca3b4);"></i>
        <h3 class="mt-3">{{#str}}emptycart, local_sentientia_cart{{/str}}</h3>
        <p class="text-muted">{{#str}}emptycart_hint, local_sentientia_cart{{/str}}</p>
        <a href="{{{ catalog_url }}}" class="btn btn-primary mt-2">
            <i class="fa fa-search"></i> {{#str}}browsecatalog, local_sentientia_cart{{/str}}
        </a>
    </div>
    {{/has_items}}

    {{#has_items}}
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    {{#items}}
                    <div class="airpay-cart__item d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div>
                            <div class="fw-semibold">{{ name }}</div>
                            {{#shortname}}<div class="small text-muted">{{ shortname }}</div>{{/shortname}}
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-semibold">{{ price_str }}</span>
                            <button type="button" class="btn btn-sm btn-link text-danger p-1"
                                    data-action="remove-from-cart" data-courseid="{{ courseid }}"
                                    title="{{#str}}remove, local_sentientia_cart{{/str}}">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    {{/items}}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="airpay-cart__summary card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">{{#str}}itemstotal, local_sentientia_cart, {{ item_count }}{{/str}}</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>{{#str}}subtotal, local_sentientia_cart{{/str}}</span>
                        <span>{{ subtotal_str }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted small">
                        <span>{{#str}}tax, local_sentientia_cart{{/str}}</span>
                        <span>{{ tax_str }}</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>{{#str}}total, local_sentientia_cart{{/str}}</strong>
                        <strong class="fs-5">{{ total_str }}</strong>
                    </div>
                    <a href="{{{ checkout_url }}}" class="btn btn-primary w-100">
                        {{#str}}proceedtocheckout, local_sentientia_cart{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/has_items}}
</div>

{{#js}}
require(['local_sentientia_cart/cart'], function(Cart) { Cart.init(); });
{{/js}}
