{{!
    Email Design Studio — Pro visual editor with smart blocks + live preview.
    Context: template_key, template_label, category, tenant_id, tenants, source,
             current_subject, current_body, preview_html, placeholders, smartblocks,
             overrides, save_url, back_url, preview_url, sesskey, wwwroot
}}

{{#just_saved}}
<div class="ap-studio-toast ap-studio-toast--success" id="save-toast">
    <i class="fa fa-check-circle"></i> Template saved successfully
</div>
{{/just_saved}}
{{#just_reverted}}
<div class="ap-studio-toast ap-studio-toast--info" id="save-toast">
    <i class="fa fa-undo"></i> Reverted to default template
</div>
{{/just_reverted}}

<div class="ap-studio">

    {{! ═══ TOP BAR ═══ }}
    <div class="ap-studio__topbar">
        <div class="ap-studio__topbar-left">
            <a href="{{back_url}}" class="ap-studio__back" title="Back to templates">
                <i class="fa fa-arrow-left"></i>
            </a>
            <div>
                <span class="ap-studio__category">{{category}}</span>
                <h1 class="ap-studio__title">{{template_label}}</h1>
            </div>
            <span class="ap-studio__source-badge ap-studio__source-badge--{{source}}">
                {{#is_override}}<i class="fa fa-database"></i> DB Override{{/is_override}}
                {{^is_override}}<i class="fa fa-file-code"></i> File Template{{/is_override}}
            </span>
        </div>
        <div class="ap-studio__topbar-right">
            <select class="ap-studio__tenant-select" onchange="window.location='{{save_url}}'.replace(/tenant=\d+/, 'tenant='+this.value);">
                {{#tenants}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/tenants}}
            </select>

            {{#is_override}}
            <a href="{{save_url}}?revert=1&sesskey={{sesskey}}" class="ap-studio__btn ap-studio__btn--ghost"
               onclick="return confirm('Revert to default file template? The DB override will be deleted.');">
                <i class="fa fa-undo"></i> Revert
            </a>
            {{/is_override}}

            <a href="{{preview_url}}" class="ap-studio__btn ap-studio__btn--outline" target="_blank">
                <i class="fa fa-external-link"></i> Full Preview
            </a>

            <button type="submit" form="editor-form" class="ap-studio__btn ap-studio__btn--primary">
                <i class="fa fa-save"></i> Save Template
            </button>
        </div>
    </div>

    {{! ═══ OVERRIDE INDICATOR ═══ }}
    {{#has_overrides}}
    <div class="ap-studio__overrides-bar">
        <span style="font-size:12px; color:#5a6070; margin-right:8px;">Overrides:</span>
        {{#overrides}}
        <a href="{{save_url}}?tenant={{tenant_id}}"
           class="ap-studio__override-chip {{#is_current}}ap-studio__override-chip--active{{/is_current}}">
            {{tenant_name}}
            <span style="font-size:10px; color:#8890a0;">{{modified}}</span>
        </a>
        {{/overrides}}
    </div>
    {{/has_overrides}}

    {{! ═══ MAIN EDITOR AREA (3-panel layout) ═══ }}
    <div class="ap-studio__workspace">

        {{! LEFT SIDEBAR — Smart Blocks + Placeholders }}
        <div class="ap-studio__sidebar">
            {{! Smart Blocks }}
            <div class="ap-studio__sidebar-section">
                <h4 class="ap-studio__sidebar-title"><i class="fa fa-puzzle-piece"></i> Smart Blocks</h4>
                <div class="ap-studio__blocks">
                    {{#smartblocks}}
                    <button class="ap-studio__block-btn" data-block-id="{{id}}"
                            title="Click to insert {{label}}" onclick="insertBlock('{{id}}')">
                        <i class="fa {{icon}}"></i>
                        <span>{{label}}</span>
                    </button>
                    {{/smartblocks}}
                </div>
            </div>

            {{! Placeholders }}
            <div class="ap-studio__sidebar-section">
                <h4 class="ap-studio__sidebar-title"><i class="fa fa-code"></i> Placeholders</h4>
                {{#placeholders}}
                <div class="ap-studio__placeholder-group">
                    <h5 class="ap-studio__placeholder-group-title">{{group}}</h5>
                    {{#items}}
                    <button class="ap-studio__placeholder-btn" onclick="insertPlaceholder('{{name}}')"
                            title="Sample: {{sample}}">
                        <code>{{name}}</code>
                        <small>{{sample}}</small>
                    </button>
                    {{/items}}
                </div>
                {{/placeholders}}
            </div>
        </div>

        {{! CENTER — Editor }}
        <div class="ap-studio__editor">
            <form id="editor-form" method="post" action="{{save_url}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                {{! Subject Line }}
                <div class="ap-studio__field">
                    <label class="ap-studio__field-label">
                        <i class="fa fa-envelope"></i> Subject Line
                    </label>
                    {{!
                        Audit fix 2026-05-15 — the placeholder attribute used to
                        read: Email subject with [[placeholders]]...
                        Mustache parsed the inner double-brace placeholders token as a variable
                        interpolation. `placeholders` is the top-level array of
                        placeholder groups, and calling s() on an array throws a
                        TypeError. Escape the curly braces with HTML entities so
                        the example renders as literal text.
                    }}
                    <input type="text" name="subject" id="editor-subject" value="{{current_subject}}"
                           class="ap-studio__subject-input"
                           placeholder="Email subject with &#123;&#123;placeholders&#125;&#125;..."
                           oninput="schedulePreview()">
                </div>

                {{! Editor Mode Tabs }}
                <div class="ap-studio__editor-tabs">
                    <button type="button" class="ap-studio__editor-tab active" onclick="switchEditorMode('visual')">
                        <i class="fa fa-eye"></i> Visual
                    </button>
                    <button type="button" class="ap-studio__editor-tab" onclick="switchEditorMode('code')">
                        <i class="fa fa-code"></i> HTML Code
                    </button>
                </div>

                {{! Editor Area }}
                <div id="editor-visual" class="ap-studio__editor-area">
                    <textarea name="bodyhtml" id="editor-body" class="ap-studio__code-editor"
                              oninput="schedulePreview()">{{{current_body_raw}}}</textarea>
                </div>
            </form>
        </div>

        {{! RIGHT — Live Preview }}
        <div class="ap-studio__preview">
            <div class="ap-studio__preview-toolbar">
                <span class="ap-studio__preview-label">Live Preview</span>
                <div class="ap-studio__device-toggle">
                    <button class="active" onclick="setDevice('desktop', this)" title="Desktop"><i class="fa fa-desktop"></i></button>
                    <button onclick="setDevice('tablet', this)" title="Tablet"><i class="fa fa-tablet"></i></button>
                    <button onclick="setDevice('mobile', this)" title="Mobile"><i class="fa fa-mobile"></i></button>
                </div>
            </div>
            <div class="ap-studio__preview-viewport" id="preview-viewport">
                <iframe id="preview-frame" class="ap-studio__preview-frame"
                        srcdoc="{{{preview_html}}}"
                        sandbox="allow-same-origin"
                        onload="this.style.height = Math.max(600, this.contentDocument.body.scrollHeight + 40) + 'px';"></iframe>
            </div>
        </div>
    </div>
</div>

{{! ═══ SMART BLOCK HTML STORE ═══ }}
{{#smartblocks}}
<template id="block-{{id}}">{{{html}}}</template>
{{/smartblocks}}

<style>
/* ═══════════════════════════════════════════════════════
   EMAIL DESIGN STUDIO — Pro Editor Styles
   ═══════════════════════════════════════════════════════ */

.ap-studio { font-family: 'Montserrat', -apple-system, sans-serif; background: #F2F4FB; min-height: 100vh; margin: -1rem -1rem 0; }

/* Toast notifications */
.ap-studio-toast {
    position: fixed; top: 16px; right: 16px; z-index: 9999;
    padding: 12px 20px; border-radius: 10px; font-size: 14px; font-weight: 500;
    display: flex; align-items: center; gap: 8px;
    animation: ap-toast-in 0.3s ease-out, ap-toast-out 0.3s ease-in 3s forwards;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}
.ap-studio-toast--success { background: #16a34a; color: #fff; }
.ap-studio-toast--info { background: #0066A7; color: #fff; }
@keyframes ap-toast-in { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes ap-toast-out { from { opacity: 1; } to { opacity: 0; display: none; } }

/* Top bar */
.ap-studio__topbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 20px; background: #fff; border-bottom: 1px solid #e2e6ef;
    position: sticky; top: 0; z-index: 100;
}
.ap-studio__topbar-left { display: flex; align-items: center; gap: 12px; }
.ap-studio__topbar-right { display: flex; align-items: center; gap: 8px; }
.ap-studio__back {
    width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    color: #5a6070; background: #f0f2f7; text-decoration: none; transition: all 0.15s;
}
.ap-studio__back:hover { background: #e2e6ef; color: #1a1a2e; }
.ap-studio__category { font-size: 11px; color: #8890a0; text-transform: uppercase; letter-spacing: 0.5px; }
.ap-studio__title { font-size: 17px; font-weight: 700; color: #1a1a2e; margin: 0; line-height: 1.3; }
.ap-studio__source-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 10px; font-size: 11px; font-weight: 600;
}
.ap-studio__source-badge--file { background: #f0f2f7; color: #5a6070; }
.ap-studio__source-badge--tenant_override,
.ap-studio__source-badge--global_override { background: #f5f3ff; color: #7c3aed; }

.ap-studio__btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500;
    text-decoration: none; cursor: pointer; transition: all 0.15s; border: none;
    font-family: inherit;
}
.ap-studio__btn--primary { background: #0066A7; color: #fff; }
.ap-studio__btn--primary:hover { background: #004d80; }
.ap-studio__btn--outline { background: #fff; color: #0066A7; border: 1px solid #0066A7; }
.ap-studio__btn--outline:hover { background: #e8f2f9; }
.ap-studio__btn--ghost { background: transparent; color: #dc2626; }
.ap-studio__btn--ghost:hover { background: #fef2f2; }

.ap-studio__tenant-select {
    padding: 6px 12px; border: 1px solid #e2e6ef; border-radius: 8px;
    font-size: 13px; font-family: inherit; background: #fff;
}

/* Override indicator bar */
.ap-studio__overrides-bar {
    display: flex; align-items: center; gap: 6px; padding: 8px 20px;
    background: #f8f9fc; border-bottom: 1px solid #e2e6ef;
}
.ap-studio__override-chip {
    display: inline-flex; flex-direction: column; align-items: center;
    padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 500;
    background: #fff; border: 1px solid #e2e6ef; color: #5a6070;
    text-decoration: none; transition: all 0.15s;
}
.ap-studio__override-chip--active { background: #0066A7; color: #fff; border-color: #0066A7; }
.ap-studio__override-chip--active span { color: rgba(255,255,255,0.7); }

/* 3-panel workspace */
.ap-studio__workspace {
    display: grid; grid-template-columns: 220px 1fr 1fr; gap: 0;
    min-height: calc(100vh - 60px);
}

/* Left sidebar */
.ap-studio__sidebar {
    background: #fff; border-right: 1px solid #e2e6ef;
    overflow-y: auto; padding: 12px;
}
.ap-studio__sidebar-section { margin-bottom: 16px; }
.ap-studio__sidebar-title {
    font-size: 11px; font-weight: 700; color: #5a6070; text-transform: uppercase;
    letter-spacing: 0.5px; margin: 0 0 8px; display: flex; align-items: center; gap: 6px;
}
.ap-studio__sidebar-title i { color: #0066A7; }

/* Smart blocks grid */
.ap-studio__blocks { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.ap-studio__block-btn {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 10px 4px; border: 1px solid #e2e6ef; border-radius: 8px;
    background: #fff; cursor: pointer; transition: all 0.15s; font-family: inherit;
}
.ap-studio__block-btn:hover { background: #e8f2f9; border-color: #0066A7; }
.ap-studio__block-btn i { font-size: 16px; color: #0066A7; }
.ap-studio__block-btn span { font-size: 10px; color: #5a6070; font-weight: 500; text-align: center; line-height: 1.2; }

/* Placeholder groups */
.ap-studio__placeholder-group { margin-bottom: 8px; }
.ap-studio__placeholder-group-title {
    font-size: 10px; font-weight: 600; color: #8890a0; text-transform: uppercase;
    letter-spacing: 0.5px; margin: 8px 0 4px; padding: 0;
}
.ap-studio__placeholder-btn {
    display: flex; justify-content: space-between; align-items: center; width: 100%;
    padding: 4px 6px; border: none; background: transparent; cursor: pointer;
    border-radius: 4px; transition: all 0.1s; text-align: left; font-family: inherit;
}
.ap-studio__placeholder-btn:hover { background: #e8f2f9; }
.ap-studio__placeholder-btn code {
    font-size: 10px; color: #0066A7; background: #f0f2f7; padding: 1px 4px; border-radius: 3px;
}
.ap-studio__placeholder-btn small { font-size: 9px; color: #8890a0; max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Center editor */
.ap-studio__editor { background: #fff; border-right: 1px solid #e2e6ef; display: flex; flex-direction: column; }
.ap-studio__field { padding: 12px 16px; border-bottom: 1px solid #e2e6ef; }
.ap-studio__field-label {
    font-size: 11px; font-weight: 600; color: #5a6070; text-transform: uppercase;
    letter-spacing: 0.5px; display: block; margin-bottom: 6px;
}
.ap-studio__field-label i { color: #0066A7; }
.ap-studio__subject-input {
    width: 100%; padding: 8px 12px; border: 1px solid #e2e6ef; border-radius: 8px;
    font-size: 14px; font-family: inherit; outline: none; transition: border-color 0.15s;
}
.ap-studio__subject-input:focus { border-color: #0066A7; box-shadow: 0 0 0 3px rgba(0,102,167,0.1); }

/* Editor mode tabs */
.ap-studio__editor-tabs {
    display: flex; gap: 0; border-bottom: 1px solid #e2e6ef; padding: 0 16px;
}
.ap-studio__editor-tab {
    padding: 8px 16px; font-size: 12px; font-weight: 500; color: #5a6070;
    cursor: pointer; border: none; background: transparent; border-bottom: 2px solid transparent;
    margin-bottom: -1px; transition: all 0.15s; font-family: inherit;
    display: flex; align-items: center; gap: 4px;
}
.ap-studio__editor-tab:hover { color: #0066A7; }
.ap-studio__editor-tab.active { color: #0066A7; border-bottom-color: #0066A7; font-weight: 600; }

/* Code editor */
.ap-studio__editor-area { flex: 1; display: flex; }
.ap-studio__code-editor {
    width: 100%; flex: 1; border: none; resize: none; padding: 16px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 12.5px; line-height: 20px; color: #1a1a2e; background: #fafbfd;
    outline: none; tab-size: 2;
}
.ap-studio__code-editor:focus { background: #fff; }

/* Right preview */
.ap-studio__preview { background: #e9ecf3; display: flex; flex-direction: column; }
.ap-studio__preview-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 16px; background: #fff; border-bottom: 1px solid #e2e6ef;
}
.ap-studio__preview-label { font-size: 11px; font-weight: 600; color: #5a6070; text-transform: uppercase; letter-spacing: 0.5px; }
.ap-studio__device-toggle { display: flex; gap: 2px; background: #f0f2f7; border-radius: 6px; padding: 2px; }
.ap-studio__device-toggle button {
    width: 30px; height: 26px; border: none; background: transparent; border-radius: 4px;
    cursor: pointer; color: #5a6070; font-size: 14px; transition: all 0.15s;
}
.ap-studio__device-toggle button.active { background: #0066A7; color: #fff; }
.ap-studio__device-toggle button:hover:not(.active) { background: #e2e6ef; }

.ap-studio__preview-viewport {
    flex: 1; overflow: auto; padding: 16px; display: flex; justify-content: center;
    transition: all 0.3s ease;
}
.ap-studio__preview-viewport.desktop { }
.ap-studio__preview-viewport.tablet .ap-studio__preview-frame { max-width: 768px; }
.ap-studio__preview-viewport.mobile .ap-studio__preview-frame { max-width: 375px; }

.ap-studio__preview-frame {
    width: 100%; border: none; min-height: 600px; background: #fff;
    border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: max-width 0.3s ease;
}

/* Responsive */
@media (max-width: 1200px) {
    .ap-studio__workspace { grid-template-columns: 200px 1fr; }
    .ap-studio__preview { display: none; }
}
@media (max-width: 768px) {
    .ap-studio__workspace { grid-template-columns: 1fr; }
    .ap-studio__sidebar { display: none; }
    .ap-studio__topbar { flex-direction: column; gap: 8px; }
}
</style>

<script>
var previewTimer = null;
var previewUrl = '{{wwwroot}}/local/sentientia_emails/preview.php?template={{template_key}}&tenant={{tenant_id}}';

function insertBlock(blockId) {
    var tmpl = document.getElementById('block-' + blockId);
    if (!tmpl) return;
    var html = tmpl.innerHTML;
    var editor = document.getElementById('editor-body');
    var start = editor.selectionStart;
    var end = editor.selectionEnd;
    editor.value = editor.value.substring(0, start) + '\n' + html + '\n' + editor.value.substring(end);
    editor.selectionStart = editor.selectionEnd = start + html.length + 2;
    editor.focus();
    schedulePreview();
}

function insertPlaceholder(name) {
    var editor = document.getElementById('editor-body');
    var insert = '{{' + name + '}}';
    var start = editor.selectionStart;
    var end = editor.selectionEnd;
    editor.value = editor.value.substring(0, start) + insert + editor.value.substring(end);
    editor.selectionStart = editor.selectionEnd = start + insert.length;
    editor.focus();
    schedulePreview();
}

function switchEditorMode(mode) {
    document.querySelectorAll('.ap-studio__editor-tab').forEach(function(t) { t.classList.remove('active'); });
    event.target.closest('.ap-studio__editor-tab').classList.add('active');
    // For now both modes show the same textarea. Visual mode could use Atto in the future.
}

function setDevice(mode, btn) {
    var viewport = document.getElementById('preview-viewport');
    viewport.className = 'ap-studio__preview-viewport ' + mode;
    document.querySelectorAll('.ap-studio__device-toggle button').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
}

function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(updatePreview, 600);
}

function updatePreview() {
    var bodyHtml = document.getElementById('editor-body').value;
    var subject = document.getElementById('editor-subject').value;
    if (!bodyHtml.trim()) return;

    // Use form data to POST for preview (avoids GET URL length limits).
    var formData = new FormData();
    formData.append('ajax', '1');
    formData.append('bodyhtml', bodyHtml);
    formData.append('subject', subject);
    formData.append('template', '{{template_key}}');
    formData.append('tenant', '{{tenant_id}}');
    formData.append('sesskey', '{{sesskey}}');

    fetch('{{wwwroot}}/local/sentientia_emails/preview_ajax.php', {
        method: 'POST',
        body: formData,
    })
    .then(function(resp) { return resp.text(); })
    .then(function(html) {
        var iframe = document.getElementById('preview-frame');
        iframe.srcdoc = html;
        iframe.onload = function() {
            try { iframe.style.height = Math.max(600, iframe.contentDocument.body.scrollHeight + 40) + 'px'; } catch(e) {}
        };
    })
    .catch(function() {
        // Silent fail — preview will update on next successful call.
    });
}

// Auto-dismiss toast after 3s.
setTimeout(function() {
    var toast = document.getElementById('save-toast');
    if (toast) toast.style.display = 'none';
}, 4000);
</script>
