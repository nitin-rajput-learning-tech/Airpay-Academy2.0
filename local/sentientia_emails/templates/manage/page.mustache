{{!
    Notification Management Panel — main page layout with tab navigation.
    Context: tabs, tenants, current_tab, is_siteadmin, manage_url, preview_url,
             is_dashboard, is_templates, is_rules, is_logs, is_settings, tabdata
}}
<div class="ap-manage-panel">

    {{! ═══ HEADER BAR ═══ }}
    <div class="ap-manage-header">
        <div class="ap-manage-header__left">
            <h2 class="ap-manage-header__title">
                <i class="fa fa-envelope" aria-hidden="true"></i>
                Notification Management
            </h2>
            <span class="ap-manage-header__subtitle">
                Manage email templates, notification rules, and delivery logs
            </span>
        </div>
        <div class="ap-manage-header__right">
            {{#is_siteadmin}}
            <div class="ap-manage-tenant-select">
                <label for="tenant-select">Tenant:</label>
                <select id="tenant-select" onchange="window.location='{{manage_url}}?tab={{current_tab}}&tenant='+this.value">
                    {{#tenants}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/tenants}}
                </select>
            </div>
            {{/is_siteadmin}}
            <a href="{{preview_url}}" class="ap-manage-btn ap-manage-btn--outline" target="_blank">
                <i class="fa fa-eye" aria-hidden="true"></i> Preview Templates
            </a>
        </div>
    </div>

    {{! ═══ TAB NAVIGATION ═══ }}
    <nav class="ap-manage-tabs">
        {{#tabs}}
        <a href="{{url}}" class="ap-manage-tab {{#active}}ap-manage-tab--active{{/active}}">
            <i class="fa {{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
        </a>
        {{/tabs}}
    </nav>

    {{! ═══ TAB CONTENT ═══ }}
    <div class="ap-manage-content">
        {{#is_dashboard}}
        {{> local_sentientia_emails/manage/tab_dashboard}}
        {{/is_dashboard}}

        {{#is_templates}}
        {{> local_sentientia_emails/manage/tab_templates}}
        {{/is_templates}}

        {{#is_rules}}
        {{> local_sentientia_emails/manage/tab_rules}}
        {{/is_rules}}

        {{#is_logs}}
        {{> local_sentientia_emails/manage/tab_logs}}
        {{/is_logs}}

        {{#is_settings}}
        {{> local_sentientia_emails/manage/tab_settings}}
        {{/is_settings}}
    </div>
</div>

<style>
/* ═══ MANAGEMENT PANEL STYLES ═══ */
.ap-manage-panel { font-family: 'Montserrat', -apple-system, sans-serif; }
.ap-manage-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 0; flex-wrap: wrap; gap: 12px;
}
.ap-manage-header__title {
    font-size: 22px; font-weight: 700; color: #1a1a2e; margin: 0;
}
.ap-manage-header__title i { color: #0066A7; margin-right: 8px; }
.ap-manage-header__subtitle { font-size: 13px; color: #5a6070; display: block; margin-top: 4px; }
.ap-manage-header__right { display: flex; align-items: center; gap: 12px; }
.ap-manage-tenant-select { display: flex; align-items: center; gap: 6px; }
.ap-manage-tenant-select label { font-size: 13px; color: #5a6070; font-weight: 500; }
.ap-manage-tenant-select select {
    padding: 6px 12px; border: 1px solid #e2e6ef; border-radius: 8px;
    font-family: inherit; font-size: 13px; background: #fff; cursor: pointer;
}
.ap-manage-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500;
    text-decoration: none; cursor: pointer; transition: all 0.15s;
}
.ap-manage-btn--outline {
    border: 1px solid #0066A7; color: #0066A7; background: transparent;
}
.ap-manage-btn--outline:hover { background: #e8f2f9; }
.ap-manage-btn--primary { background: #0066A7; color: #fff; border: none; }
.ap-manage-btn--primary:hover { background: #004d80; color: #fff; }
.ap-manage-btn--danger { background: #dc2626; color: #fff; border: none; }
.ap-manage-btn--sm { padding: 4px 10px; font-size: 12px; }

/* Tabs */
.ap-manage-tabs {
    display: flex; gap: 0; border-bottom: 2px solid #e2e6ef; margin-bottom: 24px;
}
.ap-manage-tab {
    display: flex; align-items: center; gap: 6px;
    padding: 12px 20px; font-size: 14px; font-weight: 500;
    color: #5a6070; text-decoration: none; border-bottom: 2px solid transparent;
    margin-bottom: -2px; transition: all 0.15s;
}
.ap-manage-tab:hover { color: #0066A7; }
.ap-manage-tab--active { color: #0066A7; border-bottom-color: #0066A7; font-weight: 600; }

/* Content */
.ap-manage-content { min-height: 400px; }

/* Cards */
.ap-manage-card {
    background: #fff; border: 1px solid #e2e6ef; border-radius: 12px;
    padding: 20px; margin-bottom: 16px;
}
.ap-manage-card__title {
    font-size: 13px; font-weight: 600; color: #5a6070; text-transform: uppercase;
    letter-spacing: 0.5px; margin: 0 0 8px;
}
.ap-manage-card__value {
    font-size: 28px; font-weight: 700; color: #1a1a2e; line-height: 1.2;
}

/* Stats grid */
.ap-manage-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }

/* Table */
.ap-manage-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.ap-manage-table th {
    text-align: left; padding: 10px 14px; font-weight: 600; color: #5a6070;
    text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px;
    background: #f8f9fc; border-bottom: 1px solid #e2e6ef;
}
.ap-manage-table td { padding: 10px 14px; border-bottom: 1px solid #f0f2f7; color: #1a1a2e; }
.ap-manage-table tr:hover td { background: #f8f9fc; }

/* Badges */
.ap-manage-badge {
    display: inline-block; padding: 2px 8px; border-radius: 10px;
    font-size: 11px; font-weight: 600; line-height: 18px;
}
.ap-manage-badge--sent { background: #dcfce7; color: #16a34a; }
.ap-manage-badge--failed { background: #fef2f2; color: #dc2626; }
.ap-manage-badge--suppressed { background: #fef3c7; color: #d97706; }
.ap-manage-badge--bizlms { background: #e8f2f9; color: #0066A7; }
.ap-manage-badge--override { background: #f5f3ff; color: #7c3aed; }
.ap-manage-badge--file { background: #f0f2f7; color: #5a6070; }
.ap-manage-badge--enabled { background: #dcfce7; color: #16a34a; }
.ap-manage-badge--disabled { background: #f0f2f7; color: #8890a0; }

/* Toggle switch */
.ap-toggle { position: relative; display: inline-block; width: 40px; height: 22px; }
.ap-toggle input { opacity: 0; width: 0; height: 0; }
.ap-toggle-slider {
    position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
    background: #ccc; border-radius: 22px; transition: 0.3s;
}
.ap-toggle-slider:before {
    position: absolute; content: ""; height: 16px; width: 16px;
    left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: 0.3s;
}
.ap-toggle input:checked + .ap-toggle-slider { background: #0066A7; }
.ap-toggle input:checked + .ap-toggle-slider:before { transform: translateX(18px); }

/* Empty state */
.ap-manage-empty {
    text-align: center; padding: 60px 20px; color: #5a6070;
}
.ap-manage-empty i { font-size: 48px; color: #e2e6ef; margin-bottom: 16px; display: block; }

/* Warning banner */
.ap-manage-warning {
    background: #fef3c7; border: 1px solid #fbbf24; border-radius: 8px;
    padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: #92400e;
}
.ap-manage-warning i { color: #d97706; }

/* Responsive */
@media (max-width: 768px) {
    .ap-manage-header { flex-direction: column; align-items: flex-start; }
    .ap-manage-tabs { overflow-x: auto; }
    .ap-manage-stats { grid-template-columns: repeat(2, 1fr); }
}
</style>
