<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr><td style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; line-height:24px; color:#1a1a2e;">
    <p style="margin:0 0 16px;">Hi <strong>{{firstname}}</strong>,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;">
    <tr>
        <td bgcolor="#f5f3ff" style="background-color:#f5f3ff; padding:14px 16px; border-radius:8px; border-left:4px solid #7c3aed;">
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:14px; color:#7c3aed; font-weight:600;">
                &#128230; Your Data Export is Ready
            </span><br/>
            <span style="font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">
                Your data download has been prepared as requested under the
                Digital Personal Data Protection Act, 2023.
            </span>
        </td>
    </tr>
    </table>
    <!-- File details -->
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0 16px; background-color:#f8f9fc; border-radius:8px; padding:12px 16px;">
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; width:120px;">File Size</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; font-weight:600;">{{file_size}}</td></tr>
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Format</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#1a1a2e; font-weight:600;">JSON</td></tr>
    <tr><td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070;">Expires</td>
        <td style="padding:4px 0; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#dc2626; font-weight:600;">{{download_expiry}}</td></tr>
    </table>
    <!-- Data categories -->
    <p style="margin:8px 0; font-size:14px; font-weight:600; color:#1a1a2e;">Data included:</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:4px 0 16px;">
    {{#data_categories}}
    <tr>
        <td style="padding:4px 0 4px 8px; font-family:'Montserrat',Arial,sans-serif; font-size:13px; color:#5a6070; line-height:20px;">
            <span style="color:#7c3aed; margin-right:8px;">&#10003;</span> {{category}}
        </td>
    </tr>
    {{/data_categories}}
    </table>
</td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
    <td align="center" bgcolor="#7c3aed" style="background-color:#7c3aed; border-radius:8px;">
        <a href="{{download_url}}" target="_blank" style="display:inline-block; padding:14px 32px; font-family:'Montserrat',Arial,sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; line-height:20px;">
            Download My Data
        </a>
    </td>
</tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
<tr>
    <td style="font-family:'Montserrat',Arial,sans-serif; font-size:12px; color:#8890a0; padding:8px 0;">
        This download link will expire after {{download_expiry}}. For security, do not share this link.
    </td>
</tr>
</table>
{{> local_sentientia_emails/partials/footer_note}}
