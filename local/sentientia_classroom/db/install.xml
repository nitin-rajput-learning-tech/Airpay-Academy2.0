<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/sentientia_classroom/db" VERSION="20260925"
       COMMENT="Airpay Classroom Training — replaces BizLMS local_classroom">
  <TABLES>
    <TABLE NAME="local_sentientia_classroom" COMMENT="Classroom/ILT sessions (fork of local_classroom)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="254" NOTNULL="true"/>
        <FIELD NAME="description"     TYPE="text" NOTNULL="false"/>
        <FIELD NAME="costcenterid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="Tenant org ID"/>
        <FIELD NAME="departmentid"    TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="open_path"       TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="trainerid"       TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK to mdl_user.id — primary trainer"/>
        <FIELD NAME="location"        TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="locationid"      TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Phase 5 A.5: local_sentientia_locations.id. Added by step 2026051160; declared here 2026-09-25 (step 2026092501 adds it where missing)"/>
        <FIELD NAME="capacity"        TYPE="int"  LENGTH="6"  NOTNULL="true" DEFAULT="30"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="1"
               COMMENT="1=active, 0=cancelled, 2=completed"/>
        <FIELD NAME="visible"         TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="startdate"       TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="P1 batch (2026-05-16): UNIX ts — classroom becomes enrollable on this date"/>
        <FIELD NAME="enddate"         TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="P1 batch (2026-05-16): UNIX ts — classroom closes for new enrolments on this date"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_status"     UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_classroom_sessions" COMMENT="Session instances (dates/times)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="classroomid"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="title"           TYPE="char" LENGTH="254" NOTNULL="false"
               COMMENT="Optional session title (e.g. 'Day 2 — Hands-on lab')"/>
        <FIELD NAME="sessiondate"     TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp"/>
        <FIELD NAME="starttime"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="endtime"         TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="location"        TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="locationid"      TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Phase 5 A.5: local_sentientia_locations.id. Added by step 2026051160; declared here 2026-09-25 (step 2026092501 adds it where missing)"/>
        <FIELD NAME="trainerid"       TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="Override classroom trainer for this specific session"/>
        <FIELD NAME="notes"           TYPE="text" NOTNULL="false"/>
        <FIELD NAME="meeting_url"     TYPE="char" LENGTH="1024" NOTNULL="false"
               COMMENT="W1-7: live meeting URL (Zoom/Teams/Webex/Meet)"/>
        <FIELD NAME="recording_url"   TYPE="char" LENGTH="1024" NOTNULL="false"
               COMMENT="W1-7: post-session recording URL"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_classroom" TYPE="foreign" FIELDS="classroomid" REFTABLE="local_sentientia_classroom" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_classroom_date" UNIQUE="false" FIELDS="classroomid, sessiondate"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_classroom_users" COMMENT="Roster: users enrolled in a classroom (precondition for attendance)">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="classroomid"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="enrolledby"      TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK to mdl_user.id — admin who added them"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_classroom" TYPE="foreign" FIELDS="classroomid" REFTABLE="local_sentientia_classroom" REFFIELDS="id"/>
        <KEY NAME="fk_user"      TYPE="foreign" FIELDS="userid"      REFTABLE="user"                   REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_classroom_user" UNIQUE="true"  FIELDS="classroomid, userid"
               COMMENT="A user can only be enrolled once per classroom"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_classroom_attendance" COMMENT="Attendance records per session">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status"          TYPE="int"  LENGTH="2"  NOTNULL="true" DEFAULT="0"
               COMMENT="0=absent, 1=present, 2=late, 3=excused"/>
        <FIELD NAME="markedby"        TYPE="int"  LENGTH="10" NOTNULL="false"
               COMMENT="FK to mdl_user.id — admin who marked it"/>
        <FIELD NAME="notes"           TYPE="char" LENGTH="254" NOTNULL="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_session" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_sentientia_classroom_sessions" REFFIELDS="id"/>
        <KEY NAME="fk_user"    TYPE="foreign" FIELDS="userid"    REFTABLE="user"                            REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_session_user" UNIQUE="true" FIELDS="sessionid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_classroom_waitlist" COMMENT="Waiting list for a full classroom. Created by upgrade step 2026051130; declared here 2026-09-24 so a fresh install has it too, and step 2026092400 adds it where missing. Must stay identical to both steps.">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="classroomid"     TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="userid"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="position"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"
               COMMENT="1 = head of the queue; renumbered 1..N over the waiting rows"/>
        <FIELD NAME="status"          TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="waiting"
               COMMENT="waiting, promoted or removed"/>
        <FIELD NAME="reason"          TYPE="text" NOTNULL="false" SEQUENCE="false"
               COMMENT="Why the row was removed: user left, or an admin free-text reason"/>
        <FIELD NAME="promoted_at"     TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="removed_at"      TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"      TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_classroom" TYPE="foreign" FIELDS="classroomid" REFTABLE="local_sentientia_classroom" REFFIELDS="id"/>
        <KEY NAME="fk_user"      TYPE="foreign" FIELDS="userid"      REFTABLE="user"                   REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_classroom_status" UNIQUE="false" FIELDS="classroomid, status"/>
        <INDEX NAME="idx_user_status"      UNIQUE="false" FIELDS="userid, status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_sentientia_locations" COMMENT="Phase 5 A.5 (ENTERPRISE-GRADE-PLAN.md): training venues for classroom sessions. Created by upgrade step 2026051160; declared here 2026-09-25 so a fresh install has it too, and step 2026092501 adds it where missing. Must stay identical to db/upgradelib.php.">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name"            TYPE="char" LENGTH="200" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="city"            TYPE="char" LENGTH="100" NOTNULL="false" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="address"         TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="capacity"        TYPE="int"  LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="equipment"       TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="latitude"        TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="false" SEQUENCE="false"
               COMMENT="Decimal degrees, NUMBER(10,6). Step 2026051160 created it NUMBER(10,0) until 2026-09-25"/>
        <FIELD NAME="longitude"       TYPE="number" LENGTH="10" DECIMALS="6" NOTNULL="false" SEQUENCE="false"
               COMMENT="Decimal degrees, NUMBER(10,6). Step 2026051160 created it NUMBER(10,0) until 2026-09-25"/>
        <FIELD NAME="costcenterid"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
               COMMENT="Tenant org ID"/>
        <FIELD NAME="active"          TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_active"     UNIQUE="false" FIELDS="active"/>
        <INDEX NAME="idx_costcenter" UNIQUE="false" FIELDS="costcenterid"/>
        <INDEX NAME="idx_city"       UNIQUE="false" FIELDS="city"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
