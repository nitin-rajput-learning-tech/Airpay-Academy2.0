{{!
    Airpay Courses — manager's "My requests" outbox.

    @template local_sentientia_courses/my_requests
    @package  local_sentientia_courses
    Sprint D + (2026-05-13)

    Context vars:
      rows                  array  — request rows (see my_requests.php for shape)
      has_rows              bool
      viewer_tenant_name    string
      count_total           int
      count_pending         int
      count_approved        int
      count_rejected        int
      browse_url            string — link back to browse_airpay.php
}}
<div class="airpay-courses-outbox">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">
                <i class="fa fa-clipboard-list fa-fw text-primary"></i>
                My course-share requests
            </h2>
            <div class="small text-muted">
                Every request you (or anyone in {{ viewer_tenant_name }})
                has filed to borrow a course from Airpay's library.
                <a href="{{{ browse_url }}}">Browse Airpay Library →</a>
            </div>
        </div>
    </div>

    {{# has_rows }}
    <div class="d-flex gap-3 mb-3">
        <div class="card border-0 shadow-sm flex-fill">
            <div class="card-body p-3 text-center">
                <div class="small text-muted text-uppercase">Total</div>
                <div style="font-size:1.8em;font-weight:700;">{{ count_total }}</div>
            </div>
        </div>
        <div class="card border-0 shadow-sm flex-fill">
            <div class="card-body p-3 text-center">
                <div class="small text-muted text-uppercase">Pending</div>
                <div style="font-size:1.8em;font-weight:700;color:#d97706;">{{ count_pending }}</div>
            </div>
        </div>
        <div class="card border-0 shadow-sm flex-fill">
            <div class="card-body p-3 text-center">
                <div class="small text-muted text-uppercase">Approved</div>
                <div style="font-size:1.8em;font-weight:700;color:#16a34a;">{{ count_approved }}</div>
            </div>
        </div>
        <div class="card border-0 shadow-sm flex-fill">
            <div class="card-body p-3 text-center">
                <div class="small text-muted text-uppercase">Rejected</div>
                <div style="font-size:1.8em;font-weight:700;color:#dc2626;">{{ count_rejected }}</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th style="width: 150px;">Status</th>
                        <th style="width: 160px;">Requested</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    {{# rows }}
                    <tr>
                        <td>
                            <div style="font-weight: 600;">{{ coursename }}</div>
                            <div class="small text-muted"><code>{{ courseshort }}</code></div>
                        </td>
                        <td>
                            <span class="badge {{ status_class }}">{{ status_label }}</span>
                        </td>
                        <td>
                            <span class="small text-muted">{{ requested_at }}</span>
                            {{# is_decided }}
                            <div class="small text-muted">Decided: {{ decided_at }}</div>
                            {{/ is_decided }}
                        </td>
                        <td>
                            {{# has_reason }}
                            <div class="small">
                                <strong>Admin note:</strong> {{ reason }}
                            </div>
                            {{/ has_reason }}
                            {{^ has_reason }}
                            <span class="small text-muted">—</span>
                            {{/ has_reason }}
                        </td>
                    </tr>
                    {{/ rows }}
                </tbody>
            </table>
        </div>
    </div>
    {{/ has_rows }}
    {{^ has_rows }}
    <div class="alert alert-light text-center">
        <i class="fa fa-info-circle fa-fw"></i>
        You haven't filed any course-share requests yet.
        <a href="{{{ browse_url }}}" class="alert-link">Browse the Airpay library →</a>
    </div>
    {{/ has_rows }}

</div>
