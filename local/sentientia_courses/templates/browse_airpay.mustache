{{!
    Airpay Courses — receiving-tenant manager catalogue browse.

    @template local_sentientia_courses/browse_airpay
    @package  local_sentientia_courses
    Sprint D (2026-05-13); 2026-09-17: F-12 + i18n — fullname / shortname / summary / categoryname arrive
    format_string()'d (triple braces); title / intro / empty / isolation copy are built in PHP with
    get_string() so the customer + tenant names are escaped exactly once; labels via the str helper.

    Context vars:
      courses             array — one entry per Airpay course:
                            id, fullname, shortname, summary, categoryname,
                            state, state_label, state_class, can_request
      has_courses         bool
      title, intro, empty_text, isolation_note   strings — pre-built, HTML-safe
      sesskey             string
      post_url            string — POST target for "Request access"
}}
<div class="airpay-courses-browse">

    <div class="ap-page-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">
                <i class="fa fa-handshake fa-fw text-primary"></i>
                {{{ title }}}
            </h2>
            <div class="small text-muted">{{{ intro }}}</div>
        </div>
    </div>

    {{# has_courses }}
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>{{#str}}browse_col_course, local_sentientia_courses{{/str}}</th>
                        <th>{{#str}}browse_col_category, local_sentientia_courses{{/str}}</th>
                        <th style="width: 150px;">{{#str}}browse_col_status, local_sentientia_courses{{/str}}</th>
                        <th style="width: 180px;">{{#str}}browse_col_action, local_sentientia_courses{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{# courses }}
                    <tr>
                        <td>
                            <div style="font-weight: 600;">{{{ fullname }}}</div>
                            <div class="small text-muted">
                                <code>{{{ shortname }}}</code> · {{{ summary }}}
                            </div>
                        </td>
                        <td><span class="small text-muted">{{{ categoryname }}}</span></td>
                        <td>
                            <span class="badge {{ state_class }}">{{ state_label }}</span>
                        </td>
                        <td>
                            {{# can_request }}
                            <form method="POST" action="{{{ post_url }}}" class="m-0">
                                <input type="hidden" name="sesskey"  value="{{ sesskey }}">
                                <input type="hidden" name="courseid" value="{{ id }}">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fa fa-paper-plane fa-fw"></i> {{#str}}browse_request_access, local_sentientia_courses{{/str}}
                                </button>
                            </form>
                            {{/ can_request }}
                            {{^ can_request }}
                            <span class="small text-muted">—</span>
                            {{/ can_request }}
                        </td>
                    </tr>
                    {{/ courses }}
                </tbody>
            </table>
        </div>
    </div>
    {{/ has_courses }}
    {{^ has_courses }}
    <div class="alert alert-light text-center">
        <i class="fa fa-info-circle fa-fw"></i>
        {{{ empty_text }}}
    </div>
    {{/ has_courses }}

    <div class="alert alert-info mt-3" role="alert">
        <i class="fa fa-shield fa-fw"></i>
        {{{ isolation_note }}}
    </div>

</div>
