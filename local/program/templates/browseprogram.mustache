<div class="program_container w-full pull-left mb-15 {{programstatusclass}} {{# hide_show}}
                        {{# show}} inactive_program {{/ show}} {{/ hide_show}}">
    <div class="col-lg-12 col-md-12 pull-left programname_status">
        <span class="programicon_container">
            <!-- <img src ="{{{ programicon }}}" class="programicon"> -->
            <i class="fa fa-graduation-cap" aria-hidden="true"></i>
        </span>
        <div class="pull-left program_name">
            <a href="view.php?bcid={{programid}}" class="class_name" title = "{{ program }}">{{ programname }}</a>
        </div>
        <div class="pull-right showoptions{{programid}} actionicons">
            {{# action}}
    		{{# mouse_overicon}}
                <span  class="pull-right showoptions" data-action="showoptions{{programid}}" onmouseenter="(function(e){ require('theme_epsilon/quickactions').quickactionsCall({ selector:'showoptions{{programid}}' }) })(event)" onmouseleave="(function(e){require('theme_epsilon/quickactions').quickactionsCall({ selector:'showoptions{{programid}}' }) })(event)">
                <i class="fa fa-ellipsis-h options" aria-hidden="true" title="" aria-label=""></i></span>
             {{/ mouse_overicon}}
                <ul class="options_container" id="showoptions{{programid}}">
                    {{# cannotdelete}}
                    <li>
                        <a title="{{# str}} coursebackup {{/ str}}" href="javascript:void(0)" alt = "{{# str}} delete {{/ str}}"
                            title = "{{# str}} delete {{/ str}}" onclick="(function(e){ require('local_program/program').deleteConfirm({action:'cannotdeleteprogram', id: {{ programid }}, programid: {{ programid }}, programname: '{{ program }}'}) })(event)"><i class="fa fa-trash fa-fw" aria-hidden="true" aria-label="" title = "{{# str}} delete {{/ str}}"></i></a>
                    </li>
                    {{/ cannotdelete}}
                    {{# delete}}
                    <li>
                        <a title="{{# str}} coursebackup {{/ str}}" href="javascript:void(0)" alt = "{{# str}} delete {{/ str}}"
                           title = "{{# str}} delete {{/ str}}" onclick="(function(e){ require('local_program/program').deleteConfirm({action:'deleteprogram', id: {{ programid }}, programid: {{ programid }}, programname: '{{ program }}'}) })(event)"><i class="fa fa-trash fa-fw" aria-hidden="true" aria-label="" title = "{{# str}} delete {{/ str}}"></i></a>
                    </li>
                    {{/ delete}}

    				{{# edit}}
                    <li>
                        <a title="{{# str}} user_enrollments, local_program {{/ str}}" href="javascript:void(0)" title = "{{# str}} edit {{/str}}" onclick="(function(e){ require('local_program/ajaxforms').init({contextid:1, component:'local_program', callback:'program_form', form_status:0, plugintype: 'local', pluginname: 'program', id: {{ programid }} }) })(event)"><i class="fa fa-pencil fa-fw" aria-hidden="true" aria-label="" title = "{{# str}} edit {{/str}}"></i>
                        </a>
                    </li>
                    {{/ edit}}
    				{{# assignusers}}
                    <li>
                        <a href="{{ assignusersurl }}"><i class="icon fa fa-user-plus fa-fw" aria-hidden="true" title ="{{# str}} assignusers, local_program {{/str}}"></i></a>
                    </li>
                    {{/ assignusers}}

                    {{# hide_show}}
                        {{# hide}}
                            <li>
                                <a  href="javascript:void(0)" alt = "{{# str}} inactive {{/ str}}"
                                title = "{{# str}} inactive {{/ str}}" onclick="(function(e){ require('local_program/program').deleteConfirm({action:'inactiveprogram', id: {{ programid }}, programid: {{ programid }}, programname: '{{ program }}'}) })(event)"><i class="fa fa-eye fa-fw" aria-hidden="true" aria-label="" title = "{{# str}} makeinactive,local_program {{/ str}}"></i></a>
                            </li>
                        {{/ hide}}
                        {{# show}}
                            <li>
                                <a  href="javascript:void(0)" alt = "{{# str}} active {{/ str}}"
                                 title = "{{# str}} active {{/ str}}" onclick="(function(e){ require('local_program/program').deleteConfirm({action:'activeprogram', id: {{ programid }}, programid: {{ programid }}, programname: '{{ program }}'}) })(event)"><i class="fa fa-eye-slash" aria-hidden="true" aria-label="" title = "{{# str}} makeactive,local_program {{/ str}}"></i></a>
                            </li>
                        {{/ show}}
                    {{/ hide_show}}

		            {{# programcompletionstatus}}
                        <li>
                            <a href="#"><i class="fa fa-check-circle-o" aria-hidden="true" aria-label="" title ="{{# str}} completed, local_program {{/ str}}"></i></a>
                        </li>
                    {{/ programcompletionstatus}}
                </ul>
            {{/ action}}
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 pull-left pl-15 pr-15 pb-15 dataContainer">
        <div class="datacontent pull-left">
            <div class="description {{^ isdescription }} nodescription {{/ isdescription }}">
                {{# isdescription}}
                    {{^ descriptionstring}}
                        <p class="text-muted" title="{{{ description }}}">{{{ description }}}</p>
                    {{/ descriptionstring }}
                    {{# descriptionstring}}
                        <p class="text-muted" title="{{{ description }}}">{{ descriptionstring }}...</p>
                    {{/ descriptionstring }}
                {{/ isdescription}}
                {{^ isdescription }}
                    <p class="alert alert-info text-center">{{#str}}nocoursedesc, local_courses{{/str}}</p>
                {{/ isdescription }}
            </div>
            <div class="dataContainer col-lg-12 col-md-12 pull-left p-0">
                <div class="col-lg-8 col-md-8 pull-left p-0 dataContainer_left">
           <!--          <p class="w-full pull-left contentlist">
                        <span class="bcleftlable_name text-muted">{{# str}} stream, local_program {{/str}}
                            <span class="text-muted pull-right bccolon">:</span>
                        </span>
                        <span class="bc_value font-weight-bold" title="{{ stream }}">{{ streamname }}</span>
                    </p> -->

                    <p class="w-full pull-left contentlist">
                        <span class="bcleftlable_name text-muted">{{# str}} levels, local_program {{/str}}
                            <span class="text-muted pull-right bccolon">:</span>
                        </span>
                        <span class="bc_value font-weight-bold" title="{{ shortname }}">{{ totallevels }}</span>
                    </p>
                </div>
                <div class="col-lg-4 col-md-4 p-0 pull-left dataContainer_left">
                    <p class="w-full pull-left contentlist">
                        <span class="lable_name text-muted">{{# str}} enrolled, local_program {{/str}} 
                            <span class="text-muted pull-right bccolon">:</span>
                        </span>
                        <span class="bc_value font-weight-bold">{{ enrolled_users }}</span>
                    </p>

                    <p class="w-full pull-left contentlist">
                        <span class="lable_name text-muted">{{# str}} completed, local_program {{/str}} 
                            <span class="text-muted pull-right bccolon">:</span>
                        </span>
                        <span class="bc_value font-weight-bold" title="{{# str}} completed, local_program {{/str}}">{{ completed_users }}</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
