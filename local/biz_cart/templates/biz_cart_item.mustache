{{!
    @template local_biz_cart/biz_cart_item

    This template will render the biz_cart items.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * All data attributes are required

    Context variables required for this template:
    * userid the logged in user id
    * urls The URLs for the popover

    Example context (json):
    {
        "itemid": 3,
        "userid":3588,
        "componentname": "mod_booking",
        "area": "main",
        "price": 133,
        "expirationdate": 1642155164,
        "itemname": "Tenniscourse",
        "currency": "EUR",
        "iscashier": false,
        "nodelete": false
    }

}}

<li class="p-0" id="item-{{componentname}}-{{area}}-{{itemid}}"
    class="clearfix"
    data-price='{{price}}'
    data-name='{{itemname}}'
    data-component='{{componentname}}'
    data-area='{{area}}'
    data-itemid='{{itemid}}'
    data-item="biz_cart_item"
    data-currency='{{currency}}'
    data-userid='{{userid}}'>
    <div class="row w-100 align-items-center p-2">
        <div class="col-md-1 text-center">
            {{#iscashier}}
                <span class="item-button">
                    <i class="shoppingcart-discount-icon fa fa-fw fa-percent pl-2" aria-hidden="true"
                    data-item="biz_cart_item" data-component="{{componentname}}" data-area="{{area}}"
                    data-itemid="{{itemid}}" data-action="discount" data-userid="{{userid}}"></i>
                </span>
            {{/iscashier}}
            {{^nodelete}}
            <span class="item-button">
                <i class="fa fa-fw fa-trash-o" aria-hidden="true"
                data-item="biz_cart_item" data-itemid="{{itemid}}" data-component="{{componentname}}"
                data-area="{{area}}" data-action="delete" data-userid="{{userid}}" title = "{{#str}} deletefromcart, local_biz_cart {{/str}}"></i>
            </span>
            {{/nodelete}}
            {{#nodelete}}
            <!-- This is only to fix indentation -->
            <span class="pull-right">
                <i class="fa fa-fw pl-2" aria-hidden="true"></i>
            </span>
            {{/nodelete}}
        </div>
        <div class="col-md-2 d-flex align-items-center p-0">
            <div class="cart_item d-flex align-items-center">
                <span class="item-name">
                    {{#imageurl}}
                        <img alt="Image of cart item: {{itemname}}" class="sc-cart-item-image" src="{{.}}">
                    {{/imageurl}}
                    {{^imageurl}}
                        <img alt="Image of cart item: {{itemname}}" class="sc-cart-item-image" src="{{wwwroot}}/local/biz_cart/pix/cart.png">
                    {{/imageurl}}
                </span>
            </div>
        </div>
            <div class="col-md-4">
                <div class="itemname ml-2">
                    <b>{{itemname}}</b>
                    <div class="item-description">{{{description}}}</div>
                </div>
            </div>
        <div class="col-md-5">
            <div class="item_price">
                {{> local_biz_cart/item_price }}
            </div>
        </div>
    </div>
</li>
