{{!
    @template local_biz_cart/biz_cart_items

    This template will render items container of the shopping cart

    Classes required for JS:
    * none

    Data attributes required for JS:
    * All data attributes are required

    Context variables required for this template:
    * userid the logged in user id
    * urls The URLs for the popover

    Example context (json):
    {
    	"items": [
            {
                "itemid": 3,
                "userid":3588,
                "componentname": "mod_booking",
                "area": "main",
                "price": 133,
                "expirationdate": 1642155164,
                "itemname": "Tenniscourse",
                "currency": "EUR",
                "iscashier": false,
                "nodelete": false
    	    }
        ],
    	"initialtotal": 8,
    	"currency": "EUR"
    }
}}
{{#hasitems}}
{{#checkoutpage}}
<div class="shoppingcart_header">
        <div class="row w-100">
            <div class="col-md-2"></div>
            <div class="col-md-9">
                <div class="item-name ml-5"><b>Product</b></div>
            </div>
            <div class="col-md-1"><b class="ml-3">Price</b></div>
        </div>
    </div>
{{/checkoutpage}}
{{/hasitems}}
<ul class="shopping-cart-items">
    {{#items}}
        {{> local_biz_cart/biz_cart_item }}
    {{/items}}
    {{^items}}
        <div class="text-center">{{#str}} cartisempty, local_biz_cart {{/str}}</div>
    {{/items}}
    {{#hasitems}}
    <li class="sc_initialtotal">

        {{! price have tax info}}
        {{#taxesenabled}}
            {{#initialtotal_net}}
                <div class="text-right">
                <span>
                    {{#str}} total_net, local_biz_cart {{/str}}
                </span>
                <span class="font-weight-bold">
                    {{initialtotal_net}}
                    {{currency}}
                </span>
                </div>
            {{/initialtotal_net}}
            <div class="text-right">
                <span>
                    {{#str}} total, local_biz_cart {{/str}}
                </span>
                <span class="font-weight-bold">
                    {{initialtotal}}
                    {{currency}}
                </span>
                <!-- This is only to fix indentation -->
                <span class="pull-right">
                    <i class="fa fa-fw pl-5" aria-hidden="true"></i>
                </span>
            </div>
        {{/taxesenabled}}

        {{! prices without tax information }}
        {{^taxesenabled}}
            <div class="text-right">
                <span>
                    {{#str}} total, local_biz_cart {{/str}}
                </span>
                <span class="font-weight-bold">
                    <span><i class="fa fa-inr" aria-hidden="true"></i></span>
                    {{initialtotal}}
                </span>
                <!-- This is only to fix indentation -->
                <span class="pull-right">
                    <i class="fa fa-fw pl-5" aria-hidden="true"></i>
                </span>
            </div>
        {{/taxesenabled}}
    </li>
    {{/hasitems}}
</ul>
