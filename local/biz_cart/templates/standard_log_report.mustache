{{#response}}
    {{#viewtypeCard}}

        <table id = 'view_course_standard_log' class = 'generaltable' >
            <thead>
                <tr>
                    <th>{{#str}}time, local_biz_cart{{/str}}</th>
                    <th>{{#str}}course_name, local_biz_cart{{/str}}</th>
                    <th>{{#str}}user_fullname, local_biz_cart{{/str}}</th>
                    <th>{{#str}}event, local_biz_cart{{/str}}</th>
                    <th>{{#str}}message, local_biz_cart{{/str}}</th>
                    <th>{{#str}}action, local_biz_cart{{/str}}</th>
                    
                </tr>
            </thead>
            <tbody>
                {{#records}}
                    <tr>
                        <td>{{eventdate}}</td>
                        <td>{{#coursename}}{{coursename}}{{/coursename}}{{^coursename}}N/A{{/coursename}}</td>
                        <td>{{#userfullname}}{{userfullname}}{{/userfullname}}{{^userfullname}}N/A{{/userfullname}}</td>
                        <td>{{#eventname}}{{eventname}}{{/eventname}}{{^eventname}}N/A{{/eventname}}</td>
                        <td>{{#message}}{{message}}{{/message}}{{^message}}N/A{{/message}}</td>
                        <td>{{#action}}{{action}}{{/action}}{{^action}}N/A{{/action}}</td>
                       
                    </tr>
                {{/records}}
            </tbody>
        </table>
    {{/viewtypeCard}}
{{/response}}

