{{#response}}
    {{#viewtypeCard}}

        <table id = 'view_course_standard_log' class = 'generaltable' >
            <thead>
                <tr><th>Course id</th>
                    <th>Course Name</th>
                    <th>User ID</th>
                    <th>User Fullname</th>
                    <th>Event Name</th>
                    <th>Action</th>
                    <th> Date</th>
                </tr>
            </thead>
            <tbody>
                {{#records}}
                    <tr>
                        <td>{{#courseid}}{{courseid}}{{/courseid}}{{^courseid}}N/A{{/courseid}}</td>
                        <td>{{#coursename}}{{coursename}}{{/coursename}}{{^coursename}}N/A{{/coursename}}</td>
                        <td>{{#userid}}{{userid}}{{/userid}}{{^userid}}N/A{{/userid}}</td>
                        <td>{{#userfullname}}{{userfullname}}{{/userfullname}}{{^userfullname}}N/A{{/userfullname}}</td>
                        <td>{{#eventname}}{{eventname}}{{/eventname}}{{^eventname}}N/A{{/eventname}}</td>
                        <td>{{#action}}{{action}}{{/action}}{{^action}}N/A{{/action}}</td>
                        <td>{{eventdate}}</td>
                    </tr>
                {{/records}}
            </tbody>
        </table>
    {{/viewtypeCard}}
{{/response}}

