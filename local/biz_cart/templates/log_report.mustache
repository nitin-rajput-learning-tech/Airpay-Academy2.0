{{#response}}
<div class="d-flex flex-row-reverse">
                <a class="btn btn-primary" id="viewstdlog-btn" href="{{courselink}}" role="button" aria-controls="checkout">View Standard Log</a>
</div>
    {{#viewtypeCard}}


        <table id = 'view_course_transaction_log' class = 'generaltable' >
            <thead>
                <tr>
                    <th>{{#str}}time, local_biz_cart{{/str}}</th>
                    <th>{{#str}}course_name, local_biz_cart{{/str}}</th>
                    <th>{{#str}}user_fullname, local_biz_cart{{/str}}</th>
                    <th>{{#str}}orderid, local_biz_cart{{/str}}/th>
                    <th>{{#str}}ordermethod, local_biz_cart{{/str}}</th>
                    <th>{{#str}}orderstate, local_biz_cart{{/str}}</th>
                    <th>{{#str}}message, local_biz_cart{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#records}}
                    <tr>
                        <td>{{orderdate}}</td>
                        <td>{{#coursename}}{{coursename}}{{/coursename}}{{^coursename}}N/A{{/coursename}}</td>
                        <td>{{#userfullname}}{{userfullname}}{{/userfullname}}{{^userfullname}}N/A{{/userfullname}}</td>
                        <td>{{#orderid}}{{orderid}}{{/orderid}}{{^orderid}}N/A{{/orderid}}</td>
                        <td>{{#paymentarea}}{{paymentarea}}{{/paymentarea}}{{^paymentarea}}N/A{{/paymentarea}}</td>
                        <td>{{#order_state}}{{order_state}}{{/order_state}}{{^order_state}}N/A{{/order_state}}</td>
                        <td>{{#message}}{{message}}{{/message}}{{^message}}N/A{{/message}}</td>
                        
                    </tr>
                {{/records}}
            </tbody>
        </table>
    {{/viewtypeCard}}
{{/response}}
