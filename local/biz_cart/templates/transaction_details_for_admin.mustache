{{#response}}
    {{#viewtypeCard}}
        <table id = 'manage_transactions_foradmin' class = 'generaltable' >
            <thead>
                <tr><th>Course id</th>
                    <th>Course Name</th>
                    <th>User ID</th>
                    <th>User Fullname</th>
                    <th>Order ID</th>
                    <th>Transaction Code</th>
                    <th>Invoice Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {{#records}}
                    <tr>
                        <td>{{#courseid}}{{courseid}}{{/courseid}}{{^courseid}}N/A{{/courseid}}</td>
                        <td>{{#coursename}}{{coursename}}{{/coursename}}{{^coursename}}N/A{{/coursename}}</td>
                        <td>{{#userid}}{{userid}}{{/userid}}{{^userid}}N/A{{/userid}}</td>
                        <td>{{#userfullname}}{{userfullname}}{{/userfullname}}{{^userfullname}}N/A{{/userfullname}}</td>
                        <td>{{#orderid}}{{orderid}}{{/orderid}}{{^orderid}}N/A{{/orderid}}</td>
                        <td>{{#transactioncode}}{{transactioncode}}{{/transactioncode}}{{^transactioncode}}N/A{{/transactioncode}}</td>
                        <td>{{invoicedate}}</td>
                        <td>{{#amount}}<i class="fa fa-inr mr-1"></i>{{ amount }}{{/amount}}{{^amount}}N/A{{/amount}}</td>
                        <td>{{status}}</td>
                    </tr>
                {{/records}}
            </tbody>
        </table>
    {{/viewtypeCard}}
{{/response}}

{{! <script>
window.onload = function() {
        // Check if jQuery is loaded
        if (typeof jQuery !== 'undefined') {
            $('#airpay_transactions').DataTable({
            // Enable filtering
                searching: true,
                // Add other options as needed
                paging: true,    // Enable pagination
                ordering: true,  // Enable column ordering
                info: true   
            });          
        } else {
            console.error('jQuery is not loaded');
        }
    };
</script> }}
