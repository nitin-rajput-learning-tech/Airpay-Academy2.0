{{!
    @template local_sentientia_evaluation/non_respondents

    P1 #38 (2026-05-20) — admin view of (assigned vs responded) for one
    evaluation. Closes audit item #20.

    Context vars:
      evaluationid           int
      name                   string  (format_string'd)
      count_pending          int
      count_responded        int
      tab_pending_active     bool — exactly one of pending/responded is true
      tab_responded_active   bool
      tab_pending_url        URL
      tab_responded_url      URL
      back_url               URL
      rows                   array of {userid, fullname, email, trigger,
                                       has_source, source_id, has_due,
                                       due_at, is_overdue, responded_at,
                                       assigned_at, profile_url}
      has_rows               bool
      is_pending_tab         bool
      is_responded_tab       bool
}}
<div class="container" data-region="airpay-eval-non-respondents">

    <div class="ap-page-header mb-3 d-flex justify-content-between align-items-start gap-2">
        <div>
            <a href="{{{ back_url }}}" class="small text-muted text-decoration-none">
                <i class="fa fa-angle-left fa-fw" aria-hidden="true"></i>
                {{# str }}back_to_evaluations, local_sentientia_evaluation{{/ str }}
            </a>
            <h2 class="mb-1 mt-1" style="font-weight: 700;">{{ name }}</h2>
            <div class="small text-muted">
                {{# str }}non_respondents_subtitle, local_sentientia_evaluation{{/ str }}
            </div>
        </div>
        {{! P1 #40 (2026-05-20) — bulk-assign-by-audience trigger. }}
        <button type="button" class="btn btn-outline-primary"
                data-action="bulk-assign-audience"
                data-evaluationid="{{ evaluationid }}"
                title="Bulk-assign matching learners">
            <i class="fa fa-users fa-fw" aria-hidden="true"></i>
            {{# str }}bulk_assign_modal_title, local_sentientia_evaluation{{/ str }}
        </button>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <a class="nav-link {{# tab_pending_active }}active{{/ tab_pending_active }}"
               href="{{{ tab_pending_url }}}" role="tab">
                <i class="fa fa-hourglass-half fa-fw" aria-hidden="true"></i>
                {{# str }}non_respondents_tab_pending, local_sentientia_evaluation{{/ str }}
                <span class="badge bg-warning text-dark ms-1">{{ count_pending }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{# tab_responded_active }}active{{/ tab_responded_active }}"
               href="{{{ tab_responded_url }}}" role="tab">
                <i class="fa fa-check-circle fa-fw" aria-hidden="true"></i>
                {{# str }}non_respondents_tab_responded, local_sentientia_evaluation{{/ str }}
                <span class="badge bg-success ms-1">{{ count_responded }}</span>
            </a>
        </li>
    </ul>

    {{# has_rows }}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{# str }}non_respondents_col_name, local_sentientia_evaluation{{/ str }}</th>
                    <th scope="col">{{# str }}non_respondents_col_email, local_sentientia_evaluation{{/ str }}</th>
                    <th scope="col">{{# str }}non_respondents_col_trigger, local_sentientia_evaluation{{/ str }}</th>
                    <th scope="col">{{# str }}non_respondents_col_assigned, local_sentientia_evaluation{{/ str }}</th>
                    {{# is_pending_tab }}
                    <th scope="col">{{# str }}non_respondents_col_due, local_sentientia_evaluation{{/ str }}</th>
                    {{/ is_pending_tab }}
                    {{# is_responded_tab }}
                    <th scope="col">{{# str }}non_respondents_col_responded, local_sentientia_evaluation{{/ str }}</th>
                    {{/ is_responded_tab }}
                </tr>
            </thead>
            <tbody>
                {{# rows }}
                <tr>
                    <td>
                        <a href="{{{ profile_url }}}" class="text-decoration-none">{{ fullname }}</a>
                    </td>
                    <td><small class="text-muted">{{ email }}</small></td>
                    <td>
                        <span class="badge bg-light text-dark">{{ trigger }}</span>
                        {{# has_source }}<small class="text-muted ms-1">#{{ source_id }}</small>{{/ has_source }}
                    </td>
                    <td><small>{{ assigned_at }}</small></td>
                    {{# is_pending_tab }}
                    <td>
                        {{# has_due }}
                            {{# is_overdue }}<span class="text-danger fw-bold">{{ due_at }}</span>{{/ is_overdue }}
                            {{^ is_overdue }}<span>{{ due_at }}</span>{{/ is_overdue }}
                        {{/ has_due }}
                        {{^ has_due }}<small class="text-muted">—</small>{{/ has_due }}
                    </td>
                    {{/ is_pending_tab }}
                    {{# is_responded_tab }}
                    <td><small>{{ responded_at }}</small></td>
                    {{/ is_responded_tab }}
                </tr>
                {{/ rows }}
            </tbody>
        </table>
    </div>
    {{/ has_rows }}

    {{^ has_rows }}
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            {{# is_pending_tab }}
            <i class="fa fa-check-circle fa-4x text-success mb-3 d-block" aria-hidden="true"></i>
            <h4 class="mb-2">{{# str }}non_respondents_empty_pending_heading, local_sentientia_evaluation{{/ str }}</h4>
            <p class="text-muted">{{# str }}non_respondents_empty_pending_body, local_sentientia_evaluation{{/ str }}</p>
            {{/ is_pending_tab }}
            {{# is_responded_tab }}
            <i class="fa fa-inbox fa-4x text-muted mb-3 d-block" aria-hidden="true"></i>
            <h4 class="mb-2">{{# str }}non_respondents_empty_responded_heading, local_sentientia_evaluation{{/ str }}</h4>
            <p class="text-muted">{{# str }}non_respondents_empty_responded_body, local_sentientia_evaluation{{/ str }}</p>
            {{/ is_responded_tab }}
        </div>
    </div>
    {{/ has_rows }}

</div>
