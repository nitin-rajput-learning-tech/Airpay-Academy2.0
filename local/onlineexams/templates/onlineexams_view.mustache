{{!
    @template local_onlineexams/catalog

    This template renders the courses content for the courses plugin.

    Example context (json):
    {}
}}
{{#response}}
    {{! card view }}
    {{#viewtypeCard}}
        <div class="row clearfix">
            {{#records}}
                {{# hascourses}}
                        <div class="{{cardClass}} catcourses_list {{course_class}} ">
                            <div class="d-flex course_container">
                                <div class="courseimg_container ">
                                    <div style="background-image: url('{{{ courseimage }}}');" alt="{{ coursename }}" class="courseimg courseimg_bg h-100" >
                                         <!-- <div class="course_progress_container d-flex align-items-center">
                                            <div class="progress_circular" style="background-image:conic-gradient(white 0%,transparent 0%);">
                                            </div>
                                            <div class="progress_status">Completed</div>
                                            <div class="progress_percentage">0%</div>
                                        </div> -->
                                    </div>
                                </div>
                                <div class="coursecontent   d-flex flex-column justify-content-between">

                                    <div class="d-flex mt-1">
                                        <h5 class="flex-grow-1 course_name m-0">
                                            {{^ coursenameCut}}
                                            <a href="{{ courseurl }}" title="{{ coursename }}">{{ coursename }}</a>
                                            {{/ coursenameCut}}
                                            {{# coursenameCut}}
                                            <a href="{{ courseurl }}" title="{{ coursename }}">{{ coursenameCut }}</a>
                                            {{/ coursenameCut}}
                                        </h5>
{{#actions}}
    <div>
        <div class="dropdown action_menu_dropdown">
            <span  data-toggle="dropdown" class="px-2" aria-expanded="false">
                <i class="fa fa-ellipsis-h"></i>
            </span>
        <div class="dropdown-menu dropdown-menu-right shadow-sm">

            
            {{#enrol}}
                <a href="{{ enrollusers }}" class="dropdown-item" title= "{{#str}}userenrolments, local_onlineexams{{/str}}" >
                    <i class="fa fa-user" aria-hidden="true"></i>User Enrollments
                </a>
           {{/enrol}}
           {{#update}}
                {{#auto_enrol}}
                    <a href="{{ auto_enrol }}" class="dropdown-item" title= "{{#str}}auto_enrol, local_onlineexams{{/str}}">
                        <i class="fa fa-user-circle-o" aria-hidden="true"></i>
                    </a>
                {{/auto_enrol}}
            {{/update}}
            {{#update}}
                {{# editcourse}}
                    {{{ editcourse }}}
                {{/ editcourse}}
                {{# update_status}}
                    {{{update_status}}}
                {{/ update_status}}
            {{/update}}
           
            {{#deleteaction}}
                {{{ deleteaction }}}
            {{/deleteaction}}
        </div>
        </div>
    </div>
{{/actions}}
                                    </div>
                                    <div class="coursedesc mb-2">
                                        {{# coursesummary }}
                                            <p class="desc" title = "Onlineexam Descripton" >{{ coursesummary }}</p>
                                        {{/ coursesummary }}
                                        {{^ coursesummary }}
                                            <p class="alert alert-info text-center mt-1">{{#str}}noonlineexamdesc, local_onlineexams{{/str}}</p>
                                        {{/ coursesummary }}
                                    </div>
                                    <!--<div class="d-flex mb-2">
                                        <span class="text-muted">{{#str}}category, local_onlineexams{{/str}} : </span> <span class="ml-1">{{#catnamestring}}{{catnamestring}}{{/catnamestring}}{{^catnamestring}}N/A{{/catnamestring}}</span>
                                    </div>-->
                                    <div class="row">                                       
                                         <div class="col-6">
                                            <div class="d-flex">
                                                <span class="text-muted">{{#str}}department, local_onlineexams{{/str}} : </span> <span class="ml-1">{{{}}}</span>
                                            </div>
                                        </div> 
                                    </div>

                                    <div class="courseinfo_container">                                        
                                        <div class="info_container points_info">
                                            <div class="icon"></div>
                                            <span class="info_title">{{#str}}maxgrade, local_onlineexams{{/str}} : </span> 
                                            <span class="info_value">{{skillname}}  </span>
                                        </div> 
                                       <div class="info_container rating_info">
                                            <div class="icon"></div>
                                            <span class="info_title">  {{#str}}gradepass, local_onlineexams{{/str}} : </span> 
                                            <span class="info_value"> {{ passgrade}}</span>
                                        </div>
                                        <div class="info_container enrolment_info">
                                            <div class="icon"></div>                                           
                                            <span class="info_title">{{#str}}enrollments, local_onlineexams{{/str}}/{{#str}}completed, local_onlineexams{{/str}} :  </span>
                                            <span class="info_value"> {{enrolled_count}}/{{completed_count}}</span>
                                        </div>                                        
                                    </div>

                                    <div class="d-flex coursetype coursetypes_container">                               
                                            <span class="info_title">{{#str}} from {{/str}} : {{examfromdate}} {{#str}} to{{/str}} : {{examtodate}}</span>

                                    </div>
                                </div>


                            </div>

                        </div>
                {{/ hascourses}}
                <div class="col-md-12">{{{ pagination }}}</div>
                {{# nocourses}}
                  <div class='w-full pull-left text-center alert alert-info'>No courses available.</div>
                {{/ nocourses}}
            {{/records}}
        </div>
    {{/viewtypeCard}}
{{/response}}


