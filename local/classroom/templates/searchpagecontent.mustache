{{!
    @template catalog/classroom list

    Displays classroom
   
}}
<!-- Versatile cards view-->
<span class="courseimg_strip">Strip</span>
<div class="row mt-2 mb-2">
    <div class=" card-img-top courseimg_container col-md-4">
        <a title="<% record.fullname %>">
            <div style="background-image: url('<% record.fileurl %>')" class=courseimg_bg></div>
        </a>
    </div>
    <div class="card-body readyCCnt coursecontent col-md-8">
        <div class="d-flex w-full course_name_container ">
            <div>
                <a ng-if="record.userenrolstatus == 0 || record.selfenroll == 2" class="d-block link text-decoration-none" title="<% record.fullname %>" >
                    <h4 class="course_name m-y-1 card-title course-title">
                        <% record.fullname %>
                    </h4>
                </a>
                <a ng-if="record.userenrolstatus == 1" class="d-block link text-decoration-none" title="<% record.fullname %>">
                    <h4 class="course_name m-y-1 card-title course-title">
                        <% record.fullname %>
                    </h4>
                </a>
            </div>
            <span class="CstripCnt">
                <span class="elearning">Instructor-led Course</span>
            </span>

        </div>
        <div class="card-text course-desc">
            <div class="coursedesc w-full pull-left">
                <div class="course-desc" ng-bind-html="record.intro | unsafe"></div>
            </div>
             <span ng-if='record.selfenroll == 2'>
                    <span class="all-seats-filled txt-red">
                        {{#str}}capacity_check,local_search{{/str}}
                    </span>
                </span>
        </div>
        <div class=" justify-content-between align-items-center w-full">
            <div class="action_div">
                <span ng-if='record.selfenroll == 0' class='catcr_enrol' ng-bind-html='record.enrollmentbtn | unsafe'>kasdksad</span>
               
                <span ng-if="record.userenrolstatus == 1">
                    <a class="as_button_in_anchor" ng-href="<% record.classroomlink %>">
                        <span class="cat_btn btn-sm appear_as_button btn-primary viewmore_btn">{{#str}}start_now, local_classroom{{/str}}</span>
                    </a>
                </span>
                <span ng-bind-html="record.redirect | unsafe"></span>
            </div>
        </div>
    </div>
</div>
