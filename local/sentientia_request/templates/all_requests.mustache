{{!
    @template local_sentientia_request/all_requests
}}
<div class="container-fluid">
    <h2 class="mb-3">{{#str}}allrequests, local_sentientia_request{{/str}}</h2>

    {{!
        WF-022: data-region must be "airpay-datatable" (not "datatable") to
        match theme_sentientia/datatable's init() selector; Datatable.init()
        takes no args. Same Bug #12 fix that landed on my_requests.mustache.
    }}
    <div data-region="airpay-datatable"
         data-component="local_sentientia_request"
         data-ws-name="local_sentientia_request_list_all"
         data-columns="{{ columns_json }}"
         data-default-sort="timecreated"
         data-default-sortdir="desc"
         data-extra-args='{}'>
        <div class="text-center text-muted py-5">Loading...</div>
    </div>
</div>

{{#js}}
require(['theme_sentientia/datatable'],
    function(Datatable) {
        Datatable.init();
    });
{{/js}}
