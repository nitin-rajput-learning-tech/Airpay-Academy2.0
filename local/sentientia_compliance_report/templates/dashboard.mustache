{{!
    @template local_sentientia_compliance_report/dashboard
    Compliance reporting dashboard — matrix, defaulters, scorecard, manager report.

    Escaping (F-12, 2026-09-16): fullname / designation / department / department_name / parentname /
    name / coursename (config) / entity_name arrive format_string()'d from compliance_engine or index.php
    and are rendered with triple braces. matrix_pagingbar is core paging_bar HTML. Raw DB values (matrix
    course headers, defaulters, manager report, emails) keep double braces.

    Empty states (2026-11-18): matrix_empty / defaulters_empty / scorecard_empty / manager_empty are
    contexts for theme_sentientia/components/empty_state (icon, title, message), built in index.php.
}}
<div class="airpay-compliance-rpt">

    {{! Data Freshness Indicator }}
    {{#last_refreshed}}
    <div style="display:flex; justify-content:flex-end; align-items:center; gap:8px; margin-bottom:8px; font-size:12px; color:var(--ap-text-muted, #8896a6);">
        <i class="fa fa-clock"></i>
        <span>{{#str}}data_updated, local_sentientia_compliance_report, {{last_refreshed}}{{/str}}</span>
        {{#is_stale}}<span style="color:#d97706; font-weight:600;"><i class="fa fa-exclamation-triangle"></i> {{#str}}stale_refresh, local_sentientia_compliance_report{{/str}}</span>{{/is_stale}}
    </div>
    {{/last_refreshed}}

    {{! Line managers see their reporting tree only - say so, so a short list does not read as missing data. }}
    {{#is_team_scope}}
    <div class="alert alert-info" role="status" style="font-size:13px; margin-bottom:12px;">
        <i class="fa fa-users" aria-hidden="true"></i>
        {{#str}}scope_team, local_sentientia_compliance_report, {{team_size}}{{/str}}
    </div>
    {{/is_team_scope}}

    {{! KPI Summary Bar — Phase B0 iter X: migrated to tokens-aware stat_card partial }}
    {{#has_kpi_tiles}}
    <div class="airpay-stat-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
        {{#kpi_tiles}}
        {{> theme_sentientia/components/stat_card }}
        {{/kpi_tiles}}
    </div>
    {{/has_kpi_tiles}}

    {{! ═══ FILTER BAR ═══ }}
    {{! Filter bar styling lives in styles.css (__filter-*): 590px column layout, max-width on the selects, dark mode (PB-2). }}
    <div class="airpay-compliance-rpt__filter-bar">
        <span class="airpay-compliance-rpt__filter-label"><i class="fa fa-filter"></i> {{#str}}filter_label, local_sentientia_compliance_report{{/str}}</span>
        {{#has_bus}}
        <select class="airpay-compliance-rpt__filter-select" onchange="applyFilter('bu', this.value)">
            <option value="0">{{#str}}filter_all_business_units, local_sentientia_compliance_report{{/str}}</option>
            {{#filter_bus}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}} ({{user_count}})</option>
            {{/filter_bus}}
        </select>
        {{/has_bus}}
        {{#has_depts}}
        <select class="airpay-compliance-rpt__filter-select" onchange="applyFilter('dept', this.value)">
            <option value="0">{{#str}}filter_all_departments, local_sentientia_compliance_report{{/str}}</option>
            {{#filter_depts}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}} ({{user_count}})</option>
            {{/filter_depts}}
        </select>
        {{/has_depts}}
        {{#has_subdepts}}
        <select class="airpay-compliance-rpt__filter-select" onchange="applyFilter('subdept', this.value)">
            <option value="0">{{#str}}filter_all_subdepartments, local_sentientia_compliance_report{{/str}}</option>
            {{#filter_subdepts}}
            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}} ({{user_count}})</option>
            {{/filter_subdepts}}
        </select>
        {{/has_subdepts}}
        {{#selected_bu}}
        <a href="{{baseurl}}?tab={{#tab_matrix}}matrix{{/tab_matrix}}{{#tab_defaulters}}defaulters{{/tab_defaulters}}{{#tab_scorecard}}scorecard{{/tab_scorecard}}{{#tab_manager}}manager{{/tab_manager}}{{#tab_config}}config{{/tab_config}}"
           class="airpay-compliance-rpt__filter-clear"><i class="fa fa-times"></i> {{#str}}clear_filters, local_sentientia_compliance_report{{/str}}</a>
        {{/selected_bu}}
    </div>
    <script>
    function applyFilter(param, val) {
        var url = new URL(window.location.href);
        url.searchParams.set(param, val);
        // Reset child filters when parent changes.
        if (param === 'bu') { url.searchParams.delete('dept'); url.searchParams.delete('subdept'); }
        if (param === 'dept') { url.searchParams.delete('subdept'); }
        window.location = url.toString();
    }
    document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-confirm]');
        if (el && !window.confirm(el.getAttribute('data-confirm'))) {
            e.preventDefault();
        }
    });
    </script>

    {{! Tab Navigation }}
    <div class="airpay-compliance-rpt__tabs">
        <a href="{{baseurl}}?tab=matrix&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_matrix}}active{{/tab_matrix}}">{{#str}}compliancematrix, local_sentientia_compliance_report{{/str}}</a>
        <a href="{{baseurl}}?tab=defaulters&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_defaulters}}active{{/tab_defaulters}}">{{#str}}defaulters, local_sentientia_compliance_report{{/str}}</a>
        <a href="{{baseurl}}?tab=scorecard&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_scorecard}}active{{/tab_scorecard}}">{{#str}}departmentscorecard, local_sentientia_compliance_report{{/str}}</a>
        <a href="{{baseurl}}?tab=manager&bu={{selected_bu}}&dept={{selected_dept}}&subdept={{selected_subdept}}" class="{{#tab_manager}}active{{/tab_manager}}">{{#str}}managerreport, local_sentientia_compliance_report{{/str}}</a>
        {{#is_siteadmin}}
        <a href="{{baseurl}}?tab=config" class="{{#tab_config}}active{{/tab_config}}"><i class="fa fa-cog"></i> {{#str}}configure, local_sentientia_compliance_report{{/str}}</a>
        {{/is_siteadmin}}
        {{! Export button only for users who pass the same gate export.php enforces. }}
        {{#can_export}}
        <a href="{{exporturl}}" class="airpay-compliance-rpt__export"><i class="fa fa-download"></i> {{#str}}export, local_sentientia_compliance_report{{/str}}</a>
        {{/can_export}}
    </div>

    {{! Tab Content: Compliance Matrix }}
    {{#tab_matrix}}
    {{#has_matrix}}
    <p class="airpay-compliance-rpt__showing">{{matrix_showing}}</p>
    <div class="airpay-compliance-rpt__table-wrap">
        <table class="airpay-compliance-rpt__table">
            <thead>
                <tr>
                    <th>{{#str}}col_employee, local_sentientia_compliance_report{{/str}}</th>
                    <th>{{#str}}col_email, local_sentientia_compliance_report{{/str}}</th>
                    <th>{{#str}}col_department, local_sentientia_compliance_report{{/str}}</th>
                    {{#matrix.courses}}
                    <th title="{{coursename}}">{{coursename}}</th>
                    {{/matrix.courses}}
                </tr>
            </thead>
            <tbody>
                {{#matrix.rows}}
                <tr class="{{#all_completed}}row-ok{{/all_completed}}">
                    {{! The Department column printed the designation until 2026-11-18; the designation now sits under the name.
                        The title attribute takes fullname with double braces, not triple: format_string() does not escape
                        quotes, and a quote in a user's name would close the attribute. }}
                    <td title="{{fullname}}"><strong>{{{fullname}}}</strong><br><small>{{employee_id}}{{#designation}}{{#employee_id}} · {{/employee_id}}{{{designation}}}{{/designation}}</small></td>
                    <td>{{email}}</td>
                    <td>{{{department_name}}}</td>
                    {{#courses}}
                    <td><span class="badge badge-{{status_class}}">{{status_label}}</span>
                        {{#days_overdue}}<small class="text-danger">{{days_overdue}}d</small>{{/days_overdue}}</td>
                    {{/courses}}
                </tr>
                {{/matrix.rows}}
            </tbody>
        </table>
    </div>
    {{{matrix_pagingbar}}}
    {{/has_matrix}}
    {{^has_matrix}}
    {{#matrix_empty}}{{> theme_sentientia/components/empty_state }}{{/matrix_empty}}
    {{/has_matrix}}
    {{/tab_matrix}}

    {{! Tab Content: Defaulters }}
    {{#tab_defaulters}}
    {{#has_defaulters}}
    <div class="airpay-compliance-rpt__table-wrap">
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>{{#str}}col_employee, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_email, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_course, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_days_overdue, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_progress, local_sentientia_compliance_report{{/str}}</th></tr></thead>
        <tbody>
            {{#defaulters}}
            <tr>
                <td><strong>{{firstname}} {{lastname}}</strong></td>
                <td>{{email}}</td>
                <td>{{coursename}}</td>
                <td class="text-danger"><strong>{{#str}}n_days, local_sentientia_compliance_report, {{days_overdue}}{{/str}}</strong></td>
                <td>{{progress_percent}}%</td>
            </tr>
            {{/defaulters}}
        </tbody>
    </table>
    </div>
    {{/has_defaulters}}
    {{^has_defaulters}}
    {{#defaulters_empty}}{{> theme_sentientia/components/empty_state }}{{/defaulters_empty}}
    {{/has_defaulters}}
    {{/tab_defaulters}}

    {{! Tab Content: Department Scorecard. Sub-departments follow their department, indented and
        prefixed with its name (names such as "Technology" repeat across departments). A unit with no
        assignments reads "No assignments", not red "Critical"; such units are listed on request only
        (scorecard_toggle_url). Overdue is red only when there is something overdue. }}
    {{#tab_scorecard}}
    {{#has_scorecard}}
    <div class="airpay-compliance-rpt__table-wrap">
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>{{#str}}col_department, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_total, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_completed, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_overdue, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_rate, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_status, local_sentientia_compliance_report{{/str}}</th></tr></thead>
        <tbody>
            {{#scorecard}}
            <tr class="{{#has_parent}}airpay-compliance-rpt__subunit{{/has_parent}}{{#is_empty}} airpay-compliance-rpt__row-empty{{/is_empty}}">
                <td>{{#has_parent}}<span class="airpay-compliance-rpt__parent">{{{parentname}}} ›</span> {{/has_parent}}{{{department}}}</td>
                <td>{{total}}</td>
                <td>{{completed}}</td>
                <td class="{{#has_overdue}}text-danger font-weight-bold{{/has_overdue}}">{{overdue}}</td>
                <td>{{^is_empty}}{{rate}}%{{/is_empty}}{{#is_empty}}&ndash;{{/is_empty}}</td>
                <td>
                    {{#is_empty}}<span class="badge airpay-compliance-rpt__badge-none">{{#str}}scorecard_no_assignments, local_sentientia_compliance_report{{/str}}</span>{{/is_empty}}
                    {{^is_empty}}<span class="badge badge-{{#is_green}}success{{/is_green}}{{#is_amber}}warning{{/is_amber}}{{#is_red}}danger{{/is_red}}">
                    {{#is_green}}{{#str}}on_track, local_sentientia_compliance_report{{/str}}{{/is_green}}{{#is_amber}}{{#str}}at_risk, local_sentientia_compliance_report{{/str}}{{/is_amber}}{{#is_red}}{{#str}}critical, local_sentientia_compliance_report{{/str}}{{/is_red}}
                    </span>{{/is_empty}}
                </td>
            </tr>
            {{/scorecard}}
        </tbody>
    </table>
    </div>
    {{/has_scorecard}}
    {{^has_scorecard}}
    {{#scorecard_empty}}{{> theme_sentientia/components/empty_state }}{{/scorecard_empty}}
    {{/has_scorecard}}
    {{#scorecard_toggle_url}}
    <p class="airpay-compliance-rpt__toggle"><a href="{{scorecard_toggle_url}}">{{scorecard_toggle_label}}</a></p>
    {{/scorecard_toggle_url}}
    {{/tab_scorecard}}

    {{! Tab Content: Manager Report }}
    {{#tab_manager}}
    {{#has_manager_report}}
    <div class="airpay-compliance-rpt__table-wrap">
    <table class="airpay-compliance-rpt__table">
        <thead><tr><th>{{#str}}col_manager, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_team_members, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_assignments, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_completed, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_overdue, local_sentientia_compliance_report{{/str}}</th><th>{{#str}}col_rate, local_sentientia_compliance_report{{/str}}</th></tr></thead>
        <tbody>
            {{#manager_report}}
            <tr>
                <td><strong>{{mgr_firstname}} {{mgr_lastname}}</strong>{{#mgr_left}} <span class="badge badge-secondary">{{#str}}manager_left, local_sentientia_compliance_report{{/str}}</span>{{/mgr_left}}</td>
                <td>{{team_members}}</td>
                <td>{{team_assignments}}</td>
                <td>{{team_completed}}</td>
                <td class="{{#team_overdue}}text-danger font-weight-bold{{/team_overdue}}">{{team_overdue}}</td>
                <td>{{team_rate}}%</td>
            </tr>
            {{/manager_report}}
        </tbody>
    </table>
    </div>
    {{/has_manager_report}}
    {{^has_manager_report}}
    {{#manager_empty}}{{> theme_sentientia/components/empty_state }}{{/manager_empty}}
    {{/has_manager_report}}
    {{/tab_manager}}

    {{! ═══ Tab Content: Configuration ═══ }}
    {{#tab_config}}
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">

        {{! Compliance Courses Management }}
        <div style="background:#fff; border:1px solid #e2e6ef; border-radius:12px; padding:20px;">
            <h3 style="font-size:16px; font-weight:700; color:#1a1a2e; margin:0 0 16px;">
                <i class="fa fa-book" style="color:#0066A7;"></i> {{#str}}config_courses_heading, local_sentientia_compliance_report{{/str}}
            </h3>
            <p style="font-size:13px; color:#5a6070; margin:0 0 12px;">{{#str}}config_courses_desc, local_sentientia_compliance_report{{/str}}</p>

            {{! Add course form }}
            <form method="post" action="{{baseurl}}" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; padding:12px; background:#f8f9fc; border-radius:8px;">
                <input type="hidden" name="action" value="addcourse">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="tab" value="config">
                <select name="courseid" required style="flex:2; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit; min-width:180px;">
                    <option value="">{{#str}}select_course, local_sentientia_compliance_report{{/str}}</option>
                    {{#allcourses}}
                    <option value="{{id}}">{{{name}}}</option>
                    {{/allcourses}}
                </select>
                <select name="entityid" style="flex:1; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit;">
                    <option value="0">{{#str}}filter_all_entities, local_sentientia_compliance_report{{/str}}</option>
                    {{#filter_bus}}
                    <option value="{{id}}">{{{name}}}</option>
                    {{/filter_bus}}
                </select>
                <input type="number" name="days" value="30" min="1" max="365" style="width:70px; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px;" title="{{#str}}deadline_days, local_sentientia_compliance_report{{/str}}">
                <button type="submit" style="padding:6px 14px; background:#0066A7; color:#fff; border:none; border-radius:6px; font-size:13px; font-weight:500; cursor:pointer;">
                    <i class="fa fa-plus"></i> {{#str}}add, local_sentientia_compliance_report{{/str}}
                </button>
            </form>

            {{! Course list }}
            {{#has_config_courses}}
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:#f8f9fc;">
                        <th style="text-align:left; padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_course, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_entity, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_days, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef; text-align:right;">{{#str}}col_action, local_sentientia_compliance_report{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#config_courses}}
                    <tr style="border-bottom:1px solid #f0f2f7; {{^is_active}}opacity:0.5;{{/is_active}}">
                        <td style="padding:8px 10px;"><strong>{{{coursename}}}</strong></td>
                        <td style="padding:8px 10px;">{{{entity_name}}}</td>
                        <td style="padding:8px 10px; text-align:center;">{{deadline_days}}d</td>
                        <td style="padding:8px 10px; text-align:right;">
                            {{#is_active}}
                            <a href="{{baseurl}}?action=removecourse&id={{id}}&sesskey={{sesskey}}&tab=config"
                               style="color:#dc2626; font-size:12px; text-decoration:none;"
                               data-confirm="{{#str}}confirm_remove_course, local_sentientia_compliance_report{{/str}}">
                                <i class="fa fa-times"></i> {{#str}}remove, local_sentientia_compliance_report{{/str}}
                            </a>
                            {{/is_active}}
                            {{^is_active}}
                            <span style="color:#8890a0; font-size:12px;">{{#str}}inactive, local_sentientia_compliance_report{{/str}}</span>
                            {{/is_active}}
                        </td>
                    </tr>
                    {{/config_courses}}
                </tbody>
            </table>
            {{/has_config_courses}}
        </div>

        {{! Excluded Users }}
        <div style="background:#fff; border:1px solid #e2e6ef; border-radius:12px; padding:20px;">
            <h3 style="font-size:16px; font-weight:700; color:#1a1a2e; margin:0 0 16px;">
                <i class="fa fa-user-times" style="color:#dc2626;"></i> {{#str}}excluded_users_heading, local_sentientia_compliance_report{{/str}}
            </h3>
            <p style="font-size:13px; color:#5a6070; margin:0 0 12px;">{{#str}}excluded_users_desc, local_sentientia_compliance_report{{/str}}</p>

            {{! Exclude user form }}
            <form method="post" action="{{baseurl}}" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; padding:12px; background:#f8f9fc; border-radius:8px;">
                <input type="hidden" name="action" value="exclude">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="tab" value="config">
                <input type="number" name="userid" placeholder="{{#str}}user_id, local_sentientia_compliance_report{{/str}}" required style="width:100px; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px;">
                <input type="text" name="reason" placeholder="{{#str}}reason_placeholder, local_sentientia_compliance_report{{/str}}" style="flex:1; padding:6px 10px; border:1px solid #e2e6ef; border-radius:6px; font-size:13px; font-family:inherit;">
                <button type="submit" style="padding:6px 14px; background:#dc2626; color:#fff; border:none; border-radius:6px; font-size:13px; font-weight:500; cursor:pointer;">
                    <i class="fa fa-ban"></i> {{#str}}exclude, local_sentientia_compliance_report{{/str}}
                </button>
            </form>

            {{! Excluded list }}
            {{#has_config_excluded}}
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:#f8f9fc;">
                        <th style="text-align:left; padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_user, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_reason, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef;">{{#str}}col_date, local_sentientia_compliance_report{{/str}}</th>
                        <th style="padding:8px 10px; font-size:11px; text-transform:uppercase; color:#5a6070; border-bottom:1px solid #e2e6ef; text-align:right;">{{#str}}col_action, local_sentientia_compliance_report{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#config_excluded}}
                    <tr style="border-bottom:1px solid #f0f2f7;">
                        <td style="padding:8px 10px;"><strong>{{{fullname}}}</strong><br><span style="font-size:11px; color:#8890a0;">{{email}}</span></td>
                        <td style="padding:8px 10px;">{{reason}}</td>
                        <td style="padding:8px 10px;">{{excluded_date}}</td>
                        <td style="padding:8px 10px; text-align:right;">
                            <a href="{{baseurl}}?action=include&userid={{userid}}&sesskey={{sesskey}}&tab=config"
                               style="color:#16a34a; font-size:12px; text-decoration:none;">
                                <i class="fa fa-check"></i> {{#str}}reinclude, local_sentientia_compliance_report{{/str}}
                            </a>
                        </td>
                    </tr>
                    {{/config_excluded}}
                </tbody>
            </table>
            {{/has_config_excluded}}
            {{^has_config_excluded}}
            <p style="color:#8890a0; font-size:13px; text-align:center; padding:20px;">{{#str}}no_excluded_users, local_sentientia_compliance_report{{/str}}</p>
            {{/has_config_excluded}}
        </div>
    </div>
    {{/tab_config}}
</div>
